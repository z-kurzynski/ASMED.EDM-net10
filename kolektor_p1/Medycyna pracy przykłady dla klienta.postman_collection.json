    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"success\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    if (pm.response.code === 200 && jsonData.access_token) {\r",
              "        console.log(jsonData.access_token);\r",
              "        pm.environment.set(\"auth_token\", jsonData.access_token);\r",
              "    } else {\r",
              "        pm.environment.unset(\"auth_token\", \"\");\r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/login?username=cered&password=Cered_01",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ],
          "query": [
