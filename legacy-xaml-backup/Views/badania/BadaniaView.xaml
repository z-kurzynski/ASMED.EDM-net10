<UserControl x:Class="ASMED.WPF.Views.BadaniaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
    xmlns:converters="clr-namespace:ASMED.WPF.Converters"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:local="clr-namespace:ASMED.WPF.Views"
    xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="av"
    Height="Auto" Width="Auto" VerticalAlignment="Top" MaxWidth="1800" MinWidth="1100">

    <UserControl.Resources>
        <!-- Converters removed to avoid design-time/type resolution issues; using DataTriggers instead -->

        <Style TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="{x:Type Path}" x:Key="SfDataGridHeaderIconStyle">
            <Setter Property="Fill" Value="Cyan"/>
        </Style>
        <!-- Poprawka: usunięto zbędny dwukropek na końcu TargetType -->
        <Style TargetType="{x:Type syncfusion:FilterToggleButton}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="BorderBrush" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

    </UserControl.Resources>

    <Grid HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" 
              MaxWidth="1500" MinWidth="1100"
              Width="1500">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="425"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="8"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="Filtr" Grid.Column="1" VerticalAlignment="Center" Height="46">
                <TextBlock Text="Wyszukaj :" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel HorizontalAlignment="Left">
                    <TextBox x:Name="txtFilterTop" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="247" FontSize="14" />
                    <Button Width="32" Height="28" Margin="10,0,0,0" ToolTip="Wyczyść pole" Click="ClearFilter_Click">
                        <Image Source="/ASMED.WPF;component/Assets/no.png" Width="10" Height="10" />
                    </Button>
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="10,0,8,0"
                        SelectedItem="{Binding SelectedFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding FilterOptions}"/>
                </DockPanel>
            </StackPanel>

            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->


            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->
            <syncfusion:ButtonAdv x:Name="Dadaj_badan"
                    Grid.Column="5"

                    HorizontalAlignment="Center"
                    Height="45"
                    Label=" ➕ Dodaj Badań"
                    VerticalAlignment="Top"
                    Width="220"
                    Background="#FF3F51B5"
                    Foreground="#FFFBFBFB"
                    FontStyle="Italic"
                    FontSize="16" Margin="0,10,0,0" IsCheckable="True" Visibility="Hidden"  >
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>

            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->
            <syncfusion:ButtonAdv x:Name="Lista_badan"
                    Grid.Column="6"
                    HorizontalAlignment="Center"
                    Height="45"
                    Label="  ➕ Lista Badań"
                    VerticalAlignment="Top"
                    Width="220"

                    Background="#FF009688"
                    Foreground="#FFFBFBFB"
                    FontStyle="Italic"
                    FontSize="16" IsCheckable="True" Margin="0,10,0,0"
                    Click="Lista_Badan_Click"  >
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>

        </Grid>
        <Grid Grid.Row="1" Height="NaN" Margin="10,10,10,10" Width="1500">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="505"/>
                <ColumnDefinition Width="1005"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="Lewy_lista" Orientation="Vertical" HorizontalAlignment="Center" Width="490" Margin="0,10,0,0">

                <!-- Filter controls -->

                <syncfusion:SfDataGrid x:Name="Lista_Wizyt" ItemsSource="{Binding Wizyty}"
                    AutoGenerateColumns="False"
                    LiveDataUpdateMode="AllowChildViewUpdate"
                    SelectedItem="{Binding SelectedWizyta, Mode=TwoWay}"
            
                    AlternationCount="2"
                    RowHeight="60"
                    ColumnSizer="Star"
                    FontSize="17"
                    AllowFiltering="True"
                    AllowSorting="True"
                    SelectionMode="Single"
                    SelectionUnit="Row"
                    FontFamily="Arial Narrow"
                    Padding="2,2,2,2"
                    RowSelectionBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" 
                    CurrentCellBorderBrush="{x:Null}" OpacityMask="#FFFFFDFD" HorizontalAlignment="Left" Height="600" RenderTransformOrigin="0.5,0.5" Width="472"   >
                    <syncfusion:SfDataGrid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleY="0"/>
                            <RotateTransform/>
                            <TranslateTransform Y="0"/>
                        </TransformGroup>
                    </syncfusion:SfDataGrid.RenderTransform>


                    <syncfusion:SfDataGrid.Columns>

                        <!-- Kolumna 2: Pacjent (dwa wiersze w jednej komórce) -->

                        <!-- Kolumna 3: Firma (wrap) -->

                        <!-- Kolumna 4: Edit (przycisk) -->
                        <!--
                        <syncfusion:GridTemplateColumn HeaderText="Edytuj" Width="60" AllowSorting="False" AllowFiltering="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="55" Height="34" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                            ToolTip="Edytuj wizytę" Content="✏️" Margin="5,5,20,5" />
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                        -->

                        <!-- Kolumna 5: pusta -->
                        <!--
                        <syncfusion:GridTemplateColumn HeaderText="Edytuj" Width="10" AllowSorting="False" AllowFiltering="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="" />
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                        -->
                        <!-- Kolumna 1: ID -->
                        <syncfusion:GridTextColumn MappingName="B_ID" HeaderText="ID" Width="50" IsReadOnly="True" />

                        <!-- Use MappingName to enable sorting on underlying field (nazwisko); remove unsupported SortMemberPath -->
                        <syncfusion:GridTemplateColumn HeaderText="Pacjent" Width="200" AllowFiltering="False" MappingName="P_nazwisko">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4,6,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Górny wiersz: Imię + Nazwisko (display only) -->
                                        <TextBlock Grid.Row="0" FontSize="16" Padding="0" Background="Transparent">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="P_imie"/>
                                                    <Binding Path="P_nazwisko"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <!-- Dolny wiersz: Pesel (po lewej) and Data_wizyty (po prawej) -->
                                        <Grid Grid.Row="1" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="3*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" FontSize="13"
                                                      Background="Transparent" Padding="0" Text="{Binding FormattedPesel}" />

                                            <TextBlock Grid.Column="1" FontSize="13"
                                                     Background="Transparent" Padding="0" Text="{Binding B_DataSkierowania, StringFormat=\{0:dd-MM-yyyy\}}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>

                        <!-- Use MappingName to enable sorting on Firma_Nazwa; remove unsupported SortMemberPath -->
                        <syncfusion:GridTemplateColumn HeaderText="Firma" Width="200" AllowFiltering="False" MappingName="Firma_Nazwa">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Firma_Nazwa}" TextWrapping="Wrap" FontSize="14" Margin="6,6,6,6"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>

                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </StackPanel>

            <Grid x:Name="Edit_prawa" Grid.Column="1" HorizontalAlignment="Left" Width="920" Height="610" VerticalAlignment="Center"/>
        </Grid>
        <!-- -->
        <!-- ItemsSource="{Binding SkierowaniaFiltered}" -->
    </Grid>
</UserControl>
