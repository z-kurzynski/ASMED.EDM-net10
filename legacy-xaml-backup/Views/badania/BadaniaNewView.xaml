<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="ASMED.WPF.Views.BadaniaNewView"
             Width="Auto" 
            VerticalAlignment="Top" 
            MaxWidth="1800" 
            MinWidth="1100" 
            Height="720" Background="#FFB9D1EA">

    <UserControl.Resources>
        <!-- Converters removed to avoid design-time/type resolution issues; using DataTriggers instead -->

        <Style TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#66000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="{x:Type Path}" x:Key="SfDataGridHeaderIconStyle">
            <Setter Property="Fill" Value="Cyan"/>
        </Style>
        <!-- Poprawka: usunięto zbędny dwukropek na końcu TargetType -->
        <Style TargetType="{x:Type syncfusion:FilterToggleButton}">
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="Padding" Value="1"/>
        </Style>

    </UserControl.Resources>

    <Grid VerticalAlignment="Top" Width="1520">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" 
              MaxWidth="1500" MinWidth="1100"
              Width="1500" Height="55">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="197"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition />
                <ColumnDefinition Width="226"/>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="8"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="Filtr" Grid.Column="1" VerticalAlignment="Top" Height="46" HorizontalAlignment="Left" Margin="20,0,0,0" Width="407">
                <TextBlock Text="Wyszukaj Kartę Badań" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>

                <DockPanel HorizontalAlignment="Left">
                    <TextBox x:Name="txtFilterTop" 
                             Text="{Binding FilterText,UpdateSourceTrigger=PropertyChanged}" 
                             Height="28" Width="247" FontSize="14">
                        <TextBox.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="🔍 SMART FILTER:" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="• #XXXX - Szuka dokładnie ID skierowania"/>
                                    <TextBlock Text="  Przykład: #20 → znajdzie skierowanie ID=20" Margin="5,0,0,5"/>
                                    <TextBlock Text="• Bez # - Szuka w wybranym polu (All/Nazwisko/Firma)"/>
                                    <TextBlock Text="  Przykład: Kowalski → znajdzie wszystkie nazwiska" Margin="5,0,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>

                    <Button Width="32" Height="28" Margin="10,0,0,0" 
                            ToolTip="Wyczyść pole" Click="ClearFilter_Click">
                        <Image Source="/Views/pacjent/no.png" Width="10" Height="10" IsEnabled="False" />
                    </Button>

                    <ComboBox Width="100" Height="28" FontSize="14" Margin="10,0,8,0"
                        SelectedItem="{Binding SelectedFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding FilterOptions}"/>
                </DockPanel>
            </StackPanel>

            <!-- ✅ NOWY: Checkbox + DatePicker dla domyślnej daty badania (Grid.Column="2") -->
            <StackPanel x:Name="DefaultDatePanel" Grid.Column="2" VerticalAlignment="Top" Height="46" HorizontalAlignment="Left" Margin="10,0,0,0" Width="185">
                <TextBlock Text="Domyślna Data Badania" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left" Foreground="#FF2C3E50"/>
                
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding UseCustomDefaultDate, Mode=TwoWay}" 
                              Content="Użyj" 
                              VerticalAlignment="Center" 
                              FontSize="11" 
                              Margin="0,0,8,0"
                              ToolTip="Zaznacz aby używać wybranej daty jako domyślnej dla Data Badania"/>
                    
                    <DatePicker SelectedDate="{Binding CustomDefaultDate, Mode=TwoWay}" 
                                Width="120" 
                                FontSize="11"
                                IsEnabled="{Binding UseCustomDefaultDate}"
                                ToolTip="Data która będzie ustawiana jako Data Badania przy wyborze karty"/>
                </StackPanel>
            </StackPanel>

            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->
            <syncfusion:ButtonAdv x:Name="Rejestracja"
                    Grid.Column="5"
                    Command="{Binding GoToRegistrationCommand}"
                    HorizontalAlignment="Center"
                    Height="45"
                    Label="Rejestracja"
                    VerticalAlignment="Top"
                    Width="220"
                    Background="#FF3F51B5"
                    Foreground="#FFFBFBFB"
                    FontSize="16" 
                    IconHeight="0" 
                    IconWidth="0" 
                    Margin="0,10,0,0"  >

                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>

            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->
            <syncfusion:ButtonAdv x:Name="Lista_badan"
                    Grid.Column="6"
                    Click="Lista_Badan_Click" 
                    HorizontalAlignment="Center"
                    Height="45"
                    Label="➡️ Lista Badań ➡️"
                    VerticalAlignment="Top"
                    Width="220"
                    Background="#FF009688"
                    Foreground="#FFFBFBFB"
                    FontSize="16"
                    IconHeight="0" 
                    IconWidth="0" 
                    Margin="0,10,0,0"  >

                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>

        </Grid>



        <Grid Height="695" 
              Grid.Row="1"
              VerticalAlignment="Top" Margin="0,-10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="580"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- LEWA KOLUMNA: Lista skierowań -->
            <Border Grid.Column="0" VerticalAlignment="Top" Height="625" Background="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" BorderThickness="1,1,1,1" CornerRadius="8,8,8,8" Margin="10,15,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="2,0,2,8" Orientation="Vertical" Grid.Row="1">
                        <StackPanel Height="69" Margin="10,0,0,0">
                            <TextBlock Text="📋 Karty  Badań - Do zamknięcia Wizyty" 
                                FontSize="16" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#FFEDEB47"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding SkierowaniaCount, StringFormat=Liczba: \{0\}}" 
                                    FontSize="12" 
                                    VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                <Button Content="🔄 Odśwież" 
                                    Command="{Binding RefreshCommand}"
                                    Background="#FF1565C0" Foreground="White"
                                    Padding="8,4" Margin="15,0,0,0"
                                    BorderThickness="0" Cursor="Hand"
                                    FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <syncfusion:SfDataGrid x:Name="gridSkierowania"
                            ItemsSource="{Binding Skierowania}"
                            SelectedItem="{Binding SelectedSkierowanie, Mode=TwoWay}"
                            AutoGenerateColumns="False"
                            AllowSorting="True"
                            AllowFiltering="True"
                            SelectionMode="Single"
                            AlternationCount="2"
                            RowHeight="55"
                            ColumnSizer="Star"
                            FontSize="14"
                            SelectionUnit="Row"
                            FontFamily="Arial Narrow"
                            GridLinesVisibility="Both" 
                            AllowResizingColumns="True" 
                            CurrentCellBorderBrush="{x:Null}" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Height="545" Margin="10,0,10,7" RenderTransformOrigin="0.5,0.5" BorderThickness="0,0,0,0">
                            <syncfusion:SfDataGrid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform AngleY="0.308"/>
                                    <RotateTransform/>
                                    <TranslateTransform Y="1.328"/>
                                </TransformGroup>
                            </syncfusion:SfDataGrid.RenderTransform>

                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:GridTextColumn HeaderText="ID" 
                                    MappingName="B_ID" 
                                    TextAlignment="Center"
                                    Width="45"/>

                                <syncfusion:GridTextColumn HeaderText="Data" 
                                    MappingName="B_DataSkierowania" 
                                    TextAlignment="Center"
                                    Width="85"
                                    DisplayBinding="{Binding B_DataSkierowania, StringFormat=\{0:dd-MM-yyyy\}}"/>

                                <syncfusion:GridTextColumn HeaderText="Typ" 
                                    MappingName="B_TypBadania" 
                                    AllowFiltering="False"
                                    Width="40" TextAlignment="Center" />

                                <syncfusion:GridTemplateColumn HeaderText="Pacjent" 
                                    AllowFiltering="False"
                                    Width="120" AllowSorting="False">
                                    <syncfusion:GridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" 
                                                VerticalAlignment="Center"
                                                Padding="4,2"><Run Text="{Binding P_imie}" FontWeight="Bold"/><LineBreak/><Run Text="{Binding P_nazwisko}"/></TextBlock>
                                        </DataTemplate>
                                    </syncfusion:GridTemplateColumn.CellTemplate>
                                </syncfusion:GridTemplateColumn>

                                <syncfusion:GridTextColumn HeaderText="Firma" 
                                    MappingName="Firma_Nazwa" 
                                    TextWrapping="Wrap"
                                              />
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>
                    </StackPanel>

                    <!-- Nagłówek -->

                    <!-- Nagłówek -->

                    <!-- Lista skierowań -->
                </Grid>
            </Border>
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" BorderThickness="1,0.9,1,1" CornerRadius="8,8,8,8" Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Grid.Column="1" Margin="10,15,10,10" Height="625" VerticalAlignment="Top">
                <Grid Height="640" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="75"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto" MinHeight="100"/>
                    </Grid.RowDefinitions>

                    <!-- Przyciski zapisu -->
                    <!-- Nagłówek prawej kolumny -->
                    <StackPanel VerticalAlignment="Top" Margin="11,11,11,0">
                        <TextBlock Text="✏️ Edycja Badania" 
                                FontSize="16" FontWeight="SemiBold" 
                                
                                Foreground="#FFEDEB47" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding SkierowanieInfo}" 
                                FontSize="15" 
                                TextWrapping="Wrap"
                                Margin="0,3,0,0" Height="20" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
                    </StackPanel>
                    <!-- Nagłówek prawej kolumny -->


                    <!-- Zawartość edycji -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Height="390" HorizontalAlignment="Center" Width="919" VerticalAlignment="Top">
                        <Grid Margin="10,10,10,10" Height="370">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="113"/>
                                <RowDefinition Height="Auto" MinHeight="66.96"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Wiersz 0: Dane Pacjenta i Firmy -->
                            <Grid Grid.Row="0" Height="110" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Pacjent -->
                                <Border Grid.Column="0" 
                                    BorderBrush="#FFA9CEF3" BorderThickness="1" 
                                    CornerRadius="4" Padding="8" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="Dane Pacjenta" FontWeight="SemiBold" FontSize="12" 
                                            Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"/>
                                        <Grid Margin="6,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="165.6"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="SelectedSkierowanie.P_imie"/>
                                                        <Binding Path="SelectedSkierowanie.P_nazwisko"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Width="156">
                                                <TextBlock Text="Pesel: " FontSize="11" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,3,0" Width="40" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                                <TextBlock FontSize="13" 
                                            Text="{Binding SelectedSkierowanie.FormattedPesel}" 
                                            FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Margin="6,4,0,0" FontSize="14" 
                                            Text="{Binding SelectedSkierowanie.B_Stanowisko}" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                        <Grid Margin="6,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="Typ" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" VerticalAlignment="Center"/>
                                                <Border Width="40" Margin="8,0,0,0" Height="22" 
                                                    BorderBrush="#1976D2" CornerRadius="2" BorderThickness="1" Padding="3,1" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                                    <TextBlock Text="{Binding SelectedSkierowanie.B_TypBadania}" 
                                                        FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                <TextBlock Text="Data Skier." FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                                <Border Margin="8,0,0,0" BorderBrush="#1976D2" BorderThickness="1" 
                                                    CornerRadius="2" Padding="3,1" Height="22">
                                                    <TextBlock Text="{Binding SelectedSkierowanie.B_DataSkierowania, StringFormat=\{0:dd-MM-yyyy\}}" 
                                                        FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Firma -->
                                <Border Grid.Column="1" 
                                    BorderBrush="#FFA9CEF3" BorderThickness="1" 
                                    CornerRadius="4" Padding="8" Margin="6,0,15,0">
                                    <StackPanel>
                                        <TextBlock Text="Dane Firmy" FontWeight="SemiBold" FontSize="12" 
                                            Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"/>
                                        <TextBlock Margin="6,4,0,0" FontSize="16" 
                                            Text="{Binding SelectedSkierowanie.Firma_Nazwa}" 
                                            TextWrapping="Wrap" FontWeight="SemiBold" Height="45" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                        <Grid Margin="6,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="NIP" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                                <TextBlock Text="{Binding SelectedSkierowanie.Firma_NIP}" 
                                                    FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="Cennik" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                                <ComboBox x:Name="select_cennik" ItemsSource="{Binding CennikOptions}" 
                                                    SelectedItem="{Binding SelectedCennik, Mode=TwoWay}" 
                                                    Width="120" Margin="6,0,0,0" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Wiersz 1: Dane Badania -->
                            <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Top" Margin="1,5,0,0">

                                <!-- ✅ NOWY: Selektor lat ważności -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Top">
                                    <TextBlock Text="Ważność Badania do roku:" FontSize="11" 
                                               Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ListBox ItemsSource="{Binding ValidityYearOptions}"
                                             SelectedValuePath="Years"
                                             SelectedValue="{Binding ValidityYears, Mode=TwoWay}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Focusable="False"
                                             VerticalAlignment="Center">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="2,0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="chip"
                                                                    Background="#FF546E7A"
                                                                    CornerRadius="4"
                                                                    Padding="10,4"
                                                                    BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="chip" Property="Background" Value="#FF1565C0"/>
                                                                    <Setter TargetName="chip" Property="BorderBrush" Value="#FF90CAF9"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="chip" Property="Background" Value="#FF455A64"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontSize="12" 
                                                           Foreground="White" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <!-- Pola Data Badania, Data Ważności, Wynik, Nr Księgi, etc. -->
                                <StackPanel Orientation="Horizontal" Height="40">
                                <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                    <TextBlock Text="Data Badania" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    <DatePicker SelectedDate="{Binding DataBadania, Mode=TwoWay}" Width="140" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                    <TextBlock Text="Data Ważności" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    <DatePicker SelectedDate="{Binding DataWaznosci, Mode=TwoWay}" Width="140" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                    <TextBlock Text="Wynik" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    <ComboBox ItemsSource="{Binding WynikOptions}" 
                                        SelectedItem="{Binding SelectedWynik, Mode=TwoWay}" Width="130" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                    <TextBlock Text="Nr Księgi" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    <TextBox Text="{Binding NrKsiegi, Mode=TwoWay}" Width="130" Height="22" FontSize="11"/>
                                </StackPanel>
                                <!-- Badanie Sanitarne: icon colored green when true (B_ksiazeczka), gray when false -->
                                <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                                    <TextBlock Text="Książeczka" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                                    <Ellipse Width="24" Height="24" Stroke="Transparent">
                                        <Ellipse.Style>
                                            <Style TargetType="{x:Type Ellipse}">
                                                <Setter Property="Fill" Value="#FFC1C0C0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSkierowanie.B_ksiazeczka}" Value="True">
                                                        <Setter Property="Fill" Value="#FF09D070" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                        <Ellipse.ToolTip>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Text" Value="Nie" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedSkierowanie.B_ksiazeczka}" Value="True">
                                                                <Setter Property="Text" Value="Tak" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Ellipse.ToolTip>
                                    </Ellipse>
                                </StackPanel>

                                <!-- Urlop dla poratowania zdrowia: icon colored green when true, gray when false -->
                                <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                                    <TextBlock Text="Urlop (zdrowie)" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                                    <Ellipse Width="24" Height="24" Stroke="Transparent">
                                        <Ellipse.Style>
                                            <Style TargetType="{x:Type Ellipse}">
                                                <Setter Property="Fill" Value="#FFC1C0C0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSkierowanie.B_Zaswiadczenie}" Value="True">
                                                        <Setter Property="Fill" Value="#FF09D070" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                        <Ellipse.ToolTip>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Text" Value="Nie" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedSkierowanie.B_Zaswiadczenie}" Value="True">
                                                                <Setter Property="Text" Value="Tak" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Ellipse.ToolTip>
                                    </Ellipse>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Wiersz 2: Wycena badania -->
                            <Border Grid.Row="2" BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,20,-10">
                                <Grid Margin="0,0,0,-17">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Nagłówki -->
                                    <Grid x:Name="ceny_Nazwa_Header" Grid.Row="0" Background="#E9ECEF" Margin="3,0,3,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Badanie" FontWeight="Bold" FontSize="10" 
                                            HorizontalAlignment="Center" Padding="3"/>
                                        <TextBlock Grid.Column="1" Text="Laryngolog" FontWeight="Bold" FontSize="10" 
                                            HorizontalAlignment="Center" Padding="3"/>
                                        <TextBlock Grid.Column="2" Text="Okulista" FontWeight="Bold" FontSize="10" 
                                            HorizontalAlignment="Center" Padding="3"/>
                                        <TextBlock Grid.Column="3" Text="Książeczka" FontWeight="Bold" FontSize="10" 
                                            HorizontalAlignment="Center" Padding="3"/>
                                        <TextBlock Grid.Column="4" Text="Lipidogram" FontWeight="Bold" FontSize="10" 
                                            HorizontalAlignment="Center" Padding="3"/>
                                        <TextBlock Grid.Column="5" Text="EKG" FontWeight="Bold" FontSize="10" 
                                            HorizontalAlignment="Center" Padding="3"/>
                                        <TextBlock Grid.Column="6" Text="Urlop" FontWeight="Bold" FontSize="10" 
                                            HorizontalAlignment="Center" Padding="3"/>
                                        <TextBlock Grid.Column="7" Text="Inne" FontWeight="Bold" FontSize="10" 
                                            HorizontalAlignment="Center" Padding="3"/>
                                    </Grid>

                                    <!-- Ceny z cennika -->
                                    <Grid x:Name="Ceny_z_Cennika" Grid.Row="1" Background="#FFA5CDF5" Height="25" Margin="3,0,3,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding PriceBasicText}" 
                                            FontSize="14"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="DarkBlue"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PriceLaryngologistText}" 
                                            FontSize="14"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="DarkBlue"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PriceOphthalmologistText}" 
                                           FontSize="14"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="DarkBlue"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PriceSanitaryText}" 
                                            FontSize="14"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="DarkBlue"/>
                                        <TextBlock Grid.Column="4" Text="{Binding PriceLipidogramText}" 
                                            FontSize="14"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="DarkBlue"/>
                                        <TextBlock Grid.Column="5" Text="{Binding PriceEKGText}" 
                                            FontSize="14"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="DarkBlue"/>
                                        <TextBlock Grid.Column="6" Text="{Binding PriceHealthClinicText}" 
                                            FontSize="14"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="DarkBlue"/>
                                        <TextBlock Grid.Column="7" Text="{Binding PriceOtherText}" 
                                            FontSize="14"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="DarkBlue"/>
                                    </Grid>
                                    <!-- Wartości (TextBoxy) -->
                                    <Grid x:Name="Wybrane_Ceny" Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Cena1, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                            FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                            Height="28" TextAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Cena2, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                            FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                            Height="28" TextAlignment="Center"/>
                                        <TextBox Grid.Column="2" Text="{Binding Cena3, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                            FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                            Height="28" TextAlignment="Center"/>
                                        <TextBox Grid.Column="3" Text="{Binding Cena4, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                            FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                            Height="28" TextAlignment="Center"/>
                                        <TextBox Grid.Column="4" Text="{Binding Cena5, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}"
                                            FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                            Height="28" TextAlignment="Center"/>
                                        <TextBox Grid.Column="5" Text="{Binding Cena6, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                            FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                            Height="28" TextAlignment="Center"/>
                                        <TextBox Grid.Column="6" Text="{Binding Cena7, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                            FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                            Height="28" TextAlignment="Center"/>
                                        <TextBox Grid.Column="7" Text="{Binding Cena8, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                            FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                            Height="28" TextAlignment="Center"/>
                                    </Grid>

                                    <!-- Przyciski toggle -->
                                    <Grid x:Name="Przyciski_Wyboru" Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="btnNewToggleBasic" Grid.Column="0" 
                                                Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                                Click="ToggleNewExamination_Click" 
                                                Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Tag="Basic"/>

                                        <Button x:Name="btnNewToggleLaryngologist" Grid.Column="1" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click" 
                                                Tag="Laryngologist"/>

                                        <Button x:Name="btnNewToggleOphthalmologist" Grid.Column="2" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click"
                                                Tag="Ophthalmologist"/>
                                        <Button x:Name="btnNewToggleSanitary" Grid.Column="3" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click" 
                                                Tag="Sanitary"/>
                                        <Button x:Name="btnNewToggleLipidogram" Grid.Column="4" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click"
                                                Tag="Lipidogram"/>
                                        <Button x:Name="btnNewToggleEKG" Grid.Column="5" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click" 
                                                Tag="EKG"/>
                                        <Button x:Name="btnNewToggleHealthClinic" Grid.Column="6" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click" 
                                                Tag="HealthClinic"/>
                                        <Button x:Name="btnNewToggleOther" Grid.Column="7" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click"
                                                Tag="Other"/>
                                    </Grid>

                                    <!-- Suma - nagłówek -->
                                    <Grid x:Name="Suma_Header" Grid.Row="4" Visibility="Collapsed">
                                        <TextBlock Text="SUMA:" FontSize="13" FontWeight="Bold" 
                                            HorizontalAlignment="Right" Margin="0,8,10,0"/>
                                    </Grid>

                                    <!-- Suma - wartość -->
                                    <Grid x:Name="Suma_Wartość" Grid.Row="5" Margin="0,15,0,0">
                                        <TextBlock Text="{Binding SumaText}" FontSize="18" FontWeight="Bold" 
                                            HorizontalAlignment="Right" Foreground="#FF81FD4A" Margin="0,0,10,8" Height="25"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    <StackPanel Grid.Row ="2"  Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,20,0" Height="45" Width="410">

                        <syncfusion:ButtonAdv
                            x:Name="btnWyczysc"
                            Height="45"
                            Label="🔄 Wyczyść"
                            Width="200"
                            Background="#FF607D8B"
                            Foreground="#FFFBFBFB"
                            FontSize="16"
                            Command="{Binding ClearCommand}" IconHeight="0" IconWidth="0">
                            <syncfusion:ButtonAdv.BorderBrush>
                                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                            </syncfusion:ButtonAdv.BorderBrush>
                            <syncfusion:ButtonAdv.IconTemplate>
                                <DataTemplate/>
                            </syncfusion:ButtonAdv.IconTemplate>
                        </syncfusion:ButtonAdv>
                        <syncfusion:ButtonAdv
                                x:Name="btnSaveBadanie"
                                Height="45"
                                Label="💾 Zapisz Badanie"
                                Width="200"
                                Background="#FF1976D2"
                                Foreground="#FFFBFBFB"
                                FontSize="16"
                                Command="{Binding SaveBadanieCommand}"
                                IconHeight="0" IconWidth="0" Margin="10,0,0,0" 
                                HorizontalAlignment="Left">
                            <syncfusion:ButtonAdv.BorderBrush>
                                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                            </syncfusion:ButtonAdv.BorderBrush>
                            <syncfusion:ButtonAdv.IconTemplate>
                                <DataTemplate/>
                            </syncfusion:ButtonAdv.IconTemplate>
                        </syncfusion:ButtonAdv>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- PRAWA KOLUMNA: Edycja badania (skopiowane 1:1 z BadaniaNewEditWindow) -->
        </Grid>
    </Grid>
</UserControl>
