<UserControl x:Class="ASMED.WPF.Views.WizytyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Height="Auto" Width="Auto" VerticalAlignment="Top" MaxWidth="1800" MinWidth="1100" Background="#FFB9D1EA">

    <UserControl.Resources>
        <!-- ✅ Converter Bool → Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- ✅ NOWE: Template dla standardowego tooltipa (Karty, Badania, Wizyty) -->
        <DataTemplate x:Key="TooltipTemplate">
            <Border Background="#FF333333" 
                    BorderBrush="#FF666666" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="10,6">
                <StackPanel>
                    <!-- Miesiąc -->
                    <TextBlock Text="{Binding Item.MiesiacNazwa}" 
                               FontWeight="Bold" 
                               FontSize="13" 
                               Foreground="White"/>

                    <!-- Nazwa serii + Wartość -->
                    <TextBlock FontSize="12" Foreground="White" Margin="0,4,0,0">
                        <Run Text="{Binding Series.Label}" FontWeight="SemiBold"/>
                        <Run Text=": "/>
                        <Run Text="{Binding Item.YValue}" FontWeight="Bold" Foreground="#FF4CAF50"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ✅ NOWE: Template dla tooltipa Wartość [zł] (pokazuje ORYGINALNĄ wartość) -->
        <DataTemplate x:Key="TooltipWartoscTemplate">
            <Border Background="#FF333333" 
                    BorderBrush="#FF4CAF50" 
                    BorderThickness="2" 
                    CornerRadius="4" 
                    Padding="10,6">
                <StackPanel>
                    <!-- Miesiąc -->
                    <TextBlock Text="{Binding Item.MiesiacNazwa}" 
                               FontWeight="Bold" 
                               FontSize="13" 
                               Foreground="White"/>

                    <!-- Wartość ORYGINALNA (nie skalowana) -->
                    <TextBlock FontSize="12" Foreground="White" Margin="0,4,0,0">
                        <Run Text="Wartość: " FontWeight="SemiBold"/>
                        <Run Text="{Binding Item.WartoscBadan, StringFormat='{}{0:N2} zł'}" 
                             FontWeight="Bold" 
                             Foreground="#FF4CAF50"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ✅ Style dla DataGrid -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF0F8FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE3F2FD"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Nagłówek -->
            <RowDefinition Height="*"/>
            <!-- Główna zawartość -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- ✅ ROW 0: NAGŁÓWEK -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" 
                Background="#FF2196F3" 
                Padding="15,10" 
                Margin="0,0,0,10" 
                CornerRadius="8,8,0,0">
            <TextBlock Text="📊 Raporty Wizyt " 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="White"/>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- ✅ ROW 1: GŁÓWNA ZAWARTOŚĆ (3 KOLUMNY Z BORDEREM) -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <!-- Kolumna 0: Lista firm -->
                <ColumnDefinition Width="10"/>
                <!-- Spacer -->
                <ColumnDefinition Width="Auto"/>
                <!-- Kolumna 2: Statystyki (szerokość automatyczna, Visibility kontrolowana przez toggle) -->
                <ColumnDefinition Width="10"/>
                <!-- Spacer -->
                <ColumnDefinition Width="*"/>
                <!-- Kolumna 4: Wykres (rozszerza się gdy statystyki ukryte) -->
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- ✅ KOLUMNA 1: LISTA NIEZAFAKTUROWANYCH BADAŃ (PO FIRMIE) -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" 
                    BorderBrush="#FF1976D2" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" 
                    Padding="10" Height="515" Width="NaN">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Filtr + Odśwież + Licznik -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- ✅ Filtr + Odśwież + Licznik -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <!-- Tytuł sekcji -->
                        <TextBlock Text="🏢 Niezafakturowane Badania" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#FFD2C219" 
                                   Margin="0,0,0,10"/>

                        <!-- Filtr + Odśwież -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- TextBox filtra -->
                            <TextBox Grid.Column="0" 
                                     Text="{Binding FilterFirmaNazwa, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="14" 
                                     Padding="8,5"
                                     ToolTip="Wpisz nazwę firmy (filtruje automatycznie)">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ApplyFilterCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <!-- Przycisk Clear (X) -->
                            <Button Grid.Column="2" 
                                    Content="✖" 
                                    Width="32" 
                                    Height="32" 
                                    FontSize="14" 
                                    FontWeight="Bold" 
                                    Background="#FFFF5722" 
                                    Foreground="White" 
                                    Command="{Binding ClearFilterCommand}" 
                                    ToolTip="Wyczyść filtr" 
                                    Cursor="Hand"/>

                            <!-- Przycisk Odśwież -->
                            <Button Grid.Column="4" 
                                    Content="🔄 Odśwież" 
                                    Width="100" 
                                    Height="32" 
                                    FontSize="12" 
                                    FontWeight="Bold" 
                                    Background="#FF4CAF50" 
                                    Foreground="White" 
                                    Command="{Binding OdswiezCommand}" 
                                    ToolTip="Odśwież listę" 
                                    Cursor="Hand"/>
                        </Grid>

                        <!-- ✅ NOWE: Licznik rekordów + SUMA wartości badań -->
                        <Border Background="#FFFCFCFC" 
                                BorderBrush="#FF1976D2" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="10,8" 
                                Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Liczba firm (lewa strona) -->
                                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                    <Run Text="Liczba firm: " FontWeight="Bold" Foreground="#FF555555" FontSize="13"/>
                                    <Run Text="{Binding LiczbaRekordow, Mode=OneWay}" FontWeight="Bold" Foreground="#FF2196F3" FontSize="16"/>
                                </TextBlock>

                                <!-- SUMA wartości (prawa strona) -->
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Run Text="Suma: " FontWeight="Bold" Foreground="#FF555555" FontSize="13"/>
                                    <Run Text="{Binding SumaWartosciWyfiltrowychFormatted, Mode=OneWay}" 
                                         FontWeight="Bold" 
                                         Foreground="#FF4CAF50" 
                                         FontSize="18"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ✅ DataGrid - Lista firm z niezafakturowanymi badaniami -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding NiezafakturowaneBadania}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              SelectionMode="Single" 
                              GridLinesVisibility="Horizontal" 
                              HorizontalGridLinesBrush="#FFE0E0E0" 
                              CanUserResizeRows="False" 
                              CanUserSortColumns="True" 
                              FontSize="13" 
                              RowHeight="35" 
                              AlternatingRowBackground="#FFF9F9F9"
                              BorderBrush="#FF1976D2" 
                              BorderThickness="1">

                        <DataGrid.Columns>
                            <!-- Kolumna: Nazwa Firmy -->
                            <DataGridTextColumn Header="Nazwa Firmy" 
                                                Binding="{Binding NazwaFirmy}" 
                                                Width="*" 
                                                MinWidth="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Kolumna: Wartość Badań -->
                            <DataGridTextColumn Header="Wartość Badań" 
                                                Binding="{Binding SumaWartosciFormatted}" 
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FF4CAF50"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Kolumna: Liczba Badań -->
                            <DataGridTextColumn Header="Liczba Badań" 
                                                Binding="{Binding LiczbaBadan}" 
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FF2196F3"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- ✅ KOLUMNA 2: STATYSTYKI MIESIĘCZNE (Skierowania/Wizyty/Badania) -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="2" 
                    BorderBrush="#FFFF9800" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" 
                    Padding="10" 
                    Height="515" 
                    Visibility="{Binding IsStatystykiVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Tytuł + Filtr roku -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid ze statystykami -->
                        <RowDefinition Height="Auto"/>
                        <!-- Wiersz podsumowania -->
                    </Grid.RowDefinitions>

                    <!-- ✅ Tytuł + Filtr roku -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
                        <!-- Tytuł sekcji -->
                        <TextBlock Text="📊 Statystyki Miesięczne" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#FFFF9800" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock 
                                       Text="Rok:" 
                                       FontSize="14" 
                                       Width="30" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FFFFFFFE"/>
                        <ComboBox 
                                      ItemsSource="{Binding DostepneRoki}" 
                                      SelectedItem="{Binding WybranyRok}" 
                                      FontSize="14" 
                                      Height="32" 
                                      VerticalContentAlignment="Center" Width="150" Margin="10,0,0,0" VerticalAlignment="Center"/>

                        <!-- Wybór roku -->
                    </StackPanel>

                    <!-- ✅ DataGrid - Statystyki miesięczne -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding StatystykiMiesieczne}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              SelectionMode="Single" 
                              GridLinesVisibility="Horizontal" 
                              HorizontalGridLinesBrush="#FFE0E0E0" 
                              CanUserResizeRows="False" 
                              CanUserSortColumns="False" 
                              FontSize="12" 
                              RowHeight="30" 
                              AlternatingRowBackground="#FFF9F9F9"
                              BorderBrush="#FFFF9800" 
                              BorderThickness="1">

                        <DataGrid.Columns>
                            <!-- Miesiąc -->
                            <DataGridTextColumn Header="Miesiąc" 
                                                Binding="{Binding MiesiacNazwa}" 
                                                Width="90" FontWeight="Normal">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#FF555555"/>
                                        <Setter Property="Padding" Value="5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Skierowania -->
                            <DataGridTextColumn Header="Kart." 
                                                Binding="{Binding LiczbaSkierowan}" 
                                                Width="50" FontWeight="Normal">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#FF2196F3"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Okresowe -->
                            <DataGridTextColumn Header="O" 
                                                Binding="{Binding BadaniaOkresowe}" 
                                                Width="35">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#FF4CAF50"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Wstępne -->
                            <DataGridTextColumn Header="W" 
                                                Binding="{Binding BadaniaWstepne}" 
                                                Width="35">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#FFFF9800"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Kontrolne -->
                            <DataGridTextColumn Header="K" 
                                                Binding="{Binding BadaniaKontrolne}" 
                                                Width="35">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#FFFF5722"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Inne -->
                            <DataGridTextColumn Header="IN" 
                                                Binding="{Binding BadaniaInne}" 
                                                Width="35">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#FF9E9E9E"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Książeczki -->
                            <DataGridTextColumn Header="Ks.S." 
                                                Binding="{Binding LiczbaKsiazeczek}" 
                                                Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#FF9C27B0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Badania odbyte -->
                            <DataGridTextColumn Header="Bad." 
                                                Binding="{Binding BadaniaOdbyte}" 
                                                Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#FF00BCD4"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Wizyty -->
                            <DataGridTextColumn Header="Wiz." 
                                                Binding="{Binding WizytyZarejestrowane}" 
                                                Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#FF673AB7"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ✅ WIERSZ PODSUMOWANIA (RAZEM) -->
                    <Border Grid.Row="2" 
                            Background="#FFFEF5E7" 
                            BorderBrush="#FFFF9800" 
                            BorderThickness="0,2,0,0" 
                            Padding="5,8" 
                            Margin="0,5,0,0">
                        <Grid DataContext="{Binding StatystykiPodsumowanie}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <!-- Miesiąc -->
                                <ColumnDefinition Width="50"/>
                                <!-- Skier. -->
                                <ColumnDefinition Width="35"/>
                                <!-- O -->
                                <ColumnDefinition Width="35"/>
                                <!-- W -->
                                <ColumnDefinition Width="35"/>
                                <!-- K -->
                                <ColumnDefinition Width="35"/>
                                <!-- In -->
                                <ColumnDefinition Width="50"/>
                                <!-- Książ. -->
                                <ColumnDefinition Width="50"/>
                                <!-- Bad. -->
                                <ColumnDefinition Width="50"/>
                                <!-- Wiz. -->
                            </Grid.ColumnDefinitions>

                            <!-- RAZEM -->
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding MiesiacNazwa}" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="#FFFF9800" 
                                       VerticalAlignment="Center" 
                                       Padding="5,0"/>

                            <!-- Skierowania -->
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding LiczbaSkierowan}" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="#FF2196F3" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>

                            <!-- O -->
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding BadaniaOkresowe}" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="#FF4CAF50" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>

                            <!-- W -->
                            <TextBlock Grid.Column="3" 
                                       Text="{Binding BadaniaWstepne}" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="#FFFF9800" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>

                            <!-- K -->
                            <TextBlock Grid.Column="4" 
                                       Text="{Binding BadaniaKontrolne}" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="#FFFF5722" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>

                            <!-- In -->
                            <TextBlock Grid.Column="5" 
                                       Text="{Binding BadaniaInne}" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="#FF9E9E9E" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>

                            <!-- Książeczki -->
                            <TextBlock Grid.Column="6" 
                                       Text="{Binding LiczbaKsiazeczek}" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="#FF9C27B0" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>

                            <!-- Badania -->
                            <TextBlock Grid.Column="7" 
                                       Text="{Binding BadaniaOdbyte}" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Foreground="#FF00BCD4" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>

                            <!-- Wizyty -->
                            <TextBlock Grid.Column="8" 
                                       Text="{Binding WizytyZarejestrowane}" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Foreground="#FF673AB7" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- ✅ KOLUMNA 3: WYKRES SŁUPKOWY (Syncfusion SfChart) -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="4" 
                    BorderBrush="#FF4CAF50" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}" 
                    Padding="10" Height="515">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Tytuł + Checkboxy -->
                        <RowDefinition Height="*"/>
                        <!-- Wykres -->
                    </Grid.RowDefinitions>

                    <!-- ✅ Tytuł + Checkboxy -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <!-- Nagłówek z przyciskiem Toggle -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tytuł sekcji -->
                            <TextBlock Grid.Column="0"
                                       Text="📈 Wykres Miesięczny" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#FF4CAF50" 
                                       VerticalAlignment="Center"/>

                            <!-- ✅ NOWE: Przycisk Toggle Statystyk -->
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleStatystykiCommand}"
                                    Width="140"
                                    Height="32"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Background="#FFFF9800"
                                    Foreground="White"
                                    Cursor="Hand"
                                    ToolTip="Pokaż/Ukryj kolumnę statystyk">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="◀ Ukryj Statystyki"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatystykiVisible}" Value="False">
                                                <Setter Property="Content" Value="▶ Pokaż Statystyki"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- ✅ NOWE: Przełącznik Linie/Słupki -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Typ wykresu:" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>

                            <RadioButton Content="📈 Linie" 
                                         IsChecked="{Binding IsLineChart, Mode=OneWay}" 
                                         Command="{Binding SetLineChartCommand}"
                                         GroupName="ChartType" 
                                         Margin="0,0,15,0" 
                                         FontWeight="Bold" 
                                         Foreground="#FF4CAF50"/>

                            <RadioButton Content="📊 Słupki" 
                                         IsChecked="{Binding IsColumnChart, Mode=OneWay}" 
                                         Command="{Binding SetColumnChartCommand}"
                                         GroupName="ChartType" 
                                         FontWeight="Bold" 
                                         Foreground="#FF2196F3"/>
                        </StackPanel>

                        <!-- Checkboxy (włącz/wyłącz serie) -->
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox Content="Karty" 
                                      IsChecked="{Binding WykresKartyVisible}" 
                                      Margin="0,0,15,5" 
                                      Foreground="#FF2196F3" 
                                      FontWeight="Bold"/>

                            <CheckBox Content="Badania" 
                                      IsChecked="{Binding WykresBadanVisible}" 
                                      Margin="0,0,15,5" 
                                      Foreground="#FF00BCD4" 
                                      FontWeight="Bold"/>

                            <CheckBox Content="Wizyty" 
                                      IsChecked="{Binding WykresWizytVisible}" 
                                      Margin="0,0,15,5" 
                                      Foreground="#FF673AB7" 
                                      FontWeight="Bold"/>

                            <CheckBox Content="Wartość [zł]" 
                                      IsChecked="{Binding WykresWartosciVisible}" 
                                      Margin="0,0,0,5" 
                                      Foreground="#FF4CAF50" 
                                      FontWeight="Bold"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- ✅ Wykres Syncfusion (SfChart) - DYNAMICZNY TYP -->
                    <syncfusion:SfChart Grid.Row="1" Margin="0,10,0,0">

                        <!-- ✅ NOWE: Tooltip (podpowiedzi przy hover) -->
                        <syncfusion:SfChart.Behaviors>
                            <syncfusion:ChartTooltipBehavior 
                                ShowDuration="5000"
                                InitialShowDelay="200"/>
                        </syncfusion:SfChart.Behaviors>

                        <!-- Oś X (Miesiące) -->
                        <syncfusion:SfChart.PrimaryAxis>
                            <syncfusion:CategoryAxis Header="Miesiąc" 
                                                     FontSize="11" 
                                                     LabelRotationAngle="-45"/>
                        </syncfusion:SfChart.PrimaryAxis>

                        <!-- ✅ Oś Y (Ilość) -->
                        <syncfusion:SfChart.SecondaryAxis>
                            <syncfusion:NumericalAxis Header="Ilość" 
                                                      FontSize="11" 
                                                      Minimum="0"/>
                        </syncfusion:SfChart.SecondaryAxis>

                        <!-- ════════════════════════════════════════════════════ -->
                        <!-- ✅ LINIE (Widoczne gdy IsLineChart = true) -->
                        <!-- ════════════════════════════════════════════════════ -->

                        <!-- LINIA 1: Liczba Kart (Skierowań) -->
                        <syncfusion:LineSeries ItemsSource="{Binding StatystykiMiesieczne}" 
                                               XBindingPath="MiesiacNazwa" 
                                               YBindingPath="LiczbaSkierowan" 
                                               Label="Karty" 
                                               Interior="#FF2196F3" 
                                               StrokeThickness="3"
                                               ShowTooltip="True"
                                               TooltipTemplate="{StaticResource TooltipTemplate}">
                            <syncfusion:LineSeries.AdornmentsInfo>
                                <syncfusion:ChartAdornmentInfo ShowMarker="True" 
                                                               Symbol="Ellipse" 
                                                               SymbolInterior="#FF2196F3"
                                                               SymbolHeight="8"
                                                               SymbolWidth="8"/>
                            </syncfusion:LineSeries.AdornmentsInfo>
                            <!-- ✅ Kontrola widoczności: checkbox + typ wykresu -->
                            <syncfusion:LineSeries.Style>
                                <Style TargetType="syncfusion:LineSeries">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WykresKartyVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLineChart}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:LineSeries.Style>
                        </syncfusion:LineSeries>

                        <!-- LINIA 2: Liczba Badań (GŁÓWNA) -->
                        <syncfusion:LineSeries ItemsSource="{Binding StatystykiMiesieczne}" 
                                               XBindingPath="MiesiacNazwa" 
                                               YBindingPath="BadaniaOdbyte" 
                                               Label="Badania" 
                                               Interior="#FF00BCD4" 
                                               StrokeThickness="4"
                                               ShowTooltip="True"
                                               TooltipTemplate="{StaticResource TooltipTemplate}">
                            <syncfusion:LineSeries.AdornmentsInfo>
                                <syncfusion:ChartAdornmentInfo ShowMarker="True" 
                                                               Symbol="Ellipse" 
                                                               SymbolInterior="#FF00BCD4"
                                                               SymbolHeight="10"
                                                               SymbolWidth="10"/>
                            </syncfusion:LineSeries.AdornmentsInfo>
                            <!-- ✅ Kontrola widoczności: checkbox + typ wykresu -->
                            <syncfusion:LineSeries.Style>
                                <Style TargetType="syncfusion:LineSeries">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WykresBadanVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLineChart}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:LineSeries.Style>
                        </syncfusion:LineSeries>

                        <!-- LINIA 3: Liczba Wizyt -->
                        <syncfusion:LineSeries ItemsSource="{Binding StatystykiMiesieczne}" 
                                               XBindingPath="MiesiacNazwa" 
                                               YBindingPath="WizytyZarejestrowane" 
                                               Label="Wizyty" 
                                               Interior="#FF673AB7" 
                                               StrokeThickness="3"
                                               ShowTooltip="True"
                                               TooltipTemplate="{StaticResource TooltipTemplate}">
                            <syncfusion:LineSeries.AdornmentsInfo>
                                <syncfusion:ChartAdornmentInfo ShowMarker="True" 
                                                               Symbol="Ellipse" 
                                                               SymbolInterior="#FF673AB7"
                                                               SymbolHeight="8"
                                                               SymbolWidth="8"/>
                            </syncfusion:LineSeries.AdornmentsInfo>
                            <!-- ✅ Kontrola widoczności: checkbox + typ wykresu -->
                            <syncfusion:LineSeries.Style>
                                <Style TargetType="syncfusion:LineSeries">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WykresWizytVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLineChart}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:LineSeries.Style>
                        </syncfusion:LineSeries>

                        <!-- ✅ LINIA 4: Wartość [zł] (SKALOWANA do osi Y) -->
                        <syncfusion:LineSeries ItemsSource="{Binding StatystykiMiesieczneSkalowane}" 
                                               XBindingPath="MiesiacNazwa" 
                                               YBindingPath="WartoscBadanSkalowana" 
                                               Label="Wartość [zł]" 
                                               Interior="#FF4CAF50" 
                                               StrokeThickness="3"
                                               StrokeDashArray="5,3"
                                               ShowTooltip="True"
                                               TooltipTemplate="{StaticResource TooltipWartoscTemplate}">
                            <syncfusion:LineSeries.AdornmentsInfo>
                                <syncfusion:ChartAdornmentInfo ShowMarker="True" 
                                                               Symbol="Diamond" 
                                                               SymbolInterior="#FF4CAF50"
                                                               SymbolHeight="10"
                                                               SymbolWidth="10"/>
                            </syncfusion:LineSeries.AdornmentsInfo>
                            <!-- ✅ NOWE: Kontrola widoczności przez checkbox -->
                            <syncfusion:LineSeries.Style>
                                <Style TargetType="syncfusion:LineSeries">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WykresWartosciVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLineChart}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:LineSeries.Style>
                        </syncfusion:LineSeries>

                        <!-- ════════════════════════════════════════════════════ -->
                        <!-- ✅ SŁUPKI (Widoczne gdy IsColumnChart = true) -->
                        <!-- ════════════════════════════════════════════════════ -->

                        <!-- SŁUPKI 1: Liczba Kart (Skierowań) -->
                        <syncfusion:ColumnSeries ItemsSource="{Binding StatystykiMiesieczne}" 
                                                 XBindingPath="MiesiacNazwa" 
                                                 YBindingPath="LiczbaSkierowan" 
                                                 Label="Karty" 
                                                 Interior="#FF2196F3"
                                                 ShowTooltip="True"
                                                 TooltipTemplate="{StaticResource TooltipTemplate}">
                            <!-- ✅ Kontrola widoczności: checkbox + typ wykresu -->
                            <syncfusion:ColumnSeries.Style>
                                <Style TargetType="syncfusion:ColumnSeries">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WykresKartyVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsColumnChart}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:ColumnSeries.Style>
                        </syncfusion:ColumnSeries>

                        <!-- SŁUPKI 2: Liczba Badań -->
                        <syncfusion:ColumnSeries ItemsSource="{Binding StatystykiMiesieczne}" 
                                                 XBindingPath="MiesiacNazwa" 
                                                 YBindingPath="BadaniaOdbyte" 
                                                 Label="Badania" 
                                                 Interior="#FF00BCD4"
                                                 ShowTooltip="True"
                                                 TooltipTemplate="{StaticResource TooltipTemplate}">
                            <!-- ✅ Kontrola widoczności: checkbox + typ wykresu -->
                            <syncfusion:ColumnSeries.Style>
                                <Style TargetType="syncfusion:ColumnSeries">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WykresBadanVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsColumnChart}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:ColumnSeries.Style>
                        </syncfusion:ColumnSeries>

                        <!-- SŁUPKI 3: Liczba Wizyt -->
                        <syncfusion:ColumnSeries ItemsSource="{Binding StatystykiMiesieczne}" 
                                                 XBindingPath="MiesiacNazwa" 
                                                 YBindingPath="WizytyZarejestrowane" 
                                                 Label="Wizyty" 
                                                 Interior="#FF673AB7"
                                                 ShowTooltip="True"
                                                 TooltipTemplate="{StaticResource TooltipTemplate}">
                            <!-- ✅ Kontrola widoczności: checkbox + typ wykresu -->
                            <syncfusion:ColumnSeries.Style>
                                <Style TargetType="syncfusion:ColumnSeries">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WykresWizytVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsColumnChart}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:ColumnSeries.Style>
                        </syncfusion:ColumnSeries>

                        <!-- ✅ SŁUPKI 4: Wartość [zł] (SKALOWANA do osi Y) -->
                        <syncfusion:ColumnSeries ItemsSource="{Binding StatystykiMiesieczneSkalowane}" 
                                                 XBindingPath="MiesiacNazwa" 
                                                 YBindingPath="WartoscBadanSkalowana" 
                                                 Label="Wartość [zł]" 
                                                 Interior="#FF4CAF50"
                                                 ShowTooltip="True"
                                                 TooltipTemplate="{StaticResource TooltipWartoscTemplate}">
                            <!-- ✅ NOWE: Kontrola widoczności przez checkbox -->
                            <syncfusion:ColumnSeries.Style>
                                <Style TargetType="syncfusion:ColumnSeries">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WykresWartosciVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsColumnChart}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:ColumnSeries.Style>
                        </syncfusion:ColumnSeries>

                        <!-- Legenda -->
                        <syncfusion:SfChart.Legend>
                            <syncfusion:ChartLegend DockPosition="Bottom" 
                                                    Visibility="Visible" 
                                                    FontSize="11"/>
                        </syncfusion:SfChart.Legend>
                    </syncfusion:SfChart>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
