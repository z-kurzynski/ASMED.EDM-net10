<UserControl x:Class="ASMED.WPF.Views.TenplateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
    xmlns:converters="clr-namespace:ASMED.WPF.Converters"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:local="clr-namespace:ASMED.WPF.Views" 
    xmlns:syncfusionskin ="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av"
    syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=Windows11Light}"
    Height="Auto" Width="Auto" VerticalAlignment="Top" MaxWidth="1800" MinWidth="1100">

    <UserControl.Resources>
        <Style TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="{x:Type Path}" x:Key="SfDataGridHeaderIconStyle">
            <Setter Property="Fill" Value="Cyan"/>
        </Style>
        <Style TargetType="{x:Type syncfusion:FilterToggleButton}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="BorderBrush" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" 
              MaxWidth="1500" MinWidth="1100"
              Width="1500">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="8"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Height="46">
                <TextBlock Text="Wyszukaj skierowanie:" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel>
                    <TextBox x:Name="txtSearchPacjent" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="247" FontSize="14" />
                    <Button Width="32" Height="28" Margin="8,0,0,0" ToolTip="Wyczyść pole" Command="{Binding ClearSearchTextCommand}">
                        <Image Source="/ASMED.WPF;component/Assets/no.png" Width="10" Height="10" />
                    </Button>
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="0,0,8,0"
                        SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding FilterTypes}"/>
                </DockPanel>
            </StackPanel>
            <syncfusion:ButtonAdv
                Grid.Column="3"
                HorizontalAlignment="Center"
                Height="45"
                Label=" ➕ Dodaj Skierowanie  "
                VerticalAlignment="Top"
                Width="220"
                Background="#FF9C27B0"
                Foreground="#FFFBFBFB"
                FontStyle="Italic"
                FontSize="16" Margin="0,10,0,0" IsCheckable="True"  >
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>
            <syncfusion:ButtonAdv
                Grid.Column="4"
                HorizontalAlignment="Center"
                Height="45"
                Label=" ➕ Dodaj Skierowanie  "
                VerticalAlignment="Top"
                Width="220"
                Background="#FFFF5722"
                Foreground="#FFFBFBFB"
                FontStyle="Italic"
                FontSize="16" Margin="0,10,0,0" IsCheckable="True"  >
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>


            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->
            <syncfusion:ButtonAdv
                    Grid.Column="5"

                    HorizontalAlignment="Center"
                    Height="45"
                    Label=" ➕ Dodaj Skierowanie  "
                    VerticalAlignment="Center"
                    Width="220"
                    Background="#FF3F51B5"
                    Foreground="#FFFBFBFB"
                    FontStyle="Italic"
                    FontSize="16" Margin="0,10,0,0" IsCheckable="True"  >
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>

            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->
            <syncfusion:ButtonAdv
                    Grid.Column="6"
                    HorizontalAlignment="Center"
                    Height="45"
                    Label=" ➕ Dodaj Skierowanie  "
                    VerticalAlignment="Center"
                    Width="220"

                    Background="#FF009688"
                    Foreground="#FFFBFBFB"
                    FontStyle="Italic"
                    FontSize="16" IsCheckable="True" Margin="0,10,0,0"  >
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>

        </Grid>
        <!-- -->
        <!-- ItemsSource="{Binding SkierowaniaFiltered}" -->
        
        <syncfusion:SfDataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            LiveDataUpdateMode="AllowChildViewUpdate"
            
            AlternationCount="2"
            RowHeight="40"
            ColumnSizer="Star"
            FontSize="17"
            AllowFiltering="True"
            AllowSorting="True"
            SelectionMode="Single"
            SelectionUnit="Row"
            FontFamily="Arial Narrow"
            Padding="2,2,2,2"
            Margin="10,10,10,10" RowSelectionBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" 
            MaxWidth="1500" MinWidth="1100" Width="1500"
            CurrentCellBorderBrush="{x:Null}" OpacityMask="#FFFFFDFD" Height="580">


            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="Id" HeaderText="ID" Width="50" IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="Typ" HeaderText="Typ" Width="40" TextAlignment="Center" />
                <!--
                <syncfusion:GridTextColumn MappingName="Imie" HeaderText="Imię" Width="150" />
                <syncfusion:GridTextColumn MappingName="Nazwisko" HeaderText="Nazwisko" Width="200" />
                <syncfusion:GridTextColumn MappingName="Firma" HeaderText="Firma" />
                <syncfusion:GridTextColumn MappingName="Data" HeaderText="Data" Width="120" />
                <syncfusion:GridTextColumn MappingName="Status" HeaderText=" " Width="20" />
                -->


            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
