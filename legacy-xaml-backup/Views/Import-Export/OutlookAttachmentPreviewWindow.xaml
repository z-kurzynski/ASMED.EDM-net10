<Window x:Class="ASMED.WPF.Views.OutlookAttachmentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Podglad zalacznikow PDF" 
        Height="600" Width="900" 
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F9FA">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Email Info -->
        <GroupBox Grid.Row="0" Header="Informacje o e-mailu" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Temat:" FontWeight="Bold" Width="100"/>
                    <TextBlock x:Name="SubjectText" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Od:" FontWeight="Bold" Width="100"/>
                    <TextBlock x:Name="FromText"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Data:" FontWeight="Bold" Width="100"/>
                    <TextBlock x:Name="DateText"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Attachments List -->
        <GroupBox Grid.Row="1" Header="Zalaczniki PDF" Padding="10">
            <ListBox x:Name="AttachmentsList" FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#FFE0E0E0" BorderThickness="1" 
                                Padding="10" Margin="0,0,0,5" CornerRadius="5"
                                Background="#FFF5F5F5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="PDF" FontSize="16" 
                                           VerticalAlignment="Center" FontWeight="Bold"/>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SizeFormatted}" 
                                               FontSize="10" Foreground="#FF666666"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Podglad" 
                                        Height="30" Width="90"
                                        Background="#FF2196F3"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="PreviewAttachment_Click"
                                        Tag="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Zamknij" 
                    Width="120" Height="35"
                    Background="#FF9E9E9E"
                    Foreground="White"
                    BorderThickness="0"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
