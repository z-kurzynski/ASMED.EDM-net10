<UserControl x:Class="ASMED.WPF.Views.PacjentSkierowanieView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    Width="Auto" VerticalAlignment="Top" MaxWidth="1500" MinWidth="1450" Background="#FFF7F9FA">

    <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Width="Auto" MinWidth=" 1450" Margin="0,0,0,30">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <!-- Główny podział: lewa/prawa -->
            <RowDefinition Height="144"/>
            <!-- Pasek przycisków 1 -->
            <RowDefinition Height="114"/>
            <!-- Pasek przycisków 2 -->
        </Grid.RowDefinitions>
        <Grid VerticalAlignment="Center" Height="506">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="127*"/>
                <ColumnDefinition Width="173*"/>
            </Grid.ColumnDefinitions>
            <!-- Lewa kolumna: 8 wierszy -->
            <Grid Grid.Column="0" Margin="5,10,745,0" VerticalAlignment="Top" MinWidth=" 600" Grid.ColumnSpan="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Ramka z danymi pacjenta -->
                <Border Grid.Row="0" Grid.RowSpan="4" CornerRadius="10" BorderThickness="1" BorderBrush="#2196F3" Margin="0,0,0,8" Padding="8" Width="610" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Dane pacjenta" FontWeight="Bold" FontSize="18" Foreground="#2196F3" Margin="0,0,0,8"/>
                        <!-- Imię i Nazwisko w jednym wierszu -->
                        <StackPanel Orientation="Horizontal" Margin="0,4" Width="600" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <!-- Imię -->
                            <StackPanel Width="220" Margin="5,0,12,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center" Width="200" HorizontalAlignment="Left">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE13D;" Foreground="#2196F3" Margin="0,0,8,0" FontSize="14"/>
                                    <TextBlock Text="Imię:" Margin="0,0,0,2"/>
                                </StackPanel>
                                <syncfusion:SfTextBoxExt Text="{Binding PatientFirstName}" IsReadOnly="True" FontSize="18" Height="25" Width="200" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <!-- Nazwisko -->
                            <StackPanel Width="350" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Top" Width="200" HorizontalAlignment="Left">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE13D;" Foreground="#2196F3" Margin="0,0,8,0" FontSize="14"/>
                                    <TextBlock Text="Nazwisko:" Margin="0,0,0,2"/>
                                </StackPanel>
                                <syncfusion:SfTextBoxExt Text="{Binding PatientLastName}" IsReadOnly="True" FontSize="18" Height="25" Width="349" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- PESEL, Płeć, Data ur., Stanowisko pracy w jednym wierszu -->
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <!-- PESEL -->
                            <StackPanel Width="140" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center" Width="200">
                                    <TextBlock Text="PESEL:" Width="60"/>
                                </StackPanel>
                                <syncfusion:SfTextBoxExt Text="{Binding PatientPesel}" IsReadOnly="True" Width="120" Margin="0,0,12,0" FontSize="18"/>
                            </StackPanel>
                            <!-- Płeć -->
                            <StackPanel Width="51" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Width="55">
                                    <TextBlock Text="Płeć:" Width="40"/>
                                </StackPanel>
                                <syncfusion:SfTextBoxExt Text="{Binding PatientGender}" IsReadOnly="True" Width="30" Margin="0,0,12,0" FontSize="18"/>
                            </StackPanel>
                            <!-- Data ur. -->
                            <StackPanel Width="137" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Width="125" HorizontalAlignment="Left">
                                    <TextBlock Text="Data ur.:" Width="70"/>
                                </StackPanel>
                                <syncfusion:SfTextBoxExt Text="{Binding PatientBirthDate, StringFormat=dd.MM.yyy}" IsReadOnly="True" Width="120" Margin="0,0,12,0" FontSize="18"/>
                            </StackPanel>
                            <!-- Stanowisko pracy -->
                            <StackPanel Width="226">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Width="141" HorizontalAlignment="Left">
                                    <TextBlock Text="Stanowisko pracy:" Width="130" Margin="10,0,0,0">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                                <syncfusion:SfTextBoxExt Text="{Binding PatientJobTitle}" IsReadOnly="True" Width="216" FontSize="18" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Kod, Miejscowość, Ulica/nr w jednym wierszu -->
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <!-- Kod -->
                            <StackPanel Width="80" Margin="3,0,10,0">
                                <TextBlock Text="Kod:" Width="40" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                <syncfusion:SfTextBoxExt Text="{Binding PatientPostalCode}" IsReadOnly="True" Width="78" FontSize="18"/>
                            </StackPanel>
                            <!-- Miejscowość -->
                            <StackPanel Width="150" Margin="0,0,20,0">
                                <TextBlock Text="Miejscowość:" Width="90" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                <syncfusion:SfTextBoxExt Text="{Binding PatientCity}" IsReadOnly="True" Width="145" FontSize="18"/>
                            </StackPanel>
                            <!-- Ulica/nr -->
                            <StackPanel Width="327" Margin="0,0,20,0">
                                <TextBlock Text="Ulica/nr:" Width="80" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                <syncfusion:SfTextBoxExt Text="{Binding PatientStreet}" IsReadOnly="True" Width="317" FontSize="18" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Uwagi i ID pacjenta w jednym wierszu -->
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <!-- Uwagi -->
                            <StackPanel Style="{DynamicResource StackPanelStyleBox}" Width="59" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Width="59">
                                    <TextBlock Text="ID:" Width="40"/>
                                </StackPanel>
                                <syncfusion:SfTextBoxExt Text="{Binding PatientId}" IsReadOnly="True" Width="44" FontSize="18"/>
                            </StackPanel>
                            <!-- Uwagi -->
                            <syncfusion:SfTextBoxExt Watermark="Uwagi" Text="{Binding Uwagi}" Margin="0,25,0,0" Width="500" Height="25"/>
                            <!-- ID pacjenta -->
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Ramka z danymi firmy -->
                <Border Grid.Row="4" Grid.RowSpan="2" CornerRadius="10" BorderThickness="1" BorderBrush="#FF9800" Margin="0,0,0,8" Padding="8" Width="610" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Firma" FontWeight="Bold" FontSize="18" Foreground="#FF9800" Margin="0,0,0,8"/>
                        <!-- Firma ID i Nazwa firmy w jednym wierszu -->
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <!-- ID firmy -->
                            <StackPanel Width="80" Margin="3,0,20,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                    <TextBlock Text="ID firmy:" Width="70"/>
                                </StackPanel>
                                <syncfusion:SfTextBoxExt Text="{Binding CompanyId}" IsReadOnly="True" Width="60" FontSize="18" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <!-- Nazwa firmy -->
                            <StackPanel Width="490" Margin="0,0,20,0">
                                <TextBlock Text="Nazwa firmy:" Width="117" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                <syncfusion:SfTextBoxExt Text="{Binding CompanyName}" IsReadOnly="True" Width="477" FontSize="18" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Dane adresowe firmy w jednym wierszu -->
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <!-- Kod firmy -->
                            <StackPanel Margin="3,0,10,0" Width="80" HorizontalAlignment="Left">
                                <TextBlock Text="Kod firmy:" Width="80" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                <syncfusion:SfTextBoxExt Text="{Binding CompanyPostalCode}" IsReadOnly="True" Width="70" FontSize="18" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <!-- Miejscowość firmy -->
                            <StackPanel Width="150" Margin="0,0,20,0">
                                <TextBlock Text="Miejscowość firmy:" Width="137" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                <syncfusion:SfTextBoxExt Text="{Binding CompanyCity}" IsReadOnly="True" Width="145" FontSize="18" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <!-- Ulica/nr firmy -->
                            <StackPanel Width="327" HorizontalAlignment="Left">
                                <TextBlock Text="Ulica/nr firmy:" Width="142" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                <syncfusion:SfTextBoxExt Text="{Binding CompanyStreet}" IsReadOnly="True" Width="317" FontSize="18" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Prawa kolumna: dynamiczna -->
            <ContentControl Grid.Column="1" Content="{Binding PrawyWidokVM}" Margin="50,0,10,0" HorizontalAlignment="Left"/>
        </Grid>
        <!-- Pasek przycisków 1 -->
        <Grid Grid.Row="1" Margin="0,0,0,0" Height="114" Width="Auto" HorizontalAlignment="Center" MinWidth="1450">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="93*"/>
                <ColumnDefinition Width="197*"/>

            </Grid.ColumnDefinitions>
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Center" Width="450">
                <GroupBox x:Name="Nawiacja" Header="Nawigacja" Margin="0,0,10,0" Width="420" FontFamily="Arial Rounded MT Bold" FontSize="14" Height="100">
                    <GroupBox.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                    </GroupBox.BorderBrush>
                    <!-- Twoja zawartość tutaj -->
                    <StackPanel Margin="10,0,0,0" Orientation="Horizontal" Height="75">
                        <Button Background="#F44336" Foreground="White" Height="43" Width="95" Margin="0,0,5,0">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="18" Margin="0,0,6,0" />
                                <TextBlock Text="Zamknij" />
                            </StackPanel>
                        </Button>
                        <Button Background="#FF6D7FC7"  Command="{Binding EdytujPacjentaCommand}" Foreground="White" Width="130" Height="40" Margin="0,0,5,0">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="18" Margin="5,0,5,0" HorizontalAlignment="Left" />
                                <TextBlock Text="Nowe Skier." FontFamily="Segoe UI" FontSize="16" Margin="2,0,0,0" Width="113" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Button>
                        <Button Background="#009688"  Command="{Binding EdytujPacjentaCommand}" Foreground="White" Width="150" Height="40">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="18" Margin="5,0,5,0" HorizontalAlignment="Left" />
                                <TextBlock Text="Edytuj Pacjenta" FontFamily="Segoe UI" FontSize="16" Margin="2,0,0,0" Width="113" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Button>


                    </StackPanel>
                </GroupBox>
            </StackPanel>


            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,50,0" Width="873">
                <GroupBox x:Name="drukuj" Header=" Drukuj " FontSize="16" FontFamily="Arial Rounded MT Bold" Height="100" Margin="0,0,10,0">
                    <GroupBox.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}"/>
                    </GroupBox.BorderBrush>
                    <!-- Twoja zawartość tutaj -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0" Height="70" Width="566">
                        <Button Background="#FF366D69" Foreground="White" Width="150" Height="42" Margin="0,0,5,0">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A1;" FontSize="18" Margin="0,0,6,0" />
                                <TextBlock Text="Zaświadczenie" Margin="3,0,0,0" FontFamily="Segoe UI" FontSize="16"/>
                            </StackPanel>
                        </Button>
                        <Button Background="#4CAF50" Foreground="White" Width="130" Height="42" Margin="0,0,5,0">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D4;" FontSize="18" Margin="0,0,6,0" />
                                <TextBlock Text="Ankieta" FontFamily="Segoe UI" FontSize="16" />
                            </StackPanel>
                        </Button>
                        <Button Background="#3F51B5" Foreground="White" Width="130" Height="42" Margin="0,0,5,0">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A1;" FontSize="18" Margin="0,0,6,0" />
                                <TextBlock Text="Orzeczenie" Margin="3,0,0,0" FontFamily="Segoe UI" FontSize="16" />
                            </StackPanel>
                        </Button>
                        <Button Foreground="White" Background="#FF5722" Width="130" Panel.ZIndex="-2" Height="42" Margin="0,0,5,0">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                            <StackPanel
                                    Orientation="Horizontal">
                                <TextBlock
                                        Text="&#xE8A1;" Margin="0,0,6,0" FontSize="18" FontFamily="Segoe MDL2 Assets"/>
                                <TextBlock FontFamily="Segoe UI" FontSize="16"><Run Language="pl-pl" Text="Karta Badań"/></TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="Zapisz" Header="Zarejestruj" FontFamily="Arial Rounded MT Bold" FontSize="16" Height="100">
                    <GroupBox.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                    </GroupBox.BorderBrush>
                    <!-- Twoja zawartość tutaj -->
                    <StackPanel Orientation="Horizontal" Height="43" Width="255" HorizontalAlignment="Left" Margin="8,0,0,0">
                        <Button Background="#2196F3" Foreground="White" Height="43" Width="120" Margin="0,0,5,0">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Wizytę" FontFamily="Segoe UI" FontSize="16" />
                            </StackPanel>
                        </Button>
                        <Button Background="#9C27B0" Foreground="White" Command="{Binding SaveCommand}" Height="43" Width="120" HorizontalAlignment="Left" FontFamily="Segoe UI" FontSize="14">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Skierowanie" FontFamily="Segoe UI" FontSize="16" Width="111" Margin="5,0,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </GroupBox>


            </StackPanel>

        </Grid>
        <!-- Pasek przycisków 2 -->
    </Grid>
</UserControl>
