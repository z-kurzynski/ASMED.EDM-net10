<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="ASMED.WPF.PatientAdd"
        Title="Dodaj pacjenta" Width="650" VerticalAlignment="Top" Height="632" Background="#FFF7F9FA">
    <Grid Margin="20,2,20,0" Height="615" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <!-- 1. Nagłówek -->
            <RowDefinition Height="Auto"/>
            <!-- 2. PESEL, Brak, Płeć, Data urodzenia -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Imię, Nazwisko -->
            <RowDefinition Height="Auto"/>
            <!-- 4. Zawód -->
            <RowDefinition Height="30"/>
            <!-- 5. Nagłówek adresu -->
            <RowDefinition Height="Auto"/>
            <!-- 6. Ulica -->
            <RowDefinition Height="60"/>
            <!-- 7. Kod pocztowy, Miejscowość -->
            <RowDefinition Height="Auto"/>
            <!-- 8. Firma -->
            <RowDefinition Height="Auto"/>
            <!-- 9. Przyciski -->
        </Grid.RowDefinitions>
        <!-- 1. Nagłówek -->
        <TextBlock Grid.Row="0" FontSize="14" Margin="0,0,0,7" HorizontalAlignment="Left" Width="222" FontWeight="Bold">
            <TextBlock.Foreground>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
            </TextBlock.Foreground><Run Language="pl-pl" Text="Pacjent"/></TextBlock>

        <!-- 2. PESEL, Brak, Płeć, Data urodzenia -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Width="120" Margin="10,0,0,0">
                <TextBlock Text="PESEL" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding PESEL, Mode=TwoWay}" Height="25" FontSize="18" >
                    <TextBox.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                    </TextBox.BorderBrush>
                </TextBox>
            </StackPanel>
            <StackPanel Width="31" Margin="28,0,0,0">
                <TextBlock Text="Brak" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <CheckBox IsChecked="{Binding BrakPESEL, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Width="80" Margin="10,0,0,0">
                <TextBlock Text="Płeć" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Plec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Width="60" MaxLength="1" />
            </StackPanel>
            <StackPanel Width="120" Margin="10,0,0,0">
                <TextBlock Text="Data urodzenia" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding DataUrodzenia, Mode=TwoWay}" FontSize="16" />
            </StackPanel>
        </StackPanel>

        <!-- 3. Imię, Nazwisko -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Width="270" Margin="10,0,0,0">
                <TextBlock FontSize="10" FontWeight="Bold" Margin="0,0,0,5"><Run Text="Imię/imiona"/><Run Language="pl-pl" Text=" *"/></TextBlock>
                <TextBox Text="{Binding Imie, Mode=TwoWay}" FontSize="18" Height="25" Width="260" HorizontalAlignment="Left" >
                    <TextBox.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                    </TextBox.BorderBrush>
                </TextBox>
            </StackPanel>
            <StackPanel Width="269" Margin="10,0,0,0">
                <TextBlock FontSize="10" FontWeight="Bold" Margin="0,0,0,5" ><Run Text="Nazwisko"/><Run Language="pl-pl" Text=" *"/></TextBlock>
                <TextBox Text="{Binding Nazwisko, Mode=TwoWay}" FontSize="18" Height="25" Width="260" HorizontalAlignment="Left" >
                    <TextBox.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                    </TextBox.BorderBrush>
                </TextBox>
            </StackPanel>
        </StackPanel>

        <!-- 4. Zawód -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,0,10,10">
            <StackPanel Width="270">
                <TextBlock Text="Zawód" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                <TextBox Text="{Binding Zawod, Mode=TwoWay}" FontSize="18" Height="25" Width="260" HorizontalAlignment="Left" >
                    <TextBox.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                    </TextBox.BorderBrush>
                </TextBox>
            </StackPanel>
            <StackPanel Width="284" Margin="10,0,0,0">
                <TextBlock FontSize="10" FontWeight="Bold" Margin="0,0,0,5" ><Run Language="pl-pl" Text="Uwagi"/></TextBlock>
                <TextBox Text="{Binding comments, Mode=TwoWay}" FontSize="18" Height="25" Width="260" HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>

        <!-- 4. Nagłówek adresu zamieszkania -->
        <TextBlock Grid.Row="4" Text="Adres zamieszkania" FontWeight="Bold" Margin="0,5,0,5" >
            <TextBlock.Foreground>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}"/>
            </TextBlock.Foreground>
        </TextBlock>

        <!-- 5. Ulica -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Margin="10,0,0,0" Width="550">
                <TextBlock Text="Ulica numer domu" FontSize="10" Margin="0,0,0,5" FontWeight="Bold"/>
                <TextBox Text="{Binding UlicaNumerDomu, Mode=TwoWay}" FontSize="18" Width="539" TextWrapping="Wrap" HorizontalAlignment="Left" >
                    <TextBox.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                    </TextBox.BorderBrush>
                </TextBox>
            </StackPanel>
        </StackPanel>

        <!-- 6. Kod pocztowy, Miejscowość -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,0">
            <StackPanel Width="160" Margin="10,0,0,0" Height="60">
                <TextBlock Text="Kod pocztowy" FontSize="10" Margin="0,0,0,5" FontWeight="Bold"/>
                <TextBox Text="{Binding KodPocztowy, Mode=TwoWay}" FontSize="18" >
                    <TextBox.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                    </TextBox.BorderBrush>
                </TextBox>
            </StackPanel>
            <StackPanel Width="413" Margin="10,0,0,0" Height="66">
                <TextBlock Text="Miejscowość" FontSize="10" Margin="0,0,0,5" FontWeight="Bold"/>
                <DockPanel>
                    <TextBox x:Name="txtMiejscowosc" Text="{Binding Miejscowosc, Mode=TwoWay}" FontSize="18" Width="366" >
                        <TextBox.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                        </TextBox.BorderBrush>
                    </TextBox>
                    <Button Width="18" Height="22" Margin="8,0,0,0" ToolTip="Wyczyść pole" Command="{Binding ClearMiejscowoscCommand}">
                        <Button.Background>
                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
                        </Button.Background>
                        <Image Source="/ASMED.WPF;component/Resources/clear_icon.png" Width="20" Height="20" />
                    </Button>
                </DockPanel>
            </StackPanel>
        </StackPanel>
        <!-- 7. Firma: wybór i tabela -->
        <StackPanel Grid.Row="7" Orientation="Vertical" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,5" Height="41">
                <TextBlock Text="Wyszukana firma:" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="300" FontSize="14" Height="28" IsReadOnly="True" Background="#F5F5F5"
         Text="{Binding WybranaFirma.Name, Mode=OneWay}"/>
                <TextBlock Text="ID firmy:" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="16,0,8,0" Width="60"/>
                <TextBox Width="80" FontSize="16" Height="28" IsReadOnly="True"
         Text="{Binding WybranaFirma.Id, Mode=OneWay}"/>
            </StackPanel>
            <StackPanel Width="606" HorizontalAlignment="Left" Orientation="Horizontal">
                <TextBlock FontSize="10" FontWeight="Bold" Width="85" Margin="10,0,0,0"><Run Text="Firma"/><Run Language="pl-pl" Text=" szukaj"/></TextBlock>
               
                <TextBox Width="265" Margin="5,0,0,5"
             Text="{Binding FrazaFirma, UpdateSourceTrigger=PropertyChanged}"
             FontSize="16" Height="28"
             ToolTip="Wpisz nazwę lub NIP firmy" HorizontalAlignment="Left"/>
                
                <!-- ✅ DODANY: Przycisk czyszczący -->
                <Button Width="30" Height="28" 
                        Margin="2,0,0,5"
                        Background="#FFE57373" 
                        ToolTip="Wyczyść wyszukiwanie"
                        Command="{Binding ClearSearchCommand}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" 
                               Text="&#xE894;" 
                               FontSize="14" 
                               Foreground="White"/>
                </Button>
                
                <TextBlock Text="ID pacjenta" FontSize="10" FontWeight="Bold" Margin="16,0,8,5" Width="60"/>
                <TextBox Text="{Binding ID, Mode=OneWay}" FontSize="16" IsReadOnly="True" Width="80" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding FiltrowaneFirmy}"
              SelectedItem="{Binding WybranaFirma, Mode=TwoWay}"
              AutoGenerateColumns="False"
              Height="101" MaxHeight="220"
              Margin="10,5,0,0"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              IsReadOnly="True"
              SelectionMode="Single" Background="{x:Null}" Foreground="{x:Null}">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Foreground">
                            <Setter.Value>
                                <SolidColorBrush Color="{StaticResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="#00000000"/>
                    </Style>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Background" Value="{x:Null}"/>
                        <Setter Property="FontWeight" Value="DemiBold"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="300" />
                    <DataGridTextColumn Header="NIP" Binding="{Binding NIP}" Width="80" />
                    <DataGridTextColumn Header="Adres" Binding="{Binding Address}" Width="*" />
                </DataGrid.Columns>
                <DataGrid.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}"/>
                </DataGrid.BorderBrush>
            </DataGrid>
        </StackPanel>
        <!-- 8. Przyciski (dla zakładki Skierowania) -->
        <StackPanel Grid.Row="8" HorizontalAlignment="Right" Margin="0,10,0,0" VerticalAlignment="Top" Orientation="Horizontal" Height="50" Width="428">
            <Button Width="100" Margin="10" Command="{Binding SaveCommand}" Background="#4CAF50" Foreground="White">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE105;" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Zapisz" FontWeight="Bold"/>
                </StackPanel>
            </Button>
            <Button Width="100" Margin="10" Command="{Binding AnulujCommand}" Background="#F44336" Foreground="White">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE10A;" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Anuluj" FontWeight="Bold"/>
                </StackPanel>
            </Button>
            <Button Width="160" Margin="10" Command="{Binding UtworzSkierowanieCommand}" Background="#2196F3" Foreground="White">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D2;" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Utwórz skierowanie" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,79,0,122">
            <StackPanel/>
            <StackPanel Orientation="Horizontal" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleY="0.626"/>
                        <RotateTransform/>
                        <TranslateTransform Y="0.656"/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
            </StackPanel>

        </StackPanel>

        <!-- w7: Sekcja przycisków -->
    </Grid>
</Window>
