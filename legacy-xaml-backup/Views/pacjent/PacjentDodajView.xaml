<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" 
    x:Class="ASMED.WPF.Views.PacjentDodajView"
    Height="Auto" Width="1550" VerticalAlignment="Top" MaxWidth="1800" MinWidth="1100" Background="#FFF7F9FA">
    <!--
    <UserControl.DataContext>
        <vm:PacjentDodajViewModel />
    </UserControl.DataContext>
-->
    <Grid Margin="20,2,20,0" Height="600" VerticalAlignment="Top" Width="Auto">
        <Grid.RowDefinitions>
            <RowDefinition />
            <!-- Pierwszy wiersz -->
            <RowDefinition Height="293" />
            <!-- Drugi wiersz -->
            <RowDefinition Height="67" />
            <!-- Trzeci wiersz -->
        </Grid.RowDefinitions>

        <!-- Pierwszy wiersz: dwie kolumny -->
        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="567" />
                <ColumnDefinition Width="480.187"/>
                <ColumnDefinition Width="0*" />
            </Grid.ColumnDefinitions>

            <!-- Lewa kolumna: 6 wierszy -->
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center" Height="232" Width="570">
                <!-- 1. Nag��wek -->
                <TextBlock Grid.Row="0" FontSize="20" Margin="0,0,0,7" HorizontalAlignment="Left" Width="222" FontWeight="Bold">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                    </TextBlock.Foreground><Run Language="pl-pl" Text="Pacjent"/></TextBlock>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Width="270" Margin="10,0,0,0">
                        <TextBlock FontSize="10" FontWeight="Bold" Margin="0,0,0,5"><Run Text="Imię"/><Run Language="pl-pl" Text="ę"/><Run Text="/imiona"/><Run Text=" *"/></TextBlock>
                        <syncfusion:SfTextBoxExt
                            Width="260"
                            Height="30"
                            Watermark="* Wpisz imię"
                            FontSize="18"
                            AutoCompleteSource="{Binding ImionaItems}"
                            AutoCompleteMode="SuggestAppend"
                            TextHighlightMode="FirstOccurrence"
                            HighlightedTextColor="Red"
                            SearchItemPath="."
                            SuggestionBoxPlacement="Bottom"
                            MaxDropDownHeight="300"
                            Text="{Binding WybraneImie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Width="269" Margin="10,0,0,0">
                        <TextBlock FontSize="10" FontWeight="Bold" Margin="0,0,0,5" ><Run Text="Nazwisko"/><Run Language="pl-pl" Text=" *"/></TextBlock>
                        <syncfusion:SfTextBoxExt
                            Width="260"
                            Height="30"
                            Watermark="* Wpisz nazwisko"
                            FontSize="18"
                            AutoCompleteSource="{Binding NazwiskaItems}"
                            AutoCompleteMode="SuggestAppend"
                            TextHighlightMode="FirstOccurrence"
                            HighlightedTextColor="Red"
                            SearchItemPath="."
                            SuggestionBoxPlacement="Bottom"
                            MaxDropDownHeight="300"
                            Text="{Binding WybraneNazwisko, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
                <!-- 2. PESEL, Brak, P�e�, Data urodzenia -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Width="120" Margin="10,0,0,0">
                        <TextBlock Text="PESEL" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PESEL, Mode=TwoWay}" Height="30" FontSize="18" >
                        </TextBox>
                    </StackPanel>
                    <StackPanel Width="31" Margin="28,0,0,0">
                        <TextBlock Text="Brak" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                        <CheckBox IsChecked="{Binding BrakPESEL, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Width="80" Margin="10,0,0,0">
                        <TextBlock FontSize="10" FontWeight="Bold" Margin="10,0,0,5"><Run Language="pl-pl" Text="Płeć"/></TextBlock>
                        <TextBox Text="{Binding Plec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Width="60" MaxLength="1" Height="30" />
                    </StackPanel>
                    <StackPanel Width="120" Margin="10,0,0,0">
                        <TextBlock Text="Data urodzenia" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding DataUrodzenia, Mode=TwoWay}" FontSize="16" Height="30" />
                    </StackPanel>
                </StackPanel>
                <!-- 3. Imi�, Nazwisko -->


                <!-- 4. Zaw�d -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,0,10,10">
                    <StackPanel Width="270" Height="70">
                        <TextBlock FontSize="10" FontWeight="Bold" Margin="0,0,0,5" ><Run Language="pl-pl" Text="Stanowisko"/></TextBlock>
                        <syncfusion:SfTextBoxExt
                            Width="260"
                            Height="30"
                            Watermark="Wpisz Stanowisko"
                            FontSize="18"
                            AutoCompleteSource="{Binding ZawodyItems}"
                            AutoCompleteMode="SuggestAppend"
                            TextHighlightMode="FirstOccurrence"
                            HighlightedTextColor="Red"
                            SearchItemPath="."
                            SuggestionBoxPlacement="Bottom"
                            MaxDropDownHeight="300"
                            Text="{Binding WybranyZawod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Width="284" Margin="10,-10,0,0" Height="60">
                        <TextBlock FontSize="10" FontWeight="Bold" Margin="0,0,0,5" ><Run Language="pl-pl" Text="Uwagi"/></TextBlock>
                        <TextBox Text="{Binding comments, Mode=TwoWay}" FontSize="18" Height="30" Width="260" HorizontalAlignment="Left" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>

            <!-- Prawa kolumna: 6 wierszy -->
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Height="235" Width="460" Margin="20,0,0,0">

                <!-- 4. Nag��wek adresu zamieszkania -->
                <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,6" FontSize="20" >
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}"/>
                    </TextBlock.Foreground><Run Text="Adres zamieszkania"/><Run Language="pl-pl" Text=" i kontaktowe"/></TextBlock>
                <!-- 5. Ulica -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Width="460">
                        <TextBlock Text="Ulica numer domu" FontSize="10" Margin="0,0,0,5" FontWeight="Bold"/>
                        <syncfusion:SfTextBoxExt
                            Width="450"
                            Height="30"
                            Watermark="* Wpisz Ulicę nr domu mieszkania"
                            FontSize="18"
                            AutoCompleteSource="{Binding UliceItems}"
                            AutoCompleteMode="SuggestAppend"
                            TextHighlightMode="FirstOccurrence"
                            HighlightedTextColor="Red"
                            SearchItemPath="."
                            SuggestionBoxPlacement="Bottom"
                            MaxDropDownHeight="300"
                            Text="{Binding WybranaUlica, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />

                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,0">
                    <StackPanel Width="109" Height="60" HorizontalAlignment="Left" Margin="0,-5,0,0">
                        <TextBlock Text="Kod pocztowy" FontSize="10" Margin="0,0,0,5" FontWeight="Bold"/>
                        <TextBox Text="{Binding KodPocztowy, Mode=TwoWay}" FontSize="18" Height="30" Width="100" HorizontalAlignment="Left" >
                        </TextBox>
                    </StackPanel>
                    <StackPanel Width="346" Height="66" Margin="5,0,0,0">
                        <TextBlock FontSize="10" Margin="0,0,0,5" FontWeight="Bold"><Run Text="Miejscowo"/><Run Language="pl-pl" Text="ść"/></TextBlock>
                        <DockPanel Width="342" HorizontalAlignment="Left">
                            <syncfusion:SfTextBoxExt
                            Width="335"
                            Height="30"
                            Watermark="* Wpisz miejscowość"
                            FontSize="18"
                            AutoCompleteSource="{Binding MiastaItems}"
                            AutoCompleteMode="SuggestAppend"
                            TextHighlightMode="FirstOccurrence"
                            HighlightedTextColor="Red"
                            SearchItemPath="."
                            SuggestionBoxPlacement="Bottom"
                            MaxDropDownHeight="300"
                            Text="{Binding WybraneMiasto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Wiersz 1" Height="55" />


                <!-- 6. Kod pocztowy, Miejscowo�� -->

            </StackPanel>
        </Grid>

        <!-- Drugi wiersz -->
        <!-- 7. Firma: wyb�r i tabela -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,10,10">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,5" Height="41" Width="1500">
                <TextBlock Text="Wyszukana firma:" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="280" FontSize="14" Height="30" IsReadOnly="True" Background="#F5F5F5"
         Text="{Binding WybranaFirma.Name, Mode=OneWay}"/>
                <TextBlock Text="ID firmy:" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="16,0,8,0" Width="60"/>
                <TextBox Width="80" FontSize="16" Height="30" IsReadOnly="True"
         Text="{Binding WybranaFirma.Id, Mode=OneWay}" IsEnabled="False"/>
            </StackPanel>
            <StackPanel Width="606" HorizontalAlignment="Left" Orientation="Horizontal">
                <TextBlock FontSize="10" FontWeight="Bold" Width="85" Margin="10,0,0,0"><Run Text="Firma"/><Run Language="pl-pl" Text=" szukaj"/></TextBlock>

                <TextBox Width="245" Margin="5,0,0,5"
             Text="{Binding FrazaFirma, UpdateSourceTrigger=PropertyChanged}"
             FontSize="16" Height="30"
             ToolTip="Wpisz nazwę lub NIP firmy" HorizontalAlignment="Left"/>

                <!-- ✅ DODANY: Przycisk czyszczący -->
                <Button Width="30" Height="30" 
                        Margin="2,0,0,5"
                        Background="#FFE57373" 
                        ToolTip="Wyczyść wyszukiwanie"
                        Command="{Binding ClearSearchCommand}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" 
                               Text="&#xE894;" 
                               FontSize="14" 
                               Foreground="White"/>
                </Button>

                <TextBlock Text="ID pacjenta" FontSize="10" FontWeight="Bold" Margin="16,0,8,5" Width="60"/>
                <TextBox Text="{Binding ID, Mode=OneWay}" FontSize="16" IsReadOnly="True" Width="80" Height="30" Margin="2,0,0,0" IsEnabled="False" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding FiltrowaneFirmy}"
              SelectedItem="{Binding WybranaFirma, Mode=TwoWay}"
              AutoGenerateColumns="False"
              Height="182" MaxHeight="220"
              Margin="10,5,0,0"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              IsReadOnly="True"
              SelectionMode="Single" Background="{x:Null}" Foreground="{x:Null}" Width="1470" HorizontalAlignment="Left">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Foreground">
                            <Setter.Value>
                                <SolidColorBrush Color="{StaticResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="#00000000"/>
                    </Style>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Background" Value="{x:Null}"/>
                        <Setter Property="FontWeight" Value="DemiBold"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="500" FontSize="16" SortDirection="Ascending" FontFamily="Arial" FontWeight="Thin" />
                    <DataGridTextColumn Header="NIP" Binding="{Binding NIP}" Width="90" FontSize="16" FontFamily="Arial" />
                    <DataGridTextColumn Header="Adres" Binding="{Binding Address}" Width="*" FontSize="16" FontFamily="Arial" />
                </DataGrid.Columns>
                <DataGrid.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}"/>
                </DataGrid.BorderBrush>
            </DataGrid>
        </StackPanel>

        <!-- Trzeci wiersz -->
        <!-- 8. Przyciski (dla zak�adki Skierowania) -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Left" Margin="980,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Height="60" Width="520">
            <Button Width="140" Margin="10,5,10,5" Command="{Binding PowrotDoListyCommand}" Background="#FF9800" Foreground="White" Height="45" FontSize="16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8EF;" FontSize="16" Margin="0,5,5,0"/>
                    <TextBlock Text="Lista pacjentów"/>
                </StackPanel>
            </Button>
            <Button Width="140" Margin="10,5,10,5" Command="{Binding SaveCommand}" Background="#4CAF50" Foreground="White" Height="45">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE105;" FontSize="16" Margin="0,5,5,0"/>
                    <TextBlock Text="Zapisz" FontSize="16"/>
                </StackPanel>
            </Button>
            <Button Width="140" Margin="10,5,10,5" Command="{Binding AnulujCommand}" Background="#F44336" Foreground="White">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE10A;" FontSize="16" Margin="0,5,5,0"/>
                    <TextBlock Text="Anuluj" FontSize="16"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>

</UserControl>
