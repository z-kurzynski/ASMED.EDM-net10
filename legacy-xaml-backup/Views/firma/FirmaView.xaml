<UserControl Style="{DynamicResource UserControlStyleLista}" x:Class="ASMED.WPF.Views.FirmaView"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:local="clr-namespace:ASMED.WPF.Views" 
    xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av"
    syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=Windows11Light}"
    Height="Auto" Width="Auto" VerticalAlignment="Top" MaxWidth="1800" MinWidth="1100" Background="#FFF7F9FA">


    <UserControl.Resources>
        <Style x:Key="UserControlStyleLista" TargetType="{x:Type UserControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type UserControl}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FirmaGridHeaderStyle" TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="{x:Type Path}" x:Key="SfDataGridHeaderIconStyle">
            <Setter Property="Fill" Value="Cyan"/>
        </Style>
        <Style x:Key="FirmaFilterToggleButtonStyle" TargetType="{x:Type syncfusion:FilterToggleButton}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="BorderBrush" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <!-- Górny pasek: przyciski, wyszukiwanie -->
        <Grid VerticalAlignment="Center" 
              Grid.Row="0"
              Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="485"/>
                <ColumnDefinition Width="145"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="0*"/>
                <ColumnDefinition Width="362"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="8"/>
            </Grid.ColumnDefinitions>
            <!-- Przyciski: Dodaj Firmę i Odśwież -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="0,0,0,1" HorizontalAlignment="Left" Width="280">
                <!-- Przycisk Dodaj Firmę -->
                <syncfusion:ButtonAdv
                        x:Name="btnOdswiez"
                        Height="45"
                        Label="🔄  Odśwież"
                        Width="120"
                        Background="#FF2196F3"
                        Foreground="#FFFBFBFB"
                        FontSize="14" 
                        Margin="0,7,0,0" 
                        IconHeight="14" 
                        IconWidth="0"
                        Command="{Binding OdswiezCommand}"
                        ToolTip="Odśwież listę firm">
                    <syncfusion:ButtonAdv.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                    </syncfusion:ButtonAdv.BorderBrush>
                    <syncfusion:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion:ButtonAdv.IconTemplate>
                </syncfusion:ButtonAdv>
                <!-- Przycisk Dodaj Firmę -->
                <syncfusion:ButtonAdv
                        x:Name="btnDodajFirme"
                        Height="45"
                        Label="➕  Dodaj Firmę"
                        Width="150"
                        Background="#FF009688"
                        Foreground="#FFFBFBFB"
                        FontSize="14" 
                        Margin="8,7,10,0" 
                        IconHeight="14" 
                        IconWidth="0"
                        Command="{Binding DodajFirmeCommand}">
                    <syncfusion:ButtonAdv.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                    </syncfusion:ButtonAdv.BorderBrush>
                    <syncfusion:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion:ButtonAdv.IconTemplate>
                </syncfusion:ButtonAdv>

                <!-- Przycisk Odśwież -->
            </StackPanel>
            <!-- Pole wyszukiwania -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Height="46" HorizontalAlignment="Left" Width="450">
                <TextBlock Text="Wyszukaj Fimę:" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel>
                    <TextBox x:Name="txtSearchPacjent" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="247" FontSize="14" />
                    <Button Width="32" Height="28" Margin="8,0,0,0" ToolTip="Wyczyść pole" Command="{Binding ClearSearchTextCommand}">
                        <Image Source="/Views/pacjent/no.png" Width="10" Height="10" />
                    </Button>
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="10,0,8,0"
              SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding FilterTypes}" HorizontalAlignment="Left"/>
                </DockPanel>
            </StackPanel>
        </Grid>
        <Grid Margin="10,10,15,0" Grid.Row="1" VerticalAlignment="Top">
            <syncfusion:SfDataGrid
                                    x:Name="FirmaGrid"
                                    ItemsSource="{Binding FilteredFirmy}"
                                    AutoGenerateColumns="False"
                                    RowHeight="48"
                                    ColumnSizer="Star"
                                    FontSize="15"
                                    AllowFiltering="True"
                                    AllowSorting="True"
                                    SelectionMode="Single"
                                    AllowEditing="True"
                                    EditTrigger="OnTap"
                                    SelectionUnit="Row"
                                    FontFamily="Arial Narrow"
                                    MaxWidth="1500" MinWidth="1400"
                                    CurrentCellBorderBrush="{x:Null}" 
                                    OpacityMask="#FFFFFDFD" 
                                    Height="565" 
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Top" 
                                    Width="1480" 
                                    Margin="10,0,0,0">

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn 
                                    MappingName="id" 
                                    HeaderText="ID" 
                                    Width="30" 
                                    TextAlignment="Right" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,2,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="False"
                                    IsReadOnly="True"/>
                    <syncfusion:GridTextColumn 
                                    MappingName="Cennik" 
                                    HeaderText="Cennik" 
                                    Width="60" 
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="True" SetCellBoundToolTip="False"/>

                    <!-- ✅ NOWE: Umowa Do -->
                    <syncfusion:GridTextColumn 
                                    MappingName="UmowaDo" 
                                    HeaderText="Umowa do" 
                                    Width="80" 
                                    TextAlignment="Center" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="False" 
                                    AllowFiltering="True"
                                    IsReadOnly="True">
                        <syncfusion:GridTextColumn.ValueBinding>
                            <Binding Path="UmowaDo" StringFormat="{}{0:dd.MM.yyyy}" TargetNullValue="-"/>
                        </syncfusion:GridTextColumn.ValueBinding>
                    </syncfusion:GridTextColumn>

                    <!-- ✅ NOWE: Czas Nieokreślony -->
                    <syncfusion:GridCheckBoxColumn 
                                    MappingName="CzasNieokreslon" 
                                    HeaderText="Bezterminowa" 
                                    Width="30" 
                                    AllowEditing="False"
                                    IsReadOnly="True"/>

                    <syncfusion:GridTextColumn 
                                    MappingName="Nazwa"
                                    HeaderText="Nazwa" 
                                    TextWrapping="Wrap"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="True"/>
                    <syncfusion:GridTextColumn 
                                    MappingName="Miejscowosc" 
                                    HeaderText="Miejscowość" 
                                     Width="92" 
                                    TextWrapping="Wrap"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="True"/>
                    <syncfusion:GridTextColumn 
                                    MappingName="Ulica" 
                                    HeaderText="Ulica" 
                                    TextWrapping="Wrap"
                                    Width="150"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="True"/>
                    <syncfusion:GridTextColumn 
                                    MappingName="NIP" 
                                    HeaderText="NIP" 
                                    Width="85"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="False" 
                                    TextTrimming="WordEllipsis"/>

                    <syncfusion:GridTextColumn 
                                    MappingName="Osoba_kontaktowa" 
                                    HeaderText="Osoba kontaktowa" 
                                    Width="150" 
                                    TextWrapping="Wrap"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="False" 
                                    TextTrimming="CharacterEllipsis"/>

                    <syncfusion:GridTextColumn 
                                    MappingName="Telefon" 
                                    HeaderText="Telefon" 
                                    Width="95"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="False" 
                                    TextTrimming="CharacterEllipsis"/>
<!--
                    <syncfusion:GridTextColumn 
                                    MappingName="Email" 
                                    HeaderText="Email" 
                                     Width="200" 
                                    TextWrapping="Wrap"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="False" 
                                    TextTrimming="CharacterEllipsis" FilterRowOptionsVisibility="Visible" ImmediateUpdateColumnFilter="False"/>
-->
                    <syncfusion:GridTextColumn 
                                    MappingName="FKemail" 
                                    HeaderText="FKemail" 
                                    Width="200" 
                                    TextWrapping="Wrap"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="False" 
                                    TextTrimming="CharacterEllipsis"/>

                    <syncfusion:GridTemplateColumn HeaderText="Edycja" Width="50" ColumnSizer="Auto" AllowSorting="False" AllowFiltering="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Width="45" Height="50" Background="#FF078247" BorderThickness="0" ToolTip="Edytuj firmę"
                                    Command="{Binding DataContext.EdytujFirmeCommand, RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                    CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="✏️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridTemplateColumn HeaderText="Zapisz" Width="50" 
                        AllowSorting="False" 
                        AllowFiltering="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Height="45" Width="50" Background="#1976D2" Foreground="White" ToolTip="Zapisz zmiany"
                                    Command="{Binding DataContext.SaveFirmaCommand, RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                    CommandParameter="{Binding}">
                                    <TextBlock Text="💾" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridTemplateColumn HeaderText="Umowy" Width="50" 
                        AllowSorting="False" 
                        AllowFiltering="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Height="45" Width="50" Background="#FF9C27B0" Foreground="White" ToolTip="Zarządzaj umowami firmy"
                                    Command="{Binding DataContext.PokazUmowyCommand, RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                    CommandParameter="{Binding}">
                                    <TextBlock Text="📄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                    <!---->
                </syncfusion:SfDataGrid.Columns>

            </syncfusion:SfDataGrid>

        </Grid>

        <!-- SfDataGrid: lista firm -->

    </Grid>
</UserControl>
