<Window x:Class="ASMED.WPF.Views.firma.UmowaEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=Windows11Light}"
        Title="Edytuj umowę" 
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF7F9FA" MinHeight="700" VerticalAlignment="Top">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Data Umowy -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Data umowy:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <DatePicker SelectedDate="{Binding DataUmowy, Mode=TwoWay}" 
                       FontSize="14" 
                       Height="32"/>
        </StackPanel>

        <!-- Nr Umowy -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Nr umowy:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding NrUmowy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    FontSize="14" 
                    Height="32"
                    MaxLength="50"/>
        </StackPanel>

        <!-- Ilość miesięcy -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Ilość miesięcy:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <syncfusion:IntegerTextBox Value="{Binding IloscMiesiecy, Mode=TwoWay}" 
                                      FontSize="14" 
                                      Height="32"
                                      MinValue="0"
                                      MaxValue="120"
                                      IsEnabled="{Binding CzyTerminowa}"/>
        </StackPanel>

        <!-- Czy terminowa -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15" Orientation="Horizontal">
            <CheckBox x:Name="chkCzyTerminowa"
                     IsChecked="{Binding CzyTerminowa, Mode=TwoWay}" 
                     VerticalAlignment="Center"
                     FontSize="14"
                     Margin="0,0,10,0"
                     Checked="ChkCzyTerminowa_Changed"
                     Unchecked="ChkCzyTerminowa_Changed"/>
            <TextBlock Text="Umowa terminowa" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Status -->
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Status:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox SelectedItem="{Binding Status, Mode=TwoWay}" 
                     FontSize="14" 
                     Height="32"
                     IsEditable="False">
                <System:String>Aktywna</System:String>
                <System:String>Zakończona</System:String>
                <System:String>Anulowana</System:String>
            </ComboBox>
        </StackPanel>

        <!-- Budżet -->
        <StackPanel Grid.Row="5" Margin="0,0,0,15">
            <TextBlock Text="Budżet (PLN):" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <syncfusion:CurrencyTextBox Value="{Binding Budzet, Mode=TwoWay}" 
                                       FontSize="14" 
                                       Height="32"
                                       CurrencySymbol=""
                                       CurrencyDecimalDigits="2"
                                       MinValue="0"/>
        </StackPanel>

        <!-- Data końcowa (tylko odczyt) -->
        <StackPanel Grid.Row="6" Margin="0,0,0,15">
            <TextBlock Text="Data końcowa:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding DataKoncowa, StringFormat='{}{0:dd.MM.yyyy}', TargetNullValue='Bezterminowa'}" 
                      FontSize="14" 
                      Padding="5"
                      Background="#FFE0E0E0"
                      Height="32"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Info o wartości wykonanych badań -->
        <StackPanel Grid.Row="7" Margin="0,0,0,15">
            <TextBlock Text="Wartość wykonanych badań:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding WartoscWykonanychBadan, StringFormat='{}{0:N2} PLN'}" 
                      FontSize="14" 
                      Padding="5"
                      Background="#FFE0E0E0"
                      Height="32"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Przyciski -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <syncfusion:ButtonAdv Label="💾 Zapisz" 
                                 Width="120" 
                                 Height="40"
                                 FontSize="14"
                                 Background="#FF009688"
                                 Foreground="White"
                                 Margin="0,0,10,0"
                                 Click="BtnZapisz_Click"/>
            <syncfusion:ButtonAdv Label="✖ Anuluj" 
                                 Width="120" 
                                 Height="40"
                                 FontSize="14"
                                 Background="#FFD32F2F"
                                 Foreground="White"
                                 Click="BtnAnuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>
