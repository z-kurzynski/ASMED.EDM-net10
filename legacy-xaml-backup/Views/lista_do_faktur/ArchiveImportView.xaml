<UserControl x:Class="ASMED.WPF.Views.lista_do_faktur.ArchiveImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ASMED.WPF.Views.lista_do_faktur"
             xmlns:vm="clr-namespace:ASMED.WPF.ViewModels.lista_do_faktur" 
             xmlns:local1="clr-namespace:ASMED.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200"
             Background="#FFF7F9FA">

    <UserControl.DataContext>
        <vm:ArchiveImportViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Konwerter BoolToVisibilityConverter -->

        <local1:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Konwerter InverseBoolConverter 
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/> -->
        <!-- Style dla DataGrid -->
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="LightGreen"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Górny panel - wyszukiwanie i akcje -->
        <Border Grid.Row="0" Padding="10" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Szukaj:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtSearch" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Width="300" 
                             Padding="5"
                             VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="🔍 Szukaj" 
                            Command="{Binding SearchCommand}" 
                            Margin="10,0,0,0" 
                            Padding="15,5"
                            Background="#2196F3" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <TextBlock Text="(Faktura / Firma / Nazwisko)" 
                               Foreground="Gray" 
                               VerticalAlignment="Center" 
                               Margin="10,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="🔄 Odśwież" 
                        Command="{Binding RefreshCommand}"
                        Padding="15,5"
                        Background="#4CAF50" 
                        Foreground="White" 
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Tabela z danymi -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding ArchiveRecords}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F9F9F9"
                  IsReadOnly="False"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">

            <DataGrid.Columns>
                <!-- Checkbox do zaznaczania -->
                <DataGridTemplateColumn Header="✓" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ID główne -->
                <DataGridTextColumn Header="ID" Binding="{Binding Identyfikator}" Width="50" FontSize="14"/>

                <!-- ID pomocnicze - do diagnostyki i importu -->
                <DataGridTextColumn Header="ID Fakt" Binding="{Binding Lx_ID_Faktura}" Width="60" FontSize="14" FontWeight="Normal">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="ID Firma" Binding="{Binding Lx_ID_Firma}" Width="60" FontSize="14">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="ID Pac" Binding="{Binding Lx_ID_pacjent}" Width="60" FontSize="14">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="ID Skier" Binding="{Binding Lx_ID_Skierowania}" Width="60" FontSize="14">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
<!--
                <DataGridTextColumn Header="ID Bad" Binding="{Binding Lx_ID_Badania}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
-->
                <!-- Faktura -->
                <DataGridTextColumn Header="Faktura" Binding="{Binding Lx_Faktura}" Width="120" FontSize="14" FontWeight="Bold" SortDirection="Descending"/>

                <!-- Firma -->
                <DataGridTextColumn Header="Firma" 
                                    Binding="{Binding Lx_Firma}" 
                                    Width="300" 
                                    FontSize="12"/>

                <!-- Pacjent -->
                <DataGridTextColumn Header="Imię" Binding="{Binding Lx_Imie}" Width="100" FontSize="14"/>
                <DataGridTextColumn Header="Nazwisko" Binding="{Binding Lx_Nazwisko}" Width="120" FontSize="14"/>

                <!-- Data -->
                <DataGridTextColumn Header="Data" Binding="{Binding Lx_Data, StringFormat={}{0:dd.MM.yyyy}}" Width="90" FontSize="14"/>

                <!-- Razem -->
                <DataGridTextColumn Header="Razem" Binding="{Binding Lx_Razem, StringFormat={}{0:N2} zł}" Width="90" FontSize="14">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Uwagi -->
                <!--
                <DataGridTextColumn Header="Uwagi" Binding="{Binding Lx_Uwagi}" Width="*"/>
                -->
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#EEEEEE" Padding="10" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" 
                               VerticalAlignment="Center" 
                               FontWeight="SemiBold"
                               Foreground="#1976D2"/>
                    <TextBlock Text="{Binding ProgressText}" 
                               VerticalAlignment="Center" 
                               Margin="20,0,0,0"
                               Foreground="#FF9800"
                               Visibility="{Binding IsProcessing}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Rekordy w archiwum: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding ArchiveRecords.Count}" 
                               VerticalAlignment="Center" 
                               FontWeight="Bold"
                               Foreground="#1976D2"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dolny panel - przyciski akcji -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="10" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="288.2"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Przyciski zaznaczania -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="✓ Zaznacz wszystkie" 
                            Command="{Binding SelectAllCommand}"
                            Padding="15,8"
                            Background="#2196F3" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,10,0"/>
                    <Button Content="✗ Odznacz wszystkie" 
                            Command="{Binding DeselectAllCommand}"
                            Padding="15,8"
                            Background="#9E9E9E" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>

                <!-- Informacja -->
                <TextBlock Grid.Column="1" 
                           Text="Zaznacz rekordy które chcesz zaimportować, a następnie kliknij 'Importuj'" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           Foreground="Gray"
                           FontStyle="Italic" Height="16" Width="380"/>



                <!-- Przycisk importu -->
                <Button Grid.Column="2" 
                         Content="📥 Importuj zaznaczone" 
        Width="180" 
        Height="35" 
        Background="#FF4CAF50" 
        Foreground="White" 
        FontWeight="Bold"
        Command="{Binding ImportSelectedCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>
        </Border>

        <!-- Progress overlay -->
        <!--
        <Grid Grid.RowSpan="4" 
              Background="#80000000" 
              Visibility="{Binding IsProcessing}">
            <Border Background="White" 
                    CornerRadius="5" 
                    Padding="30" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    BorderBrush="#2196F3"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="Importowanie danych..." 
                               FontSize="18" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <ProgressBar Width="300" 
                                 Height="25" 
                                 Minimum="0" 
                                 Maximum="{Binding TotalToProcess}" 
                                 Value="{Binding ProcessedCount}"
                                 Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ProgressText}" 
                               HorizontalAlignment="Center"
                               Foreground="Gray"/>
                </StackPanel>
            </Border>
        </Grid> -->
    </Grid>
</UserControl>
