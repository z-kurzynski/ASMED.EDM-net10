<UserControl
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
 xmlns:local="clr-namespace:ASMED.WPF.Views"
 xmlns:Syncfusion="http://schemas.syncfusion.com/wpf" x:Class="ASMED.WPF.Views.badania_Edit_View"
 Height="Auto" Width="Auto">
    <Grid x:Name="Edit_prawa" HorizontalAlignment="Left" Width="900" Height="610" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <!-- wiersz 0: dwie kolumny 1/2 -->
            <RowDefinition Height="130"/>
            <!-- wiersz 1: jedna kolumna (zajmuje oba columnSpan) -->
            <RowDefinition Height="12*"/>
            <!-- wiersz 2: jedna kolumna (zajmuje oba columnSpan) -->
            <RowDefinition Height="73*"/>
            <!-- wiersz 3: przyciski -->
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- wiersz 0: lewa kolumna - Pacjent -->
        <Border x:Name="Pacjent" Grid.Column="0"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
            BorderThickness="1" CornerRadius="4"
            VerticalAlignment="Center"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            Margin="0,0,455,0" Padding="8" Height="130">
            <!-- (zawartość Pacjent pozostaje bez zmian) -->
            <StackPanel Margin="0,0,0,-11">
                <TextBlock Text="Dane Pacjenta 22" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Grid Margin="6,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TextBlock_imie_nazwisko" Grid.Column="0" FontSize="18" FontWeight="Bold" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="SelectedWizyta.P_imie" />
                                <Binding Path="SelectedWizyta.P_nazwisko" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock x:Name="txtPesel" Grid.Column="1" FontSize="18" Text="{Binding FormattedPesel}" HorizontalAlignment="Right" FontWeight="Bold" TextWrapping="Wrap" />
                </Grid>

                <TextBlock Margin="6,6,0,0" FontSize="18" Text="{Binding SelectedWizyta.P_zawod}" FontWeight="Bold" />

                <Grid Margin="6,8,0,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155*" />
                        <ColumnDefinition Width="266*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,4" Width="150" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <TextBlock FontWeight="Bold" FontSize="12" VerticalAlignment="Bottom" FontStyle="Italic" Height="20"><Run Text="Typ badania"/></TextBlock>
                        <Border Width="44" Margin="10,0,0,0" Height="25" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" CornerRadius="2" BorderThickness="1" Padding="4,2,4,2" >
                            <TextBlock x:Name="TextBlock_typ_badania" Text="{Binding SelectedWizyta.B_TypBadania}" FontSize="16" FontWeight="Bold" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Height="28" VerticalAlignment="Center">
                        <TextBlock FontSize="12" VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Width="70" Text="Data Skier."/>
                        <Border Margin="10,0,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" BorderThickness="1" CornerRadius="2" Padding="4,2,4,2" Height="24" VerticalAlignment="Center" Width="120">
                            <TextBlock x:Name="txtDataSkier"  FontSize="16"
                                        Text="{Binding SelectedWizyta.Bad_Data, StringFormat='{}{0:dd.MM.yyyy}'}"
                                        VerticalAlignment="Bottom" Height="18" HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- wiersz 0: prawa kolumna - Firma -->
        <Border x:Name="Firma"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
            BorderThickness="1" CornerRadius="4"
            VerticalAlignment="Center"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            Margin="455,0,0,0" Padding="8" Height="130">
            <StackPanel>
                <TextBlock Text="Dane Firmy" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <TextBlock Margin="6,6,0,0" FontSize="18" Text="{Binding SelectedAssignedBadanie.FirmaNazwa}" TextWrapping="Wrap" FontWeight="Bold" Height="50" />

                <Grid Margin="6,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock FontWeight="Bold" FontSize="12"><Run Text="NIP"/></TextBlock>
                        <TextBlock x:Name="txtNIP" Text="" FontSize="13" Width="125" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock FontWeight="Bold" FontSize="12"><Run Text="Cennik"/></TextBlock>
                        <ComboBox Width="156" Margin="10,0,0,0" ItemsSource="{Binding CennikOptions}" SelectedItem="{Binding SelectedCennik, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- wiersz 1: Dane Badania -->

        <StackPanel x:Name="Dane_Daty" Margin="0,10,0,0" Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Left" Width="848">
            <!-- Data Badania: display-only -->
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="Data Badania" FontWeight="Bold" FontSize="12" />
                <Border Margin="0,4,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" BorderThickness="1" CornerRadius="2" Padding="4,2,4,2" Height="24" Width="160">
                    <TextBlock Text="{Binding SelectedWizyta.Bad_Data, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- Data Ważności: display-only -->
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="Data Ważności" FontWeight="Bold" FontSize="12" />
                <Border Margin="0,4,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" BorderThickness="1" CornerRadius="2" Padding="4,2,4,2" Height="24" Width="160">
                    <TextBlock Text="{Binding SelectedWizyta.Bad_Data_Do, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- Wynik: display-only (info) with frame -->
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="Wynik" FontWeight="Bold" FontSize="12" />
                <Border Margin="0,4,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" BorderThickness="1" CornerRadius="2" Padding="6,2,6,2" Height="24" Width="160">
                    <TextBlock Text="{Binding SelectedWynik}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- Nr Księgi: TextBox -->
            <StackPanel Orientation="Vertical" Margin="0,4,10,0">
                <TextBlock Text="Nr Księgi" FontWeight="Bold" FontSize="12" VerticalAlignment="Top" Margin="0,-4,0,0" />
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" BorderThickness="1" CornerRadius="2" Padding="6,2,6,2" Height="24" Width="160" Margin="0,4,0,0">
                    <TextBlock Text="{Binding SelectedWizyta.Bad_Nr_KS, Mode=TwoWay}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- Badanie Sanitarne: icon colored green when true (B_ksiazeczka), gray when false -->
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="Książeczka" FontWeight="Bold" FontSize="12" />
                <Ellipse Width="24" Height="24" Stroke="Transparent">
                    <Ellipse.Style>
                        <Style TargetType="{x:Type Ellipse}">
                            <Setter Property="Fill" Value="#FFC1C0C0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedWizyta.B_ksiazeczka}" Value="True">
                                    <Setter Property="Fill" Value="#FF09D070" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                    <Ellipse.ToolTip>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="Nie" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWizyta.B_ksiazeczka}" Value="True">
                                            <Setter Property="Text" Value="Tak" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Ellipse.ToolTip>
                </Ellipse>
            </StackPanel>

            <!-- Urlop dla poratowania zdrowia: icon colored green when true, gray when false -->
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="Urlop (zdrowie)" FontWeight="Bold" FontSize="12" />
                <Ellipse Width="24" Height="24" Stroke="Transparent">
                    <Ellipse.Style>
                        <Style TargetType="{x:Type Ellipse}">
                            <Setter Property="Fill" Value="#FFC1C0C0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedWizyta.B_Zaswiadczenie}" Value="True">
                                    <Setter Property="Fill" Value="#FF09D070" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                    <Ellipse.ToolTip>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="Nie" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWizyta.B_Zaswiadczenie}" Value="True">
                                            <Setter Property="Text" Value="Tak" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Ellipse.ToolTip>
                </Ellipse>
            </StackPanel>
        </StackPanel>


        <!-- wiersz 2: jedna kolumna (span 2) - miejsce na kolejne szczegóły / edycję -->
        <Border x:Name="wycena_Badania" Grid.Row="2" BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="0,50,0,0" Height="200" VerticalAlignment="Top">
            <Grid Width="900" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Nagłówki tabeli -->
                <Grid Grid.Row="0" Background="#E9ECEF" Width="900" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Badanie" FontWeight="Bold" FontSize="12" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                    <TextBlock Grid.Column="1" Text="Laryngolog" FontWeight="Bold" FontSize="12" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                    <TextBlock Grid.Column="2" Text="Okulista" FontWeight="Bold" FontSize="12" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                    <TextBlock Grid.Column="3" Text="Książeczka" FontWeight="Bold" FontSize="12" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                    <TextBlock Grid.Column="4" Text="Lipidogram" FontWeight="Bold" FontSize="12" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                    <TextBlock Grid.Column="5" Text="EKG" FontWeight="Bold" FontSize="12" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                    <TextBlock Grid.Column="6" Text="Urlop (zdrowie )" FontWeight="Bold" FontSize="12" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                    <TextBlock Grid.Column="7" Text="Inne" FontWeight="Bold" FontSize="12" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                </Grid>

                <!-- Ceny z cennika -->
                <Grid x:Name="Grid_Ceny" Grid.Row="1" Background="#E8F4FD" Width="900" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="lblBasicPriceList" Grid.Column="0" Text="{Binding DataContext.PriceBasicText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="DarkBlue"/>
                    <TextBlock x:Name="lblLaryngologistPriceList" Grid.Column="1" Text="{Binding DataContext.PriceLaryngologistText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="DarkBlue"/>
                    <TextBlock x:Name="lblOphthalmologistPriceList" Grid.Column="2" Text="{Binding DataContext.PriceOphthalmologistText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="DarkBlue"/>
                    <TextBlock x:Name="lblSanitaryPriceList" Grid.Column="3" Text="{Binding DataContext.PriceSanitaryText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="DarkBlue"/>
                    <TextBlock x:Name="lblLipidogramPriceList" Grid.Column="4" Text="{Binding DataContext.PriceLipidogramText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="DarkBlue"/>
                    <TextBlock x:Name="lblEKGPriceList" Grid.Column="5" Text="{Binding DataContext.PriceEKGText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="DarkBlue"/>
                    <TextBlock x:Name="lblHealthClinicPriceList" Grid.Column="6" Text="{Binding DataContext.PriceHealthClinicText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="DarkBlue"/>
                    <TextBlock x:Name="lblOtherPriceList" Grid.Column="7" Text="{Binding DataContext.PriceOtherText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="DarkBlue"/>
                </Grid>

                <!-- Wartości -->
                <Grid x:Name="Grid_Wartość" Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Width="900" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtBasicPrice" Grid.Column="0" FontSize="18" FontWeight="Bold"
                        VerticalAlignment="Center" Margin="2" Height="30" 
                        TextChanged="PriceTextBox_TextChanged" Width="100" Text="{Binding SelectedWizyta.Bad_Cena1, Mode=TwoWay}"/>
                    <TextBox x:Name="txtLaryngologistPrice" Grid.Column="1" FontSize="18" FontWeight="Bold"
                        VerticalAlignment="Center" Margin="2" Height="30"
                        TextChanged="PriceTextBox_TextChanged" Width="100" Text="{Binding SelectedWizyta.Bad_Cena2, Mode=TwoWay}"/>
                    <TextBox x:Name="txtOphthalmologistPrice" Grid.Column="2" FontSize="18" FontWeight="Bold"
                        VerticalAlignment="Center" Margin="2" Height="30"
                        TextChanged="PriceTextBox_TextChanged" Width="100" Text="{Binding SelectedWizyta.Bad_Cena3, Mode=TwoWay}"/>
                    <TextBox x:Name="txtSanitaryPrice" Grid.Column="3" FontSize="18" FontWeight="Bold"
                        VerticalAlignment="Center" Margin="2" Height="30"
                        TextChanged="PriceTextBox_TextChanged" Width="100" Text="{Binding SelectedWizyta.Bad_Cena4, Mode=TwoWay}"/>
                    <TextBox x:Name="txtLipidogramPrice" Grid.Column="4" FontSize="18" FontWeight="Bold"
                        VerticalAlignment="Center" Margin="2" Height="30"
                        TextChanged="PriceTextBox_TextChanged" Width="100" Text="{Binding SelectedWizyta.Bad_Cena5, Mode=TwoWay}"/>
                    <TextBox x:Name="txtEKGPrice" Grid.Column="5" FontSize="18" FontWeight="Bold"
                        VerticalAlignment="Center" Margin="2" Height="30"
                        TextChanged="PriceTextBox_TextChanged" Text="{Binding SelectedWizyta.Bad_Cena6, Mode=TwoWay}"/>
                    <TextBox x:Name="txtHealthClinicPrice" Grid.Column="6" FontSize="18" FontWeight="Bold"
                        VerticalAlignment="Center" Margin="2" Height="30"
                        TextChanged="PriceTextBox_TextChanged" Text="{Binding SelectedWizyta.Bad_Cena7, Mode=TwoWay}"/>
                    <TextBox x:Name="txtOtherPrice" Grid.Column="7" FontSize="18" FontWeight="Bold"
                        VerticalAlignment="Center" Margin="2,2,4,2" Height="30"
                        TextChanged="PriceTextBox_TextChanged" Text="{Binding SelectedWizyta.Bad_Cena8, Mode=TwoWay}"/>
                </Grid>

                <!-- Pola wyboru z kolorami -->
                <Grid x:Name="Grid_Przyciski" Grid.Row="3" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Width="900" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnBasic" Grid.Column="0" Content="✗ NIEAKTYWNE" Height="35" Margin="2"
                        Background="#FFD0D3D6" FontWeight="Bold" FontSize="11" Click="ToggleExamination_Click" Tag="Basic"/>
                    <Button x:Name="btnLaryngologist" Grid.Column="1" Content="✗ NIEAKTYWNE" Height="35" Margin="2"
                        Background="#FFD0D3D6" FontWeight="Bold" FontSize="11" Click="ToggleExamination_Click" Tag="Laryngologist"/>
                    <Button x:Name="btnOphthalmologist" Grid.Column="2" Content="✗ NIEAKTYWNE" Height="35" Margin="2"
                        Background="#FFD0D3D6" FontWeight="Bold" FontSize="11" Click="ToggleExamination_Click" Tag="Ophthalmologist"/>
                    <Button x:Name="btnSanitary" Grid.Column="3" Content="✗ NIEAKTYWNE" Height="35" Margin="2"
                        Background="#FFD0D3D6" FontWeight="Bold" FontSize="11" Click="ToggleExamination_Click" Tag="Sanitary"/>
                    <Button x:Name="btnLipidogram" Grid.Column="4" Content="✗ NIEAKTYWNE" Height="35" Margin="2"
                        Background="#FFD0D3D6" FontWeight="Bold" FontSize="11" Click="ToggleExamination_Click" Tag="Lipidogram"/>
                    <Button x:Name="btnEKG" Grid.Column="5" Content="✗ NIEAKTYWNE" Height="35" Margin="2"
                        Background="#FFD0D3D6" FontWeight="Bold" FontSize="11" Click="ToggleExamination_Click" Tag="EKG"/>
                    <Button x:Name="btnHealthClinic" Grid.Column="6" Content="✗ NIEAKTYWNE" Height="35" Margin="2"
                        Background="#FFD0D3D6" FontWeight="Bold" FontSize="11" Click="ToggleExamination_Click" Tag="HealthClinic"/>
                    <Button x:Name="btnOther" Grid.Column="7" Content="✗ NIEAKTYWNE" Height="35" Margin="2,2,4,2"
                        Background="#FFD0D3D6" FontWeight="Bold" FontSize="11" Click="ToggleExamination_Click" Tag="Other"/>
                </Grid>

                <!-- Rząd z sumą -->
                <Grid Grid.Row="4" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="7" Text="SUMA:" FontSize="14" FontWeight="Bold"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Wartość sumy -->
                <Grid Grid.Row="5" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="lblTotalPrice" Grid.Column="7" Text="" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="DarkGreen" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Margin="0,0,10,0"/>
                </Grid>
            </Grid>
        </Border>




        <!-- wiersz 3: przyciski (span across both columns) -->
        <StackPanel x:Name="przyciski" Grid.Row="3" Grid.Column="0"
            HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center" Height="56" Width="390" Margin="500,0,0,0">
            <Syncfusion:ButtonAdv
                x:Name="btnDeleteBadanie"
                Height="45"
                Label=" 🗑️ Usuń Badanie  "
                Width="180"
                Background="#FFD32F2F"
                Foreground="#FFFBFBFB"
                FontStyle="Italic"
                FontSize="16" IsCheckable="True" Margin="10,0,0,0"
                Visibility="Hidden"
                Click="DeleteBadanie_Click">
                <Syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </Syncfusion:ButtonAdv.BorderBrush>
                <Syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </Syncfusion:ButtonAdv.IconTemplate>
            </Syncfusion:ButtonAdv>

            <Syncfusion:ButtonAdv
                x:Name="btnSaveBadanie"
                Height="45"
                Label=" ✏️ Zapisz Badanie  "
                Width="180"
                Background="#FF1976D2"
                Foreground="#FFFBFBFB"
                FontStyle="Italic"
                FontSize="16" IsCheckable="True" Margin="10,0,0,0"
                Click="SaveBadanie_Click_SaveToDb">
                <Syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </Syncfusion:ButtonAdv.BorderBrush>
                <Syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </Syncfusion:ButtonAdv.IconTemplate>
            </Syncfusion:ButtonAdv>
        </StackPanel>
    </Grid>

    <!-- This control contains the Edit panel; reuses the layout from BadaniaView Edit_prawa Grid -->
</UserControl>