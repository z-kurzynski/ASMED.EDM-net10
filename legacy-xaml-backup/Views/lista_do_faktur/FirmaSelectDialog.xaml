<Window x:Class="ASMED.WPF.Views.lista_do_faktur.FirmaSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz firme" Height="520" Width="800" MinWidth="720" MinHeight="300" Background="#FFF7F9FA">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="61"/>
            <RowDefinition Height="Auto" MinHeight="5"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Wybierz firme:" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel HorizontalAlignment="Left" Margin="0,10,0,1" Orientation="Horizontal" Width="560">
            <DockPanel Height="40" HorizontalAlignment="Left">
                <TextBox Width="232" Height="30" Margin="0,0,8,0"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Width="80" Content="Wyczysc" Click="ClearSearch_Click" Height="30" />
            </DockPanel>
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0" Height="30">
                <Button Width="100" Content="OK" 
                        IsDefault="True" 
                        Click="Ok_Click" 
                        Height="30" 
                        Background="#FF0472EA" 
                        Foreground="#FFF1EDED" 
                        FontSize="20">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                </Button>
                <Button Width="100" Content="Anuluj" 
                        IsCancel="True" 
                        Click="Cancel_Click" 
                        Height="30" 
                        Background="#FFEA7907" 
                        Foreground="#FFF1EDED" 
                        FontSize="20" Margin="20,0,0,0">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Pole wyszukiwania -->

        <ListView Grid.Row="2" ItemsSource="{Binding FirmsView}" SelectedItem="{Binding SelectedFirma, Mode=TwoWay}" Margin="0,5,0,0" >
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nazwa" 
                                    DisplayMemberBinding="{Binding Nazwa}" 
                                    Width="360"/>
                    <GridViewColumn Header="NIP" DisplayMemberBinding="{Binding NIP}" Width="80"/>
                    <GridViewColumn Header="Cennik" DisplayMemberBinding="{Binding Cennik}" Width="80"/>
                    <GridViewColumn Header="Fk-Email" DisplayMemberBinding="{Binding FKemail}" Width="80"/>

                    <!-- Kolumna z przyciskiem "Wybierz" dla kazdego wiersza -->
                    <GridViewColumn Header="Wybierz" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Wybierz"
                                        Width="74"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        Click="RowChoose_Click"
                                        DataContext="{Binding}" Background="#FF046AA0" Foreground="White"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>


    </Grid>
</Window>