<UserControl x:Class="ASMED.WPF.Views.ListaDoFakturView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
    xmlns:converters="clr-namespace:ASMED.WPF.Converters;assembly=ASMED.WPF"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:local="clr-namespace:ASMED.WPF.Views" 
    xmlns:syncfusionskin ="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av"
     syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=Windows11Light}"
     Width="Auto"
     Height="Auto"
     VerticalAlignment="Stretch"
     MinWidth="1100" MaxWidth="1800" Background="#FFF7F9FA">

    <UserControl.Resources>
        <!-- Lp shown from AssignedBadanieDto.Lp property set in ViewModel -->
        <Style TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="{x:Type Path}" x:Key="SfDataGridHeaderIconStyle">
            <Setter Property="Fill" Value="Cyan"/>
        </Style>
        <Style TargetType="{x:Type syncfusion:FilterToggleButton}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="BorderBrush" Value="#FF9ECBF7"/>
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Height="715">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" 
              MaxWidth="1500" MinWidth="1100"
              Width="1500" Height="55">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="525"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="8"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Height="46">
                <TextBlock Text="Wyszukaj :" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel>
                    <TextBox x:Name="txtSearchFaktura" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="280" FontSize="14" />
                    <Button Width="32" Height="28" Margin="8,0,0,0" ToolTip="Wyczyść pole" Command="{Binding ClearSearchTextCommand}">
                        <Image Source="/Views/pacjent/no.png" Width="10" Height="10" IsEnabled="False" />
                    </Button>
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="0,0,8,0"
                        SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding FilterTypes}"/>
                </DockPanel>
            </StackPanel>

            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->


            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->
            <syncfusion:ButtonAdv x:Name="Importj_Archiwum"
                    Grid.Column="5"
                    Click="ImportArchiwum_Click"
                    HorizontalAlignment="Center"
                    Height="45"
                    Label=" ➕ Import Archiwum"
                    VerticalAlignment="Top"
                    Width="220"
                    Background="#FF3F51B5"
                    Foreground="#FFFBFBFB"
                    FontSize="16" Margin="0,10,0,0" IconHeight="0" IconWidth="0"  >
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>

            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->
            <syncfusion:ButtonAdv x:Name="nowa_lista_do_faktur"
                    Grid.Column="6"
                    HorizontalAlignment="Center"
                    Height="45"
                    Label=" ➕ Nowa Listę do Faktury"
                    VerticalAlignment="Top"
                    Width="220"
                    Click="Nowa_Lista_Do_Faktur_Click"
                    Background="#FF009688"
                    Foreground="#FFFBFBFB"
                    FontSize="16" Margin="0,10,0,0" IconWidth="0" IconHeight="0"  >
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>

            <!-- DODANY PRZYCISK: Import z archiwum -->
            <Button Content="📦 Import Archiwum" 
                    Width="150" 
                    Height="40" 
                    Margin="10,5"
                    Background="#FF9800" 
                    Foreground="White" 
                    FontSize="14"
                    FontWeight="SemiBold"
                    Click="ImportArchiwum_Click"
                    ToolTip="Importuj listy badań z archiwum"/>
        </Grid>
        <Border Grid.Row="1" VerticalAlignment="Center" Height="624" HorizontalAlignment="Center" Width="1480" Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" CornerRadius="12,12,12,12" Padding="8,8,8,8" Margin="10,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- left column 1/4 -->
                    <ColumnDefinition Width="340"/>
                    <!-- right column 3/4 -->
                    <ColumnDefinition Width="500*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: list of lists (ListyBadan) -->
                <Border Grid.Column="0" Margin="10,10,10,10" BorderThickness="1,1,1,1" CornerRadius="8,8,8,8" Padding="6,6,6,6" HorizontalAlignment="Left" Grid.ColumnSpan="2" BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}">
                    <StackPanel Width="328" HorizontalAlignment="Left">
                        <TextBlock Text="Listy do Faktur" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" HorizontalAlignment="Left" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />

                        <!-- Zastąpienie DataGrid na SfDataGrid -->
                        <syncfusion:SfDataGrid 
                            x:Name="dgListyBadan"
                            ItemsSource="{Binding ListyBadan}" 
                            SelectedItem="{Binding SelectedLista, Mode=TwoWay}"
                            AutoGenerateColumns="False"
                            AllowEditing="False"
                            AllowSorting="True"
                            AllowFiltering="False"
                            SelectionMode="Single"
                            SelectionUnit="Row"
                            RowHeight="75"
                            HeaderRowHeight="30"
                            ColumnSizer="Star"
                            GridLinesVisibility="Horizontal"
                            Width="320" 
                            Height="570"
                            SortColumnsChanging="DgListyBadan_SortColumnsChanging" 
                            FontSize="11" Background="{x:Null}" BorderBrush="{x:Null}" RowHoverHighlightingBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" RowSelectionBrush="#FF024D98" CurrentCellBorderBrush="{x:Null}">

                            <syncfusion:SfDataGrid.SortColumnDescriptions>
                                <syncfusion:SortColumnDescription 
                                    ColumnName="Identyfikator" 
                                    SortDirection="Descending"/>
                            </syncfusion:SfDataGrid.SortColumnDescriptions>

                            <syncfusion:SfDataGrid.Columns>
                                <!--Sort dla kolumny ID  -->

                                <!-- Kolumna Akcje (Usuń) -->
                                <!--
                            <syncfusion:GridTemplateColumn 
                                HeaderText="Akcje" 
                                Width="40"
                                AllowSorting="False"
                                AllowFiltering="False">
                                <syncfusion:GridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button 
                                            Content="🗑"
                                            ToolTip="Usuń listę"
                                            Width="30" 
                                            Height="30"
                                            Background="#FFFF4444" 
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.DeleteListaCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Click="DeleteList_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#FFFF4444"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FFCC0000"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </syncfusion:GridTemplateColumn.CellTemplate>
                            </syncfusion:GridTemplateColumn>
                            -->
                                <!-- Kolumna Identyfikator (ID) -->
                                <syncfusion:GridTextColumn 
                                    MappingName="Identyfikator" 
                                    HeaderText="ID" 
                                    Width="30" 
                                    IsReadOnly="True"
                                    TextAlignment="Center" 
                                    AllowEditing="True" 
                                    SortMode="Value" 
                                    ShowToolTip="False"/>
                                <!-- Kolumna Nazwa + Faktura Info - sortowanie po FK_Numer -->
                                <syncfusion:GridTextColumn
                                    MappingName="FK_Numer"
                                    HeaderText="Lista" 
                                    Width="275"
                                    IsReadOnly="True"
                                    DisplayBinding="{Binding Numer}" HorizontalHeaderContentAlignment="Center" Padding="3,0,3,-3" TextWrapping="Wrap">
                                    <syncfusion:GridTextColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="5">
                                                <TextBlock 
                                                    Text="{Binding Nazwa}" 
                                                    TextWrapping="Wrap" 
                                                    FontWeight="SemiBold"
                                                    FontSize="12" Foreground="White"/>
                                                <TextBlock 
                                                    Text="{Binding FakturaInfo}" 
                                                    TextWrapping="Wrap" 
                                                    FontSize="10"
                                                    Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                                    Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.CellTemplate>
                                </syncfusion:GridTextColumn>

                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>
                    </StackPanel>
                </Border>

                <!-- RIGHT: placeholder for dynamic detail/edit views -->
                <ContentControl x:Name="RightContent" Grid.Column="1" Margin="10,6,0,6" VerticalAlignment="Top" Background="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" />
            </Grid>

        </Border>

        <!-- Main content: Row 1 with two columns -->

    </Grid>
</UserControl>
