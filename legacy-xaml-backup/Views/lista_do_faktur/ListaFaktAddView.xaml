<UserControl
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:ASMED.WPF.ViewModels.ListaDoFaktur"
 xmlns:local="clr-namespace:ASMED.WPF.Views.lista_do_faktur"
 xmlns:syncfusionskin ="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF" xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.WPF"
 xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:syncfusion1="http://schemas.syncfusion.com/wpf" mc:Ignorable="av" x:Class="ASMED.WPF.Views.lista_do_faktur.ListaFaktAddView"
 syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=Windows11Light}"
     Width="Auto"
     Height="Auto"
     VerticalAlignment="Stretch"
     MinWidth="1100" MaxWidth="1800">

    <UserControl.DataContext>
        <vm:ListaFaktAddViewModel />
    </UserControl.DataContext>

    <!-- ✅ NOWY: Zasoby lokalne -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Padding="5,5,5,5" CornerRadius="20,20,20,20" VerticalAlignment="Top">

        <Grid Height="706" Width="1521">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="110" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Grid x:Name="Grid_0_Firma_Faktura" HorizontalAlignment="Center" VerticalAlignment="Top"
                MaxWidth="1500" MinWidth="1100"
                Width="1490" Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="410"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="235"/>
                    <ColumnDefinition Width="16*" />
                    <ColumnDefinition/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>

                <!-- Pole Firma: TextBox + przycisk otwierający dialog. ListBox usunięty. -->
                <StackPanel x:Name="S_Firma" Grid.Column="1" HorizontalAlignment="Center" Width="410">
                    <TextBlock Text="Firma:" FontSize="12" FontWeight="Bold" Margin="0,0,0,4" HorizontalAlignment="Left" Height="0"/>
                    <DockPanel Width="405" HorizontalAlignment="Left">
                        <TextBox
                            x:Name="FirmaText"
                            Width="330"
                            Height="45"
                            FontSize="18"
                            TextWrapping="Wrap"
                            Text="{Binding WybranaFirma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False" Margin="0,10,0,0" />
                        <Button Content="..." Width="50" Height="45" DockPanel.Dock="Right" Margin="6,10,0,0" Click="OpenFirmaDialog_Click" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <!-- Ukryte pole trzymające ID wybranej firmy (można ustawić Visibility=Visible dla debugowania) -->
                    <TextBlock Text="{Binding SelectedFirmaId}" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="NR_Faktury_Txt" Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left" Width="130" Height="56">
                    <TextBlock Text="Nr. Faktury:" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Left" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                    <TextBox 
                        x:Name="NumerFakturyTextBox" 
                        Width="125" 
                        Height="30" 
                        FontSize="18" 
                        Text="{Binding NumerFaktury, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel x:Name="Data_Wystawienia_Txt" Grid.Column="3" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left" Width="125" Height="56">
                    <TextBlock Text="Data Wystawienia:" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Left" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                    <DatePicker 
                        x:Name="DataWystawieniaPicker" 
                        Width="120" 
                        Height="30" 
                        SelectedDate="{Binding DataWystawienia, Mode=TwoWay}" 
                        HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel x:Name="Suma_Netto_Txt" Grid.Column="4" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left" Width="90" Height="56">
                    <TextBlock Text="Suma Brutto:" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Left" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                    <TextBox 
                        x:Name="SumaBruttoTextBox" 
                        Width="90" 
                        Height="30" 
                        FontSize="18" 
                        Text="{Binding SumaBrutto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel x:Name="Uwagi_Txt" Grid.Column="5" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left" Width="65" Height="56">
                    <TextBlock Text="Uwagi:" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Left" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                    <TextBox 
                        x:Name="UwagiTextBox" 
                        Width="65" 
                        Height="30" 
                        Text="{Binding Uwagi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel x:Name="S_Email" Grid.Column="6" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Width="233" Height="56">
                    <TextBlock Text="e-mail" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Left" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                    <TextBox 
                        x:Name="FKemail" 
                        Width="231" 
                        Height="30" 
                        Text="{Binding FKemail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        HorizontalAlignment="Left" FontFamily="Arial Narrow" />
                </StackPanel>

                <StackPanel Grid.Column="7" HorizontalAlignment="Center" Orientation="Vertical" VerticalAlignment="Center" Height="50" Width="150">
                    <TextBlock Text="Cennik:" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Left" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                    <ComboBox x:Name="Cennik_ComboBox" 
                        Width="150" 
                        Height="30"
                        ItemsSource="{Binding StatusOptions}" 
                        SelectedItem="{Binding SelectedCennik, Mode=TwoWay}">
                        <ComboBox.ToolTip>
                            <ToolTip Content="Wybierz Cennik Do faktury"/>
                        </ComboBox.ToolTip>
                    </ComboBox>
                </StackPanel>


                <StackPanel x:Name="Pusty_Spacer_2" Grid.Column="8" HorizontalAlignment="Center" Width="34"/>


                <!-- Przycisk otwierający okno z listą do faktur -->
                <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->
                <syncfusion1:ButtonAdv x:Name="ListaDoFaktur_powrot"
                    Grid.Column="9"
                    HorizontalAlignment="Center"
                    Height="44"
                    Label="&lt;&lt;&lt;&lt; Listy Do Faktur  &lt;&lt;"
                    VerticalAlignment="Center"
                    Width="220"
                    Background="#FF009688"
                    Foreground="#FFFBFBFB"
                    FontSize="16" 
                    Click="OpenListaDoFaktur_Click" IconWidth="0" IconHeight="0">
                    <syncfusion1:ButtonAdv.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                    </syncfusion1:ButtonAdv.BorderBrush>
                    <syncfusion1:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion1:ButtonAdv.IconTemplate>
                </syncfusion1:ButtonAdv>

            </Grid>
            <!-- dane badania -->
            <Grid x:Name="Grid_1_Badanie" Grid.Row="1" 
                MaxWidth="1500" MinWidth="1100" Height="115" VerticalAlignment="Top" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <!--1- Imie -->
                    <ColumnDefinition Width="160"/>
                    <!--2- Nazwisko -->
                    <ColumnDefinition Width="105"/>
                    <!--3- Ksiazeczka-Urlop-Typ-->
                    <ColumnDefinition Width="135"/>
                    <!--4- S_Data Badania - S_Data Waznosci -->
                    <ColumnDefinition Width="130"/>
                    <!--5- S_Wynik_S_Nr_Ksiegi-->
                    <ColumnDefinition Width="88"/>
                    <!--6- S_Badanie-->
                    <ColumnDefinition Width="88"/>
                    <!--7- S_Larynggolog-->
                    <ColumnDefinition Width="88"/>
                    <!--8- S_Okulista-->
                    <ColumnDefinition Width="88"/>
                    <!--9- S_Ksiazeczka-->
                    <ColumnDefinition Width="88"/>
                    <!--10- S_Lipitogram-->
                    <ColumnDefinition Width="88"/>
                    <!--11- S_EKG-->
                    <ColumnDefinition Width="88"/>
                    <!--12- S_Urlop-->
                    <ColumnDefinition Width="88"/>
                    <!--13- S_Inne-->
                    <ColumnDefinition Width="88"/>
                    <!--14- S_Suma-->
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,-16,0" Height="105" VerticalAlignment="Top" Grid.ColumnSpan="15">
                    <StackPanel x:Name="S_Imie" Width="150" HorizontalAlignment="Left">
                        <TextBlock Margin="15,0,0,5" Width="150.3" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"><Run Text="Imię/imiona"/><Run Text=" *"/></TextBlock>
                        <syncfusion1:SfTextBoxExt x:Name="S_Imie_wybor"
                            Width="149"
                            Height="80"
                            Watermark="* Wpisz imię"
                            FontSize="18"
                            TextWrapping="Wrap"
                            AutoCompleteSource="{Binding ImionaItems}"
                            AutoCompleteMode="SuggestAppend"
                            TextHighlightMode="FirstOccurrence"
                            HighlightedTextColor="Red"
                            SearchItemPath="."
                            SuggestionBoxPlacement="Bottom"
                            MaxDropDownHeight="300"
                            Text="{Binding WybraneImie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="S_Nazwisko" Width="150" HorizontalAlignment="Left" Margin="158,0,0,0">
                        <TextBlock Margin="0,0,0,5" Width="140" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" ><Run Text="Nazwisko"/><Run Language="pl-pl" Text=" *"/></TextBlock>
                        <syncfusion1:SfTextBoxExt x:Name="___S_Nazwisko_wybor"
                            Width="150"
                            Height="80"
                            TextWrapping="Wrap"
                            Watermark="* Wpisz nazwisko"
                            FontSize="18"
                            AutoCompleteSource="{Binding NazwiskaItems}"
                            AutoCompleteMode="SuggestAppend"
                            TextHighlightMode="FirstOccurrence"
                            HighlightedTextColor="Red"
                            SearchItemPath="."
                            SuggestionBoxPlacement="Bottom"
                            MaxDropDownHeight="300"
                            Text="{Binding WybraneNazwisko, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Width="100" VerticalAlignment="Center" Margin="315,0,0,0" Height="96">
                        <CheckBox Content="Książeczka"
                            Height="20" Width="100"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="0,0,0,2"
                            IsChecked="{Binding IsKsiazeczkaChecked, Mode=TwoWay}" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />

                        <CheckBox Content="Urlop"
                            Width="80" Height="20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="0,0,0,2"
                            IsChecked="{Binding IsUrlopChecked, Mode=TwoWay}" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />

                        <StackPanel Width="85" Height="50" HorizontalAlignment="Left">
                            <TextBlock 
                                FontSize="12" 
                                VerticalAlignment="Bottom" 
                                Height="20" Width="80" 
                                HorizontalAlignment="Left"
                                Margin="0,0,0,3" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"><Run Text="Typ badania"/></TextBlock>
                            <TextBox 
                                Text="{Binding TypBadania, UpdateSourceTrigger=PropertyChanged}"
                                Width="80" Height="26" 
                                HorizontalAlignment="Left"  />
                        </StackPanel>

                    </StackPanel>
                    <StackPanel x:Name="S_DataBadania_S_DataWaznosci" Width="130" HorizontalAlignment="Left" Margin="420,0,0,0" VerticalAlignment="Top" Height="100">
                        <StackPanel Orientation="Vertical" Width="130" HorizontalAlignment="Left">
                            <TextBlock FontSize="10" Width="100" HorizontalAlignment="Left" Margin="0,0,0,5" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"><Run Text="Data badania"/></TextBlock>
                            <DatePicker SelectedDate="{Binding DataBadania, Mode=TwoWay}" Width="125" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Width="130" HorizontalAlignment="Left" Margin="0,4,0,0" VerticalAlignment="Top">
                            <TextBlock FontSize="10" Width="100" HorizontalAlignment="Left" Margin="0,0,0,5" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"><Run Text="Data ważności"/></TextBlock>
                            <DatePicker SelectedDate="{Binding DataWaznosci, Mode=TwoWay}" Width="125" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="S_Wynik_S_Nr_Ksiegi" Width="125" HorizontalAlignment="Left" Margin="560,0,0,0" VerticalAlignment="Top" Height="100">
                        <StackPanel Orientation="Vertical" Width="125" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="Wynik" FontSize="10" Margin="0,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <ComboBox ItemsSource="{Binding WynikOptions}" SelectedItem="{Binding SelectedWynik, Mode=TwoWay}" Width="120" Height="28" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="Nr Księgi" FontSize="10" Margin="0,6,0,7" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <TextBox 
                                Text="{Binding NrKsiegi, Mode=TwoWay}" 
                                Width="120" Height="25" 
                                HorizontalAlignment="Left"  />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="S_Badanie" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="690,0,0,0" Width="83">
                        <TextBlock Text="Badanie" 
                            FontSize="12" Height="16" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                        <TextBlock x:Name="lblBasicPriceList" 
                            Text="{Binding PriceBasicText}" 
                            FontSize="11"
                            Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Margin="0,5,0,6" Height="15" 
                            HorizontalAlignment="Center"/>
                        <!--
                    <TextBox x:Name="txtBasicPrice" FontSize="16" FontWeight="Bold"
                            Height="25" 
                            TextChanged="PriceTextBox_TextChanged" Margin="0,0,0,6" 
                             HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Width="77"/>
 -->
                        <TextBox x:Name="txtBasicPrice"
                            FontSize="16"
                            FontWeight="Bold"
                            Height="25"
                            Width="77"
                            Text="{Binding EditablePriceBasic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="PriceTextBox_TextChanged"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"/>

                        <Button x:Name="btnBasic" Content="✗ NIEAKTYWNA" Height="25"
                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                            Click="ToggleExamination_Click" Tag="Basic" 
                            Width="77" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </StackPanel>

                    <StackPanel x:Name="S_Laryngolog" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="773,0,0,0">
                        <TextBlock Text="Laryngolog" 
                            FontSize="12" 
                            Width="82" Height="16" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                        <TextBlock x:Name="lblLaryngologistPriceList" 
                            Text="{Binding PriceLaryngologistText}" FontSize="11"
                            Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Margin="0,5,0,6" Height="15" 
                            HorizontalAlignment="Center"/>

                        <TextBox x:Name="txtLaryngologistPrice" FontSize="16" FontWeight="Bold"
                            Height="25"
                            Text="{Binding EditablePriceLaryngologist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="PriceTextBox_TextChanged" 
                            Width="77" Margin="0,0,0,7"/>

                        <Button x:Name="btnLaryngologist" Content="✗ NIEAKTYWNE" Height="25"
                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="Laryngologist" Width="77" VerticalAlignment="Top"/>
                    </StackPanel>

                    <StackPanel x:Name="S_Okulista" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="861,0,0,0">
                        <TextBlock Text="Okulista" 
                            FontSize="12" 
                            Width="82" Height="16" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                        <TextBlock x:Name="lblOphthalmologistPriceList" Text="{Binding PriceOphthalmologistText}" FontSize="11"
                            Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Height="15" Margin="0,5,0,6" HorizontalAlignment="Center"/>

                        <TextBox x:Name="txtOphthalmologistPrice" FontSize="16" FontWeight="Bold"
                            Height="25"
                            Text="{Binding EditablePriceOphthalmologist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="PriceTextBox_TextChanged" Width="77" Margin="0,0,0,7"/>

                        <Button x:Name="btnOphthalmologist" Content="✗ NIEAKTYWNE" Height="25"
                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="Ophthalmologist" Width="77" VerticalAlignment="Top"/>
                    </StackPanel>

                    <StackPanel x:Name="S_Ksiazeczka" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="949,0,0,0">
                        <TextBlock Text="Książeczka" 
                            FontSize="12" 
                            Width="82" Height="16" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                        <TextBlock x:Name="lblSanitaryPriceList" Text="{Binding PriceSanitaryText}" FontSize="11"
                            Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Height="15" Margin="0,5,0,6" HorizontalAlignment="Center"/>

                        <TextBox x:Name="txtSanitaryPrice" FontSize="16" FontWeight="Bold"
                            Height="25"
                            Text="{Binding EditablePriceSanitary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="PriceTextBox_TextChanged" Width="77" Margin="0,0,0,7"/>

                        <Button x:Name="btnSanitary" Content="✗ NIEAKTYWNE" Height="25"
                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="Sanitary" Width="77" VerticalAlignment="Top"/>
                    </StackPanel>

                    <StackPanel x:Name="S_Lipitogram" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1037,0,0,0">
                        <TextBlock Text="Lipidogram" 
                            FontSize="12" 
                            Width="82" Height="16" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                        <TextBlock x:Name="lblLipidogramPriceList" Text="{Binding PriceLipidogramText}" FontSize="11"
                            Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Height="15" Margin="0,5,0,6" HorizontalAlignment="Center"/>

                        <TextBox x:Name="txtLipidogramPrice" FontSize="16" FontWeight="Bold"
                            Height="25"
                            Text="{Binding EditablePriceLipidogram, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="PriceTextBox_TextChanged" Width="77" Margin="0,0,0,7"/>

                        <Button x:Name="btnLipidogram" Content="✗ NIEAKTYWNE" Height="25"
                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="Lipidogram" Width="77" VerticalAlignment="Top"/>
                    </StackPanel>
                    <StackPanel x:Name="S_EKG" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1125,0,0,0">
                        <TextBlock Text="EKG" 
                            FontSize="12" 
                            Width="82" Height="16" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                        <TextBlock x:Name="lblEKGPriceList" Text="{Binding PriceEKGText}" FontSize="11"
                            Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Height="15" Margin="0,5,0,6" HorizontalAlignment="Center"/>

                        <TextBox x:Name="txtEKGPrice" FontSize="16" FontWeight="Bold"
                            Height="25"
                            Text="{Binding EditablePriceEKG, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="PriceTextBox_TextChanged" Width="77" Margin="0,0,0,7"/>

                        <Button x:Name="btnEKG" Content="✗ NIEAKTYWNE" Height="25"
                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="EKG" Width="77" VerticalAlignment="Top"/>
                    </StackPanel>

                    <StackPanel x:Name="S_Urlop" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1213,0,0,0">
                        <TextBlock Text="Urlop" 
                            FontSize="12" 
                            Width="82" Height="16" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                        <TextBlock x:Name="lblHealthClinicPriceList" Text="{Binding PriceHealthClinicText}" FontSize="11"
                            Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Height="15" Margin="0,5,0,6" HorizontalAlignment="Center"/>

                        <TextBox x:Name="txtHealthClinicPrice" FontSize="16" FontWeight="Bold"
                            Height="25"
                            Text="{Binding EditablePriceHealthClinic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="PriceTextBox_TextChanged" Width="77" Margin="0,0,0,7"/>

                        <Button x:Name="btnHealthClinic" Content="✗ NIEAKTYWNE" Height="25"
                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="HealthClinic" Width="77" VerticalAlignment="Top"/>
                    </StackPanel>

                    <StackPanel x:Name="S_Inne" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1301,0,0,0">
                        <TextBlock Text="Inne" 
                            FontSize="12" 
                            Width="82" Height="16" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>

                        <TextBlock x:Name="lblOtherPriceList" 
                            Text="{Binding PriceLipidogramText}" 
                            FontSize="11" Height="15" Margin="0,5,0,6" 
                            HorizontalAlignment="Center" 
                            Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}"/>

                        <TextBox x:Name="txtOtherPrice" FontSize="16" 
                            FontWeight="Bold" Height="25"
                            Text="{Binding EditablePriceOther, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="PriceTextBox_TextChanged" 
                            Width="77" Margin="0,0,0,7"/>

                        <Button x:Name="btnOther" Content="✗ NIEAKTYWNE" Height="25"
                            Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="Other" Width="77" VerticalAlignment="Top"/>
                    </StackPanel>

                    <StackPanel x:Name="S_Suma" HorizontalAlignment="Left" 
                        VerticalAlignment="Top" Margin="1399,0,0,0">
                        <TextBlock Text="SUMA:" 
                            FontSize="12" 
                            Width="82" Height="16" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Center" Foreground="#FF34F952"/>

                        <TextBlock x:Name="lblTotalPrice" Text="" 
                            FontSize="16" FontWeight="Bold" 
                            Foreground="DarkGreen" 
                            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" 
                            Width="80" HorizontalAlignment="Center" 
                            Height="20" Margin="0,0,0,5"/>

                        <Button 
                            x:Name="Wyczysc" 
                            Width="80" Height="25"
                            FontSize="13"
                            Content="Wyczyść"
                            Foreground="#FFFFFF" Background="#FF7E037F"
                            Command="{Binding ClearGridCommand}"
                            Margin="0,0,0,8" BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>

                        <Button 
                            x:Name="Dodaj_Do_Listy_Kopiuj" 
                            Width="84" Height="25"
                            FontSize="13"
                            Content="+/+ Lista"
                            Foreground="#FFFFFF" Background="#FF047F28"
                            Command="{Binding SaveSelectedAssignedBadanieCommand}"
                            Margin="0,0,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <Border Grid.Row="2" VerticalAlignment="Top" Background="#FF6D6D6D" Margin="10,0,20,0" Padding="8,8,8,8" CornerRadius="12,12,12,12" BorderThickness="1,1,1,1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">


                <Grid x:Name="Grid_2_Badania_bez_Listy_Lista_do_Faktury" Height="448">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="435"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
