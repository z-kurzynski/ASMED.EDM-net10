<Window x:Class="ASMED.WPF.Views.PacjentHistoriaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=Windows11Light}"
        Title="Historia Skierowań i Badań Pacjenta" 
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F9FA" VerticalAlignment="Top">

	<Window.Resources>
		<Style TargetType="{x:Type syncfusion:GridHeaderCellControl}">
			<Setter Property="Background" Value="#FF1976D2"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>
	</Window.Resources>

	<Grid Margin="10,10,10,10" Width="850">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Nag��wek z danymi pacjenta -->
			<RowDefinition Height="*"/>
			<!-- G��wna zawarto�� -->
			<RowDefinition Height="Auto"/>
			<!-- Przyciski -->
		</Grid.RowDefinitions>

		<!-- NAG��WEK: Dane pacjenta -->
		<Border Grid.Row="0" Background="#1976D2" CornerRadius="5" Padding="15" Margin="0,0,0,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/> <!-- ✅ NOWA LINIA -->
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0" Grid.Column="0" Text="Imię i Nazwisko:" FontWeight="Bold" Foreground="White" Margin="0,0,10,5"/>
				<TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtImieNazwisko" Text="" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,20,5"/>

				<TextBlock Grid.Row="0" Grid.Column="2" Text="PESEL:" FontWeight="Bold" Foreground="White" Margin="0,0,10,5"/>
				<TextBlock Grid.Row="0" Grid.Column="3" x:Name="txtPesel" Text="" Foreground="White" FontSize="16" Margin="0,0,0,5"/>

				<TextBlock Grid.Row="1" Grid.Column="0" Text="Firma:" FontWeight="Bold" Foreground="White" Margin="0,0,10,5"/>
				<TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtFirma" Text="" Foreground="White" FontSize="14" Margin="0,0,0,5"/>

				<!-- ✅ NOWA LINIA: Liczba skierowań -->
				<TextBlock Grid.Row="2" Grid.Column="0" Text="Liczba kart badań:" FontWeight="Bold" Foreground="White" Margin="0,0,10,0"/>
				<TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtLiczbaSkierowan" Text="" Foreground="#FFD700" FontSize="16" FontWeight="Bold"/>
			</Grid>
		</Border>

		<!-- G��WNA ZAWARTO��: Dwie kolumny -->
		<Grid Grid.Row="1" HorizontalAlignment="Left" Width="898">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="379*"/>
				<ColumnDefinition Width="5"/>
				<ColumnDefinition Width="514*"/>
			</Grid.ColumnDefinitions>

			<!-- LEWA KOLUMNA: Lista Skierowa� -->

			<Border Grid.Column="0" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                    Padding="5" Width="372" HorizontalAlignment="Left">
				<Grid Width="350" HorizontalAlignment="Left">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Text="KARTY BADAŃ" FontSize="16" FontWeight="Bold" 
                               Foreground="#1976D2" Margin="5,5,5,10" HorizontalAlignment="Center"/>

					<syncfusion:SfDataGrid x:Name="gridSkierowania"
                        AutoGenerateColumns="False"
                        AllowSorting="True"
                        AllowFiltering="False"
                        SelectionMode="Single"
                        RowHeight="35"
                        FontSize="14"
                        AlternationCount="2"
                        ColumnSizer="Star" Margin="0,36,0,0" Grid.RowSpan="2" Width="349">

						<syncfusion:SfDataGrid.Columns>
							<syncfusion:GridTextColumn MappingName="Lp" 
                                                       HeaderText="Lp" 
                                                       Width="40" 
                                                       TextAlignment="Center" 
                                                       IsReadOnly="True"/>
							
							<syncfusion:GridTextColumn MappingName="B_TypBadania"
						   HeaderText="Typ"
						   Width="35"
						   TextAlignment="Center"/>
							
							<syncfusion:GridTextColumn MappingName="B_DataSkierowania" 
                                                       HeaderText="Data Skier." 
                                                       Width="100" 
                                                       TextAlignment="Center">
								<syncfusion:GridTextColumn.DisplayBinding>
									<Binding Path="B_DataSkierowania" StringFormat="dd-MM-yyyy"/>
								</syncfusion:GridTextColumn.DisplayBinding>
							</syncfusion:GridTextColumn>

							<syncfusion:GridTextColumn MappingName="B_ID"
                                                       HeaderText="ID"
                                                       Width="40"
                                                       TextAlignment="Center"/>	
                            
							<syncfusion:GridTextColumn MappingName="B_Comments" 
                                                       HeaderText="Uwagi" 
                                                       Width="110" TextWrapping="Wrap" 
													   Padding="5,7,0,0"/>
							
						</syncfusion:SfDataGrid.Columns>
					</syncfusion:SfDataGrid>
				</Grid>
			</Border>

			<!-- PRAWA KOLUMNA: Lista Wizyt/Badań -->
			<Border Grid.Column="2" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="5" HorizontalAlignment="Left" Width="459">
				<Grid HorizontalAlignment="Left">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Text="WIZYTY / BADANIA" FontSize="16" FontWeight="Bold" 
                               Foreground="#4CAF50" Margin="5,5,5,10" HorizontalAlignment="Center"/>

					<syncfusion:SfDataGrid x:Name="gridBadania"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        AllowSorting="True"
                        AllowFiltering="False"
                        SelectionMode="Single"
                        RowHeight="35"
                        FontSize="14"
                        AlternationCount="2"
                        ColumnSizer="Star">

						<syncfusion:SfDataGrid.Columns>
							<syncfusion:GridTextColumn MappingName="Lp" HeaderText="Lp" Width="30" TextAlignment="Center" IsReadOnly="True"/>
							<syncfusion:GridTextColumn MappingName="Bad_ID" HeaderText="ID" Width="30" TextAlignment="Center" IsHidden="True"/>
							<syncfusion:GridTextColumn MappingName="Bad_Typ" HeaderText="Typ" Width="35" TextAlignment="Center"/>
							<syncfusion:GridTextColumn MappingName="Bad_Data"
                                                       HeaderText="Data Od" 
                                                       Width="90" 
                                                       TextAlignment="Center">
								<syncfusion:GridTextColumn.DisplayBinding>
									<Binding Path="Bad_Data" StringFormat="dd-MM-yyyy"/>
								</syncfusion:GridTextColumn.DisplayBinding>
							</syncfusion:GridTextColumn>
							<syncfusion:GridTextColumn MappingName="Bad_Data_Do" 
                                                       HeaderText="Data Do" 
                                                       Width="90" TextAlignment="Center">
								<syncfusion:GridTextColumn.DisplayBinding>
									<Binding Path="Bad_Data_Do" StringFormat="dd-MM-yyyy"/>
								</syncfusion:GridTextColumn.DisplayBinding>
							</syncfusion:GridTextColumn>
							<syncfusion:GridTextColumn MappingName="Bad_Wynik" HeaderText="Wynik" Width="90" TextAlignment="Center"/>
							<syncfusion:GridTextColumn MappingName="Bad_Fakt" HeaderText="Nr Faktury" Width="90" Padding="5,0,0,0"/>
						</syncfusion:SfDataGrid.Columns>
					</syncfusion:SfDataGrid>
				</Grid>
			</Border>
		</Grid>

		<!-- PRZYCISKI -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
			<Button Content="Zamknij" Width="120" Height="35" 
                    Background="#1976D2" Foreground="White" 
                    FontSize="14" FontWeight="Bold"
                    Click="Zamknij_Click" Margin="0,0,10,0"/>
		</StackPanel>
	</Grid>
</Window>
