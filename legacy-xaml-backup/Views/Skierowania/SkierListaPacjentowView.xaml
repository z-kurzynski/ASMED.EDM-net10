<UserControl x:Class="ASMED.WPF.Views.SkierListaPacjentowView"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
    xmlns:converters="clr-namespace:ASMED.WPF.Converters"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:local="clr-namespace:ASMED.WPF.Views" 
    xmlns:syncfusionskin ="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av"
    syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=Windows11Light}"
    Height="Auto" 
             Width="auto" 
             VerticalAlignment="Top" 
             MaxWidth="1800" 
             MinWidth="1100" 
             Background="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}" 
             HorizontalAlignment="Left">

    <UserControl.Resources>
        <Style TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="{x:Type Path}" x:Key="SfDataGridHeaderIconStyle">
            <Setter Property="Fill" Value="Cyan"/>
        </Style>
        <Style TargetType="{x:Type syncfusion:FilterToggleButton}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="BorderBrush" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" VerticalAlignment="Top" 
              MaxWidth="1500" MinWidth="1100" Height="55">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="410"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" VerticalAlignment="Top" Height="46">
                <TextBlock Text="Wyszukaj Pacjenta" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel>
                    <TextBox x:Name="txtSearchPacjent" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="247" FontSize="14" />
                    <Button Width="32" Height="28" Margin="8,0,0,0" ToolTip="Wyczyść pole" Click="ClearSearch_Click">
                        <Image Source="/ASMED.WPF;component/Assets/no.png" Width="10" Height="10" />
                    </Button>
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="10,0,8,0"
                        SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding FilterTypes}" HorizontalAlignment="Left"/>
                </DockPanel>
            </StackPanel>
            <syncfusion:ButtonAdv x:Name="odswież"
                Grid.Column="2"
                Height="45"
                Label="🔃"
                Width="50"
                Background="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"
                Foreground="#FFFBFBFB" Margin="0,10,0,0" 
                Click="RefreshList_Click" HorizontalAlignment="Center" FontSize="22" VerticalAlignment="Center" IconHeight="0" IconWidth="0" >
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>
            <syncfusion:ButtonAdv
                Grid.Column="3"
                Height="45"
                Label="📥 Import z Email"
                VerticalAlignment="Top"
                Background="#FF9C27B0"
                Foreground="#FFFBFBFB"
                FontSize="14" Margin="8,10,2,0" 
                Command="{Binding OpenEmailImportCommand}" IconWidth="0" IconHeight="0">
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>
            <syncfusion:ButtonAdv x:Name="Dodaj_Skierowanie"
                Grid.Column="4"
                Height="45"
                Label="📑 Skierowania  PDF"
                VerticalAlignment="Top"
                Background="#FFFF5722"
                Foreground="#FFFBFBFB"
                FontSize="14" Margin="8,10,2,0"
                Command="{Binding OpenListaSkierowanCommand}" IconHeight="0" IconWidth="0">
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>

            <!-- Przycisk Wyjście -->




            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->
            <syncfusion:ButtonAdv x:Name="Wroc_do_Kart_Badan"
                Grid.Column="8"
                Height="45"
                VerticalAlignment="Top"
                Background="#FF3F51B5"
                Foreground="#FFFBFBFB"
                FontStyle="Normal"
                FontSize="16"
                Label= " ➡️ Lista Kart Badań ➡️ "
                Margin="5,10,5,0"
                Click="WrocLista_Click" IconHeight="0" IconWidth="0">
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>

            <!--  Command="{Binding OpenSkierPacjWoborCommand}"
            Click="DodajPacjenta_Click"-->
            <syncfusion:ButtonAdv x:Name="Dodaj_Pacjenta"
                    Grid.Column="7"
                    Height="45"
                    Label="🧑‍💼 Dodaj Pacjenta "
                    VerticalAlignment="Top"
                    Command="{Binding EditPatientNewCommand}"
                    Background="#FF009688"
                    Foreground="#FFFBFBFB"
                    FontStyle="Normal"
                    FontSize="16" Margin="5,10,5,0" IconHeight="0" IconWidth="0"  >
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>
            <syncfusion:ButtonAdv x:Name="rejestracja"
                Grid.Column="6"
                HorizontalAlignment="Center"
                Height="46"
                Label="📅 Rejestracja"
                VerticalAlignment="Top"
                Width="220"
                Background="#FF3F51B5"
                Foreground="#FFFBFBFB"
                FontSize="16"
                Click="Rejestracja_Click"
                IconHeight="0" 
                IconWidth="0" Margin="0,10,0,0" 
    >
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>




        </Grid>
        <!-- Lista skierowań -->
        <!-- ItemsSource="{Binding SkierowaniaFiltered}" -->

        <syncfusion:SfDataGrid x:Name="lista_pacjentów_ADD_karty_badań"
            Grid.Row="1"
            AutoGenerateColumns="False"
            LiveDataUpdateMode="AllowChildViewUpdate"
            ItemsSource="{Binding PacjenciFiltered}"
            AlternationCount="2"
            RowHeight="40"
            ColumnSizer="Star"
            FontSize="17"
            AllowFiltering="True"
            AllowSorting="True"
            SelectionMode="Single"
            SelectionUnit="Row"
            FontFamily="Arial Narrow"
            Padding="2,2,2,2"
            MaxWidth="1500" MinWidth="1100"
            Margin="10,0,10,30" RowSelectionBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" 
            CurrentCellBorderBrush="{x:Null}" OpacityMask="#FFFFFDFD" VerticalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">




            <!--Tabela z danymi pacjentów-->


            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="P_ID" HeaderText="Num." Width="50" IsReadOnly="True" TextAlignment="Center" />
                <syncfusion:GridTextColumn MappingName="LineNumber"
                                           HeaderText="Lp." 
                                           Width="50" 
                                           IsReadOnly="True" 
                                           IsCaseSensitiveFilterRow="True" 
                                           IsHidden="False" 
                                           TextAlignment="Center" />

                <syncfusion:GridTextColumn MappingName="FirstName" 
                                           HeaderText="Imię" Width="120" 
                                           Padding="5,0,0,0" TextWrapping="Wrap" />
                <syncfusion:GridTextColumn MappingName="LastName" 
                                           HeaderText="Nazwisko" 
                                           Width="200" 
                                           Padding="5,0,0,0" 
                                           AllowEditing="False" 
                                           IsReadOnly="True"
                                           TextWrapping="Wrap" />

                <syncfusion:GridTextColumn MappingName="PESEL" 
                                           HeaderText="PESEL" 
                                           Width="120" 
                                           HorizontalHeaderContentAlignment="Center" 
                                           TextAlignment="Center"/>
                <syncfusion:GridTextColumn MappingName="Company" HeaderText="Firma" Padding="5,0,0,0" TextWrapping="Wrap">
                </syncfusion:GridTextColumn>

                <syncfusion:GridTemplateColumn HeaderText="Karta Bad" Width="80" 
                                               AllowSorting="False" 
                                               AllowFiltering="False">

                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="35" Width="78" Background="#4CAF50" 
                                        Foreground="White" ToolTip="Dodaj Kartę Badań"
                                        Command="{Binding DataContext.OpenReferralCommand, 
                                        RelativeSource={RelativeSource AncestorType=syncfusion:SfDataGrid}}"
                                        CommandParameter="{Binding}">
                                <TextBlock Text="📝 nowa" FontSize="16" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <!-- NOWY: Przycisk Historia z licznikiem -->
                <syncfusion:GridTemplateColumn HeaderText="Historia" Width="80" 
                                               AllowSorting="False" 
                                               AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Background="{x:Null}">
                                <Button Height="35" Width="78" Background="#FF5722" 
                                        Foreground="White" ToolTip="Historia badań pacjenta"
                                        Command="{Binding DataContext.OpenHistoriaCommand, 
                                        RelativeSource={RelativeSource AncestorType=syncfusion:SfDataGrid}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,0" Width="57" Height="35">
                                        <TextBlock Text="📊 " FontSize="16" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LiczbaKartBadan}" 
                                               Foreground="White" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn HeaderText="Edycja" Width="60" ColumnSizer="Auto" AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="35" Width="57" Background="#1976D2" Foreground="White" ToolTip="Edytuj kartotekę"
                                        Command="{Binding DataContext.EditPatientCommand, RelativeSource={RelativeSource AncestorType=syncfusion:SfDataGrid}}"
                                        CommandParameter="{Binding}">
                                <TextBlock Text="✏️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>


    </Grid>
</UserControl>
