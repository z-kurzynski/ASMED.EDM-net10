<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
    xmlns:converters="clr-namespace:ASMED.WPF.Converters"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:local="clr-namespace:ASMED.WPF.Views" 
    xmlns:syncfusionskin ="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av"
    syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=Windows11Light}"
    x:Class="ASMED.WPF.Views.SkierowaniaView"
    Width="Auto" 
    VerticalAlignment="Top" 
    MaxWidth="1800" 
    MinWidth="1100" 
    Height="720" Background="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="{x:Type Path}" x:Key="SfDataGridHeaderIconStyle">
            <Setter Property="Fill" Value="Cyan"/>
        </Style>
        <Style TargetType="{x:Type syncfusion:FilterToggleButton}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="BorderBrush" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Top" Margin="0,0,-3,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto" MaxHeight="60" />
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Wiersz 1: Wyszukiwarka i przyciski -->
        <Grid VerticalAlignment="Top" 
              MaxWidth="1500" MinWidth="1100" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="590"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Height="50">
                <TextBlock Text="Wyszukaj skierowanie:" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel Width="551" HorizontalAlignment="Left">
                    <TextBox x:Name="txtSearchPacjent" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="247" FontSize="14">
                        <TextBox.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="🔍 SMART FILTER:" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="• #XXXX - Szuka dokładnie ID skierowania"/>
                                    <TextBlock Text="  Przykład: #20 → znajdzie skierowanie ID=20" Margin="5,0,0,5"/>
                                    <TextBlock Text="• Bez # - Szuka w wybranym polu (All/Imię/Nazwisko)"/>
                                    <TextBlock Text="  Przykład: Kowalski → znajdzie wszystkie nazwiska" Margin="5,0,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <Button Width="32" Height="28" Margin="8,0,0,0" ToolTip="Wyczyść pole" Command="{Binding ClearSearchTextCommand}">
                        <Image Source="/Views/pacjent/no.png" Width="10" Height="10" />
                    </Button>
                    <!-- Filtr typu -->
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="5,0,8,0"
                        SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding FilterTypes}" HorizontalAlignment="Left"/>

                    <!-- NOWY: Filtr Okresu daty -->
                    <StackPanel Orientation="Vertical" Width="148" Margin="0,-18,0,0">
                        <TextBlock Text="Wyszukiwany Okres" FontSize="12" FontWeight="Bold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="Filtr_Okresu_Skier" Width="140" Height="28" FontSize="14"
                            SelectedItem="{Binding SelectedDateFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding DateFilterOptions}"
                            ToolTip="Filtr według okresu dat skierowania" HorizontalAlignment="Left" MaxDropDownHeight="2050"/>
                    </StackPanel>

                </DockPanel>
            </StackPanel>

            <!-- ✅ ZMIENIONE: Przycisk Rejestracja (zamiast ukrytego Dodaj Skierowanie) -->
            <syncfusion:ButtonAdv
                Grid.Column="5"
                HorizontalAlignment="Center"
                Height="46"
                Label="📅 Rejestracja"
                VerticalAlignment="Top"
                Width="220"
                Background="#FF3F51B5"
                Foreground="#FFFBFBFB"
                FontSize="16"
                Click="Rejestracja_Click"
                IconHeight="0" 
                IconWidth="0" 
                Margin="0,5,0,0">
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>

            <!-- Przycisk Dodaj Kartę Badań -->
            <syncfusion:ButtonAdv
                    Grid.Column="6"
                    HorizontalAlignment="Center"
                    Height="45"
                    Label="📄  Dodaj Kartę Badań"
                    VerticalAlignment="Top"
                    Width="220"
                    Command="{Binding OpenSkierPacjWoborCommand}"
                    Background="#FF009688"
                    Foreground="#FFFBFBFB"
                    FontSize="16" 
                    IconHeight="0" 
                    IconWidth="0" 
                    Margin="0,5,0,0">
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>
        </Grid>

        <!-- Wiersz 2: DatePickers dla "Wybrany okres" - widoczne tylko gdy wybrano tę opcję -->
        <StackPanel x:Name="Wybrany_Okres" Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,10"
                    Visibility="{Binding IsCustomDateRangeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Top">
            <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                <TextBlock Text="Data Od:" FontSize="12" FontWeight="Bold"/>
                <DatePicker Width="140" Height="28" SelectedDate="{Binding FilterDateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                <TextBlock Text="Data Do:" FontSize="12" FontWeight="Bold"/>
                <DatePicker Width="140" Height="28" SelectedDate="{Binding FilterDateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                <Button Content="Zastosuj filtr" Padding="8,4" Command="{Binding ApplyCustomDateFilterCommand}" 
                        Background="#FF1976D2" Foreground="White" BorderThickness="0" Height="28" Width="116"/>
            </StackPanel>
        </StackPanel>

        <!-- Wiersz 3: Lista skierowań -->
        <syncfusion:SfDataGrid x:Name="Lista_kart_Badań"
    Grid.Row="2"
    AutoGenerateColumns="False"
    ItemsSource="{Binding SkierowaniaFiltered}"
    LiveDataUpdateMode="AllowChildViewUpdate"
    AlternationCount="2"
    RowHeight="40"
    ColumnSizer="Star"
    FontSize="17"
    AllowFiltering="True"
    AllowSorting="True"
    SelectionMode="Single"
    SelectionUnit="Row"
    FontFamily="Arial Narrow"
    Padding="2,2,2,2"
    Margin="10,0,10,0" 
    RowSelectionBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" 
    MaxWidth="1500" MinWidth="1100"
    CurrentCellBorderBrush="{x:Null}" 
    OpacityMask="#FFFFFDFD" 
    Height="650" 
    VerticalAlignment="Top" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

            <!-- ✅ DODANE: Domyślne sortowanie malejące po kolumnie ID -->
            <syncfusion:SfDataGrid.SortColumnDescriptions>
                <syncfusion:SortColumnDescription ColumnName="Id" SortDirection="Descending"/>
            </syncfusion:SfDataGrid.SortColumnDescriptions>

            <syncfusion:SfDataGrid.Columns>

                <syncfusion:GridTextColumn MappingName="Id" 
                                           HeaderText="ID" Width="50" 
                                           IsReadOnly="True" 
                                           AllowSorting="True"
                                           TextAlignment="Center" 
                                           SortMode="Value" 
                                           ShowHeaderToolTip="False" />


                <syncfusion:GridTextColumn MappingName="Typ" 
                                           HeaderText="Typ" Width="40" 
                                           TextAlignment="Center" />
                <syncfusion:GridTextColumn MappingName="Imie" 
                                           HeaderText="Imię" Width="120" 
                                           Padding="5,0,0,0" />
                <syncfusion:GridTextColumn MappingName="Nazwisko" 
                                           HeaderText="Nazwisko" 
                                           Width="180" 
                                           Padding="5,0,0,0" 
                                           AllowEditing="False" 
                                           TextWrapping="Wrap" />
                <syncfusion:GridTextColumn MappingName="Pesel" 
                                           HeaderText="PESEL" Width="120" 
                                           Padding="3,0,0,0" ShowHeaderToolTip="True" 
                                           TextAlignment="Center" />
                <syncfusion:GridTextColumn MappingName="Firma" 
                                           HeaderText="Firma" 
                                           TextWrapping="Wrap" 
                                           Padding="5,0,0,0" />
                <syncfusion:GridTextColumn 
                    MappingName="Data" 
                    HeaderText="Data Skier." 
                    Width="100" 
                    HorizontalHeaderContentAlignment="Center" TextAlignment="Center">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="Data" StringFormat="dd-MM-yyyy"/>
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn 
                    MappingName="DataRej" 
                    HeaderText="Data Rej." 
                    Width="100" 
                    HorizontalHeaderContentAlignment="Center" 
                    TextAlignment="Center">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DataRej" StringFormat="dd-MM-yyyy"/>
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn 
                    MappingName="DataBad" 
                    HeaderText="Data Bad." 
                    Width="100" 
                    HorizontalHeaderContentAlignment="Center" 
                    TextAlignment="Center">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DataBad" StringFormat="dd-MM-yyyy"/>
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn 
                    MappingName="NumerFaktury" 
                    HeaderText="Faktura " 
                    Width="100" 
                    HorizontalHeaderContentAlignment="Center" 
                    TextAlignment="Center"  />

                <syncfusion:GridTemplateColumn 
                    HeaderText="Edycja" 
                    Width="60" 
                    ColumnSizer="Auto" 
                    AllowSorting="False" 
                    AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="35" Width="57" Background="#1976D2" Foreground="White" ToolTip="Edytuj Skierowanie"
                                        Command="{Binding DataContext.EditSkierowanieCommand, RelativeSource={RelativeSource AncestorType=syncfusion:SfDataGrid}}"
                                        CommandParameter="{Binding}">
                                <TextBlock Text="✏️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
