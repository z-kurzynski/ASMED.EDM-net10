                        <!-- ✅ SEKCJA 2: Adres i kontakt (Prawa_0) -->

                        <!-- Ulica -->

                        <!-- Kod pocztowy + Miejscowość -->

                        <!-- Telefon + Email -->

                        <!-- ✅ SEKCJA 3: PRZYCISKI AKCJI (przeniesione z Row 2) -->
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- ✅ COLUMN 2: FIRMA -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
        </Grid>
    </Grid>
</UserControl>
