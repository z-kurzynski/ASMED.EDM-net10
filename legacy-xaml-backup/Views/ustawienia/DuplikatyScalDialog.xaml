<Window
    x:Class="ASMED.WPF.Views.DuplikatyScalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Scalanie duplikatów"
    Width="700" Height="480"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Grid.Row="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"
                   Text="{Binding NaglowekText}" TextWrapping="Wrap" Foreground="#FFFBFBFB"/>

        <TextBlock Grid.Row="1" FontSize="12" Margin="0,0,0,10" Foreground="White" TextWrapping="Wrap"
                   Text="Wybierz rekord GŁÓWNY — pozostałe zostaną usunięte, a ich powiązania przepięte na wybrany rekord."/>

        <!-- Lista rekordów -->
        <ListView Grid.Row="2" x:Name="lvRekordy"
                  ItemsSource="{Binding Rekordy}"
                  SelectedItem="{Binding WybranyRekord, Mode=TwoWay}"
                  SelectionMode="Single"
                  Margin="0,0,0,10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,6" Margin="2"
                            BorderThickness="1" BorderBrush="#FFCCCCCC" CornerRadius="4"
                            Background="White">
                        <StackPanel>
                            <TextBlock Text="{Binding Display}" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Informacja o wybranym -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Główny rekord (ID):" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding WybranyIdText}" FontSize="14" Foreground="#FF1565C0"
                       FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Przyciski -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuluj" Width="100" Height="35" FontSize="13" Margin="0,0,10,0"
                    Click="Anuluj_Click" IsCancel="True"/>
            <Button x:Name="btnScal" Content="🔗 Scal duplikaty" Width="160" Height="35" FontSize="13"
                    FontWeight="Bold" Foreground="White" Background="#FF1565C0"
                    Click="Scal_Click" IsEnabled="{Binding CzyWybrano}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Padding="{TemplateBinding Padding}" CornerRadius="4"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
