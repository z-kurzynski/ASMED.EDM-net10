<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="ASMED.WPF.Views.NarzedziaView"
    Height="580" Width="Auto" VerticalAlignment="Top" MaxWidth="1800" MinWidth="1100" Background="#FFB9D1EA">

    <Grid Margin="10" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- KOLUMNA 0: WYSZUKIWANIE I SCALANIE DUPLIKATÓW     -->
        <!-- ═══════════════════════════════════════════════════ -->
        <GroupBox Header="🔍 Duplikaty — wyszukiwanie i scalanie"
                  Grid.Column="0" Grid.ColumnSpan="1"
                  Margin="10" Padding="10" Height="540"
                  Foreground="#FF1B3A5C"
                  BorderBrush="#FF1565C0" BorderThickness="2">
            <Grid x:Name="DuplikatyGrid">
                <Grid.DataContext>
                    <vm:DuplikatyViewModel/>
                </Grid.DataContext>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Wybór tabeli + Szukaj -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Tabela:" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="120" Height="28" FontSize="12"
                              ItemsSource="{Binding TabelaOptions}"
                              SelectedItem="{Binding SelectedTabela, Mode=TwoWay}"/>
                    <Button Content="🔍 Szukaj duplikatów" Margin="10,0,0,0"
                            Padding="10,5" FontSize="12" FontWeight="Bold"
                            Foreground="White" Background="#FF1565C0"
                            Cursor="Hand" Command="{Binding SzukajDuplikatowCommand}"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Padding="{TemplateBinding Padding}" CornerRadius="4"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF0D47A1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Status -->
                <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="11"
                           Foreground="#FF555555" Margin="0,0,0,6" TextWrapping="Wrap"/>

                <!-- Lista grup duplikatów -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding GrupyDuplikatow}"
                         SelectedItem="{Binding WybranaGrupa, Mode=TwoWay}"
                         SelectionMode="Single"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderBrush="#FFCCCCCC" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,4" Margin="1"
                                    BorderThickness="0,0,0,1" BorderBrush="#FFEEEEEE">
                                <TextBlock Text="{Binding Display}" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Przycisk scalania -->
                <Button Grid.Row="3" Content="🔗 Scal wybraną grupę"
                        Margin="0,8,0,0" Padding="10,8"
                        FontSize="12" FontWeight="Bold"
                        Foreground="White"
                        Cursor="Hand"
                        Command="{Binding ScalDuplikatyCommand}"
                        IsEnabled="{Binding CzyWybranoGrupe}"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FFFF6F00"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Padding="{TemplateBinding Padding}" CornerRadius="4"
                                                Background="{TemplateBinding Background}"
                                                Opacity="{TemplateBinding Opacity}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFE65100"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#FFCCCCCC"/>
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </GroupBox>

        <GroupBox Header="Narzędzia programistyczne" 
                  Grid.Column="1" 
                  Grid.ColumnSpan="1"
                  Margin="10,10,10,10" 
                  Padding="15">
            <TextBlock Text="Ta sekcja zostanie rozbudowana o dodatkowe narzędzia." 
                       FontSize="12" 
                       Foreground="#FF666666"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </GroupBox>

        <GroupBox Header="Narzędzia programistyczne" 
                  Grid.Column="2" 
                  Grid.ColumnSpan="1"
                  Margin="10,10,10,10" 
                  Padding="15">
            <TextBlock
        VerticalAlignment="Center" Text="Ta sekcja zostanie rozbudowana o dodatkowe narzędzia." TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="12" Foreground="#FF666666"/>
        </GroupBox>
        <GroupBox

        Padding="15" Margin="10,10,10,10" Header="Wyjątki formatowania tekstu" Grid.Column="3" Foreground="#FF382D0E" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" BorderThickness="3,3,3,3">

            <Grid

        >

                <Grid.RowDefinitions

        >

                    <RowDefinition

        Height="Auto"/>

                    <!-- Przyciski akcji -->
                    <!-- Formularz dodawania -->

                    <RowDefinition

        Height="*"/>

                    <!-- Lista wyj�tk�w -->

                    <RowDefinition

        Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- ??????????????????????????????????????????????????? -->
                <!-- FORMULARZ DODAWANIA WYJ�TKU -->
                <!-- ??????????????????????????????????????????????????? -->
                <!-- LISTA WYJ�TK�W (DataGrid) -->
                <!-- ??????????????????????????????????????????????????? -->
                <!-- PRZYCISKI AKCJI -->
                <!-- ??????????????????????????????????????????????????? -->

                <StackPanel

        Margin="0,0,0,15" Grid.Row="0">

                    <TextBlock

        Text="Dodaj nowy wyjątek:" Margin="0,0,0,10" FontSize="12" FontWeight="Bold"/>

                    <StackPanel

        Width="337" VerticalAlignment="Center" Orientation="Horizontal">

                        <StackPanel

        Width="100" Orientation="Vertical" HorizontalAlignment="Left">

                            <Label

        Content="Słwo:" FontSize="11"/>

                            <TextBox

        ToolTip="Wpisz słowo które ma być wyjątkiem (np. PKP, TVP, nr)" Text="{Binding NoweSlowo, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="12"/>

                        </StackPanel>

                        <StackPanel

        Width="100" Orientation="Vertical" HorizontalAlignment="Center">

                            <Label

        Content="Typ formatowania:" FontSize="11"/>

                            <ComboBox

        ToolTip="Wybierz jak ma by� formatowane: UPPERCASE, lowercase, Capitalize" SelectedItem="{Binding NowyFormatTyp}" Padding="5" Margin="10,0,0,0" ItemsSource="{Binding FormatTypyOptions}" FontSize="12"/>

                        </StackPanel>

                        <StackPanel

        Orientation="Vertical" Width="101">

                            <Label

        Content="Kategoria (opcjonalna):" FontSize="11"/>

                            <TextBox

        ToolTip="Np. firma, skr�t, przyimek (opcjonalne)" Text="{Binding NowaKategoria, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="10,0,0,0" FontSize="12"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- S�owo -->
                    <!-- Typ formatowania -->
                    <!-- Kategoria (opcjonalna) -->
                    <!-- Przycisk Dodaj -->

                    <Button

        Padding="10,8" Margin="0,15,0,0" FontSize="12" FontWeight="Bold" Foreground="White" Content="+ Dodaj wyjątek" Cursor="Hand" Command="{Binding DodajWyjatekCommand}" BorderThickness="0" Background="#FF4CAF50">

                        <Button.Style

        >

                            <Style

        TargetType="{x:Type Button}">

                                <Setter

        Property="Template">

                                    <Setter.Value

        >

                                        <ControlTemplate

        TargetType="{x:Type Button}">

                                            <Border

        Padding="{TemplateBinding Padding}" CornerRadius="4" Background="{TemplateBinding Background}">

                                                <ContentPresenter

        HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers

        >

                                    <Trigger

        Property="IsMouseOver" Value="True">

                                        <Setter

        Property="Background" Value="#FF45A049"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                </StackPanel>

                <!-- ??????????????????????????????????????????????????? -->

                <Border

        Grid.Row="1" Margin="0,0,0,15" CornerRadius="4" BorderThickness="1" BorderBrush="#FFCCCCCC">

                    <DataGrid

        SelectedItem="{Binding WybranyWyjatek}" SelectionMode="Single" ItemsSource="{Binding Wyjatki}" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="11" CanUserDeleteRows="False" CanUserAddRows="False" AutoGenerateColumns="False" AlternatingRowBackground="#FFF5F5F5">

                        <DataGrid.Columns

        >

                            <DataGridTextColumn

        Width="*" Header="Słowo" FontWeight="Bold" Binding="{Binding Slowo}"/>

                            <DataGridTextColumn

        Binding="{Binding FormatTyp}" Header="Typ" Width="100"/>

                            <DataGridTextColumn

        Binding="{Binding Kategoria}" Header="Kategoria" Width="100"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

                <!-- ??????????????????????????????????????????????????? -->

                <StackPanel

        Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Przycisk Od�wie� -->

                    <Button

        Padding="15,8" Margin="5" FontSize="12" Foreground="White" Content="Odswież" Cursor="Hand" Command="{Binding ZaladujWyjatkiCommand}" BorderThickness="0" Background="#FF2196F3">

                        <Button.Style

        >

                            <Style

        TargetType="{x:Type Button}">

                                <Setter

        Property="Template">

                                    <Setter.Value

        >

                                        <ControlTemplate

        TargetType="{x:Type Button}">

                                            <Border

        Padding="{TemplateBinding Padding}" CornerRadius="4" Background="{TemplateBinding Background}">

                                                <ContentPresenter

        HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers

        >

                                    <Trigger

        Property="IsMouseOver" Value="True">

                                        <Setter

        Property="Background" Value="#FF1976D2"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                    <!-- Przycisk Usu� -->

                    <Button

        Padding="15,8" Margin="5" FontSize="12" Foreground="White" Content="Usuń" Cursor="Hand" Command="{Binding UsunWyjatekCommand}" BorderThickness="0" Background="#FFF44336">

                        <Button.Style

        >

                            <Style

        TargetType="{x:Type Button}">

                                <Setter

        Property="Template">

                                    <Setter.Value

        >

                                        <ControlTemplate

        TargetType="{x:Type Button}">

                                            <Border

        Padding="{TemplateBinding Padding}" CornerRadius="4" Background="{TemplateBinding Background}">

                                                <ContentPresenter

        HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers

        >

                                    <Trigger

        Property="IsMouseOver" Value="True">

                                        <Setter

        Property="Background" Value="#FFD32F2F"/>

                                    </Trigger>

                                    <Trigger

        Property="IsEnabled" Value="False">

                                        <Setter

        Property="Background" Value="#FFCCCCCC"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                    <!-- Przycisk Zastosuj do Firm -->

                    <Button

        ToolTip="Stosuje reguły formatowania do WSZYSTKICH firm w bazie" Padding="15,8" Margin="5" FontSize="12" FontWeight="Bold" Foreground="White" Content="Zastosuj do firm" Cursor="Hand" Command="{Binding ZastosujDoFirmCommand}" BorderThickness="0" Background="#FFFF9800">

                        <Button.Style

        >

                            <Style

        TargetType="{x:Type Button}">

                                <Setter

        Property="Template">

                                    <Setter.Value

        >

                                        <ControlTemplate

        TargetType="{x:Type Button}">

                                            <Border

        Padding="{TemplateBinding Padding}" CornerRadius="4" Background="{TemplateBinding Background}">

                                                <ContentPresenter

        HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers

        >

                                    <Trigger

        Property="IsMouseOver" Value="True">

                                        <Setter

        Property="Background" Value="#FFF57C00"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                </StackPanel>

            </Grid>

        </GroupBox>
    </Grid>
</UserControl>
