<UserControl x:Class="ASMED.WPF.Views.UstawieniaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
    xmlns:local="clr-namespace:ASMED.WPF.Views"
    Height="Auto" Width="Auto" VerticalAlignment="Top" MaxWidth="1800" MinWidth="1100" Background="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}">

    <Grid Background="#FFFDFDFD" Margin="10" VerticalAlignment="Top">
        <TabControl BorderBrush="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}" Margin="1,1,1,1">
            <TabItem x:Name="configuration" Header="Konfiguracja" Background="#FF29EDF1">
                <local:KonfiguracjaView />
            </TabItem>
            <TabItem x:Name="price_lists" Header="Cenniki" Background="#FFF9F127">
                <local:CennikiView />
            </TabItem>
            <TabItem x:Name="medical_facility" Header="Dane Placowki">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="#FFDA11E6" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <local:DanePlacowkiView />
            </TabItem>
            <TabItem x:Name="users" Header="Uzytkownicy" BorderBrush="{x:Null}" Background="#FF09F34E">
                <local:UzytkownicyView />
            </TabItem>
            <TabItem x:Name="tools" Header="Narzędzia" BorderBrush="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}" BorderThickness="1,1,1,1">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="#FFF7AF0F" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <local:NarzedziaView Height="615" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
