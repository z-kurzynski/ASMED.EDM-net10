<Window x:Class="ASMED.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie - ASMED" 
        Height="500" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="White" 
            CornerRadius="15" 
            BorderBrush="#FF1976D2" 
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" 
                              ShadowDepth="5" 
                              Opacity="0.3"/>
        </Border.Effect>

        <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    Background="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}" 
                    CornerRadius="15,15,0,0" 
                    Padding="20">
                <StackPanel Orientation="Horizontal">
                    <Image Height="70" 
                           Width="130" 
                           Source="/Views/logo.png"
                           Stretch="Uniform"
                           Margin="20,0,0,0" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="ASMED MP" 
                            FontSize="36" 
                            FontWeight="Bold" 
                            Foreground="White" HorizontalAlignment="Center" 
                               />
                        <TextBlock Text="System dla medycyny pracy" 
                            FontSize="12" 
                            Foreground="#FFEEEEEE" HorizontalAlignment="Center" 
                               />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" 
                        Margin="40,30,40,20">
                <TextBlock Text="Zaloguj się" 
                           FontSize="20" 
                           FontWeight="SemiBold" 
                           Foreground="#FF333333" 
                           Margin="0,0,0,30"/>

                <TextBlock Text="Nazwa uzytkownika:" 
                           FontSize="12" 
                           Foreground="#FF666666" 
                           Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameTextBox" 
                         Height="35" 
                         FontSize="18" 
                         Padding="10,0"
                         BorderBrush="#FFCCCCCC"
                         BorderThickness="1"
                         Margin="0,0,0,20"
                         KeyDown="UsernameTextBox_KeyDown" VerticalAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF1976D2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="Haslo:" 
                           FontSize="12" 
                           Foreground="#FF666666" 
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" 
                             Height="35" 
                             FontSize="18" 
                             Padding="10,0"
                             BorderBrush="#FFCCCCCC"
                             BorderThickness="1"
                             KeyDown="PasswordBox_KeyDown" VerticalAlignment="Center">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF1976D2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <TextBlock x:Name="ErrorMessage" 
                           Foreground="Red" 
                           FontSize="11" 
                           TextWrapping="Wrap" 
                           Margin="0,10,0,0" 
                           Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="2" 
                    Background="#FFF5F5F5" 
                    CornerRadius="0,0,15,15" 
                    Padding="40,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Content="Zaloguj" 
                            Height="40" 
                            FontSize="14" 
                            FontWeight="SemiBold"
                            Background="#FF4CAF50" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            Click="LoginButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF4CAF50"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5" 
                                                    Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF45A049"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="2" 
                            Content="Anuluj" 
                            Height="40" 
                            FontSize="14"
                            Background="#FF607D8B" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            Click="CancelButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF607D8B"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5" 
                                                    Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF546E7A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
