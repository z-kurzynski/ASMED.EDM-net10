<Window x:Class="ASMED.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ASMED.WPF"
    xmlns:views="clr-namespace:ASMED.WPF.Views"
    xmlns:vm="clr-namespace:ASMED.WPF.ViewModels"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:syncfusionskin ="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF" 
    xmlns:vm1="clr-namespace:ASMED.WPF.ViewModels.Skierowania" 
    xmlns:views1="clr-namespace:ASMED.WPF.Views.lista_do_faktur"
    xmlns:vmL="clr-namespace:ASMED.WPF.ViewModels.ListaDoFaktur"
    xmlns:vmBadania="clr-namespace:ASMED.WPF.ViewModels.Badania"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=Windows11Light}"
    mc:Ignorable="d"
    Title="ASMED Medycyna Pracy -- v10 -2026" 
    WindowState="Maximized" 
    WindowStartupLocation="CenterScreen" 
    Width="Auto" 
    VerticalAlignment="Top" 
    MaxWidth="1600" 
    MinWidth="1500" Height="720" Background="#FF0C69CA" 
        >

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm1:SkierowaniaViewModel}">
            <views:SkierowaniaView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm1:SkierPacjentaEditViewModel}">
            <views:SkierPacjentaEditView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm1:SkierListaPacjentowViewModel}">
            <views:SkierListaPacjentowView />
        </DataTemplate>

        <!-- -->
        <DataTemplate DataType="{x:Type vm1:SkierPacjentaViewModel}">
            <views:SkierPacjentaView />
        </DataTemplate>

        <!-- ✅ DODANE: DataTemplate for SkierNewPacjentaViewModel -->
        <DataTemplate DataType="{x:Type vm1:SkierNewPacjentaViewModel}">
            <views:SkierNewPacjentaView />
        </DataTemplate>

        <!-- -->
        <DataTemplate DataType="{x:Type vm:ListaPacjentowViewModel}">
            <views:ListaPacjentowView />
        </DataTemplate>

        <!-- -->
        <DataTemplate DataType="{x:Type vm:PacjentDodajViewModel}">
            <views:PacjentDodajView />
        </DataTemplate>

        <!-- DataTemplate for ListaDoFakturViewModel -->
        <DataTemplate DataType="{x:Type vm:ListaDoFakturViewModel}">
            <views:ListaDoFakturView />
        </DataTemplate>

        <!-- DataTemplate for the new ListaFaktAddViewModel -->
        <DataTemplate DataType="{x:Type vmL:ListaFaktAddViewModel}">
            <views1:ListaFaktAddView />
        </DataTemplate>

        <!-- DataTemplate for BadaniaNewViewModel -->
        <DataTemplate DataType="{x:Type vmBadania:BadaniaNewViewModel}">
            <views:BadaniaNewView />
        </DataTemplate>

        <!-- ✅ DODANE: DataTemplate for BadaniaEditNewViewModel -->
        <DataTemplate DataType="{x:Type vmBadania:BadaniaEditNewViewModel}">
            <views:BadaniaEditNewView />
        </DataTemplate>

    </Window.Resources>

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>




    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="117*"/>
            <ColumnDefinition Width="1397*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Border Height="37"
                VerticalAlignment="Center" 
                Background="#FF0078D7" Grid.ColumnSpan="2">

            <Grid Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="196"/>
                    <ColumnDefinition Width="89"/>
                    <ColumnDefinition Width="Auto" MinWidth="135"/>
                    <ColumnDefinition Width="Auto" MinWidth="174"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="3" Text="❤️ ASMED" FontSize="22" FontWeight="Bold" VerticalAlignment="Top" Height="30" HorizontalAlignment="Center" Width="124" Margin="0,-6,0,0">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="#FFA4EAF3"/>
                    </TextBlock.Foreground>
                </TextBlock>
            </Grid>
        </Border>
        <!-- Main Content -->
        <Grid Margin="0,2,0,26" Grid.ColumnSpan="2" Grid.RowSpan="3"
            >
            <syncfusion:TabControlExt 
                FontSize="14" 
                TabPanelBackground="{x:Null}" 
                Background="#FF075177" 
                CloseButtonType="Hide" 
                DefaultContextMenuItemVisibility="Hidden">
                <syncfusion:TabControlExt.TabItemHoverForeground>

                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                </syncfusion:TabControlExt.TabItemHoverForeground>

                <!-- Istniejące zakładki -->
                <syncfusion:TabItemExt x:Name="Rejestracja" Header="📝 Rejestracja   " FontSize="16" Padding="12,14" Margin="-27,0,0,0" Height="30" Background="#FD3A345E" Foreground="White">
                    <views:WizytyViewView VerticalAlignment="Top" Height="750" Foreground="Black" />
                </syncfusion:TabItemExt>

                <!-- Istniejące zakładki -->
                <syncfusion:TabItemExt x:Name="NowaKartaBadan" Header="📄 Nowa Karta" FontSize="16" Padding="12,14" Background="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" Margin="-27,0,0,0" Height="30" Foreground="#FFF7F5F5">
                    <ContentControl Content="{Binding NowaKartaBadanWidok}" Height="750" VerticalAlignment="Top" Foreground="#FF060606" />
                </syncfusion:TabItemExt>

                <!-- Istniejące zakładki -->
                <syncfusion:TabItemExt x:Name="Skierowania" Header="📝 Karty Badań   " FontSize="16" Padding="12,14" Background="#FF4EE7FB" Margin="-27,0,0,0"  Foreground="#FF000000" Height="30">
                    <ContentControl Content="{Binding SkierowaniaWidok}" Height="750" VerticalAlignment="Top" />
                </syncfusion:TabItemExt>

                <syncfusion:TabItemExt x:Name="BadaniaNew" Header="📝 Zakończ Badanie" FontSize="16" Padding="12,14" Background="#FF4CAF50" Margin="-27,0,0,0" Height="30" Foreground="#FFFFFDFD">
                    <views:BadaniaNewView VerticalAlignment="Top" Height="750" Foreground="#FF100F0F" />
                </syncfusion:TabItemExt>

                <syncfusion:TabItemExt x:Name="BadaniaEdit" Header="📝 Edycja Badań   " FontSize="16" Padding="12,14" Background="#FF90EE90" Margin="-27,0,0,0" Height="30">
                    <views:BadaniaEditNewView VerticalAlignment="Top" Height="750" />
                </syncfusion:TabItemExt>

                <syncfusion:TabItemExt x:Name="ListaDoFaktur" Header="📝 Lista do Faktur" FontSize="16" Padding="12,14" Margin="-27,0,0,0" Background="#F6607D8B" Height="30" Foreground="#FFFDFBFB">
                    <views1:ListaFaktAddView VerticalAlignment="Top" Height="750" Foreground="Black" />
                </syncfusion:TabItemExt>

                <!-- ✅ NOWA zakładka "Baza Danych" z pod-zakładkami -->
                <syncfusion:TabItemExt x:Name="BazaDanychTab" Header="🗄️ Baza Danych/Raporty" 
                                   FontSize="16" Padding="12,14" 
                                   Margin="-27,0,0,0" Background="#FFFFB347" 
                                   CloseButtonState="Hidden" 
                                   HeaderMargin="0,0,0,0" IconMargin="0,0,0,0" Height="30">

                    <syncfusion:TabControlExt 
                                          x:Name="Baza_Danych" 
                                          VerticalAlignment="Top" 
                                          Background="Transparent"
                                          TabPanelBackground="Transparent"
                                          Margin="0,-8,-8,35" 
                                          TabStripPlacement="Bottom" FontSize="12" 
                                           CloseButtonType="Hide" 
                                           DefaultContextMenuItemVisibility="Hidden">

                        <syncfusion:TabItemExt x:Name="Faktura" Header="📝 Faktura   " FontSize="20" Padding="12,14" Background="#FFFF6F61" Margin="0,0,0,0" Width="200" Height="40" VerticalAlignment="Top" IconMargin="0,0,0,0" IsSelected="True">
                            <views:FakturaView Height="766" VerticalAlignment="Top" />
                        </syncfusion:TabItemExt>

                        <syncfusion:TabItemExt x:Name="Pacjent" Header="📝 Pacjent   " FontSize="20" Padding="12,14" Height="40" Background="#FFD367FF" Margin="-27,0,0,0" Width="200" VerticalAlignment="Bottom">
                            <ContentControl Content="{Binding PacjentWidok}" Height="766" />
                        </syncfusion:TabItemExt>

                        <syncfusion:TabItemExt x:Name="Firma" Header="📝 Firma   " FontSize="20" Padding="12,14" Background="#FF90C6FD" Height="40" Margin="-27,0,0,0" Width="200" VerticalAlignment="Bottom">
                            <views:FirmaView Height="766" VerticalAlignment="Top" />
                        </syncfusion:TabItemExt>

                        <syncfusion:TabItemExt x:Name="Raporty" Header="📝 Raporty   " FontSize="20" Padding="12,14" Background="#FFFFA07A" Height="40" Margin="-27,0,0,0" Width="200" VerticalAlignment="Bottom">
                            <views:RaportyView Height="766" VerticalAlignment="Top" />
                        </syncfusion:TabItemExt>

                        <syncfusion:TabItemExt x:Name="Ustawienia" Header="📝 Ustawienia   " FontSize="20" Padding="12,14" Background="#FF06F537" Margin="-27,0.3,0,0" Width="200" Height="40" VerticalAlignment="Bottom">
                            <views:UstawieniaView Height="766" VerticalAlignment="Top" />
                        </syncfusion:TabItemExt>
                    </syncfusion:TabControlExt>
                </syncfusion:TabItemExt>

            </syncfusion:TabControlExt>
        </Grid>
        <!-- Footer -->

        <Button Content="❌ Zakończ" Height="34" 
                       Panel.ZIndex="100"
                       Background="#dc3545" Foreground="White" 
                       FontWeight="Bold" VerticalAlignment="Center"
                       ToolTip="Zamknij aplikację" Margin="1237,0,0,0" 
                       Click="CloseApp_Click" IsCancel="True" Width="150" HorizontalAlignment="Left" Grid.Column="1" />
        <Border x:Name="Stopka" 
                Grid.Row="2"
                Background="#FF0078D7" 
                Height="30" 
                VerticalAlignment="Center" 
                Grid.ColumnSpan="2">
            <Grid>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock  x:Name="ClockText"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#FFA4EAF3"
                               Height="23" Width="90" HorizontalAlignment="Right" Margin="20,0,0,0"/>
                    <TextBlock Text="© 2025 ASMED. All rights reserved." Foreground="White" FontSize="12" HorizontalAlignment="Left" Margin="20,3,0,0"/>

                    <!-- ✅ DODANE: Przycisk TopMost (opcjonalny) -->
                    <CheckBox x:Name="chkTopMost" 
                              Content="📌 Zawsze na wierzchu" 
                              Foreground="White" 
                              FontSize="11"
                              Margin="30,0,0,0"
                              VerticalAlignment="Center"
                              Checked="TopMost_Checked"
                              Unchecked="TopMost_Unchecked"
                              ToolTip="Przełącz tryb 'Zawsze na wierzchu' (Windows 10)"/>
                </StackPanel>

                <TextBlock Text="{Binding DatabaseInfo}" 
                           Foreground="White" 
                           FontSize="12"
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>
            </Grid>
        </Border>

    </Grid>
</Window>
