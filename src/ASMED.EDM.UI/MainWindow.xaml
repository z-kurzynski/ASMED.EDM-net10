    <Window
        x:Class="ASMED.EDM.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewspatients="clr-namespace:ASMED.EDM.UI.Views.Patients"
        xmlns:viewswizyty="clr-namespace:ASMED.EDM.UI.Views.wizytyview"
        xmlns:viewssettings="clr-namespace:ASMED.EDM.UI.Views.Settings"
        xmlns:viewsbadania="clr-namespace:ASMED.EDM.UI.Views.badania"
        xmlns:viewsskierowania="clr-namespace:ASMED.EDM.UI.Views.Skierowania"
        xmlns:viewslistadofaktur="clr-namespace:ASMED.EDM.UI.Views.lista_do_faktur"
        xmlns:viewsmigration="clr-namespace:ASMED.EDM.UI.Views.Migration"
        xmlns:viewsbadaniemod="clr-namespace:ASMED.EDM.UI.Views.Badanie"
        xmlns:viewsorzeczenie="clr-namespace:ASMED.EDM.UI.Views.Orzeczenie"
        xmlns:viewmodels="clr-namespace:ASMED.EDM.UI.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"

        mc:Ignorable="d"
    Title="ASMED EDM -- v20 -2026" 
    WindowState="Normal"
    WindowStartupLocation="CenterScreen" 
    Width="Auto" 
    VerticalAlignment="Top"
    HorizontalAlignment="Stretch"
    MaxWidth="1600" 
    MinWidth="1500" Background="#FFA4C9EF" MinHeight="820" MaxHeight="1080" >

    <Grid Background="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Nagłowek -->
            <RowDefinition Height="*"/>
            <!-- Środek -->
            <RowDefinition Height="Auto"/>
            <!-- Stopka -->
        </Grid.RowDefinitions>

        <!-- Nagłowek -->
        <Border Grid.Row="0" 
                Background="#FF0078D7" 
                Height="55">
            <TextBlock Text="❤️ ASMED EDM" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Center" Margin="0,0,40,0"/>
        </Border>

        <!-- Środek - główna zawartość -->
        <Grid Grid.Row="1" Margin="0,-44,0,0">
            <TabControl x:Name="MainTabControl" PreviewMouseDoubleClick="TabControl_PreviewMouseDoubleClick">
                <!-- Zakładka 1: Rejestracja -->
                <TabItem x:Name="tabRejestracja" Header="📝 Rejestracja" FontSize="14" Padding="15,10" Background="#FFD367FF">
                    <ContentControl x:Name="RejestracjaContent" />
                </TabItem>

                <!-- Zakładka 2: Nowa Karta -->
                <TabItem x:Name="tabNowaKarta" Header="📄 Nowa Karta" FontSize="14" Padding="15,10" Background="#FF90EE90">
                    <ContentControl x:Name="NowaKartaContent" />
                </TabItem>

                <!-- Zakładka 3: Karty Badań -->
                <TabItem x:Name="tabKartyBadan" Header="📋 Karty Badań" FontSize="14" Padding="15,10" Background="#FF90C6FD">
                    <ContentControl x:Name="KartyBadanContent" />
                </TabItem>

                <!-- Zakładka 4: Badanie -->
                <TabItem x:Name="tabBadanie" Header="🔬 Badanie" FontSize="14" Padding="15,10" Background="#FF42A5F5" Visibility="Collapsed">
                    <ContentControl x:Name="BadanieContent" />
                </TabItem>

                <!-- Zakładka 5: Orzeczenie -->
                <TabItem x:Name="tabOrzeczenie" Header="📋 Orzeczenie" FontSize="14" Padding="15,10" Background="#FF66BB6A" Visibility="Collapsed">
                    <ContentControl x:Name="OrzeczenieContent" />
                </TabItem>
                <TabItem x:Name="tabZakonczBadanie" Header="✅ Zakończ Badanie" FontSize="14" Padding="15,10" Background="#FF06F537">
                    <ContentControl x:Name="ZakonczBadanieContent" />
                </TabItem>

                <!-- Zakładka 6: Edycja Badań -->
                <TabItem x:Name="tabEdycjaBadan" Header="✏️ Edycja Badań" FontSize="14" Padding="15,10" Background="#FFFFA07A">
                    <ContentControl x:Name="EdycjaBadanContent" />
                </TabItem>

                <!-- Zakładka 7: Zakończ Badanie -->

                <!-- Zakładka 8: Lista Do Faktur -->
                <TabItem x:Name="tabListaDoFaktur" Header="💰 Lista Do Faktur" FontSize="14" Padding="15,10" Background="#FFFFB347">
                    <ContentControl x:Name="ListaDoFakturContent" />
                </TabItem>

                <!-- Zakładka: Baza Danych / Raporty / Settings -->
                <TabItem Header="🗄️ Baza Danych" FontSize="14" Padding="15,10" Background="#FFFF6F61" Margin="-2,-2,-8,0">
                    <Grid Background="White">
                        <!-- Zagnieżdżone zakładki dla Baza Danych -->
                        <TabControl Margin="10" TabStripPlacement="Left">

                            <!-- Podzakładka 1: Ustawienia -->
                            <TabItem Header="⚙️ Ustawienia" FontSize="13" Padding="12,8">
                                <viewssettings:SettingsView />
                            </TabItem>

                            <!-- Podzakładka 2: Faktura -->
                            <TabItem Header="🧾 Faktura" FontSize="13" Padding="12,8">
                                <Grid Background="#FFF5F5F5">
                                    <Border BorderBrush="#FF4CAF50" 
                                            BorderThickness="2" 
                                            CornerRadius="8" 
                                            Padding="20" 
                                            Margin="20"
                                            Background="White">
                                        <StackPanel>
                                            <TextBlock Text="🧾 Zarządzanie Fakturami" 
                                                       FontSize="20" 
                                                       FontWeight="Bold" 
                                                       Foreground="#FF4CAF50"
                                                       Margin="0,0,0,15"/>

                                            <TextBlock Text="Konfiguracja faktur, szablony, numery, serie dokumentów" 
                                                       FontSize="14" 
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,20"/>

                                            <!-- Placeholder dla faktura view -->
                                            <TextBlock Text="🔧 Widok faktur będzie zaimplementowany po połączeniu z bazą danych" 
                                                       FontSize="12" 
                                                       Foreground="#FF666666"
                                                       FontStyle="Italic"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- Podzakładka 3: Firma -->
                            <TabItem Header="🏢 Firma" FontSize="13" Padding="12,8">
                                <Grid Background="#FFF5F5F5">
                                    <Border BorderBrush="#FFFF9800" 
                                            BorderThickness="2" 
                                            CornerRadius="8" 
                                            Padding="20" 
                                            Margin="20"
                                            Background="White">
                                        <StackPanel>
                                            <TextBlock Text="🏢 Dane Firm" 
                                                       FontSize="20" 
                                                       FontWeight="Bold" 
                                                       Foreground="#FFFF9800"
                                                       Margin="0,0,0,15"/>

                                            <TextBlock Text="Zarządzanie danymi firm, kontrahenci, umowy" 
                                                       FontSize="14" 
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,20"/>

                                            <!-- Placeholder dla firma view -->
                                            <TextBlock Text="🔧 Widok firm będzie zaimplementowany po połączeniu z bazą danych" 
                                                       FontSize="12" 
                                                       Foreground="#FF666666"
                                                       FontStyle="Italic"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- Podzakładka 4: Raporty -->
                            <TabItem Header="📊 Raporty" FontSize="13" Padding="12,8">
                                <Grid Background="#FFF5F5F5">
                                    <Border BorderBrush="#FF9C27B0" 
                                            BorderThickness="2" 
                                            CornerRadius="8" 
                                            Padding="20" 
                                            Margin="20"
                                            Background="White">
                                        <StackPanel>
                                            <TextBlock Text="📊 Raporty i Statystyki" 
                                                       FontSize="20" 
                                                       FontWeight="Bold" 
                                                       Foreground="#FF9C27B0"
                                                       Margin="0,0,0,15"/>

                                            <TextBlock Text="Generowanie raportów, zestawienia, analizy danych" 
                                                       FontSize="14" 
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,20"/>

                                            <!-- Placeholder dla raporty view -->
                                            <TextBlock Text="🔧 Widok raportów będzie zaimplementowany po połączeniu z bazą danych" 
                                                       FontSize="12" 
                                                       Foreground="#FF666666"
                                                       FontStyle="Italic"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- Podzakładka 5: Migracja -->
                            <TabItem Header="📦 Migracja" FontSize="13" Padding="12,8">
                                <viewsmigration:MigrationView />
                            </TabItem>

                            <!-- Podzakładka 6: EDM / P1 -->
                            <TabItem FontSize="13" Padding="12,8">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏥" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="EDM" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ContentControl x:Name="EdmP1TestContent"/>
                            </TabItem>

                        </TabControl>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Stopka -->
        <Border Grid.Row="2" 
                Background="#FF0078D7" 
                Height="30">

            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Border
                        CornerRadius="3"
                        Padding="12,5" Height="30" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕐 " 
                                FontSize="12"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentTime}" 
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="White"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding CurrentDate}" 
                                FontSize="12"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="© 2025 ASMED EDM. All rights reserved." 
                        Foreground="White" 
                        FontSize="12" Margin="10,0,20,0" VerticalAlignment="Center"
                           />
                    <Border
                        CornerRadius="3"
                        Padding="12,5" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗄️ " 
                                FontSize="12"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConsoleWrite}" 
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
                <Border
                        Background="{Binding DatabaseStatusColor}"
                        CornerRadius="3"
                        Padding="12,5" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar
                                 Value="{Binding ConsoleProgress}"
                                 Maximum="100"
                                 Height="14"
                                 Foreground="#FF0078D7"
                                 Background="#FFE0E0E0"
                                 BorderThickness="0" Width="100"/>
                        <TextBlock Text="🗄️ " 
                                FontSize="12"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DatabaseType}" 
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                        <TextBlock Text=": " 
                                FontSize="12"
                                Foreground="White"
                                VerticalAlignment="Center"
                                Margin="2,0"/>
                        <TextBlock Text="{Binding DatabaseName}" 
                                FontSize="12"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Zegar po lewej stronie -->

                <!-- Informacja o bazie danych po prawej stronie -->
            </Grid>
        </Border>
    </Grid>
</Window>
