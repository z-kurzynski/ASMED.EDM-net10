<Window x:Class="ASMED.EDM.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewspatients="clr-namespace:ASMED.EDM.UI.Views.Patients"
        xmlns:viewsvisits="clr-namespace:ASMED.EDM.UI.Views.Visits"
        xmlns:viewswizyty="clr-namespace:ASMED.EDM.UI.Views.wizytyview"
        xmlns:viewssettings="clr-namespace:ASMED.EDM.UI.Views.Settings"
        xmlns:viewsbadania="clr-namespace:ASMED.EDM.UI.Views.badania"
        xmlns:viewsskierowania="clr-namespace:ASMED.EDM.UI.Views.Skierowania"
        xmlns:viewslistadofaktur="clr-namespace:ASMED.EDM.UI.Views.lista_do_faktur"
        xmlns:viewsmigration="clr-namespace:ASMED.EDM.UI.Views.Migration"
        xmlns:viewsbadaniemod="clr-namespace:ASMED.EDM.UI.Views.Badanie"
        xmlns:viewsorzeczenie="clr-namespace:ASMED.EDM.UI.Views.Orzeczenie"

        mc:Ignorable="d"
    Title="ASMED EDM -- v20 -2026" 
    WindowState="Normal"
    WindowStartupLocation="CenterScreen" 
    Width="Auto" 
    VerticalAlignment="Top" 
    MaxWidth="1600" 
    MinWidth="1500" Background="#FFB9D1EA" Height="720" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Nagłowek -->
            <RowDefinition Height="*"/>
            <!-- Środek -->
            <RowDefinition Height="Auto"/>
            <!-- Stopka -->
        </Grid.RowDefinitions>

        <!-- Nagłowek -->
        <Border Grid.Row="0" 
                Background="#FF0078D7" 
                Height="55">
            <TextBlock Text="❤️ ASMED EDM" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Center" Margin="0,0,40,0"/>
        </Border>

        <!-- Środek - główna zawartość -->
        <Grid Grid.Row="1" Margin="0,-44,0,0">
            <TabControl>
                <!-- Zakładka 1: Rejestracja -->
                <TabItem Header="📝 Rejestracja" FontSize="14" Padding="15,10" Background="#FFD367FF">
                    <viewswizyty:WizytyViewView />
                </TabItem>

                <!-- Zakładka 2: Nowa Karta -->
                <TabItem Header="📄 Nowa Karta" FontSize="14" Padding="15,10" Background="#FF90EE90">
                    <viewsskierowania:SkierListaPacjentowView />
                </TabItem>

                <!-- Zakładka 4: Karty Badań -->
                <TabItem Header="📋 Karty Badań" FontSize="14" Padding="15,10" Background="#FF90C6FD">
                    <viewsskierowania:SkierowaniaView />
                </TabItem>

                <!-- Zakładka 4: Zakończ Badanie -->
                <TabItem Header="✅ Zakończ Badanie" FontSize="14" Padding="15,10" Background="#FF06F537">
                    <viewsbadania:BadaniaNewView />
                </TabItem>

                <!-- Zakładka 5: Edycja Badań -->
                <TabItem Header="✏️ Edycja Badań" FontSize="14" Padding="15,10" Background="#FFFFA07A">
                    <viewsbadania:BadaniaEditNewView />
                </TabItem>

                <!-- Zakładka: Lista Do Faktur -->
                <TabItem Header="💰 Lista Do Faktur" FontSize="14" Padding="15,10" Background="#FFFFB347">
                    <viewslistadofaktur:ListaFaktAddView />
                </TabItem>

                <!-- Zakładka: Badanie -->
                <TabItem Header="🔬 Badanie" FontSize="14" Padding="15,10" Background="#FF42A5F5">
                    <viewsbadaniemod:BadanieView />
                </TabItem>

                <!-- Zakładka: Orzeczenie -->
                <TabItem Header="📋 Orzeczenie" FontSize="14" Padding="15,10" Background="#FF66BB6A">
                    <viewsorzeczenie:OrzeczenieView />
                </TabItem>

                <!-- Zakładka: Baza Danych / Raporty / Settings -->
                <TabItem Header="🗄️ Baza Danych" FontSize="14" Padding="15,10" Background="#FFFF6F61" Margin="-2,-2,-8,0">
                    <Grid Background="White">
                        <!-- Zagnieżdżone zakładki dla Baza Danych -->
                        <TabControl Margin="10" TabStripPlacement="Left">

                            <!-- Podzakładka 1: Ustawienia -->
                            <TabItem Header="⚙️ Ustawienia" FontSize="13" Padding="12,8">
                                <viewssettings:SettingsView />
                            </TabItem>

                            <!-- Podzakładka 2: Faktura -->
                            <TabItem Header="🧾 Faktura" FontSize="13" Padding="12,8">
                                <Grid Background="#FFF5F5F5">
                                    <Border BorderBrush="#FF4CAF50" 
                                            BorderThickness="2" 
                                            CornerRadius="8" 
                                            Padding="20" 
                                            Margin="20"
                                            Background="White">
                                        <StackPanel>
                                            <TextBlock Text="🧾 Zarządzanie Fakturami" 
                                                       FontSize="20" 
                                                       FontWeight="Bold" 
                                                       Foreground="#FF4CAF50"
                                                       Margin="0,0,0,15"/>

                                            <TextBlock Text="Konfiguracja faktur, szablony, numery, serie dokumentów" 
                                                       FontSize="14" 
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,20"/>

                                            <!-- Placeholder dla faktura view -->
                                            <TextBlock Text="🔧 Widok faktur będzie zaimplementowany po połączeniu z bazą danych" 
                                                       FontSize="12" 
                                                       Foreground="#FF666666"
                                                       FontStyle="Italic"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- Podzakładka 3: Firma -->
                            <TabItem Header="🏢 Firma" FontSize="13" Padding="12,8">
                                <Grid Background="#FFF5F5F5">
                                    <Border BorderBrush="#FFFF9800" 
                                            BorderThickness="2" 
                                            CornerRadius="8" 
                                            Padding="20" 
                                            Margin="20"
                                            Background="White">
                                        <StackPanel>
                                            <TextBlock Text="🏢 Dane Firm" 
                                                       FontSize="20" 
                                                       FontWeight="Bold" 
                                                       Foreground="#FFFF9800"
                                                       Margin="0,0,0,15"/>

                                            <TextBlock Text="Zarządzanie danymi firm, kontrahenci, umowy" 
                                                       FontSize="14" 
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,20"/>

                                            <!-- Placeholder dla firma view -->
                                            <TextBlock Text="🔧 Widok firm będzie zaimplementowany po połączeniu z bazą danych" 
                                                       FontSize="12" 
                                                       Foreground="#FF666666"
                                                       FontStyle="Italic"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- Podzakładka 4: Raporty -->
                            <TabItem Header="📊 Raporty" FontSize="13" Padding="12,8">
                                <Grid Background="#FFF5F5F5">
                                    <Border BorderBrush="#FF9C27B0" 
                                            BorderThickness="2" 
                                            CornerRadius="8" 
                                            Padding="20" 
                                            Margin="20"
                                            Background="White">
                                        <StackPanel>
                                            <TextBlock Text="📊 Raporty i Statystyki" 
                                                       FontSize="20" 
                                                       FontWeight="Bold" 
                                                       Foreground="#FF9C27B0"
                                                       Margin="0,0,0,15"/>

                                            <TextBlock Text="Generowanie raportów, zestawienia, analizy danych" 
                                                       FontSize="14" 
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,20"/>

                                            <!-- Placeholder dla raporty view -->
                                            <TextBlock Text="🔧 Widok raportów będzie zaimplementowany po połączeniu z bazą danych" 
                                                       FontSize="12" 
                                                       Foreground="#FF666666"
                                                       FontStyle="Italic"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                                        <!-- Podzakładka 5: Migracja -->
                                        <TabItem Header="📦 Migracja" FontSize="13" Padding="12,8">
                                            <viewsmigration:MigrationView />
                                        </TabItem>

                                    </TabControl>
                                </Grid>
                            </TabItem>
                        </TabControl>
        </Grid>

        <!-- Stopka -->
        <Border Grid.Row="2" 
                Background="#FF0078D7" 
                Height="30">

            <Grid>
                <!-- Zegar po lewej stronie -->
                <Border HorizontalAlignment="Left" 
                        Margin="10,0,0,0"
                        CornerRadius="3"
                        Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕐 " 
                                   FontSize="12"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentTime}" 
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CurrentDate}" 
                                   FontSize="12"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="© 2025 ASMED EDM. All rights reserved." 
                           Foreground="White" 
                           FontSize="12"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>

                <!-- Informacja o bazie danych po prawej stronie -->
                <Border HorizontalAlignment="Right" 
                        Margin="0,0,10,0"
                        Background="{Binding DatabaseStatusColor}"
                        CornerRadius="3"
                        Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗄️ " 
                                   FontSize="12"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DatabaseType}" 
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=": " 
                                   FontSize="12"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="2,0"/>
                        <TextBlock Text="{Binding DatabaseName}" 
                                   FontSize="12"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
