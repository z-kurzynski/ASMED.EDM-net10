<Window x:Class="ASMED.EDM.UI.Views.Dialogs.DoctorSignatureAuthDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="Autoryzacja podpisu lekarza"
    Width="420"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtHeader" Grid.Row="0"
                   Text="Potwierdź tożsamość kodem z aplikacji authenticator"
                   FontSize="16" FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>

        <StackPanel x:Name="pnlEnrollment" Grid.Row="1" Margin="0,0,0,15" Visibility="Collapsed">
            <TextBlock Text="Zeskanuj kod QR w aplikacji authenticator (np. Google/Microsoft Authenticator) lub wpisz klucz ręcznie:"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Border BorderBrush="#FFCCCCCC" BorderThickness="1" HorizontalAlignment="Center" Padding="8">
                <Image x:Name="imgQrCode" Width="220" Height="220"/>
            </Border>
            <TextBlock Text="Klucz (jeśli QR niedostępny):" Margin="0,10,0,2" FontSize="11" Foreground="#FF666666"/>
            <TextBox x:Name="txtSecret" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Wpisz 6-cyfrowy kod z aplikacji:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtCode" FontSize="20" HorizontalContentAlignment="Center"
                     MaxLength="6" Padding="5"/>
            <TextBlock x:Name="txtError" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Anuluj" Width="90" Margin="0,0,10,0" Click="btnCancel_Click"/>
            <Button x:Name="btnConfirm" Content="Potwierdź" Width="90" IsDefault="True" Click="btnConfirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
