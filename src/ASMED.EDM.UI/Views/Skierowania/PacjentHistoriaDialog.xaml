<Window x:Class="ASMED.EDM.UI.Views.Skierowania.PacjentHistoriaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Historia Badań Pacjenta" 
    Width="800" 
    Height="600"
    WindowStartupLocation="CenterScreen"
    Background="#FFF7F9FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Historia Badań Pacjenta" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#FF1976D2"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" 
                BorderThickness="1" 
                BorderBrush="#CCCCCC"
                Background="White">
            <DataGrid x:Name="HistoriaGrid"
                AutoGenerateColumns="False"
                ItemsSource="{Binding Historia}"
                IsReadOnly="True"
                AlternationCount="2"
                GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat='dd-MM-yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="Typ Badania" Binding="{Binding TypBadania}" Width="*"/>
                    <DataGridTextColumn Header="Wynik" Binding="{Binding Wynik}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Button Grid.Row="2" 
                Content="Zamknij" 
                Width="100" 
                Height="35" 
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Click="Close_Click"
                Background="#FF1976D2"
                Foreground="White"
                FontSize="14"/>
    </Grid>
</Window>
