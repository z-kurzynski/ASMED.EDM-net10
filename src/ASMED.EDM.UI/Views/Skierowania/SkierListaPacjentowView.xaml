<UserControl x:Class="ASMED.EDM.UI.Views.Skierowania.SkierListaPacjentowView"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Height="Auto" 
             Width="auto" 
             VerticalAlignment="Top" 
             MaxWidth="1800" 
             MinWidth="1100" 
             Background="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}" 
             HorizontalAlignment="Left">

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" VerticalAlignment="Top" 
              MaxWidth="1500" MinWidth="1100" Height="55">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="410"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" VerticalAlignment="Top" Height="46">
                <TextBlock Text="Wyszukaj Pacjenta" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel>
                    <TextBox x:Name="txtSearchPacjent" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="247" FontSize="14" />
                    <Button Width="32" Height="28" Margin="8,0,0,0" ToolTip="Wyczyść pole" Click="ClearSearch_Click" Content="✖"/>
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="10,0,8,0"
                        SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding FilterTypes}" HorizontalAlignment="Left"/>
                </DockPanel>
            </StackPanel>
            <Button x:Name="odśwież"
                Grid.Column="2"
                Height="45"
                Content="🔃"
                Width="50"
                Background="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"
                Foreground="#FFFBFBFB" Margin="0,10,0,0" 
                Click="RefreshList_Click" HorizontalAlignment="Center" FontSize="22" VerticalAlignment="Center"/>

            <Button x:Name="Dodaj_Pacjenta"
                    Grid.Column="8"
                    Height="45"
                    Content="🧑‍💼 Dodaj Pacjenta "
                    VerticalAlignment="Top"
                    Command="{Binding EditPatientNewCommand}"
                    Background="#FF009688"
                    Foreground="#FFFBFBFB"
                    FontSize="16" Margin="5,10,5,0"/>

        </Grid>
        <!-- Lista pacjentów - uproszczona wersja DataGrid -->

        <DataGrid x:Name="lista_pacjentów_ADD_karty_badań"
            Grid.Row="1"
            AutoGenerateColumns="False"
            ItemsSource="{Binding PacjenciFiltered}"
            AlternationCount="2"
            RowHeight="40"
            FontSize="17"
            SelectionMode="Single"
            FontFamily="Arial Narrow"
            Padding="2,2,2,2"
            MaxWidth="1500" MinWidth="1100"
            Margin="10,0,10,30" 
            VerticalAlignment="Center" 
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding P_ID}" Header="Num." Width="50"/>
                <DataGridTextColumn Binding="{Binding LineNumber}"
                                           Header="Lp." 
                                           Width="50"/>

                <DataGridTextColumn Binding="{Binding FirstName}" 
                                           Header="Imię" Width="120"/>
                <DataGridTextColumn Binding="{Binding LastName}" 
                                           Header="Nazwisko" 
                                           Width="200"/>

                <DataGridTextColumn Binding="{Binding PESEL}" 
                                           Header="PESEL" 
                                           Width="120"/>
                <DataGridTextColumn Binding="{Binding Company}" Header="Firma"/>

                <DataGridTemplateColumn Header="Karta Bad" Width="80">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="35" Width="78" Background="#4CAF50" 
                                        Foreground="White" ToolTip="Dodaj Kartę Badań"
                                        Command="{Binding DataContext.OpenReferralCommand, 
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                <TextBlock Text="📝 nowa" FontSize="16" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Przycisk Historia z licznikiem -->
                <DataGridTemplateColumn Header="Historia" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Height="35" Width="78" Background="#FF5722" 
                                        Foreground="White" ToolTip="Historia badań pacjenta"
                                        Command="{Binding DataContext.OpenHistoriaCommand, 
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,0" Width="57" Height="35">
                                        <TextBlock Text="📊 " FontSize="16" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LiczbaKartBadan}" 
                                               Foreground="White" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Edycja" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="35" Width="57" Background="#1976D2" Foreground="White" ToolTip="Edytuj kartotekę"
                                        Command="{Binding DataContext.EditPatientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                <TextBlock Text="✏️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>


    </Grid>
</UserControl>
