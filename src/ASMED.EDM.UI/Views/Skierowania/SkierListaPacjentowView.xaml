<UserControl x:Class="ASMED.EDM.UI.Views.Skierowania.SkierListaPacjentowView"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Height="Auto"
     VerticalAlignment="Stretch"
     HorizontalAlignment="Stretch"
     Background="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}">

    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: Pasek narzędzi ═══ -->
        <Grid Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" Panel.ZIndex="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Wyszukiwarka -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Height="46">
                <TextBlock Text="Wyszukaj Pacjenta" FontSize="12" FontWeight="Bold"
                           Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel>
                    <TextBox x:Name="txtSearchPacjent"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="28" Width="247" FontSize="14"/>
                    <Button Width="32" Height="28" Margin="8,0,0,0"
                            ToolTip="Wyczyść pole"
                            Click="ClearSearch_Click"
                            Content="✖"/>
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="10,0,8,0"
                              SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding FilterTypes}"
                              HorizontalAlignment="Left"/>
                </DockPanel>
            </StackPanel>

            <!-- Odśwież -->
            <Button x:Name="odśwież"
                    Grid.Column="2"
                    Height="45" Width="50"
                    Content="🔃"
                    Background="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"
                    Foreground="#FFFBFBFB"
                    Margin="0,10,0,0"
                    Click="RefreshList_Click"
                    HorizontalAlignment="Center"
                    FontSize="22"
                    VerticalAlignment="Center"/>

            <!-- Dodaj Pacjenta -->
            <Button x:Name="Dodaj_Pacjenta"
                    Grid.Column="8"
                    Height="45"
                    Content="🧑‍💼 Dodaj Pacjenta"
                    VerticalAlignment="Top"
                    Command="{Binding EditPatientNewCommand}"
                    Background="#FF009688"
                    Foreground="#FFFBFBFB"
                    FontSize="16"
                    Margin="5,10,5,0"/>
        </Grid>

        <!-- ═══ ROW 1: DataGrid ═══ -->
        <DataGrid x:Name="lista_pacjentów_ADD_karty_badań"
            Grid.Row="1"
            AutoGenerateColumns="False"
            ItemsSource="{Binding PacjenciFiltered}"
            AlternationCount="2"
            RowHeight="40"
            FontSize="17"
            SelectionMode="Single"
            FontFamily="Arial Narrow"
            Padding="2,2,2,2"
            Margin="8,0,8,8"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            IsReadOnly="True">

            <!-- Wspólny styl komórek tekstowych -->
            <DataGrid.Resources>
                <Style x:Key="CellText" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="5,2,2,2"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding P_ID}"
                                    Header="ID" Width="50"
                                    ElementStyle="{StaticResource CellText}"/>

                <DataGridTextColumn Binding="{Binding FirstName}"
                                    Header="Imię" Width="120"
                                    ElementStyle="{StaticResource CellText}"/>

                <DataGridTextColumn Binding="{Binding LastName}"
                                    Header="Nazwisko" Width="200"
                                    ElementStyle="{StaticResource CellText}"/>

                <DataGridTextColumn Binding="{Binding PESEL}"
                                    Header="PESEL" Width="120"
                                    ElementStyle="{StaticResource CellText}"/>

                <!-- Firma: rozciąga się na pozostałe miejsce, tekst się zalama -->
                <DataGridTemplateColumn Header="Firma" Width="*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Company}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Padding="5,2,2,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Nowa karta badań -->
                <DataGridTemplateColumn Header="Karta Bad." Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="35" Width="82"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    ToolTip="Dodaj Kartę Badań"
                                    Command="{Binding DataContext.OpenReferralCommand,
                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="📝 nowa" FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Historia badań z licznikiem -->
                <DataGridTemplateColumn Header="Historia" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="35" Width="82"
                                    Background="#FF5722"
                                    Foreground="White"
                                    ToolTip="Historia badań pacjenta"
                                    Command="{Binding DataContext.OpenHistoriaCommand,
                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📊 " FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LiczbaKartBadan}"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Edycja -->
                <DataGridTemplateColumn Header="Edycja" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="35" Width="62"
                                    Background="#1976D2"
                                    Foreground="White"
                                    ToolTip="Edytuj kartotekę"
                                    Command="{Binding DataContext.EditPatientCommand,
                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="✏️" FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
