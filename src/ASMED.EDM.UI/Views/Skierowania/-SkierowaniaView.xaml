<UserControl x:Class="ASMED.EDM.UI.Views.Skierowania.SkierowaniaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:conv="clr-namespace:ASMED.EDM.UI.Converters"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    mc:Ignorable="d"
    Width="Auto" 
    VerticalAlignment="Top" 
    HorizontalAlignment="Stretch"
    Height="720">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:StringTruncateConverter x:Key="StringTruncateConverter"/>
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto" MaxHeight="60" />
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Wiersz 1: Wyszukiwarka i przyciski -->
        <Grid x:Name="top" VerticalAlignment="Top" MinWidth="1100" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Height="50">
                <TextBlock Text="Wyszukaj skierowanie:" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel HorizontalAlignment="Left">
                    <TextBox x:Name="txtSearchPacjent" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="247" FontSize="14">
                        <TextBox.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="🔍 SMART FILTER:" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="• #XXXX - Szuka dokładnie ID skierowania"/>
                                    <TextBlock Text="  Przykład: #20 → znajdzie skierowanie ID=20" Margin="5,0,0,5"/>
                                    <TextBlock Text="• Bez # - Szuka w wybranym polu (All/Imię/Nazwisko)"/>
                                    <TextBlock Text="  Przykład: Kowalski → znajdzie wszystkie nazwiska" Margin="5,0,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <Button Width="32" Height="28" Margin="8,0,0,0" ToolTip="Wyczyść pole" Command="{Binding ClearSearchTextCommand}" Content="✖"/>
                    <!-- Filtr typu -->
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="5,0,8,0"
                        SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding FilterTypes}" HorizontalAlignment="Left"/>

                    <!-- Filtr Okresu daty -->
                    <StackPanel Orientation="Vertical" Width="148" Margin="0,-18,0,0">
                        <TextBlock Text="Wyszukiwany Okres" FontSize="12" FontWeight="Bold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="Filtr_Okresu_Skier" Width="140" Height="28" FontSize="14"
                            SelectedItem="{Binding SelectedDateFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding DateFilterOptions}"
                            ToolTip="Filtr według okresu dat skierowania" HorizontalAlignment="Left" MaxDropDownHeight="2050"/>
                    </StackPanel>

                </DockPanel>
            </StackPanel>

            <!-- Licznik rekordów: widoczne (po filtrach SfDataGrid) / wszystkie -->
            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="15,2,0,0">
                <TextBlock Text="Liczba rekordów" FontSize="12" FontWeight="Bold"
                           Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <TextBlock x:Name="txtRecordCount" FontSize="18" Height="28" Foreground="{DynamicResource UI.Text.Selected}" VerticalAlignment="Center" Padding="0,4,0,2"/>
            </StackPanel>

            <Button x:Name="drukuj"
                Grid.Column="7"
                Height="46" Width="46"
                Content="🖨️"
                Background="{DynamicResource UI.Background.Header}"
                Foreground="#FFFBFBFB"
                Click="prinlist_Click"
                FontSize="22"
                VerticalAlignment="Top" Margin="5,5.5,0,0" HorizontalAlignment="Right"/>

            <Button x:Name="exportExcel"
                Grid.Column="6"
                Height="46" Width="46"
                Content="📊"
                Background="#FF1D6F42"
                Foreground="#FFFBFBFB"
                Click="exportExcel_Click"
                ToolTip="Eksport do Excela"
                FontSize="20"
                VerticalAlignment="Top" Margin="5,5.5,0,0" HorizontalAlignment="Right"/>

            <Button x:Name="odśwież"
                Grid.Column="5"
                Height="46" Width="46"
                Content="🔃"
                Background="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"
                Foreground="#FFFBFBFB"
                Click="RefreshList_Click"
                FontSize="22"
                VerticalAlignment="Top" Margin="5,5.5,0,0"/>

            <!-- Przycisk Rejestracja -->
            <Button Grid.Column="8"
                Height="46"
                Content="📅 Rejestracja"
                VerticalAlignment="Top"
                Width="220"
                Background="#FF3F51B5"
                Foreground="#FFFBFBFB"
                FontSize="16"
                Click="Rejestracja_Click"
                Margin="5,5,0,0"/>

            <!-- Przycisk Dodaj Kartę Badań -->
            <Button Grid.Column="9"
                Height="45"
                Content="📄  Dodaj Kartę Badań"
                VerticalAlignment="Top"
                Width="220"
                Command="{Binding OpenSkierPacjWoborCommand}"
                Background="#FF009688"
                Foreground="#FFFBFBFB"
                FontSize="16" 
                Margin="5,5,10,4"/>
        </Grid>

        <!-- Wiersz 2: DatePickers dla "Wybrany okres" -->
        <StackPanel x:Name="Wybrany_Okres" Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,10"
                    Visibility="{Binding IsCustomDateRangeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Top">
            <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                <TextBlock Text="Data Od:" FontSize="12" FontWeight="Bold"/>
                <DatePicker Width="140" Height="28" SelectedDate="{Binding FilterDateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                <TextBlock Text="Data Do:" FontSize="12" FontWeight="Bold"/>
                <DatePicker Width="140" Height="28" SelectedDate="{Binding FilterDateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                <Button Content="Zastosuj filtr" Padding="8,4" Command="{Binding ApplyCustomDateFilterCommand}" 
                        Background="#FF1976D2" Foreground="White" BorderThickness="0" Height="28" Width="116"/>
            </StackPanel>
        </StackPanel>

        <!-- Wiersz 3: Lista skierowań (uproszczona) -->
        <syncfusion:SfDataGrid x:Name="Lista_kart_Badan"
          Grid.Row="2"
          AutoGenerateColumns="False"
          ItemsSource="{Binding SkierowaniaFiltered}"
          AllowFiltering="True"
          AllowSorting="True"
          ColumnSizer="Star"
          RowHeight="40"
          FontSize="15"
          SelectionMode="Single"
          SelectionUnit="Row"
          FontFamily="Arial Narrow"
          Padding="2,2,2,2"
          Margin="8,8,8,8"
          AllowEditing="False"
          Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" CurrentCellBorderBrush="{DynamicResource UI.Background.Hover}">

            <syncfusion:SfDataGrid.Columns>

                <syncfusion:GridTextColumn MappingName="Id"
                                           HeaderText="ID" Width="50"
                                           TextAlignment="Left" VerticalAlignment="Center"
                                           Padding="8,0,5,0" AllowFiltering="True"/>


                <syncfusion:GridTextColumn MappingName="Typ"
                                           HeaderText="Typ" Width="40"
                                           TextAlignment="Left" VerticalAlignment="Center"
                                           Padding="8,0,5,0" AllowFiltering="True"/>
                <syncfusion:GridTextColumn MappingName="Imie"
                                           HeaderText="Imię" Width="110"
                                           TextAlignment="Left" VerticalAlignment="Center"
                                           Padding="8,0,5,0" AllowFiltering="True"/>
                <syncfusion:GridTextColumn MappingName="Nazwisko"
                                           HeaderText="Nazwisko"
                                           Width="170"
                                           TextAlignment="Left" VerticalAlignment="Center"
                                           Padding="8,0,5,0" AllowFiltering="True"/>
                <syncfusion:GridTextColumn MappingName="Pesel"
                                           HeaderText="PESEL" Width="110"
                                           TextAlignment="Left" VerticalAlignment="Center"
                                           Padding="8,0,5,0" AllowFiltering="True"/>
                <syncfusion:GridTextColumn MappingName="Firma"
                                           HeaderText="Firma" MinimumWidth="120"
                                           TextAlignment="Left" VerticalAlignment="Center"
                                           Padding="8,0,5,0" AllowFiltering="True" TextWrapping="Wrap">
                    <syncfusion:GridTextColumn.CellStyle>
                        <Style TargetType="syncfusion:GridCell">
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </syncfusion:GridTextColumn.CellStyle>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn MappingName="Data"
                    HeaderText="Data Skier."
                    TextAlignment="Left" VerticalAlignment="Center"
                    Padding="8,0,5,0" AllowFiltering="True"
                    Width="100">
                    <syncfusion:GridTextColumn.ValueBinding>
                        <Binding Path="Data" StringFormat="dd-MM-yyyy"/>
                    </syncfusion:GridTextColumn.ValueBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn MappingName="StatusBad"
                    HeaderText="Status"
                    TextAlignment="Left" VerticalAlignment="Center"
                    Padding="8,0,5,0" AllowFiltering="True"
                    Width="65">
                    <syncfusion:GridTextColumn.ValueBinding>
                        <Binding Path="StatusBad" Converter="{StaticResource StringTruncateConverter}" ConverterParameter="6"/>
                    </syncfusion:GridTextColumn.ValueBinding>
                    <syncfusion:GridTextColumn.CellStyle>
                        <Style TargetType="syncfusion:GridCell">
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </syncfusion:GridTextColumn.CellStyle>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn MappingName="DataRej"
                    HeaderText="Data Rej."
                    TextAlignment="Left" VerticalAlignment="Center"
                    Padding="8,0,5,0" AllowFiltering="True"
                    Width="100">
                    <syncfusion:GridTextColumn.ValueBinding>
                        <Binding Path="DataRej" StringFormat="dd-MM-yyyy"/>
                    </syncfusion:GridTextColumn.ValueBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn MappingName="DataBad"
                    HeaderText="Data Bad."
                    TextAlignment="Left" VerticalAlignment="Center"
                    Padding="8,0,5,0" AllowFiltering="True"
                    Width="100">
                    <syncfusion:GridTextColumn.ValueBinding>
                        <Binding Path="DataBad" StringFormat="dd-MM-yyyy"/>
                    </syncfusion:GridTextColumn.ValueBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn MappingName="DataDo"
                    HeaderText="Data Do"
                    TextAlignment="Left" VerticalAlignment="Center"
                    Padding="8,0,5,0" AllowFiltering="True"
                    Width="90">
                    <syncfusion:GridTextColumn.ValueBinding>
                        <Binding Path="DataDo" StringFormat="dd-MM-yyyy"/>
                    </syncfusion:GridTextColumn.ValueBinding>
                    <syncfusion:GridTextColumn.CellStyle>
                        <Style TargetType="syncfusion:GridCell">
                            <Setter Property="FontStyle" Value="Normal"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </syncfusion:GridTextColumn.CellStyle>
                </syncfusion:GridTextColumn>

                <!-- Faktura: mniejsza czcionka 13px -->
                <syncfusion:GridTextColumn MappingName="NumerFaktury"
                    HeaderText="Faktura"
                    TextAlignment="Left" VerticalAlignment="Center"
                    Padding="8,0,5,0" AllowFiltering="True"
                    Width="90">
                    <syncfusion:GridTextColumn.CellStyle>
                        <Style TargetType="syncfusion:GridCell">
                            <Setter Property="FontStyle" Value="Normal"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </syncfusion:GridTextColumn.CellStyle>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTemplateColumn HeaderText="Dziś." Width="50" AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="wizyta_na_Dzis" Height="38" Width="50" ToolTip="Wizyta Dziś Rejestracja"
                                   Command="{Binding DataContext.ToggleRejestracjaCommand, RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                   CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#9E9E9E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Rejestracja}" Value="True">
                                                <Setter Property="Background" Value="#388E3C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="⚕ " FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>


                <syncfusion:GridTemplateColumn HeaderText="Orzecz." Width="45" AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="38" Width="45" ToolTip="Orzecz."
                                    Command="{Binding DataContext.ToggleOrzeczenieCommand, RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#9E9E9E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Orzeczenie}" Value="True">
                                                <Setter Property="Background" Value="#388E3C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="📋" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn HeaderText="P1" Width="45" AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="38" Width="45" ToolTip="EDM P1"
                                    Command="{Binding DataContext.ToggleP1Command, RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#9E9E9E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EDM_P1}" Value="True">
                                                <Setter Property="Background" Value="#1976D2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="🔗" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn HeaderText="Edycja" Width="60" AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="38" Width="60" Background="#1976D2" Foreground="White" ToolTip="Edytuj Skierowanie"
                                        Command="{Binding DataContext.EditSkierowanieCommand, RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                        CommandParameter="{Binding}">
                                <TextBlock Text="✏️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
