<UserControl x:Class="ASMED.EDM.UI.Views.Skierowania.SkierowaniaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Width="Auto" 
    VerticalAlignment="Top" 
    MaxWidth="1800" 
    MinWidth="1100" 
    Height="720" 
    Background="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Top" Margin="0,0,-3,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto" MaxHeight="60" />
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Wiersz 1: Wyszukiwarka i przyciski -->
        <Grid VerticalAlignment="Top" 
              MaxWidth="1500" MinWidth="1100" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="590"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Height="50">
                <TextBlock Text="Wyszukaj skierowanie:" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel Width="551" HorizontalAlignment="Left">
                    <TextBox x:Name="txtSearchPacjent" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="247" FontSize="14">
                        <TextBox.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="🔍 SMART FILTER:" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="• #XXXX - Szuka dokładnie ID skierowania"/>
                                    <TextBlock Text="  Przykład: #20 → znajdzie skierowanie ID=20" Margin="5,0,0,5"/>
                                    <TextBlock Text="• Bez # - Szuka w wybranym polu (All/Imię/Nazwisko)"/>
                                    <TextBlock Text="  Przykład: Kowalski → znajdzie wszystkie nazwiska" Margin="5,0,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <Button Width="32" Height="28" Margin="8,0,0,0" ToolTip="Wyczyść pole" Command="{Binding ClearSearchTextCommand}" Content="✖"/>
                    <!-- Filtr typu -->
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="5,0,8,0"
                        SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding FilterTypes}" HorizontalAlignment="Left"/>

                    <!-- Filtr Okresu daty -->
                    <StackPanel Orientation="Vertical" Width="148" Margin="0,-18,0,0">
                        <TextBlock Text="Wyszukiwany Okres" FontSize="12" FontWeight="Bold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="Filtr_Okresu_Skier" Width="140" Height="28" FontSize="14"
                            SelectedItem="{Binding SelectedDateFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding DateFilterOptions}"
                            ToolTip="Filtr według okresu dat skierowania" HorizontalAlignment="Left" MaxDropDownHeight="2050"/>
                    </StackPanel>

                </DockPanel>
            </StackPanel>

            <!-- Przycisk Rejestracja -->
            <Button Grid.Column="5"
                HorizontalAlignment="Center"
                Height="46"
                Content="📅 Rejestracja"
                VerticalAlignment="Top"
                Width="220"
                Background="#FF3F51B5"
                Foreground="#FFFBFBFB"
                FontSize="16"
                Click="Rejestracja_Click"
                Margin="0,5,0,0"/>

            <!-- Przycisk Dodaj Kartę Badań -->
            <Button Grid.Column="6"
                HorizontalAlignment="Center"
                Height="45"
                Content="📄  Dodaj Kartę Badań"
                VerticalAlignment="Top"
                Width="220"
                Command="{Binding OpenSkierPacjWoborCommand}"
                Background="#FF009688"
                Foreground="#FFFBFBFB"
                FontSize="16" 
                Margin="0,5,0,0"/>
        </Grid>

        <!-- Wiersz 2: DatePickers dla "Wybrany okres" -->
        <StackPanel x:Name="Wybrany_Okres" Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,10"
                    Visibility="{Binding IsCustomDateRangeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Top">
            <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                <TextBlock Text="Data Od:" FontSize="12" FontWeight="Bold"/>
                <DatePicker Width="140" Height="28" SelectedDate="{Binding FilterDateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                <TextBlock Text="Data Do:" FontSize="12" FontWeight="Bold"/>
                <DatePicker Width="140" Height="28" SelectedDate="{Binding FilterDateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                <Button Content="Zastosuj filtr" Padding="8,4" Command="{Binding ApplyCustomDateFilterCommand}" 
                        Background="#FF1976D2" Foreground="White" BorderThickness="0" Height="28" Width="116"/>
            </StackPanel>
        </StackPanel>

        <!-- Wiersz 3: Lista skierowań (uproszczona) -->
        <DataGrid x:Name="Lista_kart_Badan"
            Grid.Row="2"
            AutoGenerateColumns="False"
            ItemsSource="{Binding SkierowaniaFiltered}"
            AlternationCount="2"
            RowHeight="40"
            FontSize="17"
            SelectionMode="Single"
            FontFamily="Arial Narrow"
            Padding="2,2,2,2"
            Margin="10,0,10,0" 
            MaxWidth="1500" MinWidth="1100"
            Height="650" 
            VerticalAlignment="Top" 
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Binding="{Binding Id}" 
                                           Header="ID" Width="50" 
                                           ElementStyle="{StaticResource CenterAlignedCell}"/>


                <DataGridTextColumn Binding="{Binding Typ}" 
                                           Header="Typ" Width="40"/>
                <DataGridTextColumn Binding="{Binding Imie}" 
                                           Header="Imię" Width="120"/>
                <DataGridTextColumn Binding="{Binding Nazwisko}" 
                                           Header="Nazwisko" 
                                           Width="180"/>
                <DataGridTextColumn Binding="{Binding Pesel}" 
                                           Header="PESEL" Width="120"/>
                <DataGridTextColumn Binding="{Binding Firma}" 
                                           Header="Firma"/>
                <DataGridTextColumn Binding="{Binding Data, StringFormat='dd-MM-yyyy'}" 
                    Header="Data Skier." 
                    Width="100"/>
                <DataGridTextColumn Binding="{Binding DataRej, StringFormat='dd-MM-yyyy'}" 
                    Header="Data Rej." 
                    Width="100"/>
                <DataGridTextColumn Binding="{Binding DataBad, StringFormat='dd-MM-yyyy'}" 
                    Header="Data Bad." 
                    Width="100"/>

                <DataGridTextColumn Binding="{Binding NumerFaktury}" 
                    Header="Faktura" 
                    Width="100"/>

                <DataGridTemplateColumn Header="Edycja" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="35" Width="57" Background="#1976D2" Foreground="White" ToolTip="Edytuj Skierowanie"
                                        Command="{Binding DataContext.EditSkierowanieCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                <TextBlock Text="✏️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.Resources>
                <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </DataGrid.Resources>
        </DataGrid>
    </Grid>
</UserControl>
