<UserControl x:Class="ASMED.EDM.UI.Views.Skierowania.SkierListaPacjentowView"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
     Height="720"
     VerticalAlignment="Top"
     HorizontalAlignment="Stretch">



    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: Pasek narzędzi ═══ -->
        <Grid x:Name="top" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Stretch" Panel.ZIndex="3" MinWidth="1100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Wyszukiwarka -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,2,0,0">
                <TextBlock Text="Wyszukaj Pacjenta" FontSize="12" FontWeight="Bold"
                           Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel>
                    <TextBox x:Name="txtSearchPacjent"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="247" FontSize="14" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" Height="28"/>
                    <Button Width="32" Height="28" Margin="8,0,0,0"
                            ToolTip="Wyczyść pole"
                            Click="ClearSearch_Click"
                            Content="✖"/>
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="10,0,8,0"
                              SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding FilterTypes}"
                              HorizontalAlignment="Left"/>
                </DockPanel>
            </StackPanel>

            <!-- Licznik rekordów: widoczne (po filtrach SfDataGrid) / wszystkie -->
            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="15,2,0,0">
                <TextBlock Text="Liczba rekordów" FontSize="12" FontWeight="Bold"
                           Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <TextBlock x:Name="txtRecordCount" FontSize="18" VerticalAlignment="Center" Height="28" ScrollViewer.CanContentScroll="True" Foreground="{DynamicResource UI.Text.Selected}" Padding="0,4,0,2"/>
            </StackPanel>

            <!-- Odśwież -->
            <Button x:Name="odśwież"
                    Grid.Column="5"
                    Height="46" Width="46"
                    Content="🔃"
                    Background="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"
                    Foreground="#FFFBFBFB"
                    Margin="0,5,0,0"
                    Click="RefreshList_Click"
                    HorizontalAlignment="Center"
                    FontSize="22"
                    VerticalAlignment="Top"/>
            <Button Grid.Column="8"
                HorizontalAlignment="Left"
                Height="46"
                Content="📅 Rejestracja"
                VerticalAlignment="Center"
                Width="220"
                Background="#FF3F51B5"
                Foreground="#FFFBFBFB"
                FontSize="16"
                Click="Rejestracja_Click" Margin="5,2.2,0,0"/>

            <Button x:Name="drukuj"
                Grid.Column="7"
                Height="46" Width="46"
                Content="🖨️"
                Background="{DynamicResource UI.Background.Header}"
                Foreground="#FFFBFBFB"
                Click="prinlist_Click"
                FontSize="22"
                VerticalAlignment="Top" Margin="5,5.5,0,0" HorizontalAlignment="Right"/>

            <Button x:Name="exportExcel"
                Grid.Column="6"
                Height="46" Width="46"
                Content="📊"
                Background="#FF1D6F42"
                Foreground="#FFFBFBFB"
                Click="exportExcel_Click"
                ToolTip="Eksport do Excela"
                FontSize="20"
                VerticalAlignment="Top" Margin="5,5.5,0,0" HorizontalAlignment="Right"/>

            <!-- Dodaj Pacjenta -->
            <Button x:Name="Dodaj_Pacjenta"
                    Grid.Column="9"
                    Height="45"
                    Content="🧑‍💼 Dodaj Pacjenta"
                    VerticalAlignment="Top"
                    Command="{Binding EditPatientNewCommand}"
                    Background="#FF009688"
                    Foreground="#FFFBFBFB"
                    FontSize="16"
                    Margin="5,5,10,4" Width="220" HorizontalAlignment="Center"/>
        </Grid>

        <!-- ═══ ROW 1: SfDataGrid (Syncfusion) z filtrowaniem kolumn ═══ -->
        <syncfusion:SfDataGrid x:Name="lista_pacjentów_ADD_karty_badań"
            Grid.Row="1"
            AutoGenerateColumns="False"
            ItemsSource="{Binding PacjenciFiltered}"
            AllowFiltering="True"
            AllowSorting="True"
            ColumnSizer="Star"
            RowHeight="40"
            FontSize="15"
            SelectionMode="Single"
            SelectionUnit="Row"
            FontFamily="Arial Narrow"
            Padding="2,2,2,2"
            Margin="8,8,8,8"
            HorizontalAlignment="Stretch"
            AllowEditing="False"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="P_ID"
                                    HeaderText="ID" Width="50"
                                    TextAlignment="Left" VerticalAlignment="Center"
                                    Padding="5,2,2,2" AllowFiltering="True"/>

                <syncfusion:GridTextColumn MappingName="FirstName"
                                    HeaderText="Imię" Width="110"
                                    TextAlignment="Left" VerticalAlignment="Center"
                                    Padding="5,2,2,2" AllowFiltering="True"/>

                <syncfusion:GridTextColumn MappingName="LastName"
                                    HeaderText="Nazwisko" Width="180"
                                    TextAlignment="Left" VerticalAlignment="Center"
                                    Padding="5,2,2,2" AllowFiltering="True"/>

                <syncfusion:GridTextColumn MappingName="PESEL"
                                    HeaderText="PESEL" Width="120"
                                    TextAlignment="Left" VerticalAlignment="Center"
                                    Padding="5,2,2,2" AllowFiltering="True"/>

                <!-- Firma: rozciąga się na pozostałe miejsce, tekst się zalama -->
                <syncfusion:GridTextColumn MappingName="Company"
                                    HeaderText="Firma"  MinimumWidth="120"
                                    TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center"
                                    Padding="5,2,2,2" AllowFiltering="True"/>

                <syncfusion:GridTextColumn MappingName="BadWazneDo"
                                    HeaderText="Data Do" Width="120"
                                    TextAlignment="Left" VerticalAlignment="Center"
                                    Padding="5,2,2,2" AllowFiltering="True">
                    <syncfusion:GridTextColumn.ValueBinding>
                        <Binding Path="BadWazneDo" StringFormat="dd-MM-yyyy"/>
                    </syncfusion:GridTextColumn.ValueBinding>
                </syncfusion:GridTextColumn>

                <!-- Nowa karta badań -->
                <syncfusion:GridTemplateColumn HeaderText="Karta Bad." Width="90"
                                    AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="35" Width="82"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    ToolTip="Dodaj Kartę Badań"
                                    Command="{Binding DataContext.OpenReferralCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="📝 nowa" FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <!-- Historia badań z licznikiem -->
                <syncfusion:GridTemplateColumn HeaderText="Historia" Width="90"
                                    AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="35" Width="82"
                                    Background="#FF5722"
                                    Foreground="White"
                                    ToolTip="Historia badań pacjenta"
                                    Command="{Binding DataContext.OpenHistoriaCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📊 " FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LiczbaKartBadan}"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <!-- Edycja -->
                <syncfusion:GridTemplateColumn HeaderText="Edycja" Width="70"
                                    AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="35" Width="62"
                                    Background="#1976D2"
                                    Foreground="White"
                                    ToolTip="Edytuj kartotekę"
                                    Command="{Binding DataContext.EditPatientCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="✏️" FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

    </Grid>
</UserControl>
