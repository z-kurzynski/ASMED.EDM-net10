<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:wizytyview="clr-namespace:ASMED.EDM.UI.Views.wizytyview" xmlns:syncfusion="http://schemas.syncfusion.com/wpf" x:Class="ASMED.EDM.UI.Views.Orzeczenie.OrzeczenieView2"
    xmlns:m="clr-namespace:Syncfusion.AI.AgentTools.Core;assembly=Syncfusion.DocumentSDK.AI.AgentTools"
    mc:Ignorable="d"
             Background="#FFF5F5F5">

    <Grid x:Name="strona" Margin="5,5,5,5">
        <Border x:Name="ramka_strony" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1,1,1,1"
                CornerRadius="8"
                Padding="10,0,10,10"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="top" Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="Row_0_0_Header" Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Height="46" Width="405" HorizontalAlignment="Left">
                            <TextBlock Text="Wyszukaj Pacjenta" FontSize="12" FontWeight="Bold"
                                Margin="0,0,0,2" HorizontalAlignment="Left"/>
                            <DockPanel>
                                <TextBox x:Name="txtSearchPacjent"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Height="28" Width="247" FontSize="14"/>
                                <Button Width="32" Height="28" Margin="8,0,0,0"
                                    ToolTip="Wyczyść pole"
                                   
                                    Content="✖"/>
                                <ComboBox Width="100" Height="28" FontSize="14" Margin="10,0,8,0"
                                    SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ItemsSource="{Binding FilterTypes}"
                                    HorizontalAlignment="Left"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="Row_0_1_button" Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                        <Button Content="Lista Orzeczeń" 
                                HorizontalAlignment="Center"
                                Height="45"
                                VerticalAlignment="Top"
                                Width="220"
                                Command="{Binding OpenSkierPacjWoborCommand}"
                                Background="#FF009688"
                                Foreground="#FFFBFBFB"
                                FontSize="16" 
                                Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="srodek" Grid.Row="1" MinWidth="0" MinHeight="200" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="boder_lewa" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" BorderThickness="1" Padding="10,10,10,10" CornerRadius="8,8,8,8" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,10">
                                <StackPanel Orientation="Vertical">
                                    <TextBox TextWrapping="Wrap" Text="Lista pacjentów" Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" FontWeight="Bold" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <syncfusion:ButtonAdv Content="" Label="Rejestracja" IconHeight="0" IconWidth="0" Width="70" FontSize="11" FontStyle="Italic" HorizontalAlignment="Right" Margin="5,0,0,0"/>
                                    <syncfusion:ButtonAdv Content="" Label="Wizyta" IconHeight="0" IconWidth="0" Width="70" FontSize="11" FontStyle="Italic" HorizontalAlignment="Right" Margin="5,0,0,0"/>
                                    <syncfusion:ButtonAdv Content="" Label="Wywiad" Width="70" IconHeight="0" IconWidth="0" FontSize="11" FontStyle="Italic" HorizontalAlignment="Right" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <syncfusion:SfDataGrid x:Name="Lista_Wizyt" ItemsSource="{Binding Wizyty}"
                            AutoGenerateColumns="False"
                            LiveDataUpdateMode="AllowChildViewUpdate"
                            SelectedItem="{Binding SelectedWizyta, Mode=TwoWay}"
                            AlternationCount="2"
                            RowHeight="60"
                            ColumnSizer="Star"
                            FontSize="17"
                            AllowFiltering="True"
                            AllowSorting="True"
                            SelectionMode="Single"
                            SelectionUnit="Row"
                            FontFamily="Arial Narrow"
                            Padding="2,2,2,2"
                            RowSelectionBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" 
                            CurrentCellBorderBrush="{x:Null}" OpacityMask="#FFFFFDFD" 
                            RenderTransformOrigin="0.5,0.5" Height="572" Width="378">
                                <syncfusion:SfDataGrid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform AngleY="0"/>
                                        <RotateTransform/>
                                        <TranslateTransform Y="0"/>
                                    </TransformGroup>
                                </syncfusion:SfDataGrid.RenderTransform>

                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn MappingName="B_typ" HeaderText="Typ" Width="35" IsReadOnly="True" />

                                    <syncfusion:GridTemplateColumn HeaderText="Pacjent" Width="250" AllowFiltering="False" MappingName="P_nazwisko">
                                        <syncfusion:GridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,4,6,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" FontSize="16" Padding="0" Background="Transparent">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} {1}">
                                                                <Binding Path="P_imie"/>
                                                                <Binding Path="P_nazwisko"/>
                                                                <Binding Path="P_Firma"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>

                                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="3*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" FontSize="13"
                                                        Background="Transparent" Padding="0" Text="{Binding FormattedPesel}" />

                                                        <TextBlock Grid.Column="1" FontSize="13"
                                                        Background="Transparent" Padding="0" Text="{Binding B_DataSkierowania, StringFormat=\{0:dd-MM-yyyy\}}" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </syncfusion:GridTemplateColumn.CellTemplate>
                                    </syncfusion:GridTemplateColumn>

                                    <syncfusion:GridTemplateColumn HeaderText="Status" Width="100" AllowFiltering="False" MappingName="Firma_Nazwa">
                                        <syncfusion:GridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Firma_Nazwa}" TextWrapping="Wrap" FontSize="14" Margin="6,6,6,6"/>
                                            </DataTemplate>
                                        </syncfusion:GridTemplateColumn.CellTemplate>
                                    </syncfusion:GridTemplateColumn>

                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="prawa" BorderBrush="Black" Grid.Column="1" Margin="8,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="450"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="prawa_orzecz" MinHeight="100" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" BorderThickness="1,1,1,1" CornerRadius="8,8,8,8" Margin="5,0,0,10" Padding="10,10,10,10" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" d:IsHidden="True">
                                <TabControl TabStripPlacement="Top">
                                    <TabItem Header="Orzeczenie">
                                        <Grid x:Name="grid_orzeczenie"/>
                                    </TabItem>
                                    <TabItem Header="Historia">
                                        <Grid x:Name="grid_historia"/>
                                    </TabItem>
                                    <TabItem Header="Zalecenia dla pacjenta">
                                        <Grid x:Name="grid_zalecenia"/>
                                    </TabItem>
                                    <TabItem Header="Bad. sanitarne">
                                        <Grid x:Name="grid_bad_sanitarne"/>
                                    </TabItem>
                                    <TabItem Header="Urlop dla por. zdr.">
                                        <Grid x:Name="grid_urlop"/>
                                    </TabItem>
                                </TabControl>
                            </Border>

                            <Grid>





                                <!---->





                                <!---->
                                <Grid Grid.Row="1" Margin="0,5,0,5" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="450"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border MinHeight="100" BorderThickness="1,1,1,1" CornerRadius="8,8,8,8" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" Padding="10,10,10,10" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Grid.Row="2" d:IsHidden="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" MinHeight="50"/>
                                                <RowDefinition Height="*" MinHeight="300"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Vertical" Grid.Row="1" VerticalAlignment="Bottom">
                                                <StackPanel Margin="0,0,0,6" VerticalAlignment="Top">
                                                    <TextBlock Text="Ważność Badania do roku:" FontSize="14" 
                                            Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ListBox x:Name="lista_lat" ItemsSource="{Binding ValidityYearOptions}"
                                            SelectedValuePath="Years"
                                            SelectedValue="{Binding ValidityYears, Mode=TwoWay}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False"
                                            VerticalAlignment="Center" d:ItemsSource="{d:SampleData ItemCount=5}">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="{x:Type ListBoxItem}">
                                                                <Setter Property="Margin" Value="2,0"/>
                                                                <Setter Property="Padding" Value="0"/>
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                            <Border x:Name="chip"
                                                                    Background="#FF546E7A"
                                                                    CornerRadius="4"
                                                                    Padding="10,4"
                                                                    BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsSelected" Value="True">
                                                                                    <Setter TargetName="chip" Property="Background" Value="#FF1565C0"/>
                                                                                    <Setter TargetName="chip" Property="BorderBrush" Value="#FF90CAF9"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="chip" Property="Background" Value="#FF455A64"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Label}" FontSize="12" 
                                                        Foreground="White" FontWeight="SemiBold"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>

                                                    <!-- ✅ NOWY: Separator -->
                                                    <TextBlock Text="miesiąca:" FontSize="14" 
                                            Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                            VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                    <!-- ✅ NOWY: Selektor miesięcy -->
                                                    <ListBox x:Name="lista_miesiecy" ItemsSource="{Binding ValidityMonthOptions}"
                                            SelectedValuePath="Month"
                                            SelectedValue="{Binding ValidityMonth, Mode=TwoWay}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False"
                                            VerticalAlignment="Center" d:ItemsSource="{d:SampleData ItemCount=5}">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="{x:Type ListBoxItem}">
                                                                <Setter Property="Margin" Value="2,0"/>
                                                                <Setter Property="Padding" Value="0"/>
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                            <Border x:Name="chip"
                                                                    Background="#FF546E7A"
                                                                    CornerRadius="4"
                                                                    Padding="5,4"
                                                                    BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsSelected" Value="True">
                                                                                    <Setter TargetName="chip" Property="Background" Value="#FF00796B"/>
                                                                                    <Setter TargetName="chip" Property="BorderBrush" Value="#FF80CBC4"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="chip" Property="Background" Value="#FF455A64"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Label}" FontSize="11" 
                                                        Foreground="White" FontWeight="SemiBold"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                                <syncfusion:CalendarEdit Date="1/1/2020" VerticalAlignment="Bottom" Height="200"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" d:IsHidden="True">
                                        <Border MinHeight="100" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" BorderThickness="1,1,1,1" CornerRadius="8,8,8,8" Padding="10,10,10,10" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Height="374" Width="450">
                                            <StackPanel>
                                                <TextBlock Text="Dane Firmy" FontWeight="SemiBold" FontSize="12" 
                                                Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                <TextBlock Margin="6,4,0,0" FontSize="16" 
                                                Text="{Binding SelectedSkierowanie.Firma_Nazwa}" 
                                                TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                <Grid Margin="6,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="NIP" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                        <TextBlock Text="{Binding SelectedSkierowanie.Firma_NIP}" 
                                                        FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border MinHeight="100" BorderThickness="1,1,1,1" CornerRadius="8,8,8,8" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" Padding="10,10,10,10" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" d:IsHidden="True" Height="374" Width="450">
                                            <StackPanel>
                                                <TextBlock Text="Dane Pacjenta" FontWeight="SemiBold" FontSize="12" 
                                                Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                <Grid Margin="6,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="165.6"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} {1}">
                                                                <Binding Path="SelectedSkierowanie.P_imie"/>
                                                                <Binding Path="SelectedSkierowanie.P_nazwisko"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Width="156">
                                                        <TextBlock Text="Pesel: " FontSize="11" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,3,0" Width="40" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                        <TextBlock FontSize="13" 
                                                        Text="{Binding SelectedSkierowanie.FormattedPesel}" 
                                                        FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Margin="6,4,0,0" FontSize="14" 
                                                Text="{Binding SelectedSkierowanie.B_Stanowisko}" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                <Grid Margin="6,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Typ" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" VerticalAlignment="Center"/>
                                                        <Border Width="40" Margin="8,0,0,0" Height="22" 
                                                        BorderBrush="#1976D2" CornerRadius="2" BorderThickness="1" Padding="3,1" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                                            <TextBlock Text="{Binding SelectedSkierowanie.B_TypBadania}" 
                                                            FontSize="14" HorizontalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                        <TextBlock Text="Data Skier." FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                        <Border Margin="8,0,0,0" BorderBrush="#1976D2" BorderThickness="1" 
                                                        CornerRadius="2" Padding="3,1" Height="22">
                                                            <TextBlock Text="{Binding SelectedSkierowanie.B_DataSkierowania, StringFormat=\{0:dd-MM-yyyy\}}" 
                                                            FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                        </Border>
                                    </StackPanel>
                                </Grid>

                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>


