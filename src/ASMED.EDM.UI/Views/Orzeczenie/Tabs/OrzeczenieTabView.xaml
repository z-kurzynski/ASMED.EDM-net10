<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             x:Class="ASMED.EDM.UI.Views.Orzeczenie.Tabs.OrzeczenieTabView"
             d:DesignHeight="650" d:DesignWidth="800">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Orzeczenie" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="BadnietDatePanel" Height="50" Margin="20,0,0,0">
                        <TextBlock Text="Data Badania" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left" Foreground="#FF2C3E50"/>

                        <StackPanel x:Name="data_bad" Orientation="Horizontal" Height="30">

                            <DatePicker x:Name="Data_Badania" SelectedDate="{Binding TabDataBadania, Mode=TwoWay}" 
                                SelectedDateFormat="Short"
                                Width="140" 
                                FontSize="18"
                                ToolTip="Data Badania " Height="30" Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SkierowanieDate" Height="50" Margin="20,0,0,0">
                        <TextBlock Text="Data Skierowania" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left" Foreground="#FF2C3E50"/>

                        <StackPanel x:Name="data_bad_dzien1" Orientation="Horizontal" Height="30">

                            <DatePicker x:Name="Data_Skierowania" SelectedDate="{Binding SelectedWizyta.B_DataSkierowania, Mode=TwoWay}" 
                                SelectedDateFormat="Short"
                                Width="140" 
                                FontSize="18"
                                ToolTip="Data Skierowania" Height="30" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="WaznoscData" Height="50" Margin="20,0,0,0">
                        <TextBlock Text="Data następnego badania" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left" Foreground="#FF2C3E50"/>

                        <StackPanel x:Name="data_bad_Waznosc" Orientation="Horizontal" Height="30">

                            <DatePicker x:Name="Data_Waznosc_Badania" 
                                SelectedDate="{Binding WaznoscBadaniaDo, Mode=TwoWay}"
                                SelectedDateFormat="Short"
                                Width="140" 
                                FontSize="18"
                                ToolTip="Data następnego badania" Height="30" Foreground="{DynamicResource UI.Text.Selected}" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <GroupBox Header="Zdolność do pracy" Padding="8" Margin="10,10,10,0" BorderBrush="{DynamicResource UI.Background.Column}">
                    <StackPanel>
                        <RadioButton x:Name="zdolny" Margin="0,2" Padding="4,0,0,0" IsChecked="True">
                            <TextBlock Text="wobec braku przeciwwskazań zdrowotnych jest zdolny(-na) do wykonywania-podjęcia*) pracy na określonym stanowisku (symbol 21)*) " TextWrapping="Wrap" Foreground="#FF0E7134" Margin="0,0,0,5" FontWeight="Bold"/>
                        </RadioButton>
                        <RadioButton x:Name="niezdolny" Margin="0,2">
                            <TextBlock Text="wobec istnienia przeciwwskazań zdrowotnych jest niezdolny(-na) do wykonywania-podjęcia*) pracy na określonym stanowisku (symbol 22)*) " TextWrapping="Wrap" Margin="0,0,0,5" Foreground="{DynamicResource UI.Background.Row}" FontWeight="Bold"/>
                        </RadioButton>
                        <RadioButton x:Name="utracił_zdolnosc">
                            <TextBlock Text="wobec istnienia przeciwwskazań zdrowotnych utracił(a) zdolność do wykonywania dotychczasowej pracy z dniem ..  (symbol 23)*).  " TextWrapping="Wrap" Foreground="{DynamicResource UI.Background.Row}" FontWeight="Bold" Margin="0,0,0,8"/>
                        </RadioButton>
                        <StackPanel Orientation="Vertical">
                            <DatePicker Width="150" HorizontalAlignment="Left" Margin="17,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,5,0,5">
                            <TextBlock Text="Uzasadnienie:" Width="132" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" VerticalScrollBarVisibility="Auto" Height="50"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Orientation="Vertical" Grid.Row="2">

            <GroupBox Header="Dane Orzecznika" Padding="8" Margin="10,0,10,5" BorderBrush="{DynamicResource UI.Background.Column}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Lekarz:" FontWeight="Bold" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrzecznikImieNazwisko}" FontSize="14" FontWeight="SemiBold" Margin="0,0,16,4" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsOrzecznikNazwaWidoczna, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,5,4" MinWidth="220" FontSize="13"
                              ItemsSource="{Binding DostepniLekarze}"
                              SelectedItem="{Binding SelectedLekarz, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              ToolTip="Wybierz lekarza (orzecznika), w imieniu którego wystawiane jest orzeczenie"
                              Visibility="{Binding IsWyborLekarzaDostepny, Converter={StaticResource BooleanToVisibilityConverter}}" MaxDropDownHeight="200"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="PWZ:" FontWeight="Bold" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding OrzecznikPwz}" FontSize="14" Margin="0,0,16,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Specjalizacja:" FontWeight="Bold" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OrzecznikSpecjalizacja}" Margin="0,0,16,4" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Izba lekarska:" FontWeight="Bold" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding OrzecznikIdIzby}" Margin="0,0,16,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Text="{Binding OrzecznikStatus}" TextWrapping="Wrap" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFC0392B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOrzecznikGotowy}" Value="True">
                                        <Setter Property="Foreground" Value="#FF0E7134"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="4"
                            Content="🩺 Dane EDM"
                            Command="{Binding EdytujDaneOrzecznikaCommand}"
                            ToolTip="Uzupełnij / edytuj swoje dane lekarza wymagane do podpisu w EDM"
                            VerticalAlignment="Center" Padding="10,4" MinWidth="110" Cursor="Hand"/>
                </Grid>
            </GroupBox>

            <StackPanel Orientation="Horizontal" Height="39" HorizontalAlignment="Right">
                <Syncfusion:ButtonAdv Label="Podpisz"
                    Command="{Binding ZatwierdzCommand}" Foreground="{DynamicResource UI.Text.Primary}" BorderBrush="#FF707070" FontStyle="Normal" BorderThickness="1,1,2,2" Width="125" Background="{DynamicResource UI.Background.ButtonSuccess}" FontSize="16" IconHeight="0" IconWidth="0" Height="40"/>
                <Syncfusion:ButtonAdv Label="Drukuj"
                    Command="{Binding OrzeczeniePrintButton}" Foreground="{DynamicResource UI.Text.Primary}" FontStyle="Normal" BorderThickness="1,1,2,2" IsMultiLine="False" Width="125" Background="{DynamicResource Navigation.TabActive}" FontSize="16" IconHeight="0" IconWidth="0" Height="40"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
