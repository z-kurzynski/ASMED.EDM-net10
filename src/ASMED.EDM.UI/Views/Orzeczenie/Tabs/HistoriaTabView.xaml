<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Class="ASMED.EDM.UI.Views.Orzeczenie.Tabs.HistoriaTabView"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="5">
        <Grid.Resources>
            <Style x:Key="ColoredCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="#FF4CAF50"/>
                        <Setter Property="BorderBrush" Value="#FF2E7D32"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="False">
                        <Setter Property="Background" Value="#FFE9F7DB"/>
                        <Setter Property="BorderBrush" Value="#FFA2A2A2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Historia Orzeczeń Pacjenta" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

        <Button Grid.Row="1" Content="&#x2190; Wróć" Width="90" Height="30" HorizontalAlignment="Left" Margin="0,0,0,8"
                Command="{Binding WrocCommand}"/>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding PacjentImieNazwisko}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Najpóźniejsza data ważności do: " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding NajpozniejszaDataDo, StringFormat={}{0:dd-MM-yyyy}}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Historia}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" FontSize="12" Margin="0,0,0,2" Padding="0,5,0,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding B_ID}" Width="50"/>
                <DataGridTextColumn Header="Typ" Binding="{Binding B_Typ}" Width="30"/>
                <DataGridTextColumn Header="Data Skier." Binding="{Binding B_DataSkierowania, StringFormat={}{0:dd-MM-yyyy}}" Width="90"/>
                <DataGridTextColumn Header="Data Rej." Binding="{Binding R_Data, StringFormat={}{0:dd-MM-yyyy}}" Width="90"/>
                <DataGridTextColumn Header="Data Bad." Binding="{Binding Bad_Data, StringFormat={}{0:dd-MM-yyyy}}" Width="90"/>
                <DataGridTextColumn Header="Data Waż." Binding="{Binding Bad_Data_Do, StringFormat={}{0:dd-MM-yyyy}}" Width="90"/>
                <DataGridCheckBoxColumn Header="Laryn." Binding="{Binding B_laryngolog}" Width="40" ElementStyle="{StaticResource ColoredCheckBoxStyle}"/>
                <DataGridCheckBoxColumn Header="Okul." Binding="{Binding B_okulista}" Width="40" ElementStyle="{StaticResource ColoredCheckBoxStyle}"/>
                <DataGridCheckBoxColumn Header="Książ." Binding="{Binding B_ksiazeczka}" Width="40" ElementStyle="{StaticResource ColoredCheckBoxStyle}"/>
                <DataGridCheckBoxColumn Header="Urlop" Binding="{Binding B_Urlop}" Width="40" ElementStyle="{StaticResource ColoredCheckBoxStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
