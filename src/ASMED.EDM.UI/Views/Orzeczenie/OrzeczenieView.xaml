<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:wizytyview="clr-namespace:ASMED.EDM.UI.Views.wizytyview" xmlns:syncfusion="http://schemas.syncfusion.com/wpf" x:Class="ASMED.EDM.UI.Views.Orzeczenie.OrzeczenieView"
    xmlns:m="clr-namespace:Syncfusion.AI.AgentTools.Core;assembly=Syncfusion.DocumentSDK.AI.AgentTools"
    xmlns:tabs="clr-namespace:ASMED.EDM.UI.Views.Orzeczenie.Tabs" xmlns:converters="clr-namespace:ASMED.EDM.UI.Converters"
    mc:Ignorable="d"
             Background="#FFF5F5F5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <converters:TypBadaniaContainsConverter x:Key="TypBadaniaContainsConverter"/>
        <!-- Kolor tła przycisku: -->
        <Style x:Key="BistabilnyButtonStyle" TargetType="syncfusion:ButtonAdv">
            <Setter Property="Background" Value="{x:Null}"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontStyle"  Value="Italic"/>
            <Setter Property="IconHeight" Value="0"/>
            <Setter Property="IconWidth"  Value="0"/>
            <Setter Property="Content"    Value=""/>
        </Style>

        <!-- Dwukolorowy przycisk typu Toggle (filtr statusu) -->
        <Style x:Key="ToggleFilterButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#FFBDBDBD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FF1976D2"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Background" Value="#FFBDBDBD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="strona" Margin="5,5,5,5">
        <Border x:Name="ramka_strony"
                BorderThickness="1,1,1,1"
                CornerRadius="8"
                Padding="10,0,10,10"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="top" Height="55">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="Row_0_0_Header" Orientation="Vertical" VerticalAlignment="Center" Grid.Column="1">
                        <StackPanel Height="50" Width="405" HorizontalAlignment="Left">
                            <TextBlock Text="Wyszukaj Pacjenta" FontSize="12" FontWeight="Bold"
                                Margin="0,0,0,2" HorizontalAlignment="Left"/>
                            <DockPanel>
                                <TextBox x:Name="txtSearchPacjent"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Height="28" Width="247" FontSize="14"/>
                                <Button Width="32" Height="28" Margin="8,0,0,0"
                                    ToolTip="Wyczyść pole"
                                   
                                    Content="✖"/>
                                <ComboBox Width="100" Height="28" FontSize="14" Margin="10,0,8,0"
                                    SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ItemsSource="{Binding FilterTypes}"
                                    HorizontalAlignment="Left"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="DefaultDatePanel" Grid.Column="2" VerticalAlignment="Top" Height="50" HorizontalAlignment="Left" Margin="5,0,0,0" Width="185">
                        <TextBlock Text="Domyślna Data" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left" Foreground="#FF2C3E50"/>

                        <StackPanel x:Name="data_bad_dzien" Orientation="Horizontal" Height="38">

                            <syncfusion:SfDatePicker x:Name="Data_Badania" Value="{Binding CustomDefaultDate, Mode=TwoWay}" 
                                FormatString="dd.MM.yyyy"
                                Width="120" 
                                FontSize="18"
                                ToolTip="Data która będzie ustawiana jako Data Badania przy wyborze karty" Height="30"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="odśwież"
                        Grid.Column="8"
                        Height="46" Width="46"
                        Content="🔃"
                        Background="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"
                        Foreground="#FFFBFBFB"
                        Margin="0,5,5,0"
                        Click="RefreshList_Click"
                        HorizontalAlignment="Left"
                        FontSize="22"
                        VerticalAlignment="Top"/>
                    <StackPanel x:Name="Row_0_1_button" Orientation="Horizontal" Grid.Column="9" HorizontalAlignment="Right">
                        <Button Content="Lista Orzeczeń" 
                                HorizontalAlignment="Center"
                                Height="45"
                                VerticalAlignment="Top"
                                Width="220"
                                Command="{Binding OpenSkierPacjWoborCommand}"
                                Background="#FF009688"
                                Foreground="#FFFBFBFB"
                                FontSize="16" 
                                Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="srodek_Badanie" Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="boder_lewa" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" BorderThickness="1" Padding="10,10,10,10" CornerRadius="8,8,8,8" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,10">
                                <StackPanel Orientation="Vertical">
                                    <TextBox TextWrapping="Wrap" Text="Lista pacjentów" Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" FontWeight="Bold" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <ToggleButton Content="Rejestracja"
                                        Style="{StaticResource ToggleFilterButtonStyle}"
                                        IsChecked="{Binding ShowRejestracja, Mode=TwoWay}"
                                        Width="70" HorizontalAlignment="Right" Margin="5,0,0,0"/>
                                    <ToggleButton Content="Wizyta"
                                        Style="{StaticResource ToggleFilterButtonStyle}"
                                        IsChecked="{Binding ShowWizyta, Mode=TwoWay}"
                                        Width="70" HorizontalAlignment="Right" Margin="5,0,0,0"/>
                                    <ToggleButton Content="Wywiad"
                                        Style="{StaticResource ToggleFilterButtonStyle}"
                                        IsChecked="{Binding ShowWywiad, Mode=TwoWay}"
                                        Width="70" HorizontalAlignment="Right" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <syncfusion:SfDataGrid x:Name="Lista_Wizyt" ItemsSource="{Binding Wizyty}"
                                AutoGenerateColumns="False"
                                LiveDataUpdateMode="AllowChildViewUpdate"
                                SelectedItem="{Binding SelectedWizyta, Mode=TwoWay}"
                                AlternationCount="2"
                                RowHeight="50"
                                ColumnSizer="Star"
                                FontSize="15"
                                AllowFiltering="True"
                                AllowSorting="True"
                                SelectionMode="Single"
                                SelectionUnit="Row"
                                FontFamily="Arial Narrow"
                                Padding="2,2,2,2"
                                RowSelectionBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" 
                                CurrentCellBorderBrush="{x:Null}" OpacityMask="#FFFFFDFD" 
                                RenderTransformOrigin="0.5,0.5" Height="572">
                                <syncfusion:SfDataGrid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform AngleY="0"/>
                                        <RotateTransform/>
                                        <TranslateTransform Y="0"/>
                                    </TransformGroup>
                                </syncfusion:SfDataGrid.RenderTransform>

                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn MappingName="B_typ" HeaderText="Typ" Width="30" IsReadOnly="True" TextAlignment="Center" />

                                    <syncfusion:GridTemplateColumn HeaderText="Pacjent" AllowFiltering="False" MappingName="P_nazwisko">
                                        <syncfusion:GridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,4,6,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" FontSize="16" Padding="0" Background="Transparent">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} {1}">
                                                                <Binding Path="P_imie"/>
                                                                <Binding Path="P_nazwisko"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>

                                                    <TextBlock Grid.Row="1" FontSize="12" Margin="0,6,0,0"
                                                        Background="{x:Null}" Padding="0"
                                                        TextWrapping="Wrap" Text="{Binding P_Firma}" FontStyle="Italic" Foreground="{DynamicResource UI.Background.Column}" />
                                                </Grid>
                                            </DataTemplate>

                                        </syncfusion:GridTemplateColumn.CellTemplate>
                                    </syncfusion:GridTemplateColumn>

                                    <syncfusion:GridTemplateColumn HeaderText="Status" Width="70" AllowFiltering="False" MappingName="Firma_Nazwa">
                                        <syncfusion:GridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                        CornerRadius="4"
                                                        Padding="4,4,4,4"
                                                        Margin="0,8,0,8">
                                                    <TextBlock Text="{Binding StatusWizytyTekst, Mode=OneWay}"
                                                               FontSize="10"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>

                                        </syncfusion:GridTemplateColumn.CellTemplate>
                                    </syncfusion:GridTemplateColumn>

                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="border_Pacjent" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" Grid.Column="1" Margin="8,0,0,0" CornerRadius="8,8,8,8" Padding="5,5,5,5" BorderThickness="1,1,1,1" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="Dane_Pacjent_Firma" VerticalAlignment="Center">
                                <Border MinHeight="100" BorderThickness="1,1,1,1" CornerRadius="8,8,8,8" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" Padding="10,10,10,10" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="0,0,0,5">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Dane Pacjenta" FontWeight="SemiBold" FontSize="12" 
                                                    Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Pesel: " FontSize="11" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                <TextBlock FontSize="13" 
                                                    Text="{Binding SelectedWizyta.FormattedPesel}" 
                                                    FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" MinWidth="80"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Data Skier." FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" VerticalAlignment="Center" Margin="8,-4,0,0"/>
                                                <Border Margin="8,0,0,0" BorderBrush="#1976D2" BorderThickness="1" 
                                                    CornerRadius="2" Padding="3,1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="Data_skier_pacjent" Text="{Binding SelectedWizyta.B_DataSkierowania, StringFormat=\{0:dd-MM-yyyy\}}" 
                                                        FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" VerticalAlignment="Center" MinWidth="80"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource UI.Text.Secondary}" Margin="6,5,6,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="SelectedWizyta.P_imie"/>
                                                    <Binding Path="SelectedWizyta.P_nazwisko"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Foreground="{DynamicResource UI.Text.Secondary}" Margin="6,5,6,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1} {2}">
                                                    <Binding Path="SelectedWizyta.P_KodPocztowy"/>
                                                    <Binding Path="SelectedWizyta.P_Miasto"/>
                                                    <Binding Path="SelectedWizyta.P_Adres"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Margin="6,5,6,0" FontSize="14" 
                                            Text="{Binding SelectedWizyta.B_Stanowisko}" Foreground="{DynamicResource UI.Text.Selected}" FontWeight="Bold"/>

                                        <Grid Margin="6,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Typ" FontSize="11" Foreground="{DynamicResource UI.Text.Secondary}" VerticalAlignment="Center"/>
                                                <Border Width="50" Margin="8,0,0,0" 
                                                    BorderBrush="#1976D2" CornerRadius="2" BorderThickness="1" Padding="3,1">
                                                    <TextBlock Text="{Binding SelectedWizyta.B_TypBadania}" 
                                                        FontSize="14" HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0" Grid.Column="1">
                                                <syncfusion:ButtonAdv x:Name="BT_Wstepne" Content="" Label="Wstępne" IconHeight="0" IconWidth="0" Width="65" FontSize="11" HorizontalAlignment="Right" Margin="4,0,0,0" IsEnabled="{Binding IsWizytaSelected}" Command="{Binding ToggleWstepneCommand}">
                                                    <syncfusion:ButtonAdv.Style>
                                                        <Style TargetType="{x:Type syncfusion:ButtonAdv}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedWizyta.B_TypBadania}" Value="W">
                                                                    <Setter Property="Background" Value="#FFEDD21E"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </syncfusion:ButtonAdv.Style>
                                                </syncfusion:ButtonAdv>
                                                <syncfusion:ButtonAdv x:Name="BT_Kontrolne" Content="" Label="Kontrolne" IconHeight="0" IconWidth="0" Width="65" FontSize="11" HorizontalAlignment="Right" Margin="3,0,0,0" IsEnabled="{Binding IsWizytaSelected}" Command="{Binding ToggleKontrolneCommand}">
                                                    <syncfusion:ButtonAdv.Style>
                                                        <Style TargetType="{x:Type syncfusion:ButtonAdv}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedWizyta.B_TypBadania, Converter={StaticResource TypBadaniaContainsConverter}, ConverterParameter=K}" Value="True">
                                                                    <Setter Property="Background" Value="#FFEDD21E"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </syncfusion:ButtonAdv.Style>
                                                </syncfusion:ButtonAdv>
                                                <syncfusion:ButtonAdv x:Name="BT_Okresowe" Content="" Label="Okresowe" Width="65" IconHeight="0" IconWidth="0" FontSize="11" HorizontalAlignment="Right" Margin="3,0,0,0" IsEnabled="{Binding IsWizytaSelected}" Command="{Binding ToggleOkresoweCommand}">
                                                    <syncfusion:ButtonAdv.Style>
                                                        <Style TargetType="{x:Type syncfusion:ButtonAdv}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedWizyta.B_TypBadania, Converter={StaticResource TypBadaniaContainsConverter}, ConverterParameter=O}" Value="True">
                                                                    <Setter Property="Background" Value="#FFEDD21E"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </syncfusion:ButtonAdv.Style>
                                                </syncfusion:ButtonAdv>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>

                                </Border>

                                <Border MinHeight="82" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" BorderThickness="1,1,1,1" CornerRadius="8,8,8,8" Padding="10,10,10,10" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                    <StackPanel>
                                        <TextBlock Text="Dane Firmy" FontWeight="SemiBold" FontSize="14" 
                                            Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                        <TextBlock Margin="6,4,6,0" 
                                            Text="{Binding SelectedWizyta.Firma_Nazwa}" 
                                            TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                        <Grid Margin="6,6,6,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="NIP" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                <TextBlock Text="{Binding SelectedWizyta.Firma_NIP}" 
                                                    FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--Orzeczenie lewa dabe z karty -->
                            <StackPanel Grid.Row="1">
                                <StackPanel>
                                    <Grid x:Name="button_badania" Height="40" Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <syncfusion:ButtonAdv x:Name="BT_Badanie" Content="" Label="Badanie" IconHeight="0" IconWidth="0" FontSize="11" BorderThickness="1,1,2,2"
                                                    Command="{Binding ToggleBadanieCommand}" Foreground="{DynamicResource {x:Static SystemColors.DesktopBrushKey}}" FontStyle="Normal" IsEnabled="{Binding IsWizytaSelected}">
                                            <syncfusion:ButtonAdv.Style>
                                                <Style TargetType="{x:Type syncfusion:ButtonAdv}" BasedOn="{StaticResource BistabilnyButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBadanieActive}" Value="True">
                                                            <Setter Property="Background" Value="#FF68F390"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </syncfusion:ButtonAdv.Style>
                                        </syncfusion:ButtonAdv>
                                        <!-- dodaj bad Laryngologiczne do karty badan -->
                                        <syncfusion:ButtonAdv x:Name="BT_Laryngolog" Content="" Label="Laryngolog" IconHeight="0" IconWidth="0" FontSize="11" FontStyle="Normal" Grid.Column="1" Margin="2,0,0,0"
                                                    Command="{Binding ToggleLaryngologCommand}" Foreground="{DynamicResource {x:Static SystemColors.DesktopBrushKey}}" BorderThickness="1,1,2,2" IsEnabled="{Binding IsWizytaSelected}">
                                            <syncfusion:ButtonAdv.Style>
                                                <Style TargetType="{x:Type syncfusion:ButtonAdv}" BasedOn="{StaticResource BistabilnyButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLaryngologActive}" Value="True">
                                                            <Setter Property="Background" Value="#FFEDD21E"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </syncfusion:ButtonAdv.Style>
                                        </syncfusion:ButtonAdv>
                                        <!-- dodaj bad. okulistyczne do karty badan -->
                                        <syncfusion:ButtonAdv x:Name="BT_okulista" Content="" Label="okulista" IconHeight="0" IconWidth="0" FontSize="11" FontStyle="Normal" Grid.Column="2" Margin="2,0,0,0"
                                                    Command="{Binding ToggleOkulistaCommand}" Foreground="{DynamicResource {x:Static SystemColors.DesktopBrushKey}}" BorderThickness="1,1,2,2" IsEnabled="{Binding IsWizytaSelected}">
                                            <syncfusion:ButtonAdv.Style>
                                                <Style TargetType="{x:Type syncfusion:ButtonAdv}" BasedOn="{StaticResource BistabilnyButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOkulistaActive}" Value="True">
                                                            <Setter Property="Background" Value="#FFEDD21E"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </syncfusion:ButtonAdv.Style>
                                        </syncfusion:ButtonAdv>
                                        <!-- otworz krtę badania saniternego -->
                                        <syncfusion:ButtonAdv x:Name="BT_Sanitarne" Label="Sanitarne" Grid.Column="3" Margin="2,0,0,0"
                                                    Command="{Binding ToggleSanitarneCommand}" Foreground="{DynamicResource {x:Static SystemColors.DesktopBrushKey}}" BorderBrush="#FF707070" FontStyle="Normal" BorderThickness="1,1,2,2" IsEnabled="{Binding IsWizytaSelected}">
                                            <syncfusion:ButtonAdv.Style>
                                                <Style TargetType="{x:Type syncfusion:ButtonAdv}" BasedOn="{StaticResource BistabilnyButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSanitarneActive}" Value="True">
                                                            <Setter Property="Background" Value="#FFEDD21E"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </syncfusion:ButtonAdv.Style>
                                        </syncfusion:ButtonAdv>
                                        <!-- otwórz kartę urlopu -->
                                        <syncfusion:ButtonAdv x:Name="BT_Urlop" Label="Urlop" Grid.Column="4" Margin="2,0,0,0"
                                                    Command="{Binding ToggleUrlopCommand}" Foreground="Black" FontStyle="Normal" BorderThickness="1,1,2,2" IsMultiLine="False" IsEnabled="{Binding IsWizytaSelected}">
                                            <syncfusion:ButtonAdv.Style>
                                                <Style TargetType="{x:Type syncfusion:ButtonAdv}" BasedOn="{StaticResource BistabilnyButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUrlopActive}" Value="True">
                                                            <Setter Property="Background" Value="#FFEDD21E"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </syncfusion:ButtonAdv.Style>
                                        </syncfusion:ButtonAdv>
                                    </Grid>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Bottom">

                                    <!-- ✅ NOWY: Separator -->
                                    <StackPanel x:Name="waznos_do_rok" Orientation="Vertical">
                                        <TextBlock Text="Ważność Badania do roku:" FontSize="14" 
                                            Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                        <ListBox x:Name="lista_lat" ItemsSource="{Binding ValidityYearOptions}"
                                            SelectedValuePath="Years"
                                            SelectedValue="{Binding ValidityYears, Mode=TwoWay}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False" d:ItemsSource="{d:SampleData ItemCount=5}" Height="30">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="Margin" Value="2,0"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                <Border x:Name="chip"
                                                                    Background="#FF546E7A"
                                                                    CornerRadius="4"
                                                                    Padding="10,4"
                                                                    BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="chip" Property="Background" Value="#FF1565C0"/>
                                                                        <Setter TargetName="chip" Property="BorderBrush" Value="#FF90CAF9"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="chip" Property="Background" Value="#FF455A64"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" FontSize="12" 
                                                        Foreground="White" FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="miesiąca:" FontSize="14" 
                                            Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>

                                        <ListBox x:Name="lista_miesiecy" ItemsSource="{Binding ValidityMonthOptions}"
                                            SelectedValuePath="Month"
                                            SelectedValue="{Binding ValidityMonth, Mode=TwoWay}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False" d:ItemsSource="{d:SampleData ItemCount=5}" Height="30">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="Margin" Value="2,0"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                <Border x:Name="chip"
                                                                    Background="#FF546E7A"
                                                                    CornerRadius="4"
                                                                    Padding="5,4"
                                                                    BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="chip" Property="Background" Value="#FF00796B"/>
                                                                        <Setter TargetName="chip" Property="BorderBrush" Value="#FF80CBC4"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="chip" Property="Background" Value="#FF455A64"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" FontSize="11" 
                                                        Foreground="White" FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                                        <syncfusion:CalendarEdit x:Name="Calenar_Data_Do" Date="{Binding WaznoscBadaniaDo, Mode=TwoWay}" MinWidth="0"/>
                                    </StackPanel>

                                    <!-- ✅ NOWY: Separator -->

                                    <!-- ✅ NOWY: Selektor miesięcy -->
                                </StackPanel>
                            </StackPanel>


                            <!--Orzeczenie prawa dokumenty -->
                            <StackPanel Grid.Row="2" MinHeight="50" VerticalAlignment="Bottom">
                                <Grid x:Name="button_comand" Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Anuluj -->
                                    <syncfusion:ButtonAdv Content="" Label="Anuluj" IconHeight="0" IconWidth="0" FontSize="16" BorderThickness="1,1,2,2"
                                        Command="{Binding AnulujCommand}" Foreground="{DynamicResource UI.Text.Primary}" FontStyle="Normal" Width="125" Background="{DynamicResource UI.Background.ButtonError}"/>

                                    <!-- Drukuj -->
                                    <syncfusion:ButtonAdv Label="Drukuj" Grid.Column="1" Margin="2,0,0,0"
                                        Command="{Binding OrzeczeniePrintButton}" Foreground="{DynamicResource UI.Text.Primary}" FontStyle="Normal" BorderThickness="1,1,2,2" IsMultiLine="False" Width="125" Background="{DynamicResource UI.Background.Button}" FontSize="16" IconHeight="0" IconWidth="0"/>

                                    <!-- Zatwierdź -->
                                    <syncfusion:ButtonAdv Label="Zatwierdź" Grid.Column="2" Margin="2,0,0,0"
                                        Command="{Binding ZatwierdzCommand}" Foreground="{DynamicResource UI.Text.Primary}" BorderBrush="#FF707070" FontStyle="Normal" BorderThickness="1,1,2,2" Width="125" Background="{DynamicResource UI.Background.ButtonSuccess}" FontSize="16" IconHeight="0" IconWidth="0"/>
                                </Grid>
                            </StackPanel>




                        </Grid>
                    </Border>
                    <Border x:Name="prawa_wywiad" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" BorderThickness="1,1,1,1" CornerRadius="8,8,8,8" Margin="8,0,0,0" Padding="10,10,10,10" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Grid.Column="2">
                        <TabControl TabStripPlacement="Top"
                                            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                            <TabItem x:Name="_0_Orzeczenie" Header="Orzeczenie">
                                <tabs:OrzeczenieTabView/>
                            </TabItem>
                            <TabItem x:Name="_1_Historia" Header="Historia">
                                <tabs:HistoriaTabView x:Name="HistoriaTab"/>
                            </TabItem>
                            <TabItem x:Name="_2_KartaBadan" Header="Karta Badań" Visibility="Collapsed">
                                <tabs:KartaBadanTabView/>
                            </TabItem>
                            <TabItem x:Name="_3_Laryngolog" Header="Laryngolog"
                                             Visibility="{Binding IsLaryngologActive, Converter={StaticResource BoolToVis}}">
                                <tabs:BadanieLaryngologiczneTabView/>
                            </TabItem>
                            <TabItem x:Name="_4_Okulista" Header="Okulista"
                                             Visibility="{Binding IsOkulistaActive, Converter={StaticResource BoolToVis}}">
                                <tabs:BadanieOkulistyczneTabView/>
                            </TabItem>
                            <TabItem x:Name="_5_zalecenia" Header="Zalecenia dla pacjenta" Visibility="Collapsed">
                                <tabs:ZalecaniaTabView/>
                            </TabItem>
                            <TabItem x:Name="_6_BadSanitarne" Header="Bad. sanitarne"
                                             Visibility="{Binding IsSanitarneActive, Converter={StaticResource BoolToVis}}">
                                <tabs:BadaniaSanitarneTabView/>
                            </TabItem>
                            <TabItem x:Name="_7_Urlop" Header="Urlop dla por. zdr."
                                             Visibility="{Binding IsUrlopActive, Converter={StaticResource BoolToVis}}">
                                <tabs:UrlopTabView/>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
