<UserControl x:Class="ASMED.EDM.UI.Views.Migration.MigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ASMED.EDM.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MigrationViewModel}"
             Background="#FFF5F5F5">

    <UserControl.Resources>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFD0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="RightAlignCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding"       Value="0,0,4,0"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Konfiguracja -->
            <RowDefinition Height="Auto"/>   <!-- Narzędzia bazy -->
            <RowDefinition Height="Auto"/>   <!-- Lista tabel -->
            <RowDefinition Height="Auto"/>   <!-- Postęp -->
            <RowDefinition Height="Auto"/>   <!-- Weryfikacja -->
            <RowDefinition Height="Auto"/>   <!-- Log -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SEKCJA 1: KONFIGURACJA                                         -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource SectionBorder}">
            <StackPanel>
                <TextBlock Text="⚙️ Konfiguracja migracji" Style="{StaticResource SectionTitle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lewa: Plik Access -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Plik bazy Access (źródło):" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding AccessDatabasePath, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,5"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Ścieżka do pliku .accdb lub .mdb"/>
                            <Button Grid.Column="1"
                                    Content="📂 Przeglądaj"
                                    Command="{Binding BrowseAccessCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Background="#FF555555"
                                    Margin="5,0,0,0"
                                    Padding="10,5"/>
                        </Grid>
                        <Button Content="🔌 Testuj połączenie Access"
                                Command="{Binding TestAccessCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#FF0078D7"
                                Margin="0,5,0,0"
                                Padding="10,5"
                                HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Prawa: Baza MySQL -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Docelowa baza MySQL:" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding MySqlDatabases}"
                                  SelectedItem="{Binding SelectedMySqlDatabase}"
                                  DisplayMemberPath="DisplayName"
                                  Padding="6,5"
                                  FontSize="12"/>
                        <Button Content="🔌 Testuj połączenie MySQL"
                                Command="{Binding TestMySqlCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#FF0078D7"
                                Margin="0,5,0,0"
                                Padding="10,5"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SEKCJA 1b: NARZĘDZIA BAZY DANYCH                              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource SectionBorder}">
            <StackPanel>
                <TextBlock Text="🛠️ Narzędzia bazy danych" Style="{StaticResource SectionTitle}"/>

                <!-- Przywracanie z kopii -->
                <TextBlock Text="♻️ Przywróć bazę z kopii zapasowej (.sql):"
                           FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding RestoreFilePath, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,5" FontSize="12" VerticalContentAlignment="Center"
                             ToolTip="Ścieżka do pliku .sql z kopią zapasową"/>
                    <Button Grid.Column="1"
                            Content="📂 Przeglądaj"
                            Command="{Binding BrowseRestoreFileCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#FF555555"
                            Margin="5,0,0,0" Padding="10,5"/>
                    <Button Grid.Column="2"
                            Content="♻️ Przywróć do wybranej bazy"
                            Command="{Binding RestoreBackupCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#FFE65100"
                            Margin="5,0,0,0" Padding="10,5"
                            ToolTip="Przywraca kopię SQL do bazy wybranej w sekcji Konfiguracja"/>
                </Grid>

                <!-- Kopiowanie MySQL → MySQL -->
                <TextBlock Text="📋 Kopiuj bazę MySQL → MySQL:"
                           FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding MySqlDatabases}"
                              SelectedItem="{Binding CopySourceDatabase}"
                              Padding="6,5" FontSize="12"
                              ToolTip="Baza źródłowa"/>
                    <TextBlock Grid.Column="1"
                               Text="→"
                               FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0" Foreground="#FF1565C0"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding MySqlDatabases}"
                              SelectedItem="{Binding CopyTargetDatabase}"
                              Padding="6,5" FontSize="12"
                              ToolTip="Baza docelowa"/>
                    <Button Grid.Column="3"
                            Content="📋 Kopiuj bazę"
                            Command="{Binding CopyDatabaseCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#FF1565C0"
                            Margin="10,0,0,0" Padding="10,5"
                            ToolTip="Kopiuje zaznaczone tabele (lub wszystkie) ze źródła do celu"/>
                </Grid>
                <TextBlock Text="Jeśli tabele są zaznaczone — kopiowane są tylko one. Jeśli nic nie zaznaczono — kopiowane są wszystkie tabele."
                           FontSize="10" Foreground="Gray" Margin="0,4,0,0" FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SEKCJA 2: LISTA TABEL                                          -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource SectionBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Nagłówek + przyciski zaznaczania -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📋 Tabele do migracji" Style="{StaticResource SectionTitle}" Margin="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Zaznacz wszystkie"
                                Command="{Binding SelectAllTablesCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#FF4CAF50"
                                Padding="8,4"/>
                        <Button Content="Odznacz wszystkie"
                                Command="{Binding DeselectAllTablesCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#FFFF5722"
                                Padding="8,4"
                                Margin="0"/>
                    </StackPanel>
                </Grid>

                <!-- Grupy tabel w ScrollViewer -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TableGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="True" Margin="0,0,0,6">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsAllSelected}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding GroupName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Tables}" Margin="20,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Content="{Binding DisplayName}"
                                                          Margin="0,2,20,2"
                                                          FontSize="12"
                                                          VerticalContentAlignment="Center"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SEKCJA 3: POSTĘP I AKCJE                                       -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource SectionBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Pasek postępu całkowitego -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Całość:" FontSize="11" VerticalAlignment="Center" Foreground="Gray"/>
                    <ProgressBar Grid.Column="1"
                                 Value="{Binding OverallProgress}"
                                 Maximum="100"
                                 Height="14"
                                 Foreground="#FF0078D7"
                                 Background="#FFE0E0E0"
                                 BorderThickness="0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding OverallProgress, StringFormat={}{0:F0}%}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- Pasek postępu tabeli -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tabela:" FontSize="11" VerticalAlignment="Center" Foreground="Gray"/>
                    <ProgressBar Grid.Column="1"
                                 Value="{Binding TableProgress}"
                                 Maximum="100"
                                 Height="14"
                                 Foreground="#FF4CAF50"
                                 Background="#FFE0E0E0"
                                 BorderThickness="0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding TableProgress, StringFormat={}{0:F0}%}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- Status + przyciski akcji -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="#FF444444"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Kopia zapasowa -->
                        <Button Content="💾 Kopia zapasowa"
                                Command="{Binding CreateBackupCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#FF795548"
                                IsEnabled="{Binding IsNotBusy}"
                                ToolTip="Utwórz kopię zapasową zaznaczonych tabel MySQL przed migracją"/>

                        <!-- Start migracji -->
                        <Button Content="▶ Rozpocznij migrację"
                                Command="{Binding StartMigrationCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#FF4CAF50"
                                ToolTip="Migruje zaznaczone tabele z Access do MySQL (nadpisuje dane)"/>

                        <!-- Anuluj -->
                        <Button Content="⏹ Anuluj"
                                Command="{Binding CancelMigrationCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#FFE53935"
                                Margin="0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SEKCJA 4: WERYFIKACJA LICZBY REKORDÓW                          -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Style="{StaticResource SectionBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="0"/>
                </Grid.RowDefinitions>

                <!-- Nagłówek z przyciskiem -->
                <Grid Grid.Row="0" Margin="14,8,14,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="🔍 Weryfikacja liczby rekordów"
                               Style="{StaticResource SectionTitle}"
                               Margin="0"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="🔍 Weryfikuj"
                            Command="{Binding VerifyCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#FF1565C0"
                            ToolTip="Porównaj liczbę rekordów: Access ↔ MySQL"/>
                </Grid>

                <!-- Tabela wyników (widoczna tylko gdy są wyniki) -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding VerificationResults}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          FontSize="11"
                          Margin="14,0,14,8"
                          MaxHeight="200"
                          Visibility="{Binding VerificationResults.Count,
                                       Converter={StaticResource CountToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tabela"
                                           Binding="{Binding TableName}"
                                           Width="160"/>
                        <DataGridTextColumn Header="Access"
                                           Binding="{Binding AccessCount}"
                                           Width="70"
                                           ElementStyle="{StaticResource RightAlignCell}"/>
                        <DataGridTextColumn Header="MySQL"
                                           Binding="{Binding MySqlCount}"
                                           Width="70"
                                           ElementStyle="{StaticResource RightAlignCell}"/>
                        <DataGridTextColumn Header="Różnica"
                                           Binding="{Binding DiffText}"
                                           Width="70"
                                           ElementStyle="{StaticResource RightAlignCell}"/>
                        <DataGridTextColumn Header="Status"
                                           Binding="{Binding StatusIcon}"
                                           Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SEKCJA 5: LOG OPERACJI                                         -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="5" Style="{StaticResource SectionBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="📄 Log operacji"
                           Style="{StaticResource SectionTitle}"
                           Margin="14,10,14,4"/>
                <ScrollViewer Grid.Row="1"
                              x:Name="LogScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="#FF1E1E1E"
                              Margin="0,0,0,0">
                    <ItemsControl ItemsSource="{Binding MigrationLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="#FF90EE90"
                                           Margin="10,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
