                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding PriceBasicText}" 
                                                FontSize="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="DarkBlue"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PriceLaryngologistText}" 
                                                FontSize="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="DarkBlue"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PriceOphthalmologistText}" 
                                                FontSize="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="DarkBlue"/>
                                    <TextBlock Grid.Column="3" Text="{Binding PriceSanitaryText}" 
                                                FontSize="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="DarkBlue"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PriceLipidogramText}" 
                                                FontSize="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="DarkBlue"/>
                                    <TextBlock Grid.Column="5" Text="{Binding PriceEKGText}" 
                                                FontSize="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="DarkBlue"/>
                                    <TextBlock Grid.Column="6" Text="{Binding PriceHealthClinicText}" 
                                                FontSize="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="DarkBlue"/>
                                    <TextBlock Grid.Column="7" Text="{Binding PriceOtherText}" 
                                                FontSize="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="DarkBlue"/>
                                </Grid>
                                <!-- Wartości (TextBoxy) -->
                                <Grid x:Name="Wybrane_Ceny" Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Cena1, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                                FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                                Height="28" TextAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding Cena2, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                                FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                                Height="28" TextAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding Cena3, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                                FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                                Height="28" TextAlignment="Center"/>
                                    <TextBox Grid.Column="3" Text="{Binding Cena4, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                                FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                                Height="28" TextAlignment="Center"/>
                                    <TextBox Grid.Column="4" Text="{Binding Cena5, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}"
                                                FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                                Height="28" TextAlignment="Center"/>
                                    <TextBox Grid.Column="5" Text="{Binding Cena6, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                                FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                                Height="28" TextAlignment="Center"/>
                                    <TextBox Grid.Column="6" Text="{Binding Cena7, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                                FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                                Height="28" TextAlignment="Center"/>
                                    <TextBox Grid.Column="7" Text="{Binding Cena8, Mode=TwoWay, StringFormat=\{0:0\}, UpdateSourceTrigger=PropertyChanged}" 
                                                FontSize="18" FontWeight="Bold" Margin="2,2,2,2" 
                                                Height="28" TextAlignment="Center"/>
                                </Grid>

                                <!-- Przyciski toggle -->
                                <Grid x:Name="Przyciski_Wyboru" Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="btnNewToggleBasic" Grid.Column="0" 
                                                Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                                Click="ToggleNewExamination_Click" 
                                                Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Tag="Basic"/>

                                    <Button x:Name="btnNewToggleLaryngologist" Grid.Column="1" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                                Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click" 
                                                Tag="Laryngologist"/>

                                    <Button x:Name="btnNewToggleOphthalmologist" Grid.Column="2" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                                Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click"
                                                Tag="Ophthalmologist"/>
                                    <Button x:Name="btnNewToggleSanitary" Grid.Column="3" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                                Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click" 
                                                Tag="Sanitary"/>
                                    <Button x:Name="btnNewToggleLipidogram" Grid.Column="4" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                                Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click"
                                                Tag="Lipidogram"/>
                                    <Button x:Name="btnNewToggleEKG" Grid.Column="5" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                                Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click" 
                                                Tag="EKG"/>
                                    <Button x:Name="btnNewToggleHealthClinic" Grid.Column="6" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                                Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click" 
                                                Tag="HealthClinic"/>
                                    <Button x:Name="btnNewToggleOther" Grid.Column="7" Content="✗ NIEAKTYWNE" Height="32" Margin="2" 
                                                Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" 
                                                Click="ToggleNewExamination_Click"
                                                Tag="Other"/>
                                </Grid>

                                <!-- Suma - nagłówek -->
                                <Grid x:Name="Suma_Header" Grid.Row="4" Visibility="Collapsed">
                                    <TextBlock Text="SUMA:" FontSize="13" FontWeight="Bold" 
                                                HorizontalAlignment="Right" Margin="0,8,10,0"/>
                                </Grid>

                                <!-- Suma - wartość -->
                                <Grid x:Name="Suma_Wartość" Grid.Row="5" Margin="0,15,0,0">
                                    <TextBlock Text="{Binding SumaText}" FontSize="18" FontWeight="Bold" 
                                                HorizontalAlignment="Right" Foreground="#FF81FD4A" Margin="0,0,10,8" Height="25"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="Status_Info" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,20,20,0" Grid.Row="2" HorizontalAlignment="Right" Height="41" Width="507">
                        <!-- Ankieta: icon colored green when true, gray when false -->
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Książeczka" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" TextWrapping="Wrap" />
                            <Ellipse x:Name="elipse_ksiazeczka" Width="24" Height="24" Stroke="Transparent">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="#FFC1C0C0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDetails.B_ksiazeczka}" Value="True">
                                                <Setter Property="Fill" Value="#FF09D070" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.ToolTip>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="Nie" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDetails.B_ksiazeczka}" Value="True">
                                                        <Setter Property="Text" Value="Tak" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Ellipse.ToolTip>
                            </Ellipse>
                        </StackPanel>

                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Urlop (zdrowie)" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" TextWrapping="Wrap" Margin="10,0,10,0" />
                            <Ellipse x:Name="elipse_urlop" Width="24" Height="24" Stroke="Transparent">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="#FFC1C0C0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDetails.B_Zaswiadczenie}" Value="True">
                                                <Setter Property="Fill" Value="#FF09D070" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.ToolTip>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="Nie" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDetails.B_Zaswiadczenie}" Value="True">
                                                        <Setter Property="Text" Value="Tak" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Ellipse.ToolTip>
                            </Ellipse>
                        </StackPanel>
                        <!-- Ankieta: icon colored green when true, gray when false -->
                        <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                            <TextBlock Text="Ankieta" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <Ellipse x:Name="elipse_ankieta" Width="24" Height="24" Stroke="Transparent">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="#FFC1C0C0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDetails.B_Ankieta}" Value="True">
                                                <Setter Property="Fill" Value="#FF09D070" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.ToolTip>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="Nie" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDetails.B_Ankieta}" Value="True">
                                                        <Setter Property="Text" Value="Tak" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Ellipse.ToolTip>
                            </Ellipse>
                        </StackPanel>

                        <!-- Wywiad: icon colored green when true, gray when false -->
                        <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                            <TextBlock Text="Wywiad" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="10,0,10,1" />
                            <Ellipse x:Name="elipse_wywiad" Width="24" Height="24" Stroke="Transparent">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="#FFC1C0C0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDetails.B_wywiad}" Value="True">
                                                <Setter Property="Fill" Value="#FF09D070" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.ToolTip>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="Nie" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDetails.B_wywiad}" Value="True">
                                                        <Setter Property="Text" Value="Tak" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Ellipse.ToolTip>
                            </Ellipse>
                        </StackPanel>

                        <!-- Orzeczenie: icon colored green when true, gray when false -->
                        <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                            <TextBlock Text="Orzeczenie" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <Ellipse x:Name="elipse_orzeczenie" Width="24" Height="24" Stroke="Transparent">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="#FFC1C0C0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDetails.B_orzeczenie}" Value="True">
                                                <Setter Property="Fill" Value="#FF09D070" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.ToolTip>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="Nie" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDetails.B_orzeczenie}" Value="True">
                                                        <Setter Property="Text" Value="Tak" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Ellipse.ToolTip>
                            </Ellipse>
                        </StackPanel>

                        <!-- ID pola: B_orzeczenie_ID i B_edm_document_id -->
                        <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                            <TextBlock Text="Orzeczenie ID" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <TextBox Text="{Binding SelectedDetails.B_orzeczenie_ID, Mode=TwoWay}" Width="70" Height="22" FontSize="14" Background="{x:Null}" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" HorizontalAlignment="Right" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                            <TextBlock Text="EDM Doc ID" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <TextBox Text="{Binding SelectedDetails.B_edm_document_id, Mode=TwoWay}" Width="70" Height="22" FontSize="14" Background="{x:Null}" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Zawartość edycji -->
                    <StackPanel Grid.Row ="3"  Orientation="Horizontal" Margin="0,13,20,0" Height="45" Width="410" HorizontalAlignment="Right">

                        <syncfusion:ButtonAdv
                                    x:Name="btnWyczysc"
                                    Height="45"
                                    Label="🔄 Wyczyść"
                                    Width="200"
                                    Background="#FF607D8B"
                                    Foreground="#FFFBFBFB"
                                    FontSize="16"
                                    Command="{Binding ClearCommand}" IconHeight="0" IconWidth="0">
                            <syncfusion:ButtonAdv.BorderBrush>
                                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                            </syncfusion:ButtonAdv.BorderBrush>
                            <syncfusion:ButtonAdv.IconTemplate>
                                <DataTemplate/>
                            </syncfusion:ButtonAdv.IconTemplate>
                        </syncfusion:ButtonAdv>
                        <syncfusion:ButtonAdv
                                    x:Name="btnSaveBadanie"
                                    Height="45"
                                    Label="💾 Zapisz Badanie"
                                    Width="200"
                                    Background="#FF1976D2"
                                    Foreground="#FFFBFBFB"
                                    FontSize="16"
                                    Command="{Binding SaveBadanieCommand}"
                                    IconHeight="0" IconWidth="0" Margin="10,0,0,0" 
                                    HorizontalAlignment="Left">
                            <syncfusion:ButtonAdv.BorderBrush>
                                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                            </syncfusion:ButtonAdv.BorderBrush>
                            <syncfusion:ButtonAdv.IconTemplate>
                                <DataTemplate/>
                            </syncfusion:ButtonAdv.IconTemplate>
                        </syncfusion:ButtonAdv>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
