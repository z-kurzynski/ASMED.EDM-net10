<UserControl x:Class="ASMED.EDM.UI.Views.badania.BadaniaNewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Width="Auto"
    Height="Auto">

    <UserControl.Resources>
        <Style TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#66000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="{x:Type Path}" x:Key="SfDataGridHeaderIconStyle">
            <Setter Property="Fill" Value="Cyan"/>
        </Style>
        
        <Style TargetType="{x:Type syncfusion:FilterToggleButton}">
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="Padding" Value="1"/>
        </Style>
        
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" VerticalAlignment="Top" Height="55">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="197"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition />
                <ColumnDefinition Width="226"/>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="8"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="Filtr" Grid.Column="1" VerticalAlignment="Top" Height="46" HorizontalAlignment="Left" Width="407">
                <TextBlock Text="Wyszukaj Kartę Badań" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>

                <DockPanel HorizontalAlignment="Left">
                    <TextBox x:Name="txtFilterTop" 
                                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                                Height="28" Width="247" FontSize="14" Margin="20,0,0,0">
                        <TextBox.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="🔍 SMART FILTER:" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="• #XXXX - Szuka dokładnie ID skierowania"/>
                                    <TextBlock Text="  Przykład: #20 → znajdzie skierowanie ID=20" Margin="5,0,0,5"/>
                                    <TextBlock Text="• Bez # - Szuka w wybranym polu"/>
                                    <TextBlock Text="  All - szuka we wszystkich polach" Margin="5,0,0,0"/>
                                    <TextBlock Text="  ID - tylko w numerze skierowania" Margin="5,0,0,0"/>
                                    <TextBlock Text="  Imię - tylko w imieniu pacjenta" Margin="5,0,0,0"/>
                                    <TextBlock Text="  Nazwisko - tylko w nazwisku pacjenta" Margin="5,0,0,0"/>
                                    <TextBlock Text="  Firma - tylko w nazwie firmy" Margin="5,0,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>

                    <Button Width="32" Height="28" Margin="10,0,0,0" 
                                ToolTip="Wyczyść pole" Click="ClearFilter_Click">
                        <Image Source="/Assets/no.png" Width="10" Height="10" IsEnabled="False" />
                    </Button>

                    <ComboBox Width="100" Height="28" FontSize="14" Margin="10,0,8,0"
                                SelectedItem="{Binding SelectedFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{Binding FilterOptions}"/>
                </DockPanel>
            </StackPanel>



            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->

            <!--  Command="{Binding OpenSkierPacjWoborCommand}" -->

            <!-- ✅ NOWY: Checkbox + DatePicker dla domyślnej daty badania (Grid.Column="2") -->
            <StackPanel x:Name="DefaultDatePanel" Grid.Column="2" VerticalAlignment="Top" Height="46" HorizontalAlignment="Left" Margin="10,0,0,0" Width="185">
                <TextBlock Text="Domyślna Data Badania" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left" Foreground="#FF2C3E50"/>

                <StackPanel x:Name="data_bad_dzien" Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding UseCustomDefaultDate, Mode=TwoWay}" 
                                Content="Użyj" 
                                VerticalAlignment="Center" 
                                FontSize="11" 
                                Margin="0,0,8,0"
                                ToolTip="Zaznacz aby używać wybranej daty jako domyślnej dla Data Badania"/>

                    <syncfusion:SfDatePicker Value="{Binding CustomDefaultDate, Mode=TwoWay}" 
                                FormatString="dd.MM.yyyy"
                                Width="120" 
                                FontSize="11"
                                ToolTip="Data która będzie ustawiana jako Data Badania przy wyborze karty"/>
                </StackPanel>
            </StackPanel>



        </Grid>
        <Grid
                    VerticalAlignment="Top" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="600"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- PRAWA KOLUMNA: Edycja badania (skopiowane 1:1 z BadaniaNewEditWindow) -->
            <!-- LEWA KOLUMNA: Lista skierowań -->
            <Border Grid.Column="0" Margin="10,0,1,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" CornerRadius="8,8,8,8" Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" VerticalAlignment="Top" Height="625" BorderThickness="1,1,1.3,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Vertical" Grid.Row="1" Margin="2,0,2,0">
                        <StackPanel Margin="10,0,0,0" Height="69">
                            <TextBlock Text="📋 Karty  Badań - Do zamknięcia Wizyty" 
                                        FontSize="16" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#FFEDEB47"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding SkierowaniaCount, StringFormat=Liczba: \{0\}}" 
                                            FontSize="12" 
                                            VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                <Button Content="🔄 Odśwież" 
                                            Command="{Binding RefreshCommand}"
                                            Background="#FF1565C0" Foreground="White"
                                            Padding="8,4" Margin="15,0,0,0"
                                            BorderThickness="0" Cursor="Hand"
                                            FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                        <syncfusion:SfDataGrid x:Name="gridSkierowania"
                                    ItemsSource="{Binding Skierowania}"
                                    SelectedItem="{Binding SelectedSkierowanie, Mode=TwoWay}"
                           AutoGenerateColumns="False"
                           AllowSorting="True"
                           AllowFiltering="True"
                           SelectionMode="Single"
                           AlternationCount="2"
                           RowHeight="60"
                           ColumnSizer="Star"
                           SelectionUnit="Row"
                           FontFamily="Arial Narrow"
                           GridLinesVisibility="Both" 
                           AllowResizingColumns="True" 
                           CurrentCellBorderBrush="{x:Null}" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Margin="2,0,2,7" RenderTransformOrigin="0.5,0.5" BorderThickness="0,0,0,0" FontSize="13" VerticalContentAlignment="Stretch" Height="545">
                            <syncfusion:SfDataGrid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform AngleY="0.308"/>
                                    <RotateTransform/>
                                    <TranslateTransform Y="1.328"/>
                                </TransformGroup>
                            </syncfusion:SfDataGrid.RenderTransform>
                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:GridTextColumn HeaderText="ID" 
                                            MappingName="B_ID" 
                                            TextAlignment="Center"
                                            Width="45"/>

                                <syncfusion:GridTextColumn HeaderText="Data" 
                                            MappingName="B_DataSkierowania" 
                                            TextAlignment="Center"
                                            Width="85"
                                            DisplayBinding="{Binding B_DataSkierowania, StringFormat=\{0:dd-MM-yyyy\}}"/>

                                <syncfusion:GridTextColumn HeaderText="Typ" 
                                            MappingName="B_TypBadania" 
                                            AllowFiltering="False"
                                            Width="40" TextAlignment="Center" />

                                <syncfusion:GridTemplateColumn HeaderText="Pacjent" 
                                            AllowFiltering="False"
                                            Width="120" AllowSorting="False">
                                    <syncfusion:GridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" 
                                                        VerticalAlignment="Center"
                                                        Padding="4,2"><Run Text="{Binding P_imie}" FontWeight="Bold"/><LineBreak/><Run Text="{Binding P_nazwisko}"/></TextBlock>
                                        </DataTemplate>
                                    </syncfusion:GridTemplateColumn.CellTemplate>
                                </syncfusion:GridTemplateColumn>

                                <syncfusion:GridTextColumn HeaderText="Firma" 
                                            MappingName="Firma_Nazwa" 
                                            TextWrapping="Wrap"
                                              />
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>
                    </StackPanel>

                    <!-- Nagłówek -->
                    <!-- Nagłówek -->
                    <!-- Lista skierowań -->
                </Grid>
            </Border>
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" CornerRadius="8,8,8,8" Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Grid.Column="1" Margin="5,0,10,0" VerticalAlignment="Top" Height="625">
                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="75"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto" MinHeight="68.3"/>
                        <RowDefinition Height="Auto" MinHeight="100"/>
                    </Grid.RowDefinitions>

                    <!-- Przyciski zapisu -->
                    <!-- Nagłówek prawej kolumny -->
                    <!-- Nagłówek prawej kolumny -->
                    <StackPanel VerticalAlignment="Top" Margin="19,11,0,0" Orientation="Horizontal" Height="21">
                        <TextBlock Text="✏️ Zakończenie Badania" 
                                    FontSize="16" FontWeight="SemiBold" 
                                    Foreground="#FFEDEB47" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="15,0,0,20" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="113"/>
                            <RowDefinition Height="Auto" MinHeight="66.96"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Wiersz 0: Dane Pacjenta i Firmy -->
                        <Grid Grid.Row="0" Height="110" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Pacjent -->
                            <Border Grid.Column="0" 
                                        BorderBrush="#FFA9CEF3" BorderThickness="1" 
                                        CornerRadius="4" Padding="8" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Dane Pacjenta" FontWeight="SemiBold" FontSize="12" 
                                                Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"/>
                                    <Grid Margin="6,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="165.6"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="SelectedSkierowanie.P_imie"/>
                                                    <Binding Path="SelectedSkierowanie.P_nazwisko"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Width="156">
                                            <TextBlock Text="Pesel: " FontSize="11" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,3,0" Width="40" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                            <TextBlock FontSize="13" 
                                                        Text="{Binding SelectedSkierowanie.FormattedPesel}" 
                                                        FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="6,4,0,0" FontSize="14" 
                                                Text="{Binding SelectedSkierowanie.B_Stanowisko}" Foreground="#FFEDEB47"/>
                                    <Grid Margin="6,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="Typ" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" VerticalAlignment="Center"/>
                                            <Border Width="40" Margin="8,0,0,0" Height="22" 
                                                        BorderBrush="#1976D2" CornerRadius="2" BorderThickness="1" Padding="3,1" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                                <TextBlock Text="{Binding SelectedSkierowanie.B_TypBadania}" 
                                                            FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                            <TextBlock Text="Data Skier." FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                            <Border Margin="8,0,0,0" BorderBrush="#1976D2" BorderThickness="1" 
                                                        CornerRadius="2" Padding="3,1" Height="22">
                                                <TextBlock Text="{Binding SelectedSkierowanie.B_DataSkierowania, StringFormat=\{0:dd-MM-yyyy\}}" 
                                                            FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Firma -->
                            <Border Grid.Column="1" 
                                        BorderBrush="#FFA9CEF3" BorderThickness="1" 
                                        CornerRadius="4" Padding="8" Margin="6,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="Dane Firmy" FontWeight="SemiBold" FontSize="12" 
                                                Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"/>
                                    <TextBlock Margin="6,4,0,0" FontSize="16" 
                                                Text="{Binding SelectedSkierowanie.Firma_Nazwa}" 
                                                TextWrapping="Wrap" FontWeight="SemiBold" Height="45" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    <Grid Margin="6,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="NIP" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                            <TextBlock Text="{Binding SelectedSkierowanie.Firma_NIP}" 
                                                        FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Cennik" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                            <ComboBox x:Name="select_cennik" 
                                                        ItemsSource="{Binding CennikList}" 
                                                        SelectedItem="{Binding SelectedCennik, Mode=TwoWay}" 
                                                        DisplayMemberPath="bn_cennik"
                                                        Width="150" Margin="6,0,0,0" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Wiersz 1: Dane Badania -->
                        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Top" Margin="1,5,0,0">

                            <!-- ✅ NOWY: Selektor lat ważności -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Top">
                                <TextBlock Text="Ważność Badania do roku:" FontSize="11" 
                                            Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ListBox x:Name="lista_lat" ItemsSource="{Binding ValidityYearOptions}"
                                            SelectedValuePath="Years"
                                            SelectedValue="{Binding ValidityYears, Mode=TwoWay}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False"
                                            VerticalAlignment="Center">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}">
                                            <Setter Property="Margin" Value="2,0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                        <Border x:Name="chip"
                                                                    Background="#FF546E7A"
                                                                    CornerRadius="4"
                                                                    Padding="10,4"
                                                                    BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="chip" Property="Background" Value="#FF1565C0"/>
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#FF90CAF9"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="chip" Property="Background" Value="#FF455A64"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" FontSize="12" 
                                                        Foreground="White" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- ✅ NOWY: Separator -->
                                <TextBlock Text="miesiąc:" FontSize="11" 
                                            Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                            VerticalAlignment="Center" Margin="10,0,6,0"/>

                                <!-- ✅ NOWY: Selektor miesięcy -->
                                <ListBox x:Name="lista_miesiecy" ItemsSource="{Binding ValidityMonthOptions}"
                                            SelectedValuePath="Month"
                                            SelectedValue="{Binding ValidityMonth, Mode=TwoWay}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False"
                                            VerticalAlignment="Center">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}">
                                            <Setter Property="Margin" Value="2,0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                        <Border x:Name="chip"
                                                                    Background="#FF546E7A"
                                                                    CornerRadius="4"
                                                                    Padding="5,4"
                                                                    BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="chip" Property="Background" Value="#FF00796B"/>
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#FF80CBC4"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="chip" Property="Background" Value="#FF455A64"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" FontSize="11" 
                                                        Foreground="White" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Pola Data Badania, Data Ważności, Wynik, Nr Księgi, etc. -->
                            <StackPanel Orientation="Horizontal" Height="40">
                                <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                    <TextBlock Text="Data Badania" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    <syncfusion:SfDatePicker x:Name="Data_Bad_Karta" Value="{Binding DataBadania, Mode=TwoWay}" 
                                                FormatString="dd.MM.yyyy" Width="140" 
                                                Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" FontWeight="Bold" AllowNull="True" AllowInlineEditing="True" SelectorFormatString="dd.MM.yyyy" SelectorItemCount="-3"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                    <TextBlock Text="Data Ważności" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    <syncfusion:SfDatePicker x:Name="Data_Waznosci_Bad" Value="{Binding DataWaznosci, Mode=TwoWay}" 
                                                FormatString="dd.MM.yyyy" Width="140" 
                                                Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" FontWeight="Bold" AllowNull="True" AllowInlineEditing="True"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="bez Daty" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="0,0,10,0"/>
                                     <Button x:Name="btnClearDates" Content="🗑️" Width="22" Height="22" FontSize="11" 
                                        Background="#FFD0D3D6" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" 
                                        Click="ClearDates_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                    <TextBlock Text="Wynik" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    <ComboBox x:Name="Wynik_Bad" ItemsSource="{Binding WynikOptions}" 
                                                SelectedItem="{Binding SelectedWynik, Mode=TwoWay}" Width="130" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                    <TextBlock Text="Nr Księgi" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    <TextBox Text="{Binding NrKsiegi, Mode=TwoWay}" Width="130" Height="22" FontSize="11"/>
                                </StackPanel>
                                <!-- Badanie Sanitarne: icon colored green when true (B_ksiazeczka), gray when false -->
                                <!-- Urlop dla poratowania zdrowia: icon colored green when true, gray when false -->
                            </StackPanel>
                        </StackPanel>

                        <!-- Wiersz 2: Wycena badania -->
                        <Border x:Name="wycena_badania" Grid.Row="2" BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Padding="10" Margin="-0.1,10,20,-10">
                            <Grid Margin="0,0,0,-17">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Nagłówki -->
                                <Grid x:Name="ceny_Nazwa_Header" Grid.Row="0" Background="#E9ECEF" Margin="3,0,3,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="Badanie" FontWeight="Bold" FontSize="10" 
                                                HorizontalAlignment="Center" Padding="3"/>
                                    <TextBlock Grid.Column="1" Text="Laryngolog" FontWeight="Bold" FontSize="10" 
                                                HorizontalAlignment="Center" Padding="3"/>
                                    <TextBlock Grid.Column="2" Text="Okulista" FontWeight="Bold" FontSize="10" 
                                                HorizontalAlignment="Center" Padding="3"/>
                                    <TextBlock Grid.Column="3" Text="Książeczka" FontWeight="Bold" FontSize="10" 
                                                HorizontalAlignment="Center" Padding="3"/>
                                    <TextBlock Grid.Column="4" Text="Lipidogram" FontWeight="Bold" FontSize="10" 
                                                HorizontalAlignment="Center" Padding="3"/>
                                    <TextBlock Grid.Column="5" Text="EKG" FontWeight="Bold" FontSize="10" 
                                                HorizontalAlignment="Center" Padding="3"/>
                                    <TextBlock Grid.Column="6" Text="Urlop" FontWeight="Bold" FontSize="10" 
                                                HorizontalAlignment="Center" Padding="3"/>
                                    <TextBlock Grid.Column="7" Text="Inne" FontWeight="Bold" FontSize="10" 
                                                HorizontalAlignment="Center" Padding="3"/>
                                </Grid>

                                <!-- Ceny z cennika -->
                                <Grid x:Name="Ceny_z_Cennika" Grid.Row="1" Background="#FFA5CDF5" Height="25" Margin="3,0,3,0">
                                    <Grid.ColumnDefinitions>
