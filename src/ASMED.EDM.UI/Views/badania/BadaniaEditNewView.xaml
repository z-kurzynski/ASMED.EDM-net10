<UserControl x:Class="ASMED.EDM.UI.Views.badania.BadaniaEditNewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Background="White"
    Width="Auto" VerticalAlignment="Top" MaxWidth="1800" MinWidth="1100" Height="720">

    <UserControl.Resources>
        <Style TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#66000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="{x:Type Path}" x:Key="SfDataGridHeaderIconStyle">
            <Setter Property="Fill" Value="Cyan"/>
        </Style>
        <Style TargetType="{x:Type syncfusion:FilterToggleButton}">
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="Padding" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Top" Width="1520">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" 
              MaxWidth="1500" MinWidth="1100" Width="1500" Height="55">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="226"/>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="Filtr" Grid.Column="0" VerticalAlignment="Top" Height="46" HorizontalAlignment="Left" Margin="20,0,0,0" Width="407">
                <TextBlock Text="Edycja Badania" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel HorizontalAlignment="Left">
                    <TextBox x:Name="txtFilterTop" Text="{Binding FilterText,UpdateSourceTrigger=PropertyChanged}" 
                             Height="28" Width="247" FontSize="14"/>
                    <Button Width="32" Height="28" Margin="10,0,0,0" ToolTip="Wyczyść pole" Click="ClearFilter_Click">
                        <Image Source="/Assets/no.png" Width="10" Height="10" />
                    </Button>
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="10,0,8,0"
                        SelectedItem="{Binding SelectedFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding FilterOptions}"/>
                </DockPanel>
            </StackPanel>
        </Grid>

        <Grid Height="695" Grid.Row="1" VerticalAlignment="Top" Margin="0,-10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="580"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- TODO: Full examination edit form -->
            <Border Grid.Column="0" VerticalAlignment="Top" Height="625" Background="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" 
                    BorderThickness="1,1,1,1" CornerRadius="8,8,8,8" Margin="10,15,1,0">
                <TextBlock Text="Lista Badań - TODO: Implement full grid" Foreground="White" Margin="20"/>
            </Border>

            <Grid Grid.Column="1" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <TextBlock Text="Edit Examination Details - TODO: Implement full form" Margin="20"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
