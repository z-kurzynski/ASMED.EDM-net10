<UserControl x:Class="ASMED.EDM.UI.Views.Faktura.FakturaAddView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ASMED.EDM.UI.ViewModels.Faktura"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FakturaAddViewModel, IsDesignTimeCreatable=False}"
             Width="Auto" Height="Auto">

    <UserControl.Resources>
        <!-- Styl nagłówków sekcji -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#FFCDD2"/>
            <Setter Property="Margin"       Value="0,8,0,4"/>
        </Style>
        <!-- Styl etykiet -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="#B0BEC5"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Margin"            Value="0,0,8,0"/>
        </Style>
        <!-- Styl pól TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background"    Value="#263238"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="BorderBrush"   Value="#455A64"/>
            <Setter Property="Padding"       Value="6,4"/>
            <Setter Property="FontSize"      Value="12"/>
        </Style>
        <!-- Styl ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"    Value="#263238"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="BorderBrush"   Value="#455A64"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Padding"       Value="6,4"/>
        </Style>
        <!-- Styl przycisków akcji -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"    Value="#37474F"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="BorderBrush"   Value="#546E7A"/>
            <Setter Property="Padding"       Value="12,6"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Margin"        Value="4,0"/>
            <Setter Property="Cursor"        Value="Hand"/>
        </Style>
        <!-- Styl przycisku Zapisz -->
        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="BorderBrush" Value="#388E3C"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1C2B33" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Nagłówek + BusyIndicator -->
            <RowDefinition Height="Auto"/>  <!-- Firma / Cennik / Faktura -->
            <RowDefinition Height="*"/>     <!-- Dwie listy badań -->
            <RowDefinition Height="Auto"/>  <!-- Suma + Zapis -->
            <RowDefinition Height="Auto"/>  <!-- Komunikat -->
        </Grid.RowDefinitions>

        <!-- ══ NAGŁÓWEK ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Dodaj listę badań do faktury"
                       FontSize="18" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center"/>
            <!-- BusyIndicator -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="True" Width="120" Height="6"
                             Foreground="#00BCD4" Background="#37474F"/>
                <TextBlock Text="{Binding BusyMessage}" Foreground="#00BCD4"
                           Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ══ FORMULARZ — Firma / Cennik / Faktura ══════════════════════════ -->
        <Border Grid.Row="1" Background="#243440" CornerRadius="4"
                BorderBrush="#37474F" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="80"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto" MinWidth="70"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto" MinWidth="90"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto" MinWidth="80"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto" MinWidth="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Firma -->
                <TextBlock Grid.Column="0"  Text="Firma:" Style="{StaticResource FieldLabel}"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding Firmy}"
                           SelectedItem="{Binding SelectedFirma}"
                           DisplayMemberPath="Nazwa"
                           IsEnabled="{Binding IsNotBusy}"/>

                <!-- Cennik -->
                <TextBlock Grid.Column="3"  Text="Cennik:" Style="{StaticResource FieldLabel}"/>
                <ComboBox  Grid.Column="4"
                           ItemsSource="{Binding CennikNazwy}"
                           SelectedItem="{Binding SelectedCennikNazwa}"
                           IsEnabled="{Binding IsNotBusy}"/>

                <!-- Numer faktury -->
                <TextBlock Grid.Column="6"  Text="Nr faktury:" Style="{StaticResource FieldLabel}"/>
                <TextBox   Grid.Column="7"
                           Text="{Binding NumerFaktury, UpdateSourceTrigger=PropertyChanged}"
                           IsEnabled="{Binding IsNotBusy}"/>

                <!-- Data wystawienia -->
                <TextBlock Grid.Column="9"  Text="Data:"     Style="{StaticResource FieldLabel}"/>
                <DatePicker Grid.Column="10"
                            SelectedDate="{Binding DataWystawienia}"
                            Background="#263238" Foreground="White"
                            IsEnabled="{Binding IsNotBusy}"/>

                <!-- Uwagi -->
                <TextBlock Grid.Column="12" Text="Uwagi:"    Style="{StaticResource FieldLabel}"/>
                <TextBox   Grid.Column="13"
                           Text="{Binding Uwagi, UpdateSourceTrigger=PropertyChanged}"
                           IsEnabled="{Binding IsNotBusy}"/>
            </Grid>
        </Border>

        <!-- ══ DWIE LISTY BADAŃ ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lewa lista: dostępne badania -->
            <Border Grid.Column="0" Background="#243440" CornerRadius="4"
                    BorderBrush="#37474F" BorderThickness="1" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Dostępne badania"
                               Style="{StaticResource SectionHeader}"/>
                    <DataGrid ItemsSource="{Binding DostepneBadania}"
                              SelectedItem="{Binding SelectedDostepneBadanie, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Background="#1C2B33"
                              Foreground="White"
                              RowBackground="#243440"
                              AlternatingRowBackground="#1E3040"
                              BorderBrush="#37474F"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Typ"      Binding="{Binding TypBadania}"           Width="80"/>
                            <DataGridTextColumn Header="Data"     Binding="{Binding DataBadania, StringFormat=dd.MM.yyyy}" Width="85"/>
                            <DataGridTextColumn Header="Pacjent"  Binding="{Binding ImieNazwiskoPacjenta}" Width="*"/>
                            <DataGridTextColumn Header="Nr księgi" Binding="{Binding NrKsiegi}"            Width="80"/>
                            <DataGridTextColumn Header="Cena"     Binding="{Binding Cena, StringFormat=N2}" Width="65"/>
                        </DataGrid.Columns>
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick"
                                          Command="{Binding DodajBadanieCommand}"
                                          CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"/>
                        </DataGrid.InputBindings>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Środkowe przyciski przenoszenia -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Content="▶▶" ToolTip="Dodaj wszystkie"
                        Command="{Binding DodajWszystkieCommand}"
                        Style="{StaticResource ActionButton}" Margin="4,4"/>
                <Button Content="▶" ToolTip="Dodaj zaznaczone (lub dwuklik na liście)"
                        Command="{Binding DodajBadanieCommand}"
                        CommandParameter="{Binding SelectedDostepneBadanie}"
                        Style="{StaticResource ActionButton}" Margin="4,4"/>
                <Button Content="◀" ToolTip="Usuń zaznaczone"
                        Command="{Binding UsunBadanieCommand}"
                        CommandParameter="{Binding SelectedWybraneBadanie}"
                        Style="{StaticResource ActionButton}" Margin="4,4"/>
                <Button Content="◀◀" ToolTip="Usuń wszystkie"
                        Command="{Binding UsunWszystkieCommand}"
                        Style="{StaticResource ActionButton}" Margin="4,4"/>
            </StackPanel>

            <!-- Prawa lista: wybrane badania -->
            <Border Grid.Column="2" Background="#243440" CornerRadius="4"
                    BorderBrush="#37474F" BorderThickness="1" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Wybrane badania (lista do faktury)"
                               Style="{StaticResource SectionHeader}"/>
                    <DataGrid ItemsSource="{Binding WybraneBadania}"
                              SelectedItem="{Binding SelectedWybraneBadanie, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              Background="#1C2B33"
                              Foreground="White"
                              RowBackground="#1A3020"
                              AlternatingRowBackground="#163020"
                              BorderBrush="#37474F"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Typ"      Binding="{Binding TypBadania}"           Width="80"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Data"     Binding="{Binding DataBadania, StringFormat=dd.MM.yyyy}" Width="85" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Pacjent"  Binding="{Binding ImieNazwiskoPacjenta}" Width="*"   IsReadOnly="True"/>
                            <DataGridTextColumn Header="Nr księgi" Binding="{Binding NrKsiegi}"            Width="80"  IsReadOnly="True"/>
                            <!-- Cena edytowalna — użytkownik może zmienić przed zapisem -->
                            <DataGridTextColumn Header="Cena"     Binding="{Binding Cena, StringFormat=N2, UpdateSourceTrigger=LostFocus}" Width="70"/>
                        </DataGrid.Columns>
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick"
                                          Command="{Binding UsunBadanieCommand}"
                                          CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"/>
                        </DataGrid.InputBindings>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ══ SUMA + PRZYCISK ZAPISZ ═════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#243440" CornerRadius="4"
                BorderBrush="#37474F" BorderThickness="1"
                Padding="12,8" Margin="0,8,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Suma badań:" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SumaWybranych, StringFormat=N2}"
                           Foreground="#80CBC4" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" Text="Kwota brutto:" Style="{StaticResource FieldLabel}"/>
                <TextBox   Grid.Column="4"
                           Text="{Binding KwotaBrutto, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                           IsEnabled="{Binding IsNotBusy}"/>

                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Content="🔄 Odśwież"
                            Command="{Binding LoadInitialDataCommand}"
                            Style="{StaticResource ActionButton}"/>
                    <Button Content="💾 Zapisz listę"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource SaveButton}"
                            IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ KOMUNIKAT ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" CornerRadius="4" Padding="10,6" Margin="0,0,0,2"
                Visibility="{Binding Komunikat, Converter={StaticResource NullToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#B71C1C"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                            <Setter Property="Background" Value="#1B5E20"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Komunikat}"
                       Foreground="White" FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
