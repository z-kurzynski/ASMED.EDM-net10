<UserControl x:Class="ASMED.EDM.UI.Views.faktura.FakturaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:IsDesignTimeCreatable="False"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Height="Auto" Width="Auto" VerticalAlignment="Top" MaxWidth="1800" MinWidth="1100" Background="#FFF7F9FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="{x:Type Path}" x:Key="SfDataGridHeaderIconStyle">
            <Setter Property="Fill" Value="Cyan"/>
        </Style>
        <Style TargetType="{x:Type syncfusion:FilterToggleButton}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="BorderBrush" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="Auto" />
                <!-- edytor faktury -->
                <RowDefinition/>
                <!-- grid -->
                <RowDefinition Height="Auto"/>
                <!-- stopka -->
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions >

            <!-- Grid.Row="0": przyciski i wyszukiwarka -->
            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="1500" MinWidth="1100" Width="1500" Height="55">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="515"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="195"/>
                    <ColumnDefinition Width="195"/>
                    <ColumnDefinition Width="195"/>
                    <ColumnDefinition Width="197"/>
                    <ColumnDefinition Width="8"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Height="46">
                    <TextBlock Text="Wyszukaj :" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                    <DockPanel>
                        <TextBox x:Name="txtSearchFaktura" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="180" FontSize="14" HorizontalAlignment="Left" />
                        <Button Width="32" Height="28" Margin="8,0,0,0" ToolTip="Wyczyść pole" Command="{Binding ClearSearchTextCommand}">
                            <TextBlock Text="✖" FontSize="10" />
                        </Button>

                        <ComboBox x:Name="Filtr_lista" Width="80" Height="28" FontSize="14" Margin="5,0,8,0"
                              SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding FilterTypes}" HorizontalAlignment="Left"/>

                        <ComboBox x:Name="Filtr_Okresu" Width="140" Height="28" FontSize="14" Margin="5,0,8,0"
                              SelectedItem="{Binding SelectedDateFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding DateFilterOptions}" HorizontalAlignment="Left"
                              ToolTip="Filtr według okresu dat"/>
                    </DockPanel>
                </StackPanel>
                <syncfusion:ButtonAdv x:Name="refresh_list" Grid.Column="3" 
                                      HorizontalAlignment="Right" Height="45" Label="🔃 Odśwież Listę" 
                                      VerticalAlignment="Top" Width="180" 
                                      Background="#FFFF5722" Foreground="#FFFBFBFB" 
                                      FontSize="16" Margin="0,10,10,0" IconHeight="0" IconWidth="0" 
                                      Click="RefreshList_Click"  >
                    <syncfusion:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion:ButtonAdv.IconTemplate>
                </syncfusion:ButtonAdv>
                <syncfusion:ButtonAdv x:Name="soldo_button" HorizontalAlignment="Right"
                                          Grid.Column="4"
                                          Height="45" Label="🔄 przelicz -Soldo" VerticalAlignment="Top"
                                          Width="180"
                                          Background="#FF607D8B" Foreground="#FFFFFFFF" FontSize="14"
                                          ToolTip="Oblicz i zapisz saldo = Faktura - Badanie (dla pozycji z Badanie&gt;0)" 
                                          IconHeight="0" IconWidth="0" Margin="0,10,10,0">
                    <syncfusion:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion:ButtonAdv.IconTemplate>
                </syncfusion:ButtonAdv>
                <syncfusion:ButtonAdv x:Name="import_faktur" Grid.Column="5" 
                                      HorizontalAlignment="Left" 
                                      Height="45" Label=" ➕ Import z FK" 
                                      VerticalAlignment="Top" Width="180" 
                                      Background="#FF009688" Foreground="#FFFBFBFB" 
                                      FontSize="16" Margin="0,10,0,0" 
                                      IconHeight="0" IconWidth="0">
                    <syncfusion:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion:ButtonAdv.IconTemplate>
                </syncfusion:ButtonAdv>

                <syncfusion:ButtonAdv x:Name="nowa_faktura" Grid.Column="6" 
                                      HorizontalAlignment="Left" Height="45" 
                                      Label=" ➕ Nowa Faktura" 
                                      VerticalAlignment="Top" Width="180" 
                                      Background="#FF009688" Foreground="#FFFBFBFB" 
                                      FontSize="16" Margin="0,10,0,0" 
                                      Click="NewInvoice_Click" IconHeight="0" IconWidth="0"  >
                    <syncfusion:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion:ButtonAdv.IconTemplate>
                </syncfusion:ButtonAdv>
            </Grid>

            <!-- Grid.Row="1": Edytor nowej faktury -->
            <Border Grid.Row="1" Margin="10,0,20,6" 
                    Padding="8,3,8,4" Background="#FFF7F7F7" 
                    CornerRadius="4" BorderBrush="#FFD0D0D0" 
                    BorderThickness="1" VerticalAlignment="Top" MinHeight="2">
                <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <StackPanel x:Name="NewInvoice" Orientation="Horizontal" 
                                Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                            <TextBlock Text="Firma" FontSize="12" FontWeight="Bold"/>
                            <DockPanel>
                                <TextBox Width="380" IsReadOnly="True" Text="{Binding NewFirmaName}" Height="25" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" />
                                <Button Content="Wybierz..." Margin="6,0,0,0" Click="BtnSelectFirma_Click" FontSize="11" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                            <TextBlock Text="Numer faktury" FontSize="12" FontWeight="Bold"/>
                            <TextBox Width="150" Text="{Binding NewNumer, UpdateSourceTrigger=PropertyChanged}" Height="25" FontSize="11" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                            <TextBlock Text="Data" FontSize="12" FontWeight="Bold"/>
                            <DatePicker SelectedDate="{Binding NewData}" Width="140" Height="25" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                            <TextBlock Text="Kwota Faktury" FontSize="12" FontWeight="Bold"/>
                            <TextBox Width="120" Text="{Binding NewKwota, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Height="25" FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Kwota Badanie" FontSize="12" FontWeight="Bold"/>
                            <TextBox Width="120" Text="{Binding NewBadSuma, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Height="25" FontSize="11" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Margin="10,0,12,0">
                            <TextBlock Text="Status" FontSize="12" FontWeight="Bold"/>
                            <ComboBox Width="140" SelectedValue="{Binding NewStatus}" SelectedValuePath="Tag" Height="25" FontSize="11">
                                <ComboBoxItem Tag="1" FontSize="11">1 - Nowa</ComboBoxItem>
                                <ComboBoxItem Tag="2" FontSize="11">2 - Lista</ComboBoxItem>
                                <ComboBoxItem Tag="3" FontSize="11">3 - Zamknięta</ComboBoxItem>
                                <ComboBoxItem Tag="4" FontSize="11">4 - Anulowana</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                            <Button x:Name="Dodaj_Fakture" 
                                    Content="Dadaj Fakturę" 
                                    Padding="12,6" Margin="6,0,0,0" 
                                    Click="AddInvoice_Click"
                                    Background="#FF1976D2" 
                                    Foreground="#FFFDFCFC" FontSize="14" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="CustomDateRangePanel" Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding IsCustomDateRangeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Top">
                        <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                            <TextBlock Text="Data Od:" FontSize="12" FontWeight="Bold"/>
                            <DatePicker Width="140" Height="25" SelectedDate="{Binding FilterDateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                            <TextBlock Text="Data Do:" FontSize="12" FontWeight="Bold"/>
                            <DatePicker Width="140" Height="25" SelectedDate="{Binding FilterDateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                            <Button Content="Zastosuj filtr" Padding="8,4" Command="{Binding ApplyCustomDateFilterCommand}" 
                                    Background="#FF1976D2" Foreground="White" BorderThickness="0" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Grid.Row="2": SfDataGrid z edycją -->
            <syncfusion:SfDataGrid  Grid.Row="2"
                                    x:Name="FakturaGrid"
                                    ItemsSource="{Binding FilteredFaktura}"
                                    AutoGenerateColumns="False"
                                    RowHeight="45"
                                    ColumnSizer="Star"
                                    FontSize="16"
                                    AllowFiltering="True"
                                    AllowSorting="True"
                                    SelectionMode="Single"
                                    AllowEditing="True"
                                    EditTrigger="OnTap"
                                    SelectionUnit="Row"
                                    FontFamily="Arial Narrow"
                                    MaxWidth="1500" MinWidth="1400"
                                    CurrentCellBorderBrush="{x:Null}" 
                                    OpacityMask="#FFFFFDFD" 
                                    Height="475" 
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Top" 
                                    Width="1480" 
                                    Margin="10,0,0,0">

                <syncfusion:SfDataGrid.Columns>
                    <!-- ID (tylko do odczytu) -->
                    <syncfusion:GridTextColumn 
                        MappingName="Id" HeaderText="ID" 
                        Width="60" IsReadOnly="True" 
                        HorizontalHeaderContentAlignment="Center" 
                        AllowFiltering="False" 
                        TextAlignment="Right" 
                        VerticalAlignment="Center" 
                        Padding="0,0,2,2" />

                    <!-- Lista (template z kolorem, readonly) -->
                    <syncfusion:GridTemplateColumn MappingName="Lista" HeaderText="L" 
                                                   Width="20" IsReadOnly="True" 
                                                   AllowSorting="False" 
                                                   AllowFiltering="False" 
                                                   UseBindingValue="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="2" CornerRadius="2"
                                        Background="#FF4CAF50">
                                    <TextBlock Text="{Binding Lista}" HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" FontWeight="Normal" 
                                               FontSize="10" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <!-- Numer_Faktury (edytowalne) -->
                    <syncfusion:GridTextColumn 
                        MappingName="Numer_Faktury" 
                        HeaderText="Numer_Faktury" 
                        Width="100" 
                        TextAlignment="Right" 
                        VerticalAlignment="Center"
                        IsCaseSensitiveFilterRow="false" 
                        Padding="0,0,5,0" 
                        AllowEditing="True" 
                        IsReadOnly="False"/>

                    <!-- Data (edytowalne) -->
                    <syncfusion:GridDateTimeColumn 
                        MappingName="Data" HeaderText="Data" Width="100" 
                        HorizontalHeaderContentAlignment="Center" Padding="5,0,2,0" 
                        AllowEditing="True"
                        Pattern="ShortDate"/>

                    <!-- Firma (edytowalne) -->
                    <syncfusion:GridTextColumn 
                        x:Name="Firma" MappingName="Firma" HeaderText="Firma" 
                        TextWrapping="Wrap" HorizontalHeaderContentAlignment="Left" Padding="3,0,0,0" 
                        AllowEditing="True" IsReadOnly="True" SetCellBoundValue="False"/>

                    <!-- Kwota (edytowalne, numeric) -->
                    <syncfusion:GridNumericColumn 
                        MappingName="Kwota" HeaderText="Faktura" Width="80" 
                        Padding="0,0,2,0" ImmediateUpdateColumnFilter="True"
                        NumberDecimalDigits="2"
                        AllowEditing="True"/>

                    <!-- Kwota_B (edytowalne, numeric) -->
                    <syncfusion:GridNumericColumn 
                        MappingName="Kwota_B" HeaderText="Badanie" Width="80" 
                        Padding="0,0,5,0"
                        NumberDecimalDigits="2"
                        AllowEditing="True"/>

                    <!-- Saldo (edit template) -->
                    <syncfusion:GridTemplateColumn 
    x:Name="Saldo" MappingName="Saldo" HeaderText="Saldo" Width="80" 
    AllowEditing="True"
    IsCaseSensitiveFilterRow="False" 
    Padding="0,0,2,0" 
    HorizontalAlignment="Right">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock TextAlignment="Right" 
                       VerticalAlignment="Center" 
                       Padding="4,0,8,0" 
                       Text="{Binding Saldo, StringFormat={}{0:N2}}" 
                       Margin="0,0,10,0"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                        <syncfusion:GridTemplateColumn.EditTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Saldo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                     TextAlignment="Right" 
                     VerticalAlignment="Center"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.EditTemplate>
                    </syncfusion:GridTemplateColumn>

                    <!-- Zapisz (command do zapisu wiersza) -->
                    <syncfusion:GridTemplateColumn HeaderText="Zapisz" Width="50" 
                                                   AllowSorting="False" 
                                                   AllowFiltering="False" 
                                                   Padding="10,0,0,0">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Height="45" Width="50" Background="#1976D2" Foreground="White" ToolTip="Zapisz zmiany"
                                    Command="{Binding DataContext.UpdateFakturaCommand, RelativeSource={RelativeSource AncestorType=syncfusion:SfDataGrid}}"
                                    CommandParameter="{Binding}">
                                    <TextBlock Text="💾" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <!-- ✅ DODANE: Usuń (command do usunięcia faktury) -->
                    <syncfusion:GridTemplateColumn HeaderText="Usuń" Width="50" 
                                                   AllowSorting="False" 
                                                   AllowFiltering="False" 
                                                   Padding="5,0,0,0">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Height="45" Width="50" Background="#F44336" Foreground="White" ToolTip="Usuń fakturę (tylko bez przypisanej listy)"
                                    Command="{Binding DataContext.DeleteFakturaCommand, RelativeSource={RelativeSource AncestorType=syncfusion:SfDataGrid}}"
                                    CommandParameter="{Binding}">
                                    <TextBlock Text="🗑️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <!-- Grid.Row="3": Stopka z podsumowaniem -->
            <DockPanel Grid.Row="3" Margin="600,8,0,5" LastChildFill="False" HorizontalAlignment="Left" Height="41" VerticalAlignment="Top" Width="800">
                <TextBlock Text="Razem:" FontWeight="Bold" VerticalAlignment="Top" Margin="0,0,12,0"/>
                <StackPanel Orientation="Horizontal" Height="40" Width="800" VerticalAlignment="Top" >
                    <TextBlock Text="Suma_FK: " Margin="0,0,6,0" Foreground="#FF1976D2" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding TotalKwotaText}" FontWeight="Bold" Margin="0,0,16,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Suma_Bad.: " Margin="0,0,6,0" Foreground="#FF1976D2" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding TotalKwotaBText}" FontWeight="Bold" Margin="0,0,16,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Saldo: " Margin="0,0,6,0" Foreground="#FF1976D2" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding TotalSaldoText}" FontWeight="Bold" 
                               HorizontalAlignment="Left"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
