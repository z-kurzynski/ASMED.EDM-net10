<UserControl x:Class="ASMED.EDM.UI.Views.Badanie.BadanieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF5F5F5">

    <Grid Margin="20">
        <Border BorderBrush="#FF1565C0"
                BorderThickness="2"
                CornerRadius="8"
                Padding="30"
                Background="White">
            <StackPanel>
                <TextBlock Text="🔬 Badanie"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FF1565C0"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Moduł obsługi badań lekarskich — wyniki, formularze, historia badań pacjenta."
                           FontSize="14"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30"/>

                <TextBlock Text="🔧 Widok w trakcie implementacji"
                           FontSize="13"
                           Foreground="#FF666666"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>