<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    x:Class="ASMED.EDM.UI.Views.wizytyview.WizytyViewView"
    Width="Auto" 
    VerticalAlignment="Top" 
    MaxWidth="1600" 
    MinWidth="1500" Background="White">

    <UserControl.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Styles -->
        <Style TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,10,20,10" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tytuł po lewej -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Wizyty" 
                           FontSize="30" 
                           FontWeight="Bold" 
                           Foreground="#FF1976D2"/>
                <TextBlock Text="- Rejestracja wizyt" 
                           FontSize="16" 
                           FontStyle="Italic" 
                           Foreground="Gray" 
                           VerticalAlignment="Bottom" 
                           Margin="20,0,0,5"/>
            </StackPanel>

            <!-- Checkbox + DatePicker dla domyślnej daty kalendarza -->
            <StackPanel x:Name="DefaultCalendarDatePanel" Grid.Column="1" VerticalAlignment="Top" Height="46" HorizontalAlignment="Left" Margin="10,0,0,0" Width="200">
                <TextBlock Text="Data Domyślna Kalendarza" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left" Foreground="#FF2C3E50"/>

                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding UseCustomDefaultDateCalendar, Mode=TwoWay}" 
                              Content="Użyj" 
                              VerticalAlignment="Center" 
                              FontSize="11" 
                              Margin="0,0,8,0"
                              ToolTip="Zaznacz aby używać wybranej daty jako domyślnej dla kalendarza wizyt"/>

                    <DatePicker SelectedDate="{Binding CustomDefaultDateCalendar, Mode=TwoWay}" 
                                Width="130" 
                                FontSize="11"
                                IsEnabled="{Binding UseCustomDefaultDateCalendar}"
                                ToolTip="Data która będzie wyświetlana w kalendarzu przy otwarciu widoku"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Layout 3 kolumn -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Width="1480" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEWA KOLUMNA: Kalendarz -->
            <Border Grid.Column="0" 
                    BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" 
                    CornerRadius="8" 
                    Padding="10" 
                    Background="#FF6D6D6D" MaxHeight="650">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📅 Kalendarz Wizyt" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#FFEDEB47"
                                   Margin="0,0,0,5"/>
                        <Button Content="🔄 Odśwież" 
                                Height="30"
                                Background="#FF4CAF50"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" 
                                              Command="{Binding OdswiezCommand}"/>
                            </Button.InputBindings>
                        </Button>
                    </StackPanel>

                    <syncfusion:SfScheduler Grid.Row="1"
                                            x:Name="WizytyScheduler"
                                            ItemsSource="{Binding Appointments}"
                                            DisplayDate="{Binding SelectedDate, Mode=TwoWay}"
                                            EnableReminder="True"
                                            ShowBusyIndicator="True"
                                            HeaderDateFormat="dd-MM-yyyy"
                                            ViewType="Month"
                                            AllowedViewTypes="Month,Week"
                                            FontSize="10"
                                            SelectionChanged="WizytyScheduler_SelectionChanged">

                        <syncfusion:SfScheduler.MonthViewSettings>
                            <syncfusion:MonthViewSettings 
                                AppointmentDisplayCount="2"
                                MonthNavigationDirection="Horizontal"
                                ShowAgendaView="False"/>
                        </syncfusion:SfScheduler.MonthViewSettings>

                        <syncfusion:SfScheduler.DaysViewSettings>
                            <syncfusion:DaysViewSettings 
                                TimeIntervalSize="40"
                                StartHour="11"
                                EndHour="15" 
                                TimeInterval="00:05:00"
                                TimeRulerFormat="HH:mm"
                                CellRightPadding="10"
                                TimeRulerSize="60"/>
                        </syncfusion:SfScheduler.DaysViewSettings>
                    </syncfusion:SfScheduler>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Stretch" 
                          Background="#FFDDDDDD"/>

            <!-- ŚRODKOWA KOLUMNA: Lista pacjentów / Szczegóły -->
            <Border Grid.Column="2" 
                    BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" 
                    CornerRadius="8" 
                    Padding="10" 
                    Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" 
                    Width="500" 
                    HorizontalAlignment="Left" MaxHeight="650">

                <Grid Width="480" HorizontalAlignment="Left">

                    <!-- WIDOK 1: LISTA PACJENTÓW -->
                    <Grid Visibility="{Binding ShowListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10" Width="480" HorizontalAlignment="Center">
                            <TextBlock Text="👥 Pacjenci zaproszeni na wizytę" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="#FFEDEB47"
                                       Margin="0,0,0,10"/>

                            <TextBlock>
                                <Run Text="Data: " FontWeight="Bold" Foreground="White"/>
                                <Run Text="{Binding SelectedDate, StringFormat='{}{0:dd-MM-yyyy}'}" Foreground="#FFEDEB47"/>
                            </TextBlock>

                            <TextBlock Margin="0,5,0,0">
                                <Run Text="Liczba pacjentów: " FontWeight="Bold" Foreground="White"/>
                                <Run Text="{Binding PatientsForSelectedDateCount}" Foreground="#FFEDEB47"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Lista pacjentów -->
                        <syncfusion:SfDataGrid Grid.Row="1"
                                               ItemsSource="{Binding PatientsForSelectedDate}"
                                               AutoGenerateColumns="False"
                                               ColumnSizer="Star"
                                               SelectionMode="Single"
                                               FontSize="12"
                                               RowHeight="40"
                                               Margin="0,10,0,10">
                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:GridTextColumn MappingName="P_imie" HeaderText="Imię" Width="100"/>
                                <syncfusion:GridTextColumn MappingName="P_nazwisko" HeaderText="Nazwisko" Width="120"/>
                                <syncfusion:GridTextColumn MappingName="FormattedPesel" HeaderText="PESEL" Width="110"/>
                                <syncfusion:GridTextColumn MappingName="Firma_Nazwa" HeaderText="Firma" Width="150"/>
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>

                        <Button Grid.Row="2" 
                                Content="➕ Nowa karta wizyty" 
                                Height="40"
                                Background="#FF009688"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding NowaKartaCommand}"/>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" 
                          Width="5" 
                          HorizontalAlignment="Stretch" 
                          Background="#FFDDDDDD"/>

            <!-- PRAWA KOLUMNA: Szczegóły / Akcje -->
            <Border Grid.Column="4" 
                    BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" 
                    CornerRadius="8" 
                    Padding="10" 
                    Background="#FF6D6D6D" MaxHeight="650">
                <StackPanel>
                    <TextBlock Text="ℹ️ Informacje" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="#FFEDEB47"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Wybierz datę w kalendarzu aby zobaczyć pacjentów" 
                               TextWrapping="Wrap"
                               Foreground="White"
                               FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
