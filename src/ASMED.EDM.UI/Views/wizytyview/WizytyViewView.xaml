<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:syncfusion1="clr-namespace:Syncfusion.Windows.Controls.Input;assembly=Syncfusion.SfInput.Wpf"
    xmlns:converters="clr-namespace:ASMED.EDM.UI.Converters"
    x:Class="ASMED.EDM.UI.Views.wizytyview.WizytyViewView"
    Width="Auto"
    Height="Auto"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top">

    <UserControl.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>

        <!-- Styles -->
        <Style TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="10,10,10,11" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tytuł po lewej -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Wizyty"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#FF1976D2"/>
                <TextBlock Text="- Rejestracja wizyt"
                           FontSize="16"
                           FontStyle="Italic"
                           Foreground="Gray"
                           VerticalAlignment="Bottom"
                           Margin="20,0,0,5"/>
            </StackPanel>
            <!-- ✅ NOWY: Checkbox + DatePicker dla domyślnej daty kalendarza (Grid.Column="1") -->
            <StackPanel x:Name="DefaultCalendarDatePanel" Grid.Column="1" VerticalAlignment="Top" Height="46" HorizontalAlignment="Left" Margin="10,0,0,0" Width="200">
                <TextBlock Text="Data Domyślna Kalendarza" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left" Foreground="#FF2C3E50"/>

                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding UseCustomDefaultDateCalendar, Mode=TwoWay}" 
                             Content="Użyj" 
                             VerticalAlignment="Center" 
                             FontSize="11" 
                             Margin="0,0,8,0"
                             ToolTip="Zaznacz aby używać wybranej daty jako domyślnej dla kalendarza wizyt"/>

                    <DatePicker SelectedDate="{Binding CustomDefaultDateCalendar, Mode=TwoWay}" 
                               Width="130" 
                               FontSize="11"
                               IsEnabled="{Binding UseCustomDefaultDateCalendar}"
                               ToolTip="Data która będzie wyświetlana w kalendarzu przy otwarciu widoku"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Top" Height="46" Margin="50,0,10,0" Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="📊 Statystyki dnia"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,20,0">
                    <TextBlock FontSize="24"
                        FontWeight="Bold"
                        Foreground="#FF1976D2"><Run Text="{Binding TotalCount}"/></TextBlock>
                    <TextBlock Text=" / "
                        FontSize="18"
                        FontWeight="Normal"
                        Foreground="#FF666666"
                        Margin="3,0"/>
                    <!-- zrealzowane wizyty (odbyta) 
                                            <TextBlock Text="{Binding CompletedCount}"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Foreground="#FF4CAF50"/>
                                            <TextBlock Text=" / "
                                                       FontSize="18"
                                                       FontWeight="Normal"
                                                       Foreground="#FF666666"
                                                       Margin="3,0"/> -->
                    <TextBlock Text="{Binding OtherStatusCount}"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#FF4CAF50"/>
                </StackPanel>
            </StackPanel>



        </Grid>

        <!-- Layout 3 kolumn -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="470"/>
                <ColumnDefinition Width="5"/>
                <!-- Prawa kolumna: stała szerokość, nie gwiazdka, aby nie wpływać na środkową kolumnę -->
                <ColumnDefinition Width="470"/>
            </Grid.ColumnDefinitions>

            <!-- LEWA KOLUMNA: Kalendarz -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                    CornerRadius="8"
                    Padding="10"
                    Background="#FF6D6D6D" MaxHeight="650">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📅 Kalendarz Wizyt"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#FFEDEB47"
                                   Margin="0,0,0,5"/>
                        <Button Content="🔄 Odśwież"
                                Height="30"
                                Background="#FF4CAF50"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding OdswiezCommand}"/>
                    </StackPanel>

                    <syncfusion:SfScheduler Grid.Row="1"
                                            x:Name="WizytyScheduler"
                                            ItemsSource="{Binding Appointments}"
                                            EnableReminder="True"
                                            ShowBusyIndicator="True"
                                            HeaderDateFormat="dd-MM-yyyy"
                                            ViewType="Month"
                                            AllowedViewTypes="Month,Week"
                                            FontSize="10"
                                            SelectionChanged="WizytyScheduler_SelectionChanged">

                        <syncfusion:SfScheduler.MonthViewSettings>
                            <syncfusion:MonthViewSettings
                                AppointmentDisplayCount="2"
                                MonthNavigationDirection="Horizontal"
                                ShowAgendaView="False"/>
                        </syncfusion:SfScheduler.MonthViewSettings>

                        <syncfusion:SfScheduler.DaysViewSettings>
                            <syncfusion:DaysViewSettings
                                TimeIntervalSize="40"
                                StartHour="11"
                                EndHour="15"
                                TimeInterval="00:05:00"
                                TimeRulerFormat="HH:mm"
                                CellRightPadding="10"
                                TimeRulerSize="60"/>
                        </syncfusion:SfScheduler.DaysViewSettings>
                    </syncfusion:SfScheduler>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#FFDDDDDD"/>

            <!-- ═════════════════════════════════════ -->
            <!-- ✅ ŚRODKOWA KOLUMNA: LISTA PACJENTÓW -->
            <!-- ═════════════════════════════════════ -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                    CornerRadius="8"
                    Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                    HorizontalAlignment="Left" MaxHeight="650">

                <Grid HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,1,0">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <TextBlock Text="👥 Lista Pacjentów"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#FFEDEB47" Width="156"/>

                            <TextBlock Text="{Binding SelectedDateFormatted}"
                                       FontSize="14"
                                       Foreground="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                                       Width="200" Margin="20,0,0,0" VerticalAlignment="Bottom"/>
                            <TextBlock Text=" | "
                                       FontSize="14"
                                       Foreground="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}" Width="10" VerticalAlignment="Bottom"/>
                            <TextBlock Text="Pacjentów: "
                                       FontSize="12"
                                       Foreground="White" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding TotalCount}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#FFEDEB44" Width="30" VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <Grid Margin="0,10,0,0" Width="476" HorizontalAlignment="Left"
                              Visibility="{Binding ShowDetailsView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,2,5,2">
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="18"
                                             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                             BorderThickness="0"
                                             VerticalAlignment="Center"
                                             Foreground="Black"
                                             Height="24"
                                             ToolTip="Szukaj po nazwisku, imieniu lub ID skierowania. Naciśnij F2 aby wyczyścić i ustawić focus.">
                                        <TextBox.Style>
                                            <Style TargetType="{x:Type TextBox}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                                    <VisualBrush.Visual>
                                                                        <TextBlock Text="🔍 Szukaj (nazwisko/imię/ID skier.)..."
                                                                                   Foreground="Gray"
                                                                                   FontSize="14"
                                                                                   FontStyle="Italic"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Width="25"
                                            Height="25"
                                            Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                            FontSize="16"
                                            Cursor="Hand"
                                            ToolTip="Wyczyść filtr"
                                            Margin="6,0,0,0"
                                            Command="{Binding ClearSearchCommand}"/>
                                </Grid>
                            </Border>

                            <Button Grid.Column="1"
                                    x:Name="odswierz_wybrana_liste_z_kalendarza"
                                    Content="🔄"
                                    Width="40"
                                    Height="30"
                                    Background="#FF4CAF50"
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontSize="18"
                                    Cursor="Hand"
                                    ToolTip="Odśwież listę pacjentów na wybrany dzień"
                                    Command="{Binding OdswiezCommand}" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        </Grid>

                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredPacjenciNaDzien}"
                             SelectedItem="{Binding SelectedPacjent, Mode=TwoWay}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Width="476"
                             HorizontalAlignment="Left" Background="{x:Null}"
                             Visibility="{Binding ShowDetailsView, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="0,0,0,-2">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"
                                        BorderThickness="2,2,2,2"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,2"
                                        Height="65"
                                        Width="445" Background="#FFFFFCFC">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="10" Foreground="Gray"><Run Text="📋 "/><Run Text=" "/><Run Text="{Binding SkierowanieNumer, Mode=OneWay}" FontWeight="Bold" Foreground="#FF1976D2"/></TextBlock>
                                            <TextBlock FontSize="10" Margin="0,2,0,0"><Run Text="🕐 " Foreground="Gray"/><Run Text=" "/><Run Text="{Binding AppointmentTime, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding P_Imie, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding P_Nazwisko, Mode=OneWay}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Firma_Nazwa, Mode=OneWay}"
                                                   FontSize="10"
                                                   Foreground="#FF666666"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>

                                        <Border Grid.Column="3"
                                                Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                CornerRadius="4"
                                                Padding="4"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding StatusWizytyTekst, Mode=OneWay}"
                                                       FontSize="10"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- WIDOK EDYCJI DANYCH PACJENTA (środkowa kolumna) - domyślnie ukryty -->

                    <Border x:Name="dane_pacjenta_border"
                            BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="5,10,6,10"
                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            Visibility="{Binding ShowDetailsView, Converter={StaticResource BooleanToVisibilityConverter}}"
                            MaxHeight="650"
                            Grid.RowSpan="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10" HorizontalAlignment="Left" Width="476">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto" MinWidth="268"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                           Text="👤 Dane pacjenta"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FF27AE60"
                                           VerticalAlignment="Center" Height="23" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0" HorizontalAlignment="Right">
                                            <!-- Buttons moved to bottom of the middle column (see Grid.Row=1) -->
                                            <Button Grid.Column="0"
                                          Content="💾 Zapisz"
                                          Command="{Binding SaveSelectedPacjentCommand}" Margin="0,0,3,0"
                                          Background="#FF27AE60" Foreground="White"
                                          FontSize="15" FontWeight="SemiBold"
                                          BorderThickness="0" Cursor="Hand" Width="150"/>
                                            <Button Grid.Column="1"
                                          Content="◀ Powrót"
                                          Command="{Binding BackToListCommand}" Margin="3,0,0,0"
                                          Background="#FF7B8D93" Foreground="White"
                                          FontSize="15" FontWeight="SemiBold"
                                          BorderThickness="0" Cursor="Hand" Width="150"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="dane_pacjenta_edit"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="10,0,10,0.8"
                                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                        <StackPanel>


                                            <!-- Imię + Nazwisko -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <StackPanel Width="215" Margin="0,0,8,0">
                                                    <TextBlock Text="Imię:" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                                    <syncfusion:SfTextBoxExt
                                                    Text="{Binding SelectedPacjent.P_Imie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    AutoCompleteSource="{Binding ImionaItems}"
                                                    AutoCompleteMode="SuggestAppend"
                                                    TextHighlightMode="FirstOccurrence"
                                                    SearchItemPath="."
                                                    SuggestionBoxPlacement="Bottom"
                                                    MaxDropDownHeight="180"
                                                    Watermark="Imię"
                                                    Height="30" FontSize="16" FontWeight="SemiBold" Padding="4,2"/>
                                                </StackPanel>
                                                <StackPanel Width="217">
                                                    <TextBlock Text="Nazwisko:" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                                    <syncfusion:SfTextBoxExt
                                                    Text="{Binding SelectedPacjent.P_Nazwisko, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    AutoCompleteSource="{Binding NazwiskaItems}"
                                                    AutoCompleteMode="SuggestAppend"
                                                    TextHighlightMode="FirstOccurrence"
                                                    SearchItemPath="."
                                                    SuggestionBoxPlacement="Bottom"
                                                    MaxDropDownHeight="180"
                                                    Watermark="Nazwisko"
                                                    Height="30" FontSize="16" FontWeight="SemiBold" Padding="4,2" Width="206" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- PESEL + Brak + Płeć + Data urodzenia + Wiek -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <StackPanel Width="120" Margin="0,0,10,0">
                                                    <TextBlock Text="PESEL:" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SelectedPacjent.P_Pesel, Mode=TwoWay}" 
                                                    FontSize="16" FontWeight="SemiBold" Height="30"/>
                                                </StackPanel>
                                                <StackPanel Width="40" Margin="0,0,10,0">
                                                    <TextBlock Text="Brak" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                                    <CheckBox IsChecked="{Binding BrakPESEL, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                <StackPanel Width="40" Margin="0,0,10,0">
                                                    <TextBlock Text="Płeć" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SelectedPacjent.P_Plec, Mode=TwoWay}" 
                                                    FontSize="16" FontWeight="SemiBold" MaxLength="1" Height="30" Width="30"/>
                                                </StackPanel>
                                                <StackPanel Width="120" Margin="0,0,10,0">
                                                    <TextBlock Text="Data urodzenia" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                                    <DatePicker SelectedDate="{Binding SelectedPacjent.P_DataUrodzenia, Mode=TwoWay}" 
                                                    FontSize="14" Height="30"/>
                                                </StackPanel>
                                                <StackPanel Width="80">
                                                    <TextBlock Text="Wiek:" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding SelectedPacjent.Wiek, Mode=OneWay, StringFormat=\{0\} lat}" 
                                                    FontSize="16" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Ulica -->
                                            <StackPanel Margin="0,0,0,3">
                                                <TextBlock Text="Ulica numer domu" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                                <syncfusion:SfTextBoxExt
                                                Text="{Binding SelectedPacjent.P_AdresUlica, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutoCompleteSource="{Binding UliceItems}"
                                                AutoCompleteMode="SuggestAppend"
                                                TextHighlightMode="FirstOccurrence"
                                                SearchItemPath="."
                                                SuggestionBoxPlacement="Bottom"
                                                MaxDropDownHeight="180"
                                                Watermark="Ulica i numer domu"
                                                Height="30" FontSize="14" Padding="4,2"/>
                                            </StackPanel>

                                            <!-- Kod pocztowy + Miasto -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <StackPanel Width="109" Margin="0,0,10,0">
                                                    <TextBlock Text="Kod pocztowy" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SelectedPacjent.P_AdresKod, Mode=TwoWay}" 
                                                    FontSize="14" Height="30"/>
                                                </StackPanel>
                                                <StackPanel Width="319">
                                                    <TextBlock Text="Miejscowość" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                                    <syncfusion:SfTextBoxExt
                                                    Text="{Binding SelectedPacjent.P_AdresMiasto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    AutoCompleteSource="{Binding MiastoItems}"
                                                    AutoCompleteMode="SuggestAppend"
                                                    TextHighlightMode="FirstOccurrence"
                                                    SearchItemPath="."
                                                    SuggestionBoxPlacement="Bottom"
                                                    MaxDropDownHeight="180"
                                                    Watermark="Miejscowość"
                                                    Height="30" FontSize="14" Padding="4,2" HorizontalAlignment="Left" Width="312"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Stanowisko/Zawód -->
                                            <StackPanel Margin="0,0,0,3">
                                                <TextBlock Text="Stanowisko/Zawód" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                                                <syncfusion:SfTextBoxExt
                                                Text="{Binding SelectedPacjent.P_Zawod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutoCompleteSource="{Binding ZawodyItems}"
                                                AutoCompleteMode="SuggestAppend"
                                                TextHighlightMode="FirstOccurrence"
                                                SearchItemPath="."
                                                SuggestionBoxPlacement="Bottom"
                                                MaxDropDownHeight="180"
                                                Watermark="Stanowisko / zawód"
                                                Height="30" FontSize="14" Padding="4,2"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Height="47" Width="430">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="e-mail" FontSize="11" Foreground="Gray"/>
                                                        <TextBox Text="{Binding SelectedPacjent.P_Email, Mode=TwoWay}" 
                                                            FontSize="14" Height="30"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Telefon" FontSize="11" Foreground="Gray"/>
                                                        <syncfusion1:SfTextBoxExt
                                                            Text="{Binding SelectedPacjent.P_Telefon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            AutoCompleteSource="{Binding TelefonItems}"
                                                            AutoCompleteMode="SuggestAppend"
                                                            TextHighlightMode="FirstOccurrence"
                                                            SearchItemPath="."
                                                            SuggestionBoxPlacement="Bottom"
                                                            MaxDropDownHeight="180"
                                                            Watermark="Telefon"
                                                            Height="30" FontSize="14" Padding="4,2" HorizontalAlignment="Left" Width="210"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Firma -->
                                            <StackPanel>
                                                <TextBlock Text="Firma:" FontSize="11" Foreground="Gray" Margin="0,0,0,2" Padding="0,10,0,0"/>
                                                <StackPanel Panel.ZIndex="-2" Background="{x:Null}">
                                                    <TextBox x:Name="Firma_Nazwa_Dane"
                                                         Text="{Binding SelectedPacjent.Firma_Nazwa_Dane, Mode=OneWay}"
                                                         FontSize="14"
                                                         Height="28"
                                                         IsReadOnly="True"
                                                         BorderThickness="1,1,1,1"
                                                         Background="{x:Null}"
                                                         CaretBrush="{x:Null}"
                                                         Padding="0"
                                                         VerticalContentAlignment="Center"/>
                                                    <TextBox x:Name="Firma_Adres_Dane"
                                                         Text="{Binding SelectedPacjent.Firma_Adres_Dane, Mode=OneWay}"
                                                         Height="28"
                                                         IsReadOnly="True"
                                                         BorderThickness="0"
                                                         Background="{x:Null}"
                                                         CaretBrush="{x:Null}"
                                                         Padding="0"
                                                         VerticalContentAlignment="Center" FontStyle="Italic" Foreground="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- ✅ PRZYCISKI NA DOLE (Grid.Row=1) -->
                            <StackPanel Grid.Row="1" Margin="0,8,0,8">

                                <!-- Wydruki -->
                                <TextBlock Text="🖨️ Wydruki"
                                           FontSize="11"
                                           Foreground="Gray"
                                           Margin="0,0,0,4"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,0,12">
                                    <CheckBox Content="Data badania do wydruku"
                                              IsChecked="{Binding DodajDateBadaniaDoWydruku, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              FontSize="11"
                                              Foreground="Gray"/>
                                    <DatePicker SelectedDate="{Binding DataBadaniaDoWydruku, Mode=TwoWay}"
                                                Width="105" Height="24"
                                                VerticalAlignment="Center"
                                                IsEnabled="{Binding DodajDateBadaniaDoWydruku}"/>
                                </StackPanel>

                                <!-- Wiersz 1: Komplet | Karta -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="📑 Komplet"
                                            Command="{Binding PrintAllCommand}"
                                            Height="30" Margin="0,0,3,0"
                                            Background="#FF34495E" Foreground="White"
                                            FontSize="12" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand"/>
                                    <Button Grid.Column="1" Content="🗂️ Karta"
                                            Command="{Binding PrintKartaCommand}"
                                            Height="30" Margin="3,0,0,0"
                                            Background="#FF4A90E2" Foreground="White"
                                            FontSize="12" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand"/>
                                </Grid>

                                <!-- Wiersz 2: Orzecz x 2 | Sanitarne -->
                                <Grid Margin="0,5,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="📝 Orzecz. x2"
                                            Command="{Binding PrintOrzeczenieCommand}"
                                            Height="30" Margin="0,0,3,0"
                                            Background="#FF8E44AD" Foreground="White"
                                            FontSize="12" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand"/>
                                    <Button Grid.Column="1" Content="🧪 Sanitarne"
                                            Command="{Binding PrintSanitarneCommand}"
                                            Height="30" Margin="3,0,0,0"
                                            Background="#FF16A085" Foreground="White"
                                            FontSize="12" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand"/>
                                </Grid>

                                <!-- Wiersz 3: Urlop | Ankieta -->
                                <Grid Margin="0,5,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🏖️ Urlop"
                                            Command="{Binding PrintUrlopCommand}"
                                            Height="30" Margin="0,0,3,0"
                                            Background="#FFC0392B" Foreground="White"
                                            FontSize="12" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand"/>
                                    <Button Grid.Column="1" Content="📋 Ankieta"
                                            Command="{Binding PrintAnkietaCommand}"
                                            Height="30" Margin="3,0,0,0"
                                            Background="#FFD35400" Foreground="White"
                                            FontSize="12" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand"/>
                                </Grid>

                                <!-- Zapisz + Powrót -->
                                <Grid Margin="0,10,0,5" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="💾 Zapisz"
                                            Command="{Binding SaveSelectedPacjentCommand}"
                                            Height="35" Margin="0,0,3,0"
                                            Background="#FF27AE60" Foreground="White"
                                            FontSize="15" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand"/>
                                    <Button Grid.Column="1"
                                            Content="◀ Powrót"
                                            Command="{Binding BackToListCommand}"
                                            Height="35" Margin="3,0,0,0"
                                            Background="#FF7B8D93" Foreground="White"
                                            FontSize="15" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand"/>
                                </Grid>

                            </StackPanel>

                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Vertical" Width="480" HorizontalAlignment="Center"
                                Visibility="{Binding ShowDetailsView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                        <TextBlock Text="⌨️ Naciśnij F2 aby szybko wyszukać pacjenta"
                                   FontSize="9"
                                   Foreground="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,2,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!--koniec kolumny środkowej -->

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#FFDDDDDD"/>

            <!--PRAWA KOLUMNA -->
            <Grid Grid.Column="4">
                <!-- ✅ WIDOK 1: KARTA BADAŃ -->
                <Border x:Name="prawy_szczegoly_karty" BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="10"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        Visibility="{Binding ShowDetailsView, Converter={StaticResource BooleanToVisibilityConverter}}"
                        MaxHeight="650">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋 Karta badań"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#FF1976D2"
                                           />

                                    <StackPanel Orientation="Horizontal" Height="23" Margin="10,0,0,0">
                                        <!-- Buttons moved to bottom of the middle column (see Grid.Row=1) -->
                                        <Button Grid.Column="0"
                                        Content="💾 Zapisz"
                                        Command="{Binding SaveSelectedPacjentCommand}" Margin="0,0,3,0"
                                        Background="#FF27AE60" Foreground="White"
                                        FontSize="15" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand" Width="150"/>
                                        <Button Grid.Column="1"
                                        Content="◀ Powrót"
                                        Command="{Binding BackToListCommand}" Margin="3,0,0,0"
                                        Background="#FF7B8D93" Foreground="White"
                                        FontSize="15" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand" Width="150"/>
                                    </StackPanel>

                                </StackPanel>

                                <Border Background="{Binding SelectedPacjent.R_Status, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="4"
                                        Padding="3,1,3,1"
                                        Margin="0,6,0,10" Height="20">
                                    <TextBlock Text="{Binding SelectedPacjent.StatusWizytyTekst}"
                                               Foreground="White"
                                               HorizontalAlignment="Center" FontSize="14" FontFamily="Sitka Subheading"/>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋 Skierowanie: "
                                                   FontSize="11"
                                                   Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}"
                                                   Width="100"/>
                                        <TextBox Text="{Binding SelectedPacjent.SkierowanieNumer, Mode=OneWay}"
                                                 FontSize="14"
                                                 FontWeight="Bold"
                                                 Width="80" 
                                                 Height="25"
                                                 IsReadOnly="True"
                                                 HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                        <TextBlock Text="🕐 Godzina: "
                                                   FontSize="11"
                                                   Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}"
                                                   Width="100"/>
                                        <TextBox Text="{Binding SelectedPacjent.GodzinaFormatted, Mode=OneWay}"
                                                 FontSize="14"
                                                 FontWeight="Bold" 
                                                 Width="100" 
                                                 Height="25"
                                                 IsReadOnly="True"
                                                 HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </StackPanel>

                                <Separator Margin="0,5,0,10" Background="#FFDDDDDD"/>

                                <TextBlock Text="📄 Skierowanie"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#FF1976D2"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel x:Name="TYP_Badania_Wybór" Width="232">
                                        <TextBlock Text="TYP Badania" HorizontalAlignment="Left" Margin="0,0,10,5" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <RadioButton
                                                    Content="W"
                                                    GroupName="GrupaWOK"
                                                    Margin="2,0,5,0"
                                                    IsChecked="{Binding IsTypBadaniaWstepne, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    FontWeight="Bold"
                                                    ToolTip="Wstępne">
                                                    <RadioButton.BorderBrush>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                                                    </RadioButton.BorderBrush>
                                                </RadioButton>

                                                <RadioButton
                                                    Content="O"
                                                    GroupName="GrupaWOK"
                                                    Margin="2,0,5,0"
                                                    IsChecked="{Binding IsTypBadaniaPeriodyczne, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    FontWeight="Bold"
                                                    ToolTip="Okresowe/Badania Kontrolne">
                                                    <RadioButton.BorderBrush>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                                                    </RadioButton.BorderBrush>
                                                </RadioButton>

                                                <RadioButton
                                                    Content="K"
                                                    GroupName="GrupaWOK"
                                                    Margin="2,0,5,0.3"
                                                    IsChecked="{Binding IsTypBadaniaKontrolne, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    FontWeight="Bold"
                                                    ToolTip="Kontrolne">
                                                    <RadioButton.BorderBrush>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                                                    </RadioButton.BorderBrush>
                                                </RadioButton>

                                                <RadioButton
                                                    Content="K/O"
                                                    GroupName="GrupaWOK"
                                                    Margin="2,0,5,0.3"
                                                    IsChecked="{Binding IsTypBadaniaKontrolneOkresowe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    FontWeight="Bold"
                                                    ToolTip="Kontrolne/Okresowe">
                                                    <RadioButton.BorderBrush>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
                                                    </RadioButton.BorderBrush>
                                                </RadioButton>


                                            </StackPanel>

                                            <TextBox
                                                Text="{Binding SelectedPacjent.B_TypBadania, Mode=TwoWay}"
                                                Width="57"
                                                FontSize="18"
                                                ToolTip="Wybrany typ badania"
                                                TextAlignment="Center"
                                                Margin="10,0,0,0"
                                                Height="25"
                                                VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Width="122" Margin="10,0,0,0">
                                        <TextBlock Width="102" HorizontalAlignment="Left" Margin="0,0,0,5" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}"><Run Text="Data Skier"/><Run Language="pl-pl" Text="."/><Run Text=":"/></TextBlock>
                                        <DatePicker
                                            SelectedDate="{Binding SelectedPacjent.B_DataSkierowania, Mode=TwoWay}"
                                            Width="120"
                                            HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,3">
                                    <TextBlock Text="Stanowisko: "
                                               FontSize="11"
                                               Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}"
                                               Width="90" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                    <TextBox
                                        Width="420"
                                        Height="30"
                                        FontSize="16"
                                        Text="{Binding SelectedPacjent.B_Stanowisko, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <Separator Margin="0,5,0,10" Background="#FFDDDDDD"/>

                                <!-- Dokumenty -->
                                <TextBlock Text="📄 Dokumenty"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#FF1976D2"
                                           Margin="0,0,0,8"/>

                                <StackPanel Margin="0,0,0,10">
                                    <CheckBox Content="📖 Książeczka"
                                              IsChecked="{Binding SelectedPacjent.B_Ksiazeczka, Mode=TwoWay}"
                                              FontSize="18"
                                              VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" Padding="10,0,0,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                                    <CheckBox Content="✅ Urlop Dla Poratowania Zdrowia"
                                              IsChecked="{Binding SelectedPacjent.B_Zaswiadczenie, Mode=TwoWay}"
                                              FontSize="18" Background="White" Foreground="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" Margin="0,0,0,5" Padding="10,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ✅ PRZYCISKI NA DOLE (Grid.Row=1) -->
                        <StackPanel Grid.Row="1" Margin="0,8,0,8">

                            <!-- Zmiana statusu karty badań -->
                            <TextBlock Text="📋 Status karty badań"
                                       FontSize="11"
                                       Foreground="Gray"
                                       Margin="0,0,0,4"
                                       HorizontalAlignment="Center"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="📄 Dokumenty"
                                        Command="{Binding SetStatusDokumentyCommand}"
                                        Height="30" Margin="0,0,3,0"
                                        Background="#FF34495E" Foreground="White"
                                        FontSize="12" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand"/>
                                <Button Grid.Column="1"
                                        Content="🏥 w trakcie"
                                        Command="{Binding SetStatusWizytaCommand}"
                                        Height="30" Margin="3,0,0,0"
                                        Background="#FF1565C0" Foreground="White"
                                        FontSize="12" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                            <Grid Margin="0,5,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="📝 Rejestracja"
                                        Command="{Binding SetStatusRejestracjaCommand}"
                                        Height="30" Margin="0,0,3,0"
                                        Background="#FF6A1B9A" Foreground="White"
                                        FontSize="12" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand"/>
                                <Button Grid.Column="1"
                                        Content="🔒 Zamknij Badanie"
                                        Command="{Binding SetStatusZamknijCommand}"
                                        Height="30" Margin="3,0,0,0"
                                        Background="#FFC62828" Foreground="White"
                                        FontSize="12" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand"/>
                            </Grid>

                            <!-- Zapisz + Powrót -->
                            <Grid Margin="0,10,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="💾 Zapisz"
                                        Command="{Binding SaveSelectedPacjentCommand}"
                                        Height="35" Margin="0,0,3,0"
                                        Background="#FF27AE60" Foreground="White"
                                        FontSize="15" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand"/>
                                <Button Grid.Column="1"
                                        Content="◀ Powrót"
                                        Command="{Binding BackToListCommand}"
                                        Height="35" Margin="3,0,0,0"
                                        Background="#FF7B8D93" Foreground="White"
                                        FontSize="15" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand"/>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ✅ WIDOK 2: STATYSTYKI (gdy ShowStatsView = true) -->
                <!-- ═══════════════════════════════════════════ -->
                <Border x:Name="Prawy_wybrany_pacjent"
                        BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                        CornerRadius="8"
                        Padding="10,10,10,10"
                        Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                        Visibility="{Binding ShowStatsView, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left" d:IsHidden="True">

                    <Grid VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="90"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- ✅ SEKCJA 1: Statystyki dnia -->
                        <StackPanel Grid.Row="0" Margin="0,10,0,5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="415"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="💡 Wskazówka"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Kliknij na pacjenta z listy aby zobaczyć szczegóły"
                                       FontSize="11"
                                       Foreground="LightGray"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
