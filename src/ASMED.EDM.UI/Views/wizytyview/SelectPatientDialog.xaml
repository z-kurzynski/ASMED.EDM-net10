<Window x:Class="ASMED.EDM.UI.Views.wizytyview.SelectPatientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz pacjenta" Height="400" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="FilterTextBox" Grid.Row="0" Height="28" Margin="0,0,0,8" />

        <ListBox x:Name="CandidatesListBox" Grid.Row="1" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" KeyboardNavigation.TabIndex="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="0,2" Background="WhiteSmoke" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="14" />
                            <TextBlock>
                                <Run Text="PESEL: " FontWeight="SemiBold"/>
                                <Run Text="{Binding P_Pesel}" />
                                <Run Text="  |  " />
                                <Run Text="Firma: " FontWeight="SemiBold"/>
                                <Run Text="{Binding Firma_Nazwa}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click" />
            <Button Content="Anuluj" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
