<UserControl x:Class="ASMED.EDM.UI.Views.raporty.WizytyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="Auto" Width="Auto" VerticalAlignment="Top" MaxWidth="1800" MinWidth="1100" Background="#FFB9D1EA">

    <UserControl.Resources>
        <!-- ✅ Converter Bool → Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- ✅ NOWE: Template dla standardowego tooltipa (Karty, Badania, Wizyty) -->
        <DataTemplate x:Key="TooltipTemplate">
            <Border Background="#FF333333" 
                    BorderBrush="#FF666666" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="10,6">
                <StackPanel>
                    <!-- Miesiąc -->
                    <TextBlock Text="{Binding Item.MiesiacNazwa}" 
                               FontWeight="Bold" 
                               FontSize="13" 
                               Foreground="White"/>

                    <!-- Nazwa serii + Wartość -->
                    <TextBlock FontSize="12" Foreground="White" Margin="0,4,0,0">
                        <Run Text="{Binding Series.Label}" FontWeight="SemiBold"/>
                        <Run Text=": "/>
                        <Run Text="{Binding Item.YValue}" FontWeight="Bold" Foreground="#FF4CAF50"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ✅ NOWE: Template dla tooltipa Wartość [zł] (pokazuje ORYGINALNĄ wartość) -->
        <DataTemplate x:Key="TooltipWartoscTemplate">
            <Border Background="#FF333333" 
                    BorderBrush="#FF4CAF50" 
                    BorderThickness="2" 
                    CornerRadius="4" 
                    Padding="10,6">
                <StackPanel>
                    <!-- Miesiąc -->
                    <TextBlock Text="{Binding Item.MiesiacNazwa}" 
                               FontWeight="Bold" 
                               FontSize="13" 
                               Foreground="White"/>

                    <!-- Wartość ORYGINALNA (nie skalowana) -->
                    <TextBlock FontSize="12" Foreground="White" Margin="0,4,0,0">
                        <Run Text="Wartość: " FontWeight="SemiBold"/>
                        <Run Text="{Binding Item.WartoscBadan, StringFormat='{}{0:N2} zł'}" 
                             FontWeight="Bold" 
                             Foreground="#FF4CAF50"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ✅ Style dla DataGrid -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF0F8FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE3F2FD"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <Border Grid.Row="0" 
                Background="#FF2196F3" 
                Padding="15,10" 
                Margin="0,0,0,10" 
                CornerRadius="8,8,0,0">
            <TextBlock Text="📊 Raporty Wizyt" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="White"/>
        </Border>

        <!-- Zawartość -->
        <Border Grid.Row="1" 
                BorderBrush="#FF1976D2" 
                BorderThickness="2" 
                CornerRadius="8" 
                Background="White" 
                Padding="15">
            <TextBlock Text="Szczegółowe raporty wizyt zostaną dodane w późniejszym etapie rozwoju aplikacji." 
                       FontSize="14" 
                       Foreground="#FF666666"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
