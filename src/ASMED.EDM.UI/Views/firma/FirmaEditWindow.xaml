<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        x:Class="ASMED.EDM.UI.Views.Firma.FirmaEditWindow"
        Title="{Binding WindowTitle}"
        Height="650" Width="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize" Background="#FFF7F9FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłowek z wyszukiwaniem NIP -->
        <Border Grid.Row="0" Background="#FF2196F3" Padding="15">
            <StackPanel>
                <TextBlock Text="Wyszukaj firmę po NIP (GUS REGON + Biała Lista VAT)" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="White"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding NipDoWyszukania, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             ToolTip="Wpisz 10-cyfrowy NIP bez myslnikow"/>

                    <Button Grid.Column="2"
                            Content="🔍 Pobierz dane po NIP"
                            Command="{Binding PobierzDanePoNIPCommand}"
                            Height="35"
                            Width="200"
                            Background="#FF4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>

                <TextBlock Text="GUS REGON: wszystkie firmy + nazwa skrócona. Biała Lista VAT: fallback."
                           FontSize="11"
                           Foreground="#FFEEEEEE"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Formularz -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
            <StackPanel Margin="18,10,20,20" VerticalAlignment="Top">

                <!-- Cennik -->
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="NIP" Orientation="Vertical" Width="300" Margin="10,0,0,0">
                        <TextBlock Text="NIP:" FontWeight="Bold"/>
                        <TextBox Text="{Binding NIP, UpdateSourceTrigger=PropertyChanged}"
                            Height="35"
                            FontSize="16" VerticalAlignment="Center" Margin="0,-3,0,0"
                         />

                    </StackPanel>
                    <StackPanel x:Name="REGON" Orientation="Vertical" Width="342" Margin="20,0,0,0">
                        <TextBlock Text="REGON:" FontWeight="Bold" Width="60" HorizontalAlignment="Left"/>
                        <TextBox Text="{Binding REGON, UpdateSourceTrigger=PropertyChanged}"
                            Height="35"
                            FontSize="16"
                            IsReadOnly="True"
                            Background="#FFF0F0F0"
                            ToolTip="REGON jest pobierany automatycznie z GUS API" Width="310" HorizontalAlignment="Left"/>

                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="Nazwa" Orientation="Vertical" Margin="10,0,0,0">
                    <TextBlock Text="Nazwa firmy: *" FontWeight="Bold"/>
                    <TextBox Text="{Binding Nazwa, UpdateSourceTrigger=PropertyChanged}"
                        Height="35"
                        FontSize="14"
                         />

                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="Adres" Orientation="Vertical" Margin="10,0,0,0" Width="300">
                        <TextBlock Text="Ulica i numer:" FontWeight="Bold"/>
                        <TextBox Text="{Binding Ulica, UpdateSourceTrigger=PropertyChanged}"
                            Height="35"
                            FontSize="14"
                            ToolTip="np. ul. Warszawska 123/45"/>

                    </StackPanel>

                    <Grid Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Width="80">
                            <TextBlock Text="Kod pocztowy:" FontWeight="Bold"/>
                            <TextBox Text="{Binding KodPocztowy, UpdateSourceTrigger=PropertyChanged}"
                                Height="35"
                                FontSize="14"
                                ToolTip="np. 00-001"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Width="245">
                            <TextBlock Text="Miejscowosc:" FontWeight="Bold"/>
                            <TextBox Text="{Binding Miejscowosc, UpdateSourceTrigger=PropertyChanged}"
                                Height="35"
                                FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Kod pocztowy i Miejscowosc -->
                <StackPanel x:Name="Kontaktowa_Osoba" Orientation="Vertical" Margin="10,-0.1,0,0">
                    <TextBlock Text="Osoba kontaktowa:" FontWeight="Bold"/>
                    <TextBox Text="{Binding Osoba_kontaktowa, UpdateSourceTrigger=PropertyChanged}"
                        Height="35"
                        FontSize="14"
                         />

                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="Cennik" Orientation="Vertical" Width="150" Margin="10,0,10,0" HorizontalAlignment="Left">
                        <TextBlock Text="Cennik:" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding CennikiOptions}"
                            SelectedItem="{Binding Cennik}"
                            Height="35"
                            FontSize="14" Width="150" HorizontalAlignment="Left"
                          />
                    </StackPanel>
                    <StackPanel x:Name="Telefon" Orientation="Vertical" Width="150" Margin="0,0,10,0">
                        <TextBlock Text="Telefon:" FontWeight="Bold"/>
                        <TextBox Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}"
                            Height="35"
                            FontSize="14"
                         />

                    </StackPanel>
                    <StackPanel x:Name="Email" Orientation="Vertical" Width="328">
                        <TextBlock Text="Email:" FontWeight="Bold"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                            Height="35"
                            FontSize="14"
                         />

                    </StackPanel>

                </StackPanel>
                <StackPanel x:Name="FK_Email" Orientation="Vertical" Margin="10,0,0,0">
                    <TextBlock Text="Email do faktur:" FontWeight="Bold"/>
                    <TextBox Text="{Binding FKemail, UpdateSourceTrigger=PropertyChanged}"
                        Height="35"
                        FontSize="14"
                        ToolTip="Email na ktory maja byc wysylane faktury"/>

                </StackPanel>

                <!-- Email -->

                <!-- FK Email (do faktur) -->

                <!-- Informacja o polach wymaganych -->
                <TextBlock Text="* - pole wymagane"
                           FontSize="11"
                           Foreground="Gray"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Przyciski akcji -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#FFCCCCCC" 
                BorderThickness="0,1,0,0"
                Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="zapisz" Content="Zapisz"
                        Command="{Binding SaveCommand}"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#FF4CAF50"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content="Anuluj"
                        Command="{Binding CancelCommand}"
                        Width="120"
                        Height="40"
                        Background="#FF9E9E9E"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Loading indicator -->
        <Border Grid.RowSpan="3"
                Background="#88000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <syncfusion:SfBusyIndicator Width="100" Height="100" 
                                            Foreground="White"
                                            AnimationType="DoubleCircle"/>
                <TextBlock Text="Pobieranie danych z GUS REGON..."
                           Foreground="White"
                           FontSize="14"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
