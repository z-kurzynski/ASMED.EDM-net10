<UserControl x:Class="ASMED.EDM.UI.Views.Firma.FirmaView"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
    syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=Windows11Light}"
    Height="Auto" Width="Auto" VerticalAlignment="Top" MaxWidth="1800" MinWidth="1100">

    <UserControl.Resources>
        <Style x:Key="FirmaGridHeaderStyle" TargetType="{x:Type syncfusion:GridHeaderCellControl}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="{x:Type Path}" x:Key="SfDataGridHeaderIconStyle">
            <Setter Property="Fill" Value="Cyan"/>
        </Style>
        <Style x:Key="FirmaFilterToggleButtonStyle" TargetType="{x:Type syncfusion:FilterToggleButton}">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="BorderBrush" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Górny pasek: przyciski, wyszukiwanie -->
        <Grid VerticalAlignment="Center" 
              Grid.Row="0"
              Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Przyciski: Dodaj Firmę i Odśwież -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Height="46" HorizontalAlignment="Left" Width="450">
                <TextBlock Text="Wyszukaj Fimę:" FontSize="12" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                <DockPanel>
                    <TextBox x:Name="txtSearchPacjent" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="247" FontSize="14" />
                    <Button Width="32" Height="28" Margin="8,0,0,0" ToolTip="Wyczyść pole" Command="{Binding ClearSearchTextCommand}">
                        <Image Source="/Views/pacjent/no.png" Width="10" Height="10" />
                    </Button>
                    <ComboBox Width="100" Height="28" FontSize="14" Margin="10,0,8,0"
              SelectedItem="{Binding ActiveFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding FilterTypes}" HorizontalAlignment="Left"/>
                </DockPanel>
            </StackPanel>
            <syncfusion:ButtonAdv
                        x:Name="btnOdswiez"
                        Label="🔄  Odśwież"
                        Background="#FF2196F3"
                        Foreground="#FFFBFBFB"
                        FontSize="14" 
                        IconHeight="14" 
                        IconWidth="0"
                        Command="{Binding OdswiezCommand}"
                        ToolTip="Odśwież listę firm" Grid.Column="8" Width="220" Margin="5,5,0,5">
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>
            <syncfusion:ButtonAdv
                        x:Name="btnDodajFirme"
                        Label="➕  Dodaj Firmę"
                        Background="#FF009688"
                        Foreground="#FFFBFBFB"
                        FontSize="14" 
                        IconHeight="14" 
                        IconWidth="0"
                        Command="{Binding DodajFirmeCommand}" Margin="5,5,10,4" Grid.Column="9" Width="220">
                <syncfusion:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion:ButtonAdv.BorderBrush>
                <syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion:ButtonAdv.IconTemplate>
            </syncfusion:ButtonAdv>

            <!-- Przyciski: Dodaj Firmę i Odśwież -->

            <!-- Przyciski: Dodaj Firmę i Odśwież -->

            <!-- Pole wyszukiwania -->
        </Grid>
        <syncfusion:SfDataGrid
                                    x:Name="FirmaGrid"
                                    ItemsSource="{Binding FilteredFirmy}"
                                    AutoGenerateColumns="False"
                                    RowHeight="48"
                                    ColumnSizer="Star"
                                    FontSize="15"
                                    AllowFiltering="True"
                                    AllowSorting="True"
                                    SelectionMode="Single"
                                    AllowEditing="True"
                                    EditTrigger="OnTap"
                                    SelectionUnit="Row"
                                    FontFamily="Arial Narrow"
                                    CurrentCellBorderBrush="{x:Null}" 
                                    OpacityMask="#FFFFFDFD" 
                                    Margin="10,0,0,0" Grid.Row="1" MinHeight="200">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn 
                                    MappingName="Id" 
                                    HeaderText="ID" 
                                    Width="30" 
                                    TextAlignment="Right" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,2,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="False"
                                    IsReadOnly="True"/>
                <syncfusion:GridTextColumn 
                                    MappingName="NazwaCennika" 
                                    HeaderText="Cennik" 
                                    Width="60" 
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="True" SetCellBoundToolTip="False"/>

                <!-- ✅ NOWE: Umowa Do -->
                <syncfusion:GridTextColumn 
                                    MappingName="UmowaDo" 
                                    HeaderText="Umowa do" 
                                    Width="80" 
                                    TextAlignment="Center" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="False" 
                                    AllowFiltering="True"
                                    IsReadOnly="True" ValueBinding="{Binding UmowaDo, StringFormat=\{0:dd.MM.yyyy\}, TargetNullValue=-}"/>

                <!-- ✅ NOWE: Czas Nieokreślony -->
                <syncfusion:GridCheckBoxColumn 
                                    MappingName="CzasNieokreslon" 
                                    HeaderText="Bezterminowa" 
                                    Width="30" 
                                    AllowEditing="False"
                                    IsReadOnly="True"/>

                <syncfusion:GridTextColumn 
                                    MappingName="Nazwa"
                                    HeaderText="Nazwa" 
                                    TextWrapping="Wrap"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="True"/>
                <syncfusion:GridTextColumn 
                                    MappingName="Miejscowosc" 
                                    HeaderText="Miejscowość" 
                                     Width="92" 
                                    TextWrapping="Wrap"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="True"/>
                <syncfusion:GridTextColumn 
                                    MappingName="Ulica" 
                                    HeaderText="Ulica" 
                                    TextWrapping="Wrap"
                                    Width="150"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="True"/>
                <syncfusion:GridTextColumn 
                                    MappingName="NIP" 
                                    HeaderText="NIP" 
                                    Width="85"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="False" 
                                    TextTrimming="WordEllipsis"/>

                <syncfusion:GridTextColumn 
                                    MappingName="Osoba_kontaktowa" 
                                    HeaderText="Osoba kontaktowa" 
                                    Width="150" 
                                    TextWrapping="Wrap"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="False" 
                                    TextTrimming="CharacterEllipsis"/>

                <syncfusion:GridTextColumn 
                                    MappingName="Telefon" 
                                    HeaderText="Telefon" 
                                    Width="95"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="False" 
                                    TextTrimming="CharacterEllipsis"/>

                <syncfusion:GridTextColumn 
                                    MappingName="FkEmail" 
                                    HeaderText="FKemail" 
                                    Width="200" 
                                    TextWrapping="Wrap"
                                    TextAlignment="Left" 
                                    VerticalAlignment="Center"
                                    IsCaseSensitiveFilterRow="false" 
                                    Padding="0,0,5,0" 
                                    AllowEditing="True" 
                                    AllowFiltering="True"
                                    IsReadOnly="False" 
                                    TextTrimming="CharacterEllipsis"/>

                <syncfusion:GridTemplateColumn HeaderText="Edycja" Width="50" ColumnSizer="Auto" AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="45" Height="50" Background="#FF078247" BorderThickness="0" ToolTip="Edytuj firmę"
                                    Command="{Binding DataContext.EdytujFirmeCommand, RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="✏️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn HeaderText="Zapisz" Width="50" 
                        AllowSorting="False" 
                        AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="45" Width="50" Background="#1976D2" Foreground="White" ToolTip="Zapisz zmiany"
                                    Command="{Binding DataContext.SaveFirmaCommand, RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="💾" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn HeaderText="Umowy" Width="50" 
                        AllowSorting="False" 
                        AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Height="45" Width="50" Background="#FF9C27B0" Foreground="White" ToolTip="Zarządzaj umowami firmy"
                                    Command="{Binding DataContext.PokazUmowyCommand, RelativeSource={RelativeSource AncestorType={x:Type syncfusion:SfDataGrid}}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="📄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>

        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
