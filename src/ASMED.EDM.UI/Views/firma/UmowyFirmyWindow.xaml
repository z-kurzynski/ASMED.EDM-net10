<Window x:Class="ASMED.EDM.UI.Views.Firma.UmowyFirmyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Tytul}" 
        Height="650" 
        Width="1400"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F9FA">

    <Window.Resources>
        <!-- Style dla DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="45"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Górny pasek z przyciskiem dodawania -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="➕ Dodaj umowę"
                       Width="150"
                       Height="40"
                       FontSize="14"
                       Background="#FF009688"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"
                       Command="{Binding DodajUmoweCommand}"/>
            </StackPanel>
        </Grid>

        <!-- DataGrid z umowami -->
        <DataGrid Grid.Row="1"
                 x:Name="UmowyGrid"
                 ItemsSource="{Binding Umowy}"
                 AutoGenerateColumns="False"
                 CanUserAddRows="False"
                 CanUserDeleteRows="False"
                 CanUserReorderColumns="False"
                 CanUserResizeRows="False"
                 IsReadOnly="True"
                 SelectionMode="Single"
                 SelectionUnit="FullRow"
                 GridLinesVisibility="Horizontal"
                 HorizontalGridLinesBrush="LightGray"
                 AlternatingRowBackground="#FFF5F5F5"
                 FontSize="14">

            <DataGrid.Columns>

                <!-- ID -->
                <DataGridTextColumn Header="ID"
                                   Binding="{Binding Id}"
                                   Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Data Umowy -->
                <DataGridTextColumn Header="Data umowy"
                                   Binding="{Binding DataUmowy, StringFormat='{}{0:dd.MM.yyyy}'}"
                                   Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Nr Umowy -->
                <DataGridTextColumn Header="Nr umowy"
                                   Binding="{Binding NrUmowy}"
                                   Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Ilość miesięcy -->
                <DataGridTextColumn Header="Ilość miesięcy"
                                   Binding="{Binding IloscMiesiecy}"
                                   Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Terminowa -->
                <DataGridCheckBoxColumn Header="Terminowa"
                                       Binding="{Binding CzyTerminowa, Mode=OneWay}"
                                       Width="90">
                    <DataGridCheckBoxColumn.ElementStyle>
                        <Style TargetType="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </DataGridCheckBoxColumn.ElementStyle>
                </DataGridCheckBoxColumn>

                <!-- Data końcowa -->
                <DataGridTextColumn Header="Data końcowa"
                                   Width="110">
                    <DataGridTextColumn.Binding>
                        <Binding Path="DataKoncowa" StringFormat="{}{0:dd.MM.yyyy}" TargetNullValue="Bezterminowa"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Status -->
                <DataGridTextColumn Header="Status"
                                   Binding="{Binding Status}"
                                   Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Budżet -->
                <DataGridTextColumn Header="Budżet (PLN)"
                                   Binding="{Binding Budzet, StringFormat='{}{0:N2}'}"
                                   Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Wartość wykonanych badań -->
                <DataGridTextColumn Header="Wykonane (PLN)"
                                   Binding="{Binding WartoscWykonanychBadan, StringFormat='{}{0:N2}'}"
                                   Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Pozostała kwota -->
                <DataGridTextColumn Header="Pozostało (PLN)"
                                   Binding="{Binding PozostalaKwota, StringFormat='{}{0:N2}'}"
                                   Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Edycja -->
                <DataGridTemplateColumn Header="Edycja" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="50"
                                   Height="35"
                                   Background="#FF078247"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   ToolTip="Edytuj umowę"
                                   Command="{Binding DataContext.EdytujUmoweCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                   CommandParameter="{Binding}">
                                <TextBlock Text="✏️" FontSize="16"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Usuń -->
                <DataGridTemplateColumn Header="Usuń" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="50"
                                   Height="35"
                                   Background="#FFD32F2F"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   ToolTip="Usuń umowę"
                                   Command="{Binding DataContext.UsunUmoweCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                   CommandParameter="{Binding}">
                                <TextBlock Text="🗑️" FontSize="16"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Dolny pasek z przyciskiem zamknięcia -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="✖ Zamknij"
                   Width="120"
                   Height="40"
                   FontSize="14"
                   Background="#FF607D8B"
                   Foreground="White"
                   BorderThickness="0"
                   Cursor="Hand"
                   Command="{Binding ZamknijCommand}"
                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>
