<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:IsDesignTimeCreatable="False"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
    x:Class="ASMED.EDM.UI.Views.lista_do_faktur.ListaDoFaktur_DetailView" 
    syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=Windows11Light}" Width="Auto" VerticalAlignment="Top" MaxWidth="1800">

    <Grid x:Name="Grid_lista_inner" Margin="0,6,0,0" VerticalAlignment="Top" Height="600">

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <!-- Selected list header single line -->
        <Border Padding="8" BorderBrush="#FFCCCCCC" CornerRadius="4" VerticalAlignment="Top" Margin="15,0,10,0" BorderThickness="1,1,1,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Width="1094">
                <TextBlock x:Name="faktura_Nr" Text="{Binding SelectedLista.FK_Numer}" Margin="12,0,0,0" Width="100" FontWeight="SemiBold" />
                <TextBlock x:Name="data" Text="{Binding SelectedLista.FK_Data, StringFormat={}{0:dd.MM.yyyy}}" Margin="12,0,0,0" Width="100" />
                <TextBlock x:Name="kwota" Text="{Binding SelectedLista.FK_Kwota, StringFormat=Kwota: {0:N2} zl}" Margin="12,0,20,0" />
                <TextBlock x:Name="firma" Text="{Binding SelectedLista.Nazwa}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Assigned badania table -->
        <Border x:Name="___Border__Lista" Grid.Row="1" Margin="15,8,10,0" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="8,8,8,8" Grid.RowSpan="2" VerticalAlignment="Top" Padding="8,8,8,8">
            <Grid Height="451">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="0">
                    <TextBlock Text="Suma Razem:" FontSize="14" Margin="20,0,0,0" />
                    <TextBlock Text="{Binding TotalRazem, StringFormat={}{0:N2} zl}" FontWeight="Bold" FontSize="13" Width="100" Margin="20,0,0,0" />
                    <TextBlock Text="Przypisane badania" FontSize="14" VerticalAlignment="Top" />
                </StackPanel>

                <DataGrid x:Name="dgAssignedBadania" ItemsSource="{Binding SelectedLista.Badania}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFDDDDDD" RowBackground="White" AlternatingRowBackground="#FFF8F8F8" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,25,0,0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="Box" Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" ToolTip="Zaznacz wiersz"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn x:Name="LP" Header="Lp" Width="40" IsReadOnly="True" Binding="{Binding Lp}" />
                        <DataGridTextColumn x:Name="Data" Header="Data Bad" Binding="{Binding Bad_Data, StringFormat={}{0:dd.MM.yyyy}}" Width="100" />
                        <DataGridTextColumn x:Name="TYP" Header="Typ" Binding="{Binding Bad_Typ}"  Width="40">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn x:Name="Pacjent" Header="Pacjent" Binding="{Binding PacjentDisplay}" Width="*" />

                        <DataGridTemplateColumn x:Name="Lek_Med" Header="Lek.Med" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtCena1" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena1, StringFormat={}{0:N2}}" Foreground="Black" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Bad_Cena1}" Value="0">
                                            <Setter TargetName="txtCena1" Property="Foreground" Value="LightGray" />
                                            <Setter TargetName="txtCena1" Property="Text" Value="" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="Laryng" Header="Laryng." Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtCena2" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena2, StringFormat={}{0:N2}}" Foreground="Black" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Bad_Cena2}" Value="0">
                                            <Setter TargetName="txtCena2" Property="Foreground" Value="LightGray" />
                                            <Setter TargetName="txtCena2" Property="Text" Value="" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="Okul" Header="Okul." Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtCena3" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena3, StringFormat={}{0:N2}}" Foreground="Black" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Bad_Cena3}" Value="0">
                                            <Setter TargetName="txtCena3" Property="Foreground" Value="LightGray" />
                                            <Setter TargetName="txtCena3" Property="Text" Value="" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="Książ" Header="Książ." Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtCena4" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena4, StringFormat={}{0:N2}}" Foreground="Black" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Bad_Cena4}" Value="0">
                                            <Setter TargetName="txtCena4" Property="Foreground" Value="LightGray" />
                                            <Setter TargetName="txtCena4" Property="Text" Value="" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="Lipid" Header="Lipid." Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtCena5" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena5, StringFormat={}{0:N2}}" Foreground="Black" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Bad_Cena5}" Value="0">
                                            <Setter TargetName="txtCena5" Property="Foreground" Value="LightGray" />
                                            <Setter TargetName="txtCena5" Property="Text" Value="" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="EKG" Header="EKG" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtCena6" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena6, StringFormat={}{0:N2}}" Foreground="Black" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Bad_Cena6}" Value="0">
                                            <Setter TargetName="txtCena6" Property="Foreground" Value="LightGray" />
                                            <Setter TargetName="txtCena6" Property="Text" Value="" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="Urlop" Header="Urlop" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtCena7" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena7, StringFormat={}{0:N2}}" Foreground="Black" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Bad_Cena7}" Value="0">
                                            <Setter TargetName="txtCena7" Property="Foreground" Value="LightGray" />
                                            <Setter TargetName="txtCena7" Property="Text" Value="" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="Inne" Header="Inne" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtCena8" TextAlignment="Right" Margin="2" Text="{Binding Bad_Cena8, StringFormat={}{0:N2}}" Foreground="Black" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Bad_Cena8}" Value="0">
                                            <Setter TargetName="txtCena8" Property="Foreground" Value="LightGray" />
                                            <Setter TargetName="txtCena8" Property="Text" Value="" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="Razem" Header="Razem  ." Width="100" CanUserResize="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtRazem" TextAlignment="Right" Margin="10,2,35,2" FontWeight="Bold" Text="{Binding Bad_Razem, StringFormat={}{0:N2}}" Foreground="Black" FontSize="14" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Bad_Razem}" Value="0">
                                            <Setter TargetName="txtRazem" Property="Foreground" Value="LightGray" />
                                            <Setter TargetName="txtRazem" Property="Text" Value="" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Action buttons -->
        <Grid Grid.Row="2" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Height="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="337"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="250" VerticalAlignment="Top" Margin="10,10,0,0">
                <syncfusion:ButtonAdv x:Name="Email" Label="📧 Email" 
                                          IsCheckable="True" FontSize="18" 
                                          Foreground="#FFFBFBFB" 
                                          Background="#FF8E44AD" 
                                          IconHeight="0" IconWidth="0" 
                                          Width="140" Height="45" 
                                          Command="{Binding SendEmailCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                          FontFamily="Segoe UI" FontWeight="Normal">
                    <syncfusion:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion:ButtonAdv.IconTemplate>
                    <syncfusion:ButtonAdv.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                    </syncfusion:ButtonAdv.BorderBrush>
                </syncfusion:ButtonAdv>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Width="445" VerticalAlignment="Top" Margin="0,10,0,0" HorizontalAlignment="Right" Grid.Column="1">
                <syncfusion:ButtonAdv x:Name="Druk_Ceny" Width="140" Label="🖨️  Ceny" IsCheckable="True" Height="45" FontSize="18" Foreground="#FFFBFBFB" Background="#FF16A085" Margin="4,0" Command="{Binding PrintSzczegolowyCommand}" IconHeight="0" IconWidth="0" FontFamily="Segoe UI">
                    <syncfusion:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion:ButtonAdv.IconTemplate>
                    <syncfusion:ButtonAdv.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                    </syncfusion:ButtonAdv.BorderBrush>
                </syncfusion:ButtonAdv>
                <syncfusion:ButtonAdv x:Name="Druk_Rezem" Height="45" Label=" 🖨️   Razem" Width="140" Background="#FFFF6F61" Foreground="#FFFBFBFB" FontSize="18" IsCheckable="True" Margin="4,0" Command="{Binding PrintPodstawowyCommand}" IconHeight="0" IconWidth="0" FontFamily="Segoe UI">
                    <syncfusion:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion:ButtonAdv.IconTemplate>
                    <syncfusion:ButtonAdv.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                    </syncfusion:ButtonAdv.BorderBrush>
                </syncfusion:ButtonAdv>
                <syncfusion:ButtonAdv x:Name="Druk_Lista" Width="140" Label="🖨️   Lista" IsCheckable="True" Height="45" FontSize="18" Foreground="#FFFBFBFB" Background="#FF4A90E2" Margin="4,0,0,0" Command="{Binding PrintListaCommand}" IconHeight="0" IconWidth="0" FontFamily="Segoe UI" HorizontalAlignment="Left">
                    <syncfusion:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion:ButtonAdv.IconTemplate>
                    <syncfusion:ButtonAdv.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                    </syncfusion:ButtonAdv.BorderBrush>
                </syncfusion:ButtonAdv>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
