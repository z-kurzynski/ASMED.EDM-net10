<UserControl
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:IsDesignTimeCreatable="False"
 xmlns:Syncfusion="http://schemas.syncfusion.com/wpf" x:Class="ASMED.EDM.UI.Views.lista_do_faktur.ListaDoFaktur_EditView"
 Height="Auto" Width="Auto">

    <Grid x:Name="Edit_prawa" HorizontalAlignment="Left" Width="900" Height="610" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="12*"/>
            <RowDefinition Height="73*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Pacjent -->
        <Border x:Name="Pacjent" Grid.Column="0"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
            BorderThickness="1" CornerRadius="4"
            VerticalAlignment="Center"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            Margin="0,0,455,0" Padding="8" Height="130">
            <StackPanel Margin="0,0,0,-11">
                <TextBlock Text="Dane Pacjenta" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Grid Margin="6,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TextBlock_imie_nazwisko" Grid.Column="0" FontSize="18" FontWeight="Bold" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="SelectedWizyta.P_imie" />
                                <Binding Path="SelectedWizyta.P_nazwisko" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock x:Name="txtPesel" Grid.Column="1" FontSize="18" Text="{Binding FormattedPesel}" HorizontalAlignment="Right" FontWeight="Bold" TextWrapping="Wrap" />
                </Grid>

                <TextBlock Margin="6,6,0,0" FontSize="18" Text="{Binding SelectedWizyta.P_zawod}" FontWeight="Bold" />

                <Grid Margin="6,8,0,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155*" />
                        <ColumnDefinition Width="266*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,4" Width="150" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <TextBlock FontWeight="Bold" FontSize="12" VerticalAlignment="Bottom" FontStyle="Italic" Height="20"><Run Text="Typ badania"/></TextBlock>
                        <Border Width="44" Margin="10,0,0,0" Height="25" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" CornerRadius="2" BorderThickness="1" Padding="4,2,4,2">
                            <TextBlock x:Name="TextBlock_typ_badania" Text="{Binding SelectedWizyta.B_TypBadania}" FontSize="16" FontWeight="Bold" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Height="28" VerticalAlignment="Center">
                        <TextBlock FontSize="12" VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Width="70" Text="Data Skier."/>
                        <Border Margin="10,0,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" BorderThickness="1" CornerRadius="2" Padding="4,2,4,2" Height="24" VerticalAlignment="Center" Width="120">
                            <TextBlock x:Name="txtDataSkier" FontSize="16" Text="{Binding SelectedWizyta.Bad_Data, StringFormat='{}{0:dd.MM.yyyy}'}" VerticalAlignment="Bottom" Height="18" HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Firma -->
        <Border x:Name="Firma"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
            BorderThickness="1" CornerRadius="4"
            VerticalAlignment="Center"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            Margin="455,0,0,0" Padding="8" Height="130">
            <StackPanel>
                <TextBlock Text="Dane Firmy" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <TextBlock Margin="6,6,0,0" FontSize="18" Text="{Binding SelectedAssignedBadanie.FirmaNazwa}" TextWrapping="Wrap" FontWeight="Bold" Height="50" />

                <Grid Margin="6,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock FontWeight="Bold" FontSize="12"><Run Text="NIP"/></TextBlock>
                        <TextBlock x:Name="txtNIP" Text="" FontSize="13" Width="125" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock FontWeight="Bold" FontSize="12"><Run Text="Cennik"/></TextBlock>
                        <ComboBox Width="156" Margin="10,0,0,0" ItemsSource="{Binding CennikOptions}" SelectedItem="{Binding SelectedCennik, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Pricing grid placeholder -->
        <Border x:Name="wycena_Badania" Grid.Row="2" BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="0,50,0,0" Height="200" VerticalAlignment="Top">
            <TextBlock Text="Szczegóły wyceny" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
        </Border>

        <!-- Buttons -->
        <StackPanel x:Name="przyciski" Grid.Row="3" Grid.Column="0"
            HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center" Height="56" Width="390" Margin="500,0,0,0">
            <Syncfusion:ButtonAdv
                x:Name="btnDeleteBadanie"
                Height="45"
                Label=" 🗑️ Usuń Badanie"
                Width="180"
                Background="#FFD32F2F"
                Foreground="#FFFBFBFB"
                FontStyle="Italic"
                IconHeight="0" IconWidth="0">
                <Syncfusion:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </Syncfusion:ButtonAdv.IconTemplate>
            </Syncfusion:ButtonAdv>
        </StackPanel>
    </Grid>
</UserControl>
