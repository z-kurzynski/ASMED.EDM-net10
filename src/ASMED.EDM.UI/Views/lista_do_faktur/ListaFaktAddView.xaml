<UserControl
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
 xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF" 
 xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.WPF"
 xmlns:syncfusion1="http://schemas.syncfusion.com/wpf" x:Class="ASMED.EDM.UI.Views.lista_do_faktur.ListaFaktAddView"
     Width="Auto"
     Height="Auto"
     VerticalAlignment="Top"
     MinWidth="1100" MaxWidth="1800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Height="706" Background="#FF545252" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="110" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <Grid x:Name="Grid_0_Firma_Faktura" VerticalAlignment="Top"
                MaxWidth="1500" MinWidth="1100" Height="60" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="410"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="262"/>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition />

                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="S_Firma" Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="Firma:" FontSize="12" FontWeight="Bold" Margin="0,0,0,4" HorizontalAlignment="Left" Height="0"/>
                <DockPanel HorizontalAlignment="Left">
                    <TextBox
                            x:Name="FirmaText"
                            Width="330"
                            Height="45"
                            FontSize="18"
                            TextWrapping="Wrap"
                            Text="{Binding WybranaFirma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False" Margin="0,10,0,0" />
                    <Button Content="..." Width="50" Height="45" DockPanel.Dock="Right" Margin="6,10,0,0" Click="OpenFirmaDialog_Click"/>
                </DockPanel>

                <TextBlock Text="{Binding SelectedFirmaId}" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="NR_Faktury_Txt" Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Height="56">
                <TextBlock Text="Nr. Faktury:" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                <TextBox 
                        x:Name="NumerFakturyTextBox" 
                        Height="30" 
                        FontSize="18" 
                        Text="{Binding NumerFaktury, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,5,0" />
            </StackPanel>

            <StackPanel x:Name="Data_Wystawienia_Txt" Grid.Column="3" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left" Height="56" Margin="5,0,0,0">
                <TextBlock Text="Data Wystawienia:" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Left" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                <DatePicker 
                        x:Name="DataWystawieniaPicker" 
                        Height="30" 
                        SelectedDate="{Binding DataWystawienia, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel x:Name="Suma_Netto_Txt" Grid.Column="4" Orientation="Vertical" VerticalAlignment="Center" Height="56" Margin="0,0,5,0">
                <TextBlock Text="Suma Brutto:" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                <TextBox 
                        x:Name="SumaBruttoTextBox" 
                        Height="30" 
                        FontSize="18" 
                        Text="{Binding SumaBrutto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel x:Name="Uwagi_Txt" Grid.Column="5" Orientation="Vertical" VerticalAlignment="Center" Height="56" Margin="0,0,5,0">
                <TextBlock Text="Uwagi:" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                <TextBox 
                        x:Name="UwagiTextBox" 
                        Height="30" 
                        Text="{Binding Uwagi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel x:Name="S_Email" Grid.Column="6" Orientation="Vertical" VerticalAlignment="Center" Height="56" Margin="0,0,5,0">
                <TextBlock Text="e-mail" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                <TextBox 
                        x:Name="FKemail" 
                        Height="30" 
                        Text="{Binding FKemail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Arial Narrow" />
            </StackPanel>

            <StackPanel Grid.Column="7" Orientation="Vertical" VerticalAlignment="Center" Height="50" Margin="0,0,10,0">
                <TextBlock Text="Cennik:" FontSize="12" Margin="0,0,0,1" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                <ComboBox x:Name="Cennik_ComboBox" 
                        Height="30"
                        ItemsSource="{Binding StatusOptions}" 
                        SelectedItem="{Binding SelectedCennik, Mode=TwoWay}">
                    <ComboBox.ToolTip>
                        <ToolTip Content="Wybierz Cennik Do faktury"/>
                    </ComboBox.ToolTip>
                </ComboBox>
            </StackPanel>

            <syncfusion1:ButtonAdv x:Name="ListaDoFaktur_powrot"
                    Grid.Column="8"
                    Height="44"
                    Label="Listy Do Faktur"
                    Background="#FF009688"
                    Foreground="#FFFBFBFB" 
                    Click="OpenListaDoFaktur_Click" IconWidth="0" IconHeight="0" FontSize="14">
                <syncfusion1:ButtonAdv.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                </syncfusion1:ButtonAdv.BorderBrush>
                <syncfusion1:ButtonAdv.IconTemplate>
                    <DataTemplate/>
                </syncfusion1:ButtonAdv.IconTemplate>
            </syncfusion1:ButtonAdv>

        </Grid>

        <!-- dane badania -->
        <Grid x:Name="Grid_1_Badanie" Grid.Row="1" 
                MaxWidth="1500" MinWidth="1100" Height="115" VerticalAlignment="Top" Grid.RowSpan="2" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="S_Imie" Width="150" HorizontalAlignment="Left" Grid.ColumnSpan="2" Margin="0,0,0,10" Grid.Column="1">
                <TextBlock Margin="15,0,0,5" Width="150.3" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"><Run Text="Imię/imiona"/><Run Text=" *"/></TextBlock>
                <syncfusion1:SfTextBoxExt x:Name="S_Imie_wybor"
                            Height="80"
                            Watermark="* Wpisz imię"
                            FontSize="18"
                            TextWrapping="Wrap"
                            AutoCompleteSource="{Binding ImionaItems}"
                            AutoCompleteMode="SuggestAppend"
                            TextHighlightMode="FirstOccurrence"
                            HighlightedTextColor="Red"
                            SearchItemPath="."
                            SuggestionBoxPlacement="Bottom"
                            MaxDropDownHeight="300"
                            Text="{Binding WybraneImie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel x:Name="S_Nazwisko" Margin="5,0,0,10" Grid.Column="2">
                <TextBlock Margin="0,0,0,5" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" ><Run Text="Nazwisko"/><Run Language="pl-pl" Text=" *"/></TextBlock>
                <syncfusion1:SfTextBoxExt x:Name="___S_Nazwisko_wybor"
                            Height="80"
                            TextWrapping="Wrap"
                            Watermark="* Wpisz nazwisko"
                            FontSize="18"
                            AutoCompleteSource="{Binding NazwiskaItems}"
                            AutoCompleteMode="SuggestAppend"
                            TextHighlightMode="FirstOccurrence"
                            HighlightedTextColor="Red"
                            SearchItemPath="."
                            SuggestionBoxPlacement="Bottom"
                            MaxDropDownHeight="300"
                            Text="{Binding WybraneNazwisko, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" Height="96" Margin="5,4,0,0" Grid.Column="3">
                <CheckBox Content="Książeczka"
                            Height="20"
                            VerticalAlignment="Center"
                            Margin="0,0,0,2"
                            IsChecked="{Binding IsKsiazeczkaChecked, Mode=TwoWay}" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />

                <CheckBox Content="Urlop" Height="20"
                            VerticalAlignment="Center"
                            Margin="0,0,0,2"
                            IsChecked="{Binding IsUrlopChecked, Mode=TwoWay}" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />

                <StackPanel Height="50">
                    <TextBlock 
                                FontSize="12" 
                                VerticalAlignment="Bottom" 
                                Height="20"
                                Margin="0,0,0,3" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"><Run Text="Typ badania"/></TextBlock>
                    <TextBox x:Name="badanie_typ" 
                                Text="{Binding TypBadania, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="20,0,20,0"  />
                </StackPanel>

            </StackPanel>
            <StackPanel x:Name="S_DataBadania_S_DataWaznosci" VerticalAlignment="Top" Height="100" Grid.Column="4" Margin="0,0,10,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock FontSize="10" Margin="0,0,0,5" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"><Run Text="Data badania"/></TextBlock>
                    <DatePicker SelectedDate="{Binding DataBadania, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="0,4,0,0" VerticalAlignment="Top">
                    <TextBlock FontSize="10" Margin="0,0,0,5" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"><Run Text="Data ważności"/></TextBlock>
                    <DatePicker SelectedDate="{Binding DataWaznosci, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="S_Wynik_S_Nr_Ksiegi" VerticalAlignment="Top" Height="100" Grid.Column="5">
                <StackPanel Orientation="Vertical" VerticalAlignment="Top">
                    <TextBlock Text="Wynik" FontSize="10" Margin="0,0,0,5" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                    <ComboBox ItemsSource="{Binding WynikOptions}" DisplayMemberPath="Nazwa" SelectedValuePath="Kod"
                              SelectedValue="{Binding SelectedWynik, Mode=TwoWay}"
                              ToolTip="{Binding SelectedItem.Nazwa, RelativeSource={RelativeSource Self}}" Height="28" Margin="0,0,5,0" />
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="0,0,10,-4">
                    <TextBlock Text="Nr Księgi" FontSize="10" Margin="0,3,0,5" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                    <TextBox 
                                Text="{Binding NrKsiegi, Mode=TwoWay}" Height="25"  />
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="S_Badanie" VerticalAlignment="Top" Grid.Column="6" Margin="5,0,0,0">
                <TextBlock Text="Badanie" FontSize="12" Height="16" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                <TextBlock x:Name="lblBasicPriceList" Text="{Binding PriceBasicText}" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Margin="0,5,0,6" Height="15"/>
                <TextBox x:Name="txtBasicPrice" FontSize="16" FontWeight="Bold" Height="25" Text="{Binding EditablePriceBasic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="PriceTextBox_TextChanged" Margin="0,0,0,6" VerticalAlignment="Top"/>
                <Button x:Name="btnBasic" Content="✗ NIEAKTYWNA" Height="25" Background="#FFD0D3D6" FontWeight="Bold" FontSize="8" Click="ToggleExamination_Click" Tag="Basic" VerticalAlignment="Top"/>
            </StackPanel>
            <StackPanel x:Name="S_Laryngolog" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="7" Margin="5,0,0,0" Width="83">
                <TextBlock Text="Laryngolog" FontSize="12" Height="16" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                <TextBlock x:Name="lblLaryngologistPriceList" Text="{Binding PriceLaryngologistText}" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Margin="0,5,0,6" Height="15"/>
                <TextBox x:Name="txtLaryngologistPrice" FontSize="16" FontWeight="Bold" Height="25" Text="{Binding EditablePriceLaryngologist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="PriceTextBox_TextChanged" Margin="0,0,0,7"/>
                <Button x:Name="btnLaryngologist" Content="✗ NIEAKTYWNE" Height="25" Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="Laryngologist" VerticalAlignment="Top"/>
            </StackPanel>
            <StackPanel x:Name="S_Okulista" VerticalAlignment="Top" Grid.Column="8" Margin="5,0,0,0">
                <TextBlock Text="Okulista" FontSize="12" Height="16" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                <TextBlock x:Name="lblOphthalmologistPriceList" Text="{Binding PriceOphthalmologistText}" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Height="15" Margin="0,5,0,6"/>
                <TextBox x:Name="txtOphthalmologistPrice" FontSize="16" FontWeight="Bold" Height="25" Text="{Binding EditablePriceOphthalmologist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="PriceTextBox_TextChanged" Margin="0,0,0,7"/>
                <Button x:Name="btnOphthalmologist" Content="✗ NIEAKTYWNE" Height="25" Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="Ophthalmologist" VerticalAlignment="Top"/>
            </StackPanel>
            <StackPanel x:Name="S_Ksiazeczka" VerticalAlignment="Top" Grid.Column="9" Margin="5,0,0,0">
                <TextBlock Text="Książeczka" FontSize="12" Height="16" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                <TextBlock x:Name="lblSanitaryPriceList" Text="{Binding PriceSanitaryText}" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Height="15" Margin="0,5,0,6"/>
                <TextBox x:Name="txtSanitaryPrice" FontSize="16" FontWeight="Bold" Height="25" Text="{Binding EditablePriceSanitary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="PriceTextBox_TextChanged" Margin="0,0,0,7"/>
                <Button x:Name="btnSanitary" Content="✗ NIEAKTYWNE" Height="25" Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="Sanitary" VerticalAlignment="Top"/>
            </StackPanel>
            <StackPanel x:Name="S_Lipitogram" VerticalAlignment="Top" Grid.Column="10" Margin="5,0,0,0">
                <TextBlock Text="Lipidogram" FontSize="12" Height="16" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                <TextBlock x:Name="lblLipidogramPriceList" Text="{Binding PriceLipidogramText}" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Height="15" Margin="0,5,0,6"/>
                <TextBox x:Name="txtLipidogramPrice" FontSize="16" FontWeight="Bold" Height="25" Text="{Binding EditablePriceLipidogram, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="PriceTextBox_TextChanged" Margin="0,0,0,7"/>
                <Button x:Name="btnLipidogram" Content="✗ NIEAKTYWNE" Height="25" Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="Lipidogram" VerticalAlignment="Top"/>
            </StackPanel>
            <StackPanel x:Name="S_EKG" VerticalAlignment="Top" Grid.Column="11" Margin="5,0,0,0">
                <TextBlock Text="EKG" FontSize="12" Height="16" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                <TextBlock x:Name="lblEKGPriceList" Text="{Binding PriceEKGText}" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Height="15" Margin="0,5,0,6"/>
                <TextBox x:Name="txtEKGPrice" FontSize="16" FontWeight="Bold" Height="25" Text="{Binding EditablePriceEKG, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="PriceTextBox_TextChanged" Margin="0,0,0,7"/>
                <Button x:Name="btnEKG" Content="✗ NIEAKTYWNE" Height="25" Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="EKG" VerticalAlignment="Top"/>
            </StackPanel>
            <StackPanel x:Name="S_Urlop" VerticalAlignment="Top" Grid.Column="12" Margin="5,0,0,0">
                <TextBlock Text="Urlop" FontSize="12" Height="16" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                <TextBlock x:Name="lblHealthClinicPriceList" Text="{Binding PriceHealthClinicText}" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" Height="15" Margin="0,5,0,6"/>
                <TextBox x:Name="txtHealthClinicPrice" FontSize="16" FontWeight="Bold" Height="25" Text="{Binding EditablePriceHealthClinic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="PriceTextBox_TextChanged" Margin="0,0,0,7"/>
                <Button x:Name="btnHealthClinic" Content="✗ NIEAKTYWNE" Height="25" Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="HealthClinic" VerticalAlignment="Top"/>
            </StackPanel>
            <StackPanel x:Name="S_Inne" VerticalAlignment="Top" Grid.Column="13" Margin="5,0,0,0">
                <TextBlock Text="Inne" FontSize="12" Height="16" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
                <TextBlock x:Name="lblOtherPriceList" Text="{Binding PriceLipidogramText}" FontSize="11" Height="15" Margin="0,5,0,6" Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}"/>
                <TextBox x:Name="txtOtherPrice" FontSize="16" FontWeight="Bold" Height="25" Text="{Binding EditablePriceOther, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="PriceTextBox_TextChanged" Margin="0,0,0,7"/>
                <Button x:Name="btnOther" Content="✗ NIEAKTYWNE" Height="25" Background="#FFD0D3D6" FontWeight="Bold" FontSize="9" Click="ToggleExamination_Click" Tag="Other" VerticalAlignment="Top"/>
            </StackPanel>
            <StackPanel x:Name="S_Suma" VerticalAlignment="Top" Grid.Column="14" Margin="5,0,0,0">
                <TextBlock Text="SUMA:" FontSize="12" Height="16" VerticalAlignment="Center" Foreground="#FF34F952"/>
                <TextBlock x:Name="lblTotalPrice" Text="" FontSize="16" FontWeight="Bold" Foreground="DarkGreen" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Height="20" Margin="0,0,0,5"/>
                <Button x:Name="Wyczysc" Height="25" FontSize="13" Content="Wyczyść" Foreground="#FFFFFF" Background="#FF7E037F" Command="{Binding ClearGridCommand}" Margin="0,0,0,8" BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                <Button x:Name="Dodaj_Do_Listy_Kopiuj" Height="25" FontSize="13" Content="+/+ Lista" Foreground="#FFFFFF" Background="#FF047F28" Command="{Binding SaveSelectedAssignedBadanieCommand}" Margin="0,0,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" VerticalAlignment="Top" Background="#FF6D6D6D" Margin="10,0,10,0" Padding="8,8,8,8" CornerRadius="12,12,12,12" BorderThickness="1,1,1,1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

            <Grid x:Name="Grid_2_Badania_bez_Listy_Lista_do_Faktury" Height="448">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="Lewy_Badania_Bez_Listy" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="441">
                    <StackPanel Height="27" Margin="0,0,0,5" Orientation="Horizontal">
                        <TextBlock Text="Dostępne badania" FontSize="14" Width="156" HorizontalAlignment="Left" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" VerticalAlignment="Center"/>

                        <Button Content="{Binding RefreshBadaniaButtonText}"
                                    Command="{Binding RefreshAvailableBadaniaCommand}"
                                    Visibility="{Binding ShowRefreshBadaniaButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="#FF2196F3"
                                    Foreground="White"
                                    FontSize="11"
                                    Padding="8,2"
                                    BorderThickness="0"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Kliknij aby załadować nowe badania z bazy"
                                    Cursor="Hand" Width="30"/>
                    </StackPanel>

                    <ListView x:Name="lvBadania" Background="{x:Null}" ItemsSource="{Binding FilteredAvailableBadania}" AlternationCount="2">
                        <ListView.Resources>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#F6F8FA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="28">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsMarked, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Badanie" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="4,2">
                                                <TextBlock Text="{Binding Dto.PacjentDisplay}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Dto.PacjentDisplay}" FontSize="14" FontWeight="Bold" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Data Badania -" FontSize="14" VerticalAlignment="Top"/>
                                                    <TextBlock Text="{Binding Dto.Bad_Data, StringFormat=\{0:dd.MM.yyyy\}}" FontSize="12" VerticalAlignment="Top" Margin="4,0,0,0"/>
                                                    <TextBlock Text="{Binding Dto.Bad_Typ}" FontSize="12" VerticalAlignment="Top" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Dto.Bad_Razem, StringFormat=\{0:N2\}}" FontSize="12" VerticalAlignment="Top" Margin="8,0,0,0" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Dto.FirmaNazwa}" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0" FontStyle="Italic" TextWrapping="Wrap"/>

                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Add" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <syncfusion1:ButtonAdv
                                                    Width="55"
                                                    Height="40"
                                                    Label="Dodaj"
                                                    FontSize="14"
                                                    Foreground="#FFFBFBFB"
                                                    Background="#FF16A085"
                                                    Command="{Binding DataContext.AddWithoutEditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding Dto}"
                                                    HorizontalAlignment="Center" IconHeight="0" IconWidth="0" VerticalAlignment="Center">
                                                <syncfusion1:ButtonAdv.IconTemplate>
                                                    <DataTemplate/>
                                                </syncfusion1:ButtonAdv.IconTemplate>
                                                <syncfusion1:ButtonAdv.BorderBrush>
                                                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                                                </syncfusion1:ButtonAdv.BorderBrush>
                                            </syncfusion1:ButtonAdv>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                </StackPanel>
                <StackPanel x:Name="Prawy_Badania_Na_Liscie_do_faktury" Grid.Column="1" VerticalAlignment="Top" Height="448">
                    <StackPanel Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Height="30" Margin="0,0,0,2">
                            <TextBlock Text="Przypisane badania" FontSize="14" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="20,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="Suma Razem:" FontSize="14" Margin="20,0,0,0" Foreground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalRazem, StringFormat=\{0:N2\} zl}" FontSize="18" Width="100" Margin="20,0,0,0" Foreground="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" FontWeight="Bold" VerticalAlignment="Top" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Height="410" VerticalAlignment="Top">
                            <DataGrid x:Name="dgAssignedBadania"
                                    ItemsSource="{Binding SelectedLista.Badania}"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    IsReadOnly="True"
                                    GridLinesVisibility="Horizontal"
                                    HorizontalGridLinesBrush="#FFDDDDDD"
                                    RowBackground="White"
                                    AlternatingRowBackground="#FFF8F8F8"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    Height="412"
                                    Margin="0,0,5,0" Background="{x:Null}" VerticalAlignment="Top">
                                <DataGrid.RowStyle>
                                    <Style TargetType="{x:Type DataGridRow}">
                                        <EventSetter Event="Control.MouseDoubleClick" Handler="dgAssignedBadania_MouseDoubleClick"/>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Visibility="Visible">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" ToolTip="Zaznacz wiersz" Width="20" Height="20"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Lp" IsReadOnly="True" Binding="{Binding Lp}" />
                                    <DataGridTextColumn Header="Data Bad" Binding="{Binding Bad_Data, StringFormat=\{0:dd.MM.yyyy\}}" Width="100" />
                                    <DataGridTextColumn Header="Typ" Binding="{Binding Bad_Typ}"  Width="40">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextAlignment" Value="Center" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Pacjent" Binding="{Binding PacjentDisplay}" Width="200" />

                                    <DataGridTemplateColumn Header="Razem" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="txtRazem" TextAlignment="Right" Margin="4" FontWeight="Bold" Text="{Binding Bad_Razem, StringFormat=\{0:N2\}}" Foreground="Black" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Bad_Razem}" Value="0">
                                                        <Setter TargetName="txtRazem" Property="Foreground" Value="LightGray" />
                                                        <Setter TargetName="txtRazem" Property="Text" Value="" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Lek.Med" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="txtCena1" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena1, StringFormat=\{0:N2\}}" Foreground="Black" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Bad_Cena1}" Value="0">
                                                        <Setter TargetName="txtCena1" Property="Foreground" Value="LightGray" />
                                                        <Setter TargetName="txtCena1" Property="Text" Value="" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Laryng." Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="txtCena2" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena2, StringFormat=\{0:N2\}}" Foreground="Black" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Bad_Cena2}" Value="0">
                                                        <Setter TargetName="txtCena2" Property="Foreground" Value="LightGray" />
                                                        <Setter TargetName="txtCena2" Property="Text" Value="" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Okul." Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="txtCena3" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena3, StringFormat=\{0:N2\}}" Foreground="Black" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Bad_Cena3}" Value="0">
                                                        <Setter TargetName="txtCena3" Property="Foreground" Value="LightGray" />
                                                        <Setter TargetName="txtCena3" Property="Text" Value="" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Książ." Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="txtCena4" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena4, StringFormat=\{0:N2\}}" Foreground="Black" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Bad_Cena4}" Value="0">
                                                        <Setter TargetName="txtCena4" Property="Foreground" Value="LightGray" />
                                                        <Setter TargetName="txtCena4" Property="Text" Value="" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Lipid." Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="txtCena5" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena5, StringFormat=\{0:N2\}}" Foreground="Black" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Bad_Cena5}" Value="0">
                                                        <Setter TargetName="txtCena5" Property="Foreground" Value="LightGray" />
                                                        <Setter TargetName="txtCena5" Property="Text" Value="" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="EKG" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="txtCena6" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena6, StringFormat=\{0:N2\}}" Foreground="Black" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Bad_Cena6}" Value="0">
                                                        <Setter TargetName="txtCena6" Property="Foreground" Value="LightGray" />
                                                        <Setter TargetName="txtCena6" Property="Text" Value="" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Urlop" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="txtCena7" TextAlignment="Right" Margin="4" Text="{Binding Bad_Cena7, StringFormat=\{0:N2\}}" Foreground="Black" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Bad_Cena7}" Value="0">
                                                        <Setter TargetName="txtCena7" Property="Foreground" Value="LightGray" />
                                                        <Setter TargetName="txtCena7" Property="Text" Value="" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Inne" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="txtCena8" TextAlignment="Right" Margin="2" Text="{Binding Bad_Cena8, StringFormat=\{0:N2\}}" Foreground="Black" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Bad_Cena8}" Value="0">
                                                        <Setter TargetName="txtCena8" Property="Foreground" Value="LightGray" />
                                                        <Setter TargetName="txtCena8" Property="Text" Value="" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Kas" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <syncfusion1:ButtonAdv
                                                        Width="36"
                                                        Height="28"
                                                        Label="🗑"
                                                        ToolTip="Usuń"
                                                        FontSize="14"
                                                        Foreground="#FFFFFFFF"
                                                        Background="#FFFF8726"
                                                        Command="{Binding DataContext.DeleteAssignedBadanieCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="4"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" IconHeight="0" IconWidth="0">
                                                    <syncfusion1:ButtonAdv.IconTemplate>
                                                        <DataTemplate/>
                                                    </syncfusion1:ButtonAdv.IconTemplate>
                                                    <syncfusion1:ButtonAdv.BorderBrush>
                                                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                                                    </syncfusion1:ButtonAdv.BorderBrush>
                                                </syncfusion1:ButtonAdv>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

        </Border>

        <Grid x:Name="Grid_3_Przyciski" Grid.Row="3" MinWidth="1450" VerticalAlignment="Center" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="421*"/>
                <ColumnDefinition Width="755*"/>
                <ColumnDefinition Width="304*"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="Nawigacja_Stack" Orientation="Horizontal" VerticalAlignment="Top" Margin="13,5,0,20">
                <syncfusion1:ButtonAdv x:Name="Zaznacz_Wszystkie" Width="128" Height="45" Label="Zaznacz All" FontSize="16" Foreground="White" Background="#FF03A7A7" Command="{Binding MarkCommand}" Margin="0,0,4,0" IconWidth="20" IconHeight="15" FontFamily="Segoe UI" HorizontalAlignment="Left">
                    <syncfusion1:ButtonAdv.IconTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="18" Margin="0,0,6,0" Foreground="White"/>
                        </DataTemplate>
                    </syncfusion1:ButtonAdv.IconTemplate>
                    <syncfusion1:ButtonAdv.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                    </syncfusion1:ButtonAdv.BorderBrush>
                </syncfusion1:ButtonAdv>
                <syncfusion1:ButtonAdv x:Name="Dadaj_Wybrane" Width="128" Height="45" Label="Dadaj Wyb." FontSize="16" Foreground="White" Background="#FF2196F3"
                        Command="{Binding AddSelectedCommand}"
                        Margin="4,0,4,0" Visibility="Visible" IconWidth="20" IconHeight="15" FontFamily="Segoe UI">
                    <syncfusion1:ButtonAdv.IconTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE730;" FontSize="14" Margin="0,0,6,0" Foreground="White"/>
                        </DataTemplate>
                    </syncfusion1:ButtonAdv.IconTemplate>
                    <syncfusion1:ButtonAdv.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                    </syncfusion1:ButtonAdv.BorderBrush>
                </syncfusion1:ButtonAdv>

                <syncfusion1:ButtonAdv x:Name="Nowa_Lista_Add" Width="128" Height="45" Label="Nowa Lista" FontSize="16" Foreground="White" Background="#FF6D7FC7" Command="{Binding NewCommand}" Margin="4,0,4,0" IconWidth="20" IconHeight="20" FontFamily="Segoe UI">
                    <syncfusion1:ButtonAdv.IconTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE78F;" FontSize="18" Margin="5,0,5,0" Foreground="White"/>
                        </DataTemplate>
                    </syncfusion1:ButtonAdv.IconTemplate>
                    <syncfusion1:ButtonAdv.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                    </syncfusion1:ButtonAdv.BorderBrush>
                </syncfusion1:ButtonAdv>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Top" Margin="0,5,0,20">

                <StackPanel Orientation="Horizontal" Width="270">
                    <syncfusion1:ButtonAdv x:Name="Email" 
                            Width="128" Label="📧 Email" 
                            IsCheckable="False" Height="45" 
                            FontSize="16" Foreground="#FFFBFBFB" 
                            Background="#FF8E44AD" IconHeight="0" 
                            Command="{Binding SendEmailCommand}"
                            Visibility="{Binding WydrukiVisibility}"
                            IconWidth="0" FontFamily="Segoe UI" Margin="4,0,0,0" HorizontalAlignment="Right">
                        <syncfusion1:ButtonAdv.IconTemplate>
                            <DataTemplate/>
                        </syncfusion1:ButtonAdv.IconTemplate>
                        <syncfusion1:ButtonAdv.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                        </syncfusion1:ButtonAdv.BorderBrush>
                    </syncfusion1:ButtonAdv>
                    <syncfusion1:ButtonAdv x:Name="EXEL" Width="128" Label="📊  Excel" IsCheckable="False" Height="45" FontSize="16" Foreground="#FFFBFBFB" Background="#FF16A085" IconHeight="0" IconWidth="0" Margin="0,0,4,0" FontFamily="Segoe UI" Visibility="Hidden">
                        <syncfusion1:ButtonAdv.IconTemplate>
                            <DataTemplate/>
                        </syncfusion1:ButtonAdv.IconTemplate>
                        <syncfusion1:ButtonAdv.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                        </syncfusion1:ButtonAdv.BorderBrush>
                    </syncfusion1:ButtonAdv>
                </StackPanel>
                <StackPanel x:Name="wydruki" Orientation="Horizontal" Visibility="{Binding WydrukiVisibility}" 
                        Width="442">
                    <syncfusion1:ButtonAdv x:Name="Druk_Ceny" Width="140" Label="🖨️ Lista Ceny" 
                            IsCheckable="False" Height="45" FontSize="16" 
                            Foreground="#FFFBFBFB" Background="#FF16A085" 
                            Command="{Binding PrintSzczegolowyCommand}" 
                            Margin="4,0,4,0" HorizontalAlignment="Right" 
                            IconHeight="0" IconWidth="0" FontFamily="Segoe UI">
                        <syncfusion1:ButtonAdv.IconTemplate>
                            <DataTemplate/>
                        </syncfusion1:ButtonAdv.IconTemplate>
                        <syncfusion1:ButtonAdv.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                        </syncfusion1:ButtonAdv.BorderBrush>
                    </syncfusion1:ButtonAdv>
                    <syncfusion1:ButtonAdv x:Name="Druk_Razem" Height="45" Label=" 🖨️ Lista Razem" Width="140" Background="#FFFF6F61" Foreground="#FFFBFBFB" FontSize="16" IsCheckable="False" Command="{Binding PrintPodstawowyCommand}" Margin="4,0,4,0" HorizontalAlignment="Right" IconHeight="0" IconWidth="0" FontFamily="Segoe UI">
                        <syncfusion1:ButtonAdv.IconTemplate>
                            <DataTemplate/>
                        </syncfusion1:ButtonAdv.IconTemplate>
                        <syncfusion1:ButtonAdv.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                        </syncfusion1:ButtonAdv.BorderBrush>
                    </syncfusion1:ButtonAdv>

                    <syncfusion1:ButtonAdv x:Name="Druk_Lista" Width="140" 
                                               Label="🖨️ Lista" IsCheckable="False" 
                                               Height="45" FontSize="16" Foreground="#FFFBFBFB" 
                                               Background="#FF4A90E2" Command="{Binding PrintListaCommand}" Margin="4,0,4,0" HorizontalAlignment="Right" IconHeight="0" IconWidth="0" FontFamily="Segoe UI">
                        <syncfusion1:ButtonAdv.IconTemplate>
                            <DataTemplate/>
                        </syncfusion1:ButtonAdv.IconTemplate>
                        <syncfusion1:ButtonAdv.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                        </syncfusion1:ButtonAdv.BorderBrush>
                    </syncfusion1:ButtonAdv>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="290" VerticalAlignment="Top" Margin="0,5,10,20" Grid.Column="2">
                <syncfusion1:ButtonAdv x:Name="Anuluj_Button"
                        Label="❌  Anuluj"
                        IsCheckable="False"
                        Height="45" FontSize="16"
                        Foreground="#FFFBFBFB"
                        Background="#FFC73A04"
                        Command="{Binding CancelSaveCommand}"
                        Width="140" HorizontalAlignment="Right" Margin="0,0,5,0" IconHeight="0" IconWidth="0" FontFamily="Segoe UI">
                    <syncfusion1:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion1:ButtonAdv.IconTemplate>
                    <syncfusion1:ButtonAdv.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                    </syncfusion1:ButtonAdv.BorderBrush>
                </syncfusion1:ButtonAdv>
                <syncfusion1:ButtonAdv x:Name="Dodaj_Zapisz" 
                        Label="💾  Zapisz" 
                        IsCheckable="False" 
                        Height="45" FontSize="16" 
                        Foreground="#FFFBFBFB" 
                        Background="#FF16A085" 
                        Command="{Binding SaveListCommand}" 
                        Margin="0,0,5,0" Width="140" IconHeight="0" 
                        IconWidth="0" FontFamily="Segoe UI">

                    <syncfusion1:ButtonAdv.IconTemplate>
                        <DataTemplate/>
                    </syncfusion1:ButtonAdv.IconTemplate>
                    <syncfusion1:ButtonAdv.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}"/>
                    </syncfusion1:ButtonAdv.BorderBrush>
                </syncfusion1:ButtonAdv>
            </StackPanel>
        </Grid>

    </Grid>

</UserControl>
