<UserControl x:Class="ASMED.EDM.UI.Views.Visits.VisitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:ASMED.EDM.UI.Converters"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
    d:IsDesignTimeCreatable="False" 
             d:DesignHeight="800" d:DesignWidth="1500"
             Width="Auto"
             VerticalAlignment="Top"
             MaxWidth="1600"
             MinWidth="1500"
             Background="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Wizyty" 
                       FontSize="30" 
                       FontWeight="Bold" 
                       Foreground="#FF1976D2"/>
            <TextBlock Text="- Rejestracja wizyt" 
                       FontSize="16" 
                       FontStyle="Italic" 
                       Foreground="Gray" 
                       VerticalAlignment="Bottom" 
                       Margin="20,0,0,5"/>
        </StackPanel>

        <!-- Main Content: 3-column layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- KOLUMNA 1: Kalendarz -->
            <Border Grid.Column="0" 
                    BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" 
                    CornerRadius="8" 
                    Padding="10" 
                    Background="#FF6D6D6D">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📅 Kalendarz Wizyt" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#FFEDEB47"
                                   Margin="0,0,0,5"/>
                        <Button Content="🔄 Odśwież" 
                                Height="32"
                                Background="#FF4CAF50"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="Transparent" CornerRadius="4" Padding="0">
                        <syncfusion:SfScheduler x:Name="WizytyScheduler"
                                                ItemsSource="{Binding Appointments}"
                                                DisplayDate="{Binding SelectedDate, Mode=TwoWay}"
                                                EnableReminder="True"
                                                ShowBusyIndicator="True"
                                                HeaderDateFormat="dd-MM-yyyy"
                                                ViewType="Month"
                                                AllowedViewTypes="Month,Week"
                                                FontSize="10">

                            <syncfusion:SfScheduler.MonthViewSettings>
                                <syncfusion:MonthViewSettings 
                                    AppointmentDisplayCount="2"
                                    MonthNavigationDirection="Horizontal"
                                    ShowAgendaView="False"/>
                            </syncfusion:SfScheduler.MonthViewSettings>

                            <syncfusion:SfScheduler.DaysViewSettings>
                                <syncfusion:DaysViewSettings 
                                    TimeIntervalSize="40"
                                    StartHour="11"
                                    EndHour="15" 
                                    TimeInterval="00:05:00"
                                    TimeRulerFormat="HH:mm"
                                    CellRightPadding="10"
                                    TimeRulerSize="60"/>
                            </syncfusion:SfScheduler.DaysViewSettings>
                        </syncfusion:SfScheduler>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Stretch" 
                          Background="#FFDDDDDD"/>

            <!-- KOLUMNA 2: Lista Pacjentów -->
            <Border Grid.Column="2" 
                    BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" 
                    CornerRadius="8" 
                    Padding="10" 
                    Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" 
                    Width="500" 
                    HorizontalAlignment="Left" 
                    MaxHeight="650">

                <Grid Width="480" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Tytuł + Data + Licznik -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10" Width="480" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥 Lista Pacjentów" 
                                       FontSize="18" 
                                       FontWeight="SemiBold" 
                                       Foreground="#FFEDEB47" 
                                       Width="156"/>

                            <TextBlock Text="{Binding SelectedDateFormatted}" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                                       Width="200" 
                                       Margin="20,0,0,0" 
                                       VerticalAlignment="Bottom"/>

                            <TextBlock Text=" | " 
                                       FontSize="14" 
                                       Foreground="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}" 
                                       Width="10" 
                                       VerticalAlignment="Bottom"/>

                            <TextBlock Text="Pacjentów: " 
                                       FontSize="12" 
                                       Foreground="White" 
                                       VerticalAlignment="Bottom"/>

                            <TextBlock Text="{Binding TotalCount}" 
                                       FontSize="12" 
                                       FontWeight="Bold"
                                       Foreground="#FFEDEB44" 
                                       Width="30" 
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Szukajka + Przycisk Odśwież -->
                        <Grid Margin="0,10,0,0" Width="476" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <!-- SearchBox z placeholderem -->
                            <Border Grid.Column="0"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="4,2,5,2">
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="18"
                                             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                             BorderThickness="0"
                                             VerticalAlignment="Center"
                                             Foreground="Black" 
                                             Height="24"
                                             ToolTip="Szukaj po nazwisku, imieniu lub ID skierowania. Naciśnij F2 aby wyczyścić i ustawić focus.">
                                        <TextBox.Style>
                                            <Style TargetType="{x:Type TextBox}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                                    <VisualBrush.Visual>
                                                                        <TextBlock Text="🔍 Szukaj (nazwisko/imię/ID skier.)..." 
                                                                                   Foreground="Gray"
                                                                                   FontSize="14"
                                                                                   FontStyle="Italic"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Width="25"
                                            Height="25"
                                            Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                            FontSize="16"
                                            Cursor="Hand"
                                            ToolTip="Wyczyść filtr" 
                                            Margin="6,0,0,0"
                                            Command="{Binding ClearSearchCommand}"/>
                                </Grid>
                            </Border>

                            <!-- Przycisk Odśwież -->
                            <Button Grid.Column="1"
                                    Content="🔄"
                                    Width="60"
                                    Height="34"
                                    Background="#FF4CAF50"
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontSize="18"
                                    Cursor="Hand"
                                    ToolTip="Odśwież listę pacjentów na wybrany dzień" 
                                    Margin="8,0,0,0"
                                    Command="{Binding OdswiezCommand}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Lista pacjentów -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding FilteredPacjenciNaDzien}"
                             SelectedItem="{Binding SelectedPacjent, Mode=TwoWay}"
                             Margin="0,0,0,2"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" 
                             Width="476" 
                             HorizontalAlignment="Left" 
                             Background="{x:Null}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" 
                                        BorderThickness="2,2,2,2" 
                                        CornerRadius="4" 
                                        Padding="8" 
                                        Margin="0,2"
                                        Height="65" 
                                        Width="445" 
                                        Background="#FFFFFCFC">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Kolumna 1: Numer skierowania + Godzina -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="10" Foreground="Gray">
                                                <Run Text="📋 "/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding SkierowanieNumer, Mode=OneWay}" FontWeight="Bold" Foreground="#FF1976D2"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Margin="0,2,0,0">
                                                <Run Text="🕐 " Foreground="Gray"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding AppointmentTime, Mode=OneWay}" FontWeight="Bold"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Kolumna 2: Imię + Nazwisko -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding P_Imie, Mode=OneWay}" 
                                                       FontSize="12" 
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding P_Nazwisko, Mode=OneWay}" 
                                                       FontSize="17" 
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Kolumna 3: Firma -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Firma_Nazwa, Mode=OneWay}" 
                                                   FontSize="10" 
                                                   Foreground="#FF666666"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>

                                        <!-- Kolumna 4: Status wizyty -->
                                        <Border Grid.Column="3" 
                                                Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                CornerRadius="4"
                                                Padding="4"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding StatusWizytyTekst, Mode=OneWay}" 
                                                       FontSize="10" 
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer: Przyciski akcji -->
                    <StackPanel Grid.Row="2" Orientation="Vertical" Width="480" HorizontalAlignment="Center">
                        <Button Content="🖨️ Wydruk listy pacjentów" 
                                Height="35"
                                Margin="0,0,0,5"
                                Background="#FF2196F3"
                                Foreground="White"
                                FontSize="18"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding WydrukListyCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="5" 
                          HorizontalAlignment="Stretch" 
                          Background="#FFDDDDDD"/>

            <!-- KOLUMNA 3: Szczegóły / Statystyki -->
            <Border Grid.Column="4" 
                    BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" 
                    CornerRadius="8" 
                    Padding="10" 
                    Background="#FF6D6D6D">

                <Grid>
                    <!-- WIDOK 1: Karta Badań (gdy pacjent wybrany) -->
                    <Border x:Name="prawy_szczegoly_karty" 
                            BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" 
                            BorderThickness="2" 
                            CornerRadius="8" 
                            Padding="10" 
                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            Visibility="{Binding ShowDetailsView, Converter={StaticResource BooleanToVisibilityConverter}}"
                            MaxHeight="650">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="📋 Karta badań" 
                                               FontSize="18" 
                                               FontWeight="Bold" 
                                               Foreground="#FF1976D2"
                                               Margin="0,0,0,10"/>

                                    <!-- Status wizyty -->
                                    <Border Background="{Binding SelectedPacjent.Status, Converter={StaticResource StatusToBrushConverter}}"
                                            CornerRadius="4"
                                            Padding="8"
                                            Margin="0,0,0,10">
                                        <TextBlock Text="{Binding SelectedPacjent.StatusWizytyTekst}" 
                                                   FontSize="14" 
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Podstawowe info -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋 Skierowanie: " 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" 
                                                       Width="100"/>
                                            <TextBlock Text="{Binding SelectedPacjent.SkierowanieNumer}" 
                                                       FontSize="14" 
                                                       FontWeight="Bold"
                                                       Foreground="#FF000810" 
                                                       Width="80" 
                                                       HorizontalAlignment="Left"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                            <TextBlock Text="🕐 Godzina: " 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" 
                                                       Width="100"/>
                                            <TextBlock Text="{Binding SelectedPacjent.AppointmentTime}" 
                                                       FontSize="14" 
                                                       FontWeight="Bold" 
                                                       Width="100" 
                                                       HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Separator Margin="0,5,0,10" Background="#FFDDDDDD"/>

                                    <!-- Dane pacjenta -->
                                    <TextBlock Text="👤 Dane pacjenta" 
                                               FontSize="14" 
                                               FontWeight="Bold" 
                                               Foreground="#FF1976D2"
                                               Margin="0,0,0,8"/>

                                    <Border BorderBrush="#FF2196F3" 
                                            BorderThickness="2" 
                                            CornerRadius="8" 
                                            Padding="10" 
                                            Margin="0,0,0,10"
                                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                        <StackPanel>
                                            <TextBlock FontSize="12" Foreground="Gray">Imię i Nazwisko:</TextBlock>
                                            <TextBlock Text="{Binding SelectedPacjent.P_Imie}" 
                                                       FontSize="14" 
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedPacjent.P_Nazwisko}" 
                                                       FontSize="16" 
                                                       FontWeight="Bold"
                                                       Margin="0,2,0,10"/>

                                            <TextBlock FontSize="12" Foreground="Gray">Firma:</TextBlock>
                                            <TextBlock Text="{Binding SelectedPacjent.Firma_Nazwa}" 
                                                       FontSize="14" 
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Placeholder dla dalszych sekcji -->
                                    <TextBlock Text="🔧 Pełna edycja danych będzie dodana w następnej iteracji" 
                                               FontSize="11" 
                                               Foreground="Gray"
                                               FontStyle="Italic"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,20,0,0"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Przyciski na dole (będą dodane później) -->
                            <StackPanel Grid.Row="1" 
                                        Orientation="Vertical" 
                                        Margin="0,10,0,0">
                                <!-- TODO: Przyciski akcji -->
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- WIDOK 2: Statystyki (domyślnie widoczne) -->
                    <Border x:Name="Prawy_wybrany_pacjent" 
                            BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" 
                            CornerRadius="8" 
                            Padding="10,10,10,10" 
                            Background="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                            Visibility="{Binding ShowStatsView, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <Grid MaxHeight="650" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="90"/>
                                <RowDefinition Height="Auto" MinHeight="375"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- SEKCJA 1: Statystyki dnia -->
                            <StackPanel Grid.Row="0" Margin="0,10,0,5" MaxHeight="650">
                                <TextBlock Text="📊 Statystyki dnia" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="#FFEDEB44"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="415">
                                    <!-- Liczba wizyt -->
                                    <Border BorderBrush="#FFE0E0E0" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="8"
                                            Background="#FFFAFAFA" 
                                            Width="133" 
                                            Margin="5,0,0,0" 
                                            Height="60" 
                                            VerticalAlignment="Top"
                                            ToolTip="Wszystkie wizyty / W realizacji lub zrealizowane">
                                        <StackPanel>
                                            <TextBlock Text="Liczba wizyt" 
                                                       FontSize="10" 
                                                       Foreground="Gray"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock FontSize="24" 
                                                           FontWeight="Bold"
                                                           Foreground="#FF1976D2">
                                                    <Run Text="{Binding TotalCount}"/>
                                                </TextBlock>
                                                <TextBlock Text=" / " 
                                                           FontSize="18" 
                                                           FontWeight="Normal"
                                                           Foreground="#FF666666"
                                                           Margin="3,0"/>
                                                <TextBlock Text="{Binding CompletedCount}" 
                                                           FontSize="24" 
                                                           FontWeight="Bold"
                                                           Foreground="#FF4CAF50"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Wolne sloty (placeholder) -->
                                    <Border BorderBrush="#FFE0E0E0" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="8"
                                            Background="#FFFAFAFA" 
                                            Width="133" 
                                            Margin="5,0,0,0" 
                                            Height="60">
                                        <StackPanel>
                                            <TextBlock Text="Wolne sloty" 
                                                       FontSize="10" 
                                                       Foreground="Gray"/>
                                            <TextBlock Text="—" 
                                                       FontSize="24" 
                                                       FontWeight="Bold"
                                                       Foreground="#FF4CAF50"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pierwsza / Ostatnia (placeholder) -->
                                    <Border BorderBrush="#FFE0E0E0" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="8"
                                            Background="#FFFAFAFA" 
                                            Width="133" 
                                            Margin="5,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Pierwsza" 
                                                           FontSize="9" 
                                                           Foreground="Gray"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="—" 
                                                           FontSize="14" 
                                                           FontWeight="Bold"
                                                           Foreground="#FF1976D2"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Ostatnia" 
                                                           FontSize="9" 
                                                           Foreground="Gray"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="—" 
                                                           FontSize="14" 
                                                           FontWeight="Bold"
                                                           Foreground="#FF1976D2"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- SEKCJA 2: Placeholder dla reszty statystyk -->
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="📈 Dodatkowe statystyki będą dodane w następnej iteracji" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
