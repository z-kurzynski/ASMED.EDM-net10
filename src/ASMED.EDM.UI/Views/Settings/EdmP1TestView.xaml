<UserControl x:Class="ASMED.EDM.UI.Views.Settings.EdmP1TestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#F0F4FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16">
    <StackPanel Width="360" Margin="0,0,16,0">
        <TextBlock Text="🏥" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock Text="Test Middleware — odczyt danych pacjenta"
                   FontSize="14"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4"/>
        <TextBlock Text="Uwaga: to lokalny rejestr pacjentów podmiotu w P1 (nie CWUB). Sukces tu nie gwarantuje zgodności z CWUB przy orzeczeniach."
                   FontSize="11" Foreground="#555" TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <TextBlock Text="PESEL pacjenta:" Margin="0,0,0,4"/>
        <TextBox x:Name="PeselTextBox" Text="70032816894" Margin="0,0,0,8"/>

        <TextBlock Text="Imię:" Margin="0,0,0,4"/>
        <TextBox x:Name="ImieTextBox" Text="Anna" Margin="0,0,0,8"/>

        <TextBlock Text="Nazwisko:" Margin="0,0,0,4"/>
        <TextBox x:Name="NazwiskoTextBox" Text="Kasina" Margin="0,0,0,8"/>

        <Button x:Name="SearchButton" Content="Wyszukaj pacjenta w P1 (Middleware)"
                Click="SearchButton_Click" Margin="0,0,0,8" Padding="8,4"/>

        <TextBlock Text="ID pacjenta (z wyszukiwania):" Margin="0,0,0,4"/>
        <TextBox x:Name="PacjentIdTextBox" IsReadOnly="True" Margin="0,0,0,8"/>

        <Button x:Name="ReadButton" Content="Odczytaj pacjenta po ID (Middleware)"
                Click="ReadButton_Click" Margin="0,0,0,8" Padding="8,4"/>

        <TextBlock Text="Wynik:" Margin="0,8,0,4" FontWeight="Bold"/>
        <TextBox x:Name="ResultTextBox" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" MinHeight="120" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>

    <StackPanel Width="360" Margin="0,0,16,0">
        <TextBlock Text="Test Middleware — wysyłka orzeczenia medycyny pracy do P1"
                   FontSize="14"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4"/>
        <TextBlock Text="Uwaga: dokument CDA jest walidowany względem CWUB (kraj.), a nie lokalnego rejestru pacjentów P1. Zgodne dane w wyszukiwaniu/odczycie nie gwarantują zgodności z CWUB."
                   FontSize="11" Foreground="#555" TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <TextBlock Text="Numer dokumentu:" Margin="0,0,0,4"/>
        <TextBox x:Name="NumerDokumentuTextBox" Text="14/2026" Margin="0,0,0,8"/>

        <TextBlock Text="Numer skierowania:" Margin="0,0,0,4"/>
        <TextBox x:Name="NumerSkierowaniaTextBox" Text="2345678" Margin="0,0,0,8"/>

        <TextBlock Text="Data skierowania (yyyy-MM-dd):" Margin="0,0,0,4"/>
        <TextBox x:Name="DataSkierowaniaTextBox" Text="2026-01-10" Margin="0,0,0,8"/>

        <TextBlock Text="Rodzaj badania (WSTEPNE / OKRESOWE / KONTROLNE):" Margin="0,0,0,4"/>
        <TextBox x:Name="RodzajBadaniaTextBox" Text="WSTEPNE" Margin="0,0,0,8"/>

        <TextBlock Text="Rodzaj zatrudnienia (PRZYJMOWANY / ZATRUDNIONY):" Margin="0,0,0,4"/>
        <TextBox x:Name="RodzajZatrudnieniaTextBox" Text="PRZYJMOWANY" Margin="0,0,0,8"/>

        <TextBlock Text="Zawód:" Margin="0,0,0,4"/>
        <TextBox x:Name="ZawodTextBox" Text="Specjalista ds. sprzedaży" Margin="0,0,0,8"/>

        <TextBlock Text="Płeć pacjenta (K / M):" Margin="0,0,0,4"/>
        <TextBox x:Name="PlecTextBox" Text="K" Margin="0,0,0,8"/>

        <TextBlock Text="Data urodzenia pacjenta (yyyy-MM-dd):" Margin="0,0,0,4"/>
        <TextBox x:Name="DataUrodzeniaTextBox" Text="1981-10-26" Margin="0,0,0,8"/>

        <TextBlock Text="Pracodawca — NIP:" Margin="0,0,0,4"/>
        <TextBox x:Name="PracodawcaNipTextBox" Text="1382222234" Margin="0,0,0,8"/>

        <TextBlock Text="Pracodawca — REGON9:" Margin="0,0,0,4"/>
        <TextBox x:Name="PracodawcaRegon9TextBox" Text="190190190" Margin="0,0,0,8"/>

        <TextBlock Text="Pracodawca — nazwa:" Margin="0,0,0,4"/>
        <TextBox x:Name="PracodawcaNazwaTextBox" Text="ABC Sp. z o.o." Margin="0,0,0,8"/>

        <TextBlock Text="Pracodawca — miejscowość:" Margin="0,0,0,4"/>
        <TextBox x:Name="PracodawcaMiejscowoscTextBox" Text="Warszawa" Margin="0,0,0,8"/>

        <TextBlock Text="Pracodawca — kod pocztowy:" Margin="0,0,0,4"/>
        <TextBox x:Name="PracodawcaKodPocztowyTextBox" Text="00-100" Margin="0,0,0,8"/>

        <TextBlock Text="Pracodawca — ulica:" Margin="0,0,0,4"/>
        <TextBox x:Name="PracodawcaUlicaTextBox" Text="Długa" Margin="0,0,0,8"/>

        <TextBlock Text="Pracodawca — nr domu:" Margin="0,0,0,4"/>
        <TextBox x:Name="PracodawcaNrDomuTextBox" Text="8" Margin="0,0,0,8"/>

        <TextBlock Text="Pracodawca — telefon:" Margin="0,0,0,4"/>
        <TextBox x:Name="PracodawcaTelefonTextBox" Text="221234567" Margin="0,0,0,8"/>

        <TextBlock Text="Symbol werdyktu (np. SYMBOL_21):" Margin="0,0,0,4"/>
        <TextBox x:Name="WerdyktSymbolTextBox" Text="SYMBOL_21" Margin="0,0,0,8"/>

        <TextBlock Text="Data następnego badania (yyyy-MM-dd):" Margin="0,0,0,4"/>
        <TextBox x:Name="DataNastepnegoBadaniaTextBox" Text="2028-01-10" Margin="0,0,0,8"/>

        <TextBlock Text="Miejsce wystawienia:" Margin="0,0,0,4"/>
        <TextBox x:Name="MiejsceWystawieniaTextBox" Text="Bydgoszcz" Margin="0,0,0,8"/>

        <Button x:Name="WeryfikujOrzeczenieButton" Content="Zweryfikuj orzeczenie (bez zapisu, Middleware)"
                Click="WeryfikujOrzeczenieButton_Click" Margin="0,0,0,8" Padding="8,4"/>

        <Button x:Name="WystawOrzeczenieButton" Content="Wystaw orzeczenie w P1 (Middleware)"
                Click="WystawOrzeczenieButton_Click" Margin="0,0,0,8" Padding="8,4"/>

        <TextBlock Text="Wynik orzeczenia:" Margin="0,8,0,4" FontWeight="Bold"/>
        <TextBox x:Name="OrzeczenieResultTextBox" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" MinHeight="120" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>

    <StackPanel Width="360">
        <TextBlock Text="Test Middleware — rejestracja / aktualizacja pacjenta"
                   FontSize="14"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4"/>
        <TextBlock Text="Uwaga: aktualizacja odrzuca żądanie, jeśli nie zmienia się żadna dana tożsamościowa (imię/nazwisko/płeć/data urodzenia); sama zmiana adresu może nie wystarczyć."
                   FontSize="11" Foreground="#555" TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <TextBlock Text="PESEL pacjenta:" Margin="0,0,0,4"/>
        <TextBox x:Name="RegPeselTextBox" Text="70032816894" Margin="0,0,0,8"/>

        <TextBlock Text="Imię:" Margin="0,0,0,4"/>
        <TextBox x:Name="RegImieTextBox" Text="Anna" Margin="0,0,0,8"/>

        <TextBlock Text="Nazwisko:" Margin="0,0,0,4"/>
        <TextBox x:Name="RegNazwiskoTextBox" Text="Kasina" Margin="0,0,0,8"/>

        <TextBlock Text="Płeć (K / M):" Margin="0,0,0,4"/>
        <TextBox x:Name="RegPlecTextBox" Text="K" Margin="0,0,0,8"/>

        <TextBlock Text="Data urodzenia (yyyy-MM-dd):" Margin="0,0,0,4"/>
        <TextBox x:Name="RegDataUrodzeniaTextBox" Text="1981-10-26" Margin="0,0,0,8"/>

        <TextBlock Text="Miejscowość:" Margin="0,0,0,4"/>
        <TextBox x:Name="RegMiejscowoscTextBox" Text="Szczecin" Margin="0,0,0,8"/>

        <TextBlock Text="Kod pocztowy:" Margin="0,0,0,4"/>
        <TextBox x:Name="RegKodPocztowyTextBox" Text="70-570" Margin="0,0,0,8"/>

        <TextBlock Text="Ulica:" Margin="0,0,0,4"/>
        <TextBox x:Name="RegUlicaTextBox" Text="Misjonarska" Margin="0,0,0,8"/>

        <TextBlock Text="Nr domu:" Margin="0,0,0,4"/>
        <TextBox x:Name="RegNrDomuTextBox" Text="116" Margin="0,0,0,8"/>

        <TextBlock Text="Nr lokalu:" Margin="0,0,0,4"/>
        <TextBox x:Name="RegNrLokaluTextBox" Margin="0,0,0,8"/>

        <Button x:Name="RegisterPatientButton" Content="Zarejestruj pacjenta w P1 (Middleware)"
                Click="RegisterPatientButton_Click" Margin="0,0,0,8" Padding="8,4"/>

        <TextBlock Text="ID pacjenta do aktualizacji (z rejestracji lub wyszukania):" Margin="0,0,0,4"/>
        <TextBox x:Name="RegPacjentIdTextBox" Margin="0,0,0,8"/>

        <Button x:Name="UpdatePatientButton" Content="Aktualizuj pacjenta w P1 (Middleware)"
                Click="UpdatePatientButton_Click" Margin="0,0,0,8" Padding="8,4"/>

        <TextBlock Text="Wynik:" Margin="0,8,0,4" FontWeight="Bold"/>
        <TextBox x:Name="RegResultTextBox" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" MinHeight="120" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>

    <StackPanel Width="360" Margin="16,0,0,0">
        <TextBlock Text="Test Middleware — pozostałe operacje na orzeczeniu"
                   FontSize="14"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <TextBlock Text="Odczytaj orzeczenie (POST /orzeczenie/odczyt)" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Identyfikator Root:" Margin="0,0,0,4"/>
        <TextBox x:Name="OrzeczenieIdentyfikatorRootTextBox" Margin="0,0,0,8"/>
        <TextBlock Text="Identyfikator Extension:" Margin="0,0,0,4"/>
        <TextBox x:Name="OrzeczenieIdentyfikatorExtensionTextBox" Text="14/2026" Margin="0,0,0,8"/>
        <Button x:Name="OdczytajOrzeczenieButton" Content="Odczytaj orzeczenie (Middleware)"
                Click="OdczytajOrzeczenieButton_Click" Margin="0,0,0,12" Padding="8,4"/>

        <TextBlock Text="Wyszukaj orzeczenia (POST /orzeczenie/wyszukaj)" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Data wystawienia od (yyyy-MM-dd):" Margin="0,0,0,4"/>
        <TextBox x:Name="OrzeczenieWyszukajDataOdTextBox" Text="2020-01-01" Margin="0,0,0,8"/>
        <TextBlock Text="Data wystawienia do (yyyy-MM-dd):" Margin="0,0,0,4"/>
        <TextBox x:Name="OrzeczenieWyszukajDataDoTextBox" Margin="0,0,0,8"/>
        <TextBlock Text="Identyfikator usługobiorcy (PESEL):" Margin="0,0,0,4"/>
        <TextBox x:Name="OrzeczenieWyszukajIdentyfikatorTextBox" Text="70032816894" Margin="0,0,0,8"/>
        <TextBlock Text="Status dokumentu (opcjonalnie):" Margin="0,0,0,4"/>
        <TextBox x:Name="OrzeczenieWyszukajStatusTextBox" Margin="0,0,0,8"/>
        <Button x:Name="WyszukajOrzeczeniaButton" Content="Wyszukaj orzeczenia (Middleware)"
                Click="WyszukajOrzeczeniaButton_Click" Margin="0,0,0,12" Padding="8,4"/>

        <TextBlock Text="Anuluj orzeczenie (POST /orzeczenie/anuluj)" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Numer dokumentu (anulującego):" Margin="0,0,0,4"/>
        <TextBox x:Name="AnulujNumerDokumentuTextBox" Text="15/2026" Margin="0,0,0,8"/>
        <TextBlock Text="Anulowany numer dokumentu:" Margin="0,0,0,4"/>
        <TextBox x:Name="AnulowanyNumerDokumentuTextBox" Text="14/2026" Margin="0,0,0,8"/>
        <TextBlock Text="Anulowana wersja:" Margin="0,0,0,4"/>
        <TextBox x:Name="AnulowanaWersjaTextBox" Text="1" Margin="0,0,0,8"/>
        <Button x:Name="AnulujOrzeczenieButton" Content="Anuluj orzeczenie (Middleware)"
                Click="AnulujOrzeczenieButton_Click" Margin="0,0,0,12" Padding="8,4"/>

        <TextBlock Text="Wynik:" Margin="0,8,0,4" FontWeight="Bold"/>
        <TextBox x:Name="OrzeczenieExtraResultTextBox" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" MinHeight="160" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>

