<UserControl x:Class="ASMED.EDM.UI.Views.Settings.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ASMED.EDM.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             Background="#FFE8F5E9">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- LEWA KOLUMNA: Lista użytkowników -->
        <Border Grid.Column="0"
                BorderBrush="#FF1976D2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="👥 Użytkownicy systemu"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FF1976D2"
                           Margin="0,0,0,15"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#FFF5F5F5"
                          HeadersVisibility="Column"
                          FontSize="12"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                        <DataGridTextColumn Header="🔑 Login" Binding="{Binding Username}" Width="90" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="👤 Imię i nazwisko" Binding="{Binding FullName}" Width="160"/>
                        <DataGridTextColumn Header="📧 Email" Binding="{Binding Email}" Width="170"/>
                        <DataGridTextColumn Header="👔 Rola" Binding="{Binding Role}" Width="100"/>
                        <DataGridTextColumn Header="📊 Status" Binding="{Binding IsActive}" Width="70"/>
                        <DataGridTextColumn Header="🕐 Ostatnie logowanie" Binding="{Binding LastLoginAt}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="10"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"/>

        <!-- PRAWA KOLUMNA: Formularz -->
        <Border Grid.Column="2"
                BorderBrush="#FF4CAF50"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Background="White">

            <TabControl BorderThickness="0" Background="Transparent">

                <!-- Zakładka 1: Formularz użytkownika -->
                <TabItem Header="📝 Formularz" FontSize="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="📝 Formularz użytkownika"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#FF4CAF50"
                                       Margin="0,0,0,20"/>

                            <!-- Username -->
                            <TextBlock Text="Login:" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding FormUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14"
                                     Height="30"
                                     Margin="10,0,10,5"
                                     IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBooleanConverter}}"/>

                            <!-- Password -->
                            <TextBlock Text="Hasło:" FontSize="12" Margin="10,0,10,3"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="PasswordBox"
                                             Grid.Column="0"
                                             FontSize="14"
                                             Height="30"
                                             PasswordChanged="PasswordBox_PasswordChanged"
                                             Visibility="{Binding ShowPassword, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="10,0,10,0"/>

                                <TextBox x:Name="PasswordTextBox"
                                         Grid.Column="0"
                                         Text="{Binding FormPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14"
                                         Height="30"
                                         Visibility="{Binding ShowPassword, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="10,0,0,0"/>

                                <Button Grid.Column="1"
                                        Content="{Binding ShowPasswordIcon}"
                                        Height="30"
                                        Background="#FF9E9E9E"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Pokaż/Ukryj hasło"
                                        Command="{Binding TogglePasswordVisibilityCommand}" Margin="0,0,5,0"/>

                                <Button Grid.Column="2"
                                        Content="🎲"
                                        Height="30"
                                        Background="#FF2196F3"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Generuj losowe hasło"
                                        Command="{Binding GeneratePasswordCommand}" Margin="0,0,5,0"/>
                            </Grid>
                            <TextBlock Text="Hasło można wpisać ręcznie także przy edycji użytkownika (zapisze się po kliknięciu Zapisz zmiany)."
                                       FontSize="10"
                                       Foreground="#FF757575"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"
                                       Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- First Name -->
                            <TextBlock Text="Imię:" FontSize="12" Margin="10,0,10,3"/>
                            <TextBox Text="{Binding FormFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14"
                                     Height="30"
                                     Margin="10,0,10,5"/>

                            <!-- Last Name -->
                            <TextBlock Text="Nazwisko:" FontSize="12" Margin="10,0,10,3"/>
                            <TextBox Text="{Binding FormLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14"
                                     Height="30"
                                     Margin="10,0,10,5"/>

                            <!-- Email -->
                            <TextBlock Text="Email:" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding FormEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14"
                                     Height="30"
                                     Margin="10,0,10,5"/>

                            <!-- Role -->
                            <TextBlock Text="Rola:" FontSize="12" Margin="10,0,10,5"/>
                            <ComboBox ItemsSource="{Binding AvailableRoles}"
                                      SelectedItem="{Binding FormRole, Mode=TwoWay}"
                                      FontSize="14"
                                      Height="30"
                                      Margin="0,0,0,10"/>

                            <!-- IsActive -->
                            <CheckBox Content="✅ Konto aktywne"
                                      IsChecked="{Binding FormIsActive, Mode=TwoWay}"
                                      FontSize="12"
                                      Margin="0,0,0,10"/>

                            <!-- Przyciski -->
                            <Button Content="{Binding SaveButtonLabel}"
                                    Command="{Binding SaveUserCommand}"
                                    Height="35"
                                    Background="#FF4CAF50"
                                    Foreground="White"
                                    FontSize="16"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,0,5"/>

                            <Button Content="🔒 Zmień hasło"
                                    Command="{Binding ChangePasswordCommand}"
                                    Height="35"
                                    Background="#FF2196F3"
                                    Foreground="White"
                                    FontSize="14"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,0,5"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Button Content="🗑️ Dezaktywuj użytkownika"
                                    Command="{Binding DeleteUserCommand}"
                                    Height="35"
                                    Background="#FFF44336"
                                    Foreground="White"
                                    FontSize="14"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,0,5"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Button Content="🆕 Nowy użytkownik"
                                    Command="{Binding ClearFormCommand}"
                                    Height="35"
                                    Background="#FF607D8B"
                                    Foreground="White"
                                    FontSize="14"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Zakładka 2: Historia logowań -->
                <TabItem Header="📜 Historia" FontSize="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="📜 Historia logowań"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FF2196F3"
                                   Margin="0,10,0,10"/>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding LoginHistory}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#FFF5F5F5"
                                  HeadersVisibility="Column"
                                  FontSize="11"
                                  Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="📅 Logowanie" Binding="{Binding LoginTime}" Width="140"/>
                                <DataGridTextColumn Header="🚪 Wylogowanie" Binding="{Binding LogoutTime}" Width="140"/>
                                <DataGridTextColumn Header="💻 Komputer" Binding="{Binding ComputerName}" Width="130"/>
                                <DataGridTextColumn Header="🌐 IP" Binding="{Binding IpAddress}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
