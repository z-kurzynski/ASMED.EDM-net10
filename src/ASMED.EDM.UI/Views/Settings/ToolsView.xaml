<UserControl x:Class="ASMED.EDM.UI.Views.Settings.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFF8E1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🛠️ Narzędzia Pomocnicze" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#FF1976D2" 
                       Margin="0,0,0,10"/>
            <TextBlock Text="Import UI z migrowanego projektu" 
                       FontSize="14" 
                       Foreground="Gray"/>
        </StackPanel>

        <!-- Główna zawartość -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#FFE0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Ostrzeżenie -->
                <Border Grid.Row="0" 
                        Background="#FFFFF3CD" 
                        BorderBrush="#FFFFC107" 
                        BorderThickness="2" 
                        CornerRadius="6" 
                        Padding="15" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#FF856404" Margin="0,0,0,5">
                            ⚠️ WAŻNE - Przed rozpoczęciem pracy z narzędziem:
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#FF856404" TextWrapping="Wrap">
                            • Upewnij się, że masz kopię zapasową projektu<LineBreak/>
                            • Narzędzie modyfikuje pliki - zatwierdź zmiany w Git przed użyciem<LineBreak/>
                            • Po imporcie sprawdź namespace i dodaj pliki do projektu<LineBreak/>
                            • Metody będą zawierały tylko throw NotImplementedException()
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Zawartość główna -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Panel lewy - kontrolki -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <!-- Sekcja wyboru pliku -->
                        <Border Background="#FFF5F5F5" 
                                BorderBrush="#FF1976D2" 
                                BorderThickness="2" 
                                CornerRadius="6" 
                                Padding="15" 
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="1️⃣ Wybierz plik XAML" 
                                           FontSize="16" 
                                           FontWeight="SemiBold" 
                                           Foreground="#FF1976D2" 
                                           Margin="0,0,0,10"/>

                                <Button Content="📁 Wybierz plik XAML..." 
                                        Command="{Binding SelectXamlFileCommand}"
                                        Height="40"
                                        FontSize="14"
                                        Background="#FF1976D2"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="0,0,0,10">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="4" 
                                                                Padding="10,5">
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                                                            VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FF1565C0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <TextBlock Text="{Binding SelectedXamlPath}" 
                                           TextWrapping="Wrap" 
                                           FontSize="11" 
                                           Foreground="#FF666666"
                                           Margin="0,0,0,5"/>

                                <TextBlock FontSize="11" Foreground="Green" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❌ Nie wybrano pliku"/>
                                            <Setter Property="Foreground" Value="#FFFF5252"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsXamlSelected}" Value="True">
                                                    <Setter Property="Text" Value="✅ Plik wybrany"/>
                                                    <Setter Property="Foreground" Value="#FF4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Sekcja kategorii -->
                        <Border Background="#FFF5F5F5" 
                                BorderBrush="#FFFF9800" 
                                BorderThickness="2" 
                                CornerRadius="6" 
                                Padding="15" 
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="2️⃣ Wybierz kategorię" 
                                           FontSize="16" 
                                           FontWeight="SemiBold" 
                                           Foreground="#FFFF9800" 
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="Katalog docelowy:" 
                                           FontSize="12" 
                                           Foreground="Gray" 
                                           Margin="0,0,0,5"/>

                                <ComboBox ItemsSource="{Binding AvailableCategories}"
                                         SelectedItem="{Binding TargetCategory}"
                                         Height="35"
                                         FontSize="14"
                                         Margin="0,0,0,10"/>

                                <TextBlock FontSize="11" Foreground="#FF666666">
                                    <Run Text="Pliki zostaną zapisane w:"/>
                                    <LineBreak/>
                                    <Run Text="Views/" FontWeight="SemiBold"/>
                                    <Run Text="{Binding TargetCategory}" FontWeight="SemiBold" Foreground="#FFFF9800"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Sekcja importu -->
                        <Border Background="#FFF5F5F5" 
                                BorderBrush="#FF4CAF50" 
                                BorderThickness="2" 
                                CornerRadius="6" 
                                Padding="15">
                            <StackPanel>
                                <TextBlock Text="3️⃣ Importuj" 
                                           FontSize="16" 
                                           FontWeight="SemiBold" 
                                           Foreground="#FF4CAF50" 
                                           Margin="0,0,0,10"/>

                                <Button Content="🚀 Importuj UI" 
                                        Command="{Binding ImportUICommand}"
                                        Height="45"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Background="#FF4CAF50"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="0,0,0,10">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="6" 
                                                                Padding="10,5">
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                                                            VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FF388E3C"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Background" Value="#FFBDBDBD"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <TextBlock Text="Narzędzie skopiuje XAML i wygeneruje pliki .cs z samymi sygnaturami metod" 
                                           TextWrapping="Wrap" 
                                           FontSize="11" 
                                           Foreground="#FF666666"/>
                            </StackPanel>
                        </Border>

                        <!-- Status -->
                        <Border Background="#FFFFE082" 
                                BorderBrush="#FFFFA000" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="10" 
                                Margin="0,15,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏳" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding BusyMessage}" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Panel prawy - logi -->
                    <Border Grid.Column="1" 
                            Background="White" 
                            BorderBrush="#FFE0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Nagłówek logów -->
                            <Border Grid.Row="0" 
                                    Background="#FF37474F" 
                                    CornerRadius="6,6,0,0" 
                                    Padding="10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋 Logi importu" 
                                               FontSize="14" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                    <Button Content="🗑️ Wyczyść" 
                                            Command="{Binding ClearLogCommand}"
                                            Margin="15,0,0,0"
                                            Padding="8,3"
                                            FontSize="11"
                                            Background="#FF546E7A"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="3" 
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                                VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FF607D8B"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Obszar logów -->
                            <ScrollViewer Grid.Row="1" 
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding ImportLog, Mode=OneWay}" 
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Background="#FFF5F5F5"
                                         BorderThickness="0"
                                         Padding="10"
                                         VerticalAlignment="Stretch"
                                         AcceptsReturn="True"/>
                            </ScrollViewer>

                            <!-- Informacje -->
                            <Border Grid.Row="2" 
                                    Background="#FFE3F2FD" 
                                    BorderBrush="#FF2196F3" 
                                    BorderThickness="0,1,0,0" 
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="ℹ️ Jak używać tego narzędzia:" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="#FF1976D2" 
                                               Margin="0,0,0,5"/>
                                    <TextBlock FontSize="10" 
                                               Foreground="#FF424242" 
                                               TextWrapping="Wrap">
                                        1. Wybierz plik .xaml ze starego projektu<LineBreak/>
                                        2. Wybierz kategorię (katalog docelowy)<LineBreak/>
                                        3. Kliknij "Importuj UI"<LineBreak/>
                                        4. Narzędzie skopiuje XAML i code-behind/ViewModel z pustymi metodami<LineBreak/>
                                        5. Projekt będzie się kompilował - wypełnij metody później
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
