<UserControl x:Class="ASMED.EDM.UI.Views.Settings.FacilityDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ASMED.EDM.UI.ViewModels.ustawienia"
             xmlns:converters="clr-namespace:ASMED.EDM.UI.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FacilityDataViewModel, IsDesignTimeCreatable=False}"
             Background="#F4F6FB">

    <UserControl.Resources>

        <!-- konwertery bool → pędzel -->
        <converters:BoolToBrushConverter x:Key="CertBrush"
            TrueColor="#2E7D32" FalseColor="#78909C"/>
        <converters:BoolToBrushConverter x:Key="EdmBrush"
            TrueColor="#2E7D32" FalseColor="#F57F17"/>
        <converters:BoolToBrushConverter x:Key="CheckBrush"
            TrueColor="#2E7D32" FalseColor="#B71C1C"/>
        <!-- stub=true → czerwony (źle), stub=false → zielony (prod) -->
        <converters:BoolToBrushConverter x:Key="StubBrush"
            TrueColor="#B71C1C" FalseColor="#2E7D32"/>

        <!-- konwertery bool → tekst -->
        <converters:BoolToTextConverter x:Key="CheckMark" TrueText="☑" FalseText="☐"/>
        <converters:BoolToTextConverter x:Key="StubMode"  TrueText="STUB" FalseText="PROD"/>
        <!-- stub=true=źle → ☐, false → ☑ -->
        <converters:BoolToTextConverter x:Key="StubCheck" TrueText="☐" FalseText="☑"/>

        <!-- kolory akcentów -->
        <SolidColorBrush x:Key="Col1Accent" Color="#1565C0"/>
        <SolidColorBrush x:Key="Col2Accent" Color="#6A1B9A"/>
        <SolidColorBrush x:Key="Col3Accent" Color="#2E7D32"/>
        <SolidColorBrush x:Key="LabelFg"    Color="#546E7A"/>

        <!-- Karta z cieniem -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                      Color="#CCCCCC" Opacity="0.35" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nagłówek kolumny -->
        <Style x:Key="ColHeader" TargetType="Border">
            <Setter Property="CornerRadius" Value="10,10,0,0"/>
            <Setter Property="Padding"      Value="16,12"/>
        </Style>

        <!-- Etykieta pola -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelFg}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,8,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- TextBox -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="Padding"                  Value="6,4"/>
            <Setter Property="BorderBrush"              Value="#B0BEC5"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="#FAFAFA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- PasswordBox -->
        <Style x:Key="PwdBox" TargetType="PasswordBox">
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="Padding"                  Value="6,4"/>
            <Setter Property="BorderBrush"              Value="#B0BEC5"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="#FAFAFA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Przycisk -->
        <Style x:Key="ColBtn" TargetType="Button">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separator -->
        <Style x:Key="HSep" TargetType="Separator">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Margin"     Value="0,10,0,6"/>
            <Setter Property="Height"     Value="1"/>
        </Style>

        <!-- Nagłówek sekcji -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- Badge statusu -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding"      Value="8,3"/>
            <Setter Property="Margin"       Value="0,4,0,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Nagłówek strony ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1565C0" Padding="20,14" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="2"
                                  Color="#1565C0" Opacity="0.4" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏥" FontSize="26" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Dane Placówki i Integracja P1"
                                   FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="NZOZ — Niepubliczny Zakład Opieki Zdrowotnej"
                                   FontSize="11" Foreground="#90CAF9" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ColBtn}"
                        Background="#0D47A1" Height="34" Padding="14,0"
                        Command="{Binding RefreshStatusCommand}"
                        ToolTip="Odśwież statusy certyfikatów i repozytorium">
                    🔄  Odśwież statusy
                </Button>
            </Grid>
        </Border>

        <!-- ══ Trzy kolumny ════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*" MinWidth="280"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  KOLUMNA 1 — Dane placówki                             -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Style="{StaticResource ColHeader}" Background="#1565C0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏢" FontSize="18" Foreground="White"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="Dane Placówki"
                                               FontSize="14" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Informacje podstawowe NZOZ"
                                               FontSize="10" Foreground="#90CAF9"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="16,10,16,16">

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nazwa placówki *"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding OrganizationName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Typ placówki"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding FacilityType, UpdateSourceTrigger=PropertyChanged}"/>

                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource Col1Accent}"
                                       Text="Dane identyfikacyjne"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="NIP"/>
                            <TextBox Style="{StaticResource InputBox}" MaxLength="13"
                                     Text="{Binding Nip, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="REGON (14-znakowy) *"/>
                            <TextBox Style="{StaticResource InputBox}" MaxLength="14"
                                     Text="{Binding Regon14, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Numer księgi RPWDL *"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding RpwdlBookNumber, UpdateSourceTrigger=PropertyChanged}"/>

                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource Col1Accent}"
                                       Text="Adres siedziby"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ulica i numer"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Kod pocztowy"/>
                                    <TextBox Style="{StaticResource InputBox}" MaxLength="6"
                                             Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Miejscowość"/>
                                    <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource Col1Accent}"
                                       Text="Kontakt"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Telefon"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="E-mail"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  KOLUMNA 2 — Integracja P1 / e-zdrowie                 -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Style="{StaticResource ColHeader}" Background="#6A1B9A">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔗" FontSize="18" Foreground="White"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="Integracja P1 / e-zdrowie"
                                               FontSize="14" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Zdarzenia Medyczne · PESEL · Certyfikaty"
                                               FontSize="10" Foreground="#CE93D8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="16,10,16,16">

                            <!-- Tryb stub -->
                            <Border Background="#F3E5F5" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding UseStub}"
                                              Foreground="#4A148C" FontWeight="SemiBold" FontSize="13">
                                        🧪  Tryb stub (bez połączenia z P1)
                                    </CheckBox>
                                    <TextBlock Foreground="#7B1FA2" FontSize="10"
                                               Margin="22,3,0,0" TextWrapping="Wrap">
                                        Tryb testowy — działa bez certyfikatów.
                                        Wyłącz po uzyskaniu certyfikatów z CeZ.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="URL API P1 (INT/PROD)"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>

                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource Col2Accent}"
                                       Text="Identyfikatory podmiotu"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="OID usługodawcy (SubjectOid) *"/>
                            <TextBox Style="{StaticResource InputBox}" FontFamily="Consolas"
                                     Text="{Binding SubjectOid, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Kod resortowy komórki org. (cz. VII)"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding OrganizationalUnitCode, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Middleware (API Medycyny Pracy) -->
                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource Col2Accent}"
                                       Text="Middleware - API Medycyny Pracy"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="URL API Middleware"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding MiddlewareBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Login (username)"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding MiddlewareUsername, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Haslo"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding MiddlewarePassword, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="PWZ lekarza wystawiajacego"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding DoctorPwz, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Certyfikat TLS -->
                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource Col2Accent}"
                                       Text="Certyfikat TLS (mutual TLS — API P1)"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="84"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                         IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                         Text="{Binding TlsCertificatePath}"/>
                                <Button Grid.Column="2" Style="{StaticResource ColBtn}"
                                        Background="#6A1B9A"
                                        Command="{Binding BrowseTlsCertCommand}"
                                        ToolTip="Wybierz plik PKCS#12 (.p12/.pfx)">
                                    📂 Wybierz
                                </Button>
                            </Grid>
                            <Border Style="{StaticResource StatusBadge}"
                                    Background="{Binding TlsCertOk, Converter={StaticResource CertBrush}}">
                                <TextBlock Text="{Binding TlsCertStatus}" FontSize="11" Foreground="White"/>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Hasło certyfikatu TLS"/>
                            <PasswordBox x:Name="TlsPwdBox" Style="{StaticResource PwdBox}"
                                         PasswordChanged="TlsPwdBox_PasswordChanged"/>

                            <!-- Certyfikat WSS -->
                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource Col2Accent}"
                                       Text="Certyfikat WSS (pieczęć placówki — CDA)"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="84"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                         IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                         Text="{Binding WssCertificatePath}"/>
                                <Button Grid.Column="2" Style="{StaticResource ColBtn}"
                                        Background="#6A1B9A"
                                        Command="{Binding BrowseWssCertCommand}"
                                        ToolTip="Wybierz plik PKCS#12 (.p12/.pfx)">
                                    📂 Wybierz
                                </Button>
                            </Grid>
                            <Border Style="{StaticResource StatusBadge}"
                                    Background="{Binding WssCertOk, Converter={StaticResource CertBrush}}">
                                <TextBlock Text="{Binding WssCertStatus}" FontSize="11" Foreground="White"/>
                            </Border>

							<TextBlock Style="{StaticResource FieldLabel}" Text="Hasło certyfikatu WSS"/>
							<PasswordBox x:Name="WssPwdBox" Style="{StaticResource PwdBox}"
										 PasswordChanged="WssPwdBox_PasswordChanged"/>

						</StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  KOLUMNA 3 — Repozytorium EDM i statusy                -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Style="{StaticResource ColHeader}" Background="#2E7D32">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="18" Foreground="White"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="Repozytorium EDM"
                                               FontSize="14" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Lokalne pliki CDA · Orzeczenia · Status"
                                               FontSize="10" Foreground="#A5D6A7"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="16,10,16,16">

                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Ścieżka repozytorium dokumentów EDM"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="84"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                         FontFamily="Consolas" FontSize="11"
                                         Text="{Binding EdmRepositoryPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="2" Style="{StaticResource ColBtn}"
                                        Background="#2E7D32"
                                        Command="{Binding BrowseEdmRepositoryCommand}"
                                        ToolTip="Wybierz katalog repozytorium">
                                    📂 Wybierz
                                </Button>
                            </Grid>
                            <Border Style="{StaticResource StatusBadge}" Margin="0,6,0,0"
                                    Background="{Binding EdmRepositoryOk, Converter={StaticResource EdmBrush}}">
                                <TextBlock Text="{Binding EdmRepositoryStatus}"
                                           FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Statystyki -->
                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource Col3Accent}"
                                       Text="Statystyki repozytorium"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#E8F5E9" CornerRadius="8"
                                        Padding="12,10" Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EdmDocumentCount}"
                                                   FontSize="28" FontWeight="Bold"
                                                   Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                        <TextBlock Text="dokumentów XML" FontSize="10"
                                                   Foreground="#558B2F" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#F1F8E9" CornerRadius="8"
                                        Padding="12,10" Margin="6,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding UseStub, Converter={StaticResource StubMode}}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="#558B2F" HorizontalAlignment="Center"/>
                                        <TextBlock Text="tryb P1" FontSize="10"
                                                   Foreground="#558B2F" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Button Margin="0,12,0,0" Style="{StaticResource ColBtn}"
                                    Background="#388E3C" HorizontalAlignment="Stretch"
                                    Command="{Binding OpenEdmRepositoryCommand}">
                                🗂️  Otwórz katalog w Eksploratorze
                            </Button>

                            <!-- Stałe OID systemu P1 -->
                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource Col3Accent}"
                                       Text="Stałe identyfikatory systemu P1"/>

                            <Border Background="#F9FBE7" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="OID PESEL:"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LabelFg}"/>
                                        <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="10"
                                                   Text="2.16.840.1.113883.3.4424.1.1.616"
                                                   Foreground="#1B5E20"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="OID NPWZ:"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LabelFg}"/>
                                        <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="10"
                                                   Text="2.16.840.1.113883.3.4424.1.6.2"
                                                   Foreground="#1B5E20"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="OID base:"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LabelFg}"/>
                                        <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="10"
                                                   Text="2.16.840.1.113883.3.4424.2.3.1"
                                                   Foreground="#1B5E20"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Lista kontrolna onboardingu -->
                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource Col3Accent}"
                                       Text="Lista kontrolna wdrożenia P1"/>

                            <Border Background="#FAFAFA" CornerRadius="6" Padding="10,8"
                                    BorderBrush="#C8E6C9" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontSize="10" Margin="0,2"
                                               Foreground="{Binding TlsCertOk, Converter={StaticResource CheckBrush}}">
                                        <Run Text="{Binding TlsCertOk, Converter={StaticResource CheckMark}, Mode=OneWay}"/>
                                        <Run Text="  Certyfikat TLS (mutual TLS)"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Margin="0,2"
                                               Foreground="{Binding WssCertOk, Converter={StaticResource CheckBrush}}">
                                        <Run Text="{Binding WssCertOk, Converter={StaticResource CheckMark}, Mode=OneWay}"/>
                                        <Run Text="  Certyfikat WSS / pieczęć placówki"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Margin="0,2"
                                               Foreground="{Binding EdmRepositoryOk, Converter={StaticResource CheckBrush}}">
                                        <Run Text="{Binding EdmRepositoryOk, Converter={StaticResource CheckMark}, Mode=OneWay}"/>
                                        <Run Text="  Repozytorium EDM (katalog istnieje)"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Margin="0,2"
                                               Foreground="{Binding UseStub, Converter={StaticResource StubBrush}}">
                                        <Run Text="{Binding UseStub, Converter={StaticResource StubCheck}, Mode=OneWay}"/>
                                        <Run Text="  Tryb stub wyłączony (gotowość PROD)"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- ══ Pasek akcji ═══════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#ECEFF1" BorderBrush="#CFD8DC"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="6"
                        Padding="12,6" Margin="0,0,12,0"
                        BorderBrush="#B0BEC5" BorderThickness="1">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12" VerticalAlignment="Center" Foreground="#37474F"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <Button Grid.Column="1" Style="{StaticResource ColBtn}"
                        Background="#1565C0" Height="36" Padding="24,0" FontSize="13"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusyLocal,
                            Converter={StaticResource InverseBooleanConverter}}">
                    💾  Zapisz konfigurację
                </Button>

                <ProgressBar Grid.Column="3" IsIndeterminate="True"
                             Width="120" Height="6" Foreground="#1565C0"
                             Visibility="{Binding IsBusyLocal,
                                 Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
