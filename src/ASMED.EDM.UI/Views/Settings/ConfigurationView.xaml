<UserControl x:Class="ASMED.EDM.UI.Views.Settings.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="#FFB6D4F3">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <StackPanel>
                <!-- Nagłówek -->
                <TextBlock Text="🔧 Konfiguracja Połączeń MySQL" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="#FF1976D2" 
                          Margin="0,0,0,20"/>

                <TextBlock Text="Skonfiguruj połączenia do baz danych MySQL w chmurze (Primary, Backup, Local)" 
                          FontSize="14" 
                          Foreground="#FF555555" 
                          TextWrapping="Wrap"
                          Margin="0,0,0,30"/>

                <!-- ========================== PRIMARY CONNECTION ========================== -->
                <Border BorderBrush="#FF4CAF50" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20"
                        Background="White">
                    <StackPanel>
                        <TextBlock Text="🟢 Primary Connection (Główna baza produkcyjna)" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#FF4CAF50"
                                  Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Server -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" 
                                    Text="{Binding PrimaryServer, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Database -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1" 
                                    Text="{Binding PrimaryDatabase, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- User -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="User:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="2" Grid.Column="1" 
                                    Text="{Binding PrimaryUser, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Password -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <PasswordBox Grid.Row="3" Grid.Column="1" 
                                        x:Name="PrimaryPasswordBox"
                                        Margin="0,0,0,10"
                                        FontSize="14"/>

                            <!-- Port -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="4" Grid.Column="1" 
                                    Text="{Binding PrimaryPort, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Test Button -->
                            <syncfusion:ButtonAdv Grid.Row="5" Grid.Column="1"
                                                 Content="🧪 Test Primary Connection"
                                                 Command="{Binding TestPrimaryConnectionCommand}"
                                                 IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}"
                                                 Background="#FF4CAF50"
                                                 Foreground="White"
                                                 FontSize="14"
                                                 Padding="15,8"
                                                 HorizontalAlignment="Left"
                                                 Margin="0,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========================== BACKUP CONNECTION ========================== -->
                <Border BorderBrush="#FFFF9800" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20"
                        Background="White">
                    <StackPanel>
                        <TextBlock Text="🟡 Backup Connection (Baza zapasowa w chmurze)" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#FFFF9800"
                                  Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Server -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" 
                                    Text="{Binding BackupServer, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Database -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1" 
                                    Text="{Binding BackupDatabase, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- User -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="User:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="2" Grid.Column="1" 
                                    Text="{Binding BackupUser, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Password -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <PasswordBox Grid.Row="3" Grid.Column="1" 
                                        x:Name="BackupPasswordBox"
                                        Margin="0,0,0,10"
                                        FontSize="14"/>

                            <!-- Port -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="4" Grid.Column="1" 
                                    Text="{Binding BackupPort, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Test Button -->
                            <syncfusion:ButtonAdv Grid.Row="5" Grid.Column="1"
                                                 Content="🧪 Test Backup Connection"
                                                 Command="{Binding TestBackupConnectionCommand}"
                                                 IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}"
                                                 Background="#FFFF9800"
                                                 Foreground="White"
                                                 FontSize="14"
                                                 Padding="15,8"
                                                 HorizontalAlignment="Left"
                                                 Margin="0,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========================== LOCAL CONNECTION ========================== -->
                <Border BorderBrush="#FF2196F3" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20"
                        Background="White">
                    <StackPanel>
                        <TextBlock Text="🔵 Local Connection (Baza lokalna - offline)" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#FF2196F3"
                                  Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Server -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" 
                                    Text="{Binding LocalServer, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Database -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1" 
                                    Text="{Binding LocalDatabase, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- User -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="User:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="2" Grid.Column="1" 
                                    Text="{Binding LocalUser, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Password -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <PasswordBox Grid.Row="3" Grid.Column="1" 
                                        x:Name="LocalPasswordBox"
                                        Margin="0,0,0,10"
                                        FontSize="14"/>

                            <!-- Port -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="4" Grid.Column="1" 
                                    Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Test Button -->
                            <syncfusion:ButtonAdv Grid.Row="5" Grid.Column="1"
                                                 Content="🧪 Test Local Connection"
                                                 Command="{Binding TestLocalConnectionCommand}"
                                                 IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}"
                                                 Background="#FF2196F3"
                                                 Foreground="White"
                                                 FontSize="14"
                                                 Padding="15,8"
                                                 HorizontalAlignment="Left"
                                                 Margin="0,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========================== SETTINGS ========================== -->
                <Border BorderBrush="#FF9C27B0" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20"
                        Background="White">
                    <StackPanel>
                        <TextBlock Text="⚙️ Ustawienia Połączenia" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#FF9C27B0"
                                  Margin="0,0,0,15"/>

                        <CheckBox Content="Enable Automatic Failover (Primary → Backup → Local)"
                                 IsChecked="{Binding EnableFailover}"
                                 FontSize="14"
                                 Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                      Text="Connection Timeout (seconds):" 
                                      VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider Value="{Binding ConnectionTimeout}" 
                                       Minimum="1" 
                                       Maximum="30" 
                                       Width="200"
                                       TickFrequency="1"
                                       IsSnapToTickEnabled="True"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding ConnectionTimeout}" 
                                          FontWeight="Bold" 
                                          FontSize="16"
                                          VerticalAlignment="Center"
                                          Width="30"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========================== STATUS & SAVE ========================== -->
                <Border BorderBrush="#FF607D8B" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20"
                        Background="#FFF5F5F5">
                    <StackPanel>
                        <!-- Status Message -->
                        <TextBlock Text="{Binding StatusMessage}" 
                                  FontSize="14" 
                                  FontWeight="Bold"
                                  Foreground="#FF607D8B"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,15"
                                  HorizontalAlignment="Center"/>

                        <!-- Save Button -->
                        <syncfusion:ButtonAdv Content="💾 Save Configuration"
                                             Command="{Binding SaveConfigurationCommand}"
                                             IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                                             Background="#FF1976D2"
                                             Foreground="White"
                                             FontSize="16"
                                             FontWeight="Bold"
                                             Padding="30,12"
                                             HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>