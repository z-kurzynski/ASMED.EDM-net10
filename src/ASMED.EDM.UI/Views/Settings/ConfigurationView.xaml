<UserControl x:Class="ASMED.EDM.UI.Views.Settings.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="#FFB6D4F3">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><!-- Nagłówek -->
                <RowDefinition Height="*"/><!-- 2-kolumnowy content -->
            </Grid.RowDefinitions>

            <!-- ==================== NAGŁÓWEK ==================== -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="🔧 Konfiguracja i Zarządzanie Bazą Danych MySQL" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="#FF1976D2" 
                          Margin="0,0,0,10"/>

                <TextBlock Text="Skonfiguruj połączenia do baz danych MySQL w chmurze i zarządzaj bazą danych" 
                          FontSize="14" 
                          Foreground="#FF555555" 
                          TextWrapping="Wrap"
                          Margin="0,0,0,10"/>

                <!-- Status aktywnego połączenia -->
                <Border Background="#FFF3F4F6" 
                        BorderBrush="#FFD1D5DB" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="15,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔌 Aktywne połączenie: " 
                                  FontSize="13" 
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveConnectionType}" 
                                  FontSize="13" 
                                  FontWeight="Bold"
                                  Foreground="#FF059669"
                                  VerticalAlignment="Center"
                                  Margin="5,0,15,0"/>
                        <TextBlock Text="📊 Baza: " 
                                  FontSize="13" 
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveDatabaseName}" 
                                  FontSize="13" 
                                  FontWeight="SemiBold"
                                  Foreground="#FF1E40AF"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== 2-KOLUMNOWY LAYOUT ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><!-- Lewa kolumna: Połączenia -->
                    <ColumnDefinition Width="20"/><!-- Spacer -->
                    <ColumnDefinition Width="*"/><!-- Prawa kolumna: Zarządzanie bazą -->
                </Grid.ColumnDefinitions>

                <!-- ========== LEWA KOLUMNA: POŁĄCZENIA ========== -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                <!-- ========================== PRIMARY CONNECTION ========================== -->
                <Border BorderBrush="#FF4CAF50" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20"
                        Background="White">
                    <StackPanel>
                        <TextBlock Text="🟢 Primary Connection (Główna baza produkcyjna)" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#FF4CAF50"
                                  Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Server -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" 
                                    Text="{Binding PrimaryServer, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Database -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1" 
                                    Text="{Binding PrimaryDatabase, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- User -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="User:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="2" Grid.Column="1" 
                                    Text="{Binding PrimaryUser, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Password -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <PasswordBox Grid.Row="3" Grid.Column="1" 
                                        x:Name="PrimaryPasswordBox"
                                        Margin="0,0,0,10"
                                        FontSize="14"/>

                            <!-- Port -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="4" Grid.Column="1" 
                                    Text="{Binding PrimaryPort, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Test Button -->
                            <syncfusion:ButtonAdv Grid.Row="5" Grid.Column="1"
                                                 Content="🧪 Test Primary Connection"
                                                 Command="{Binding TestPrimaryConnectionCommand}"
                                                 IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}"
                                                 Background="#FF4CAF50"
                                                 Foreground="White"
                                                 FontSize="14"
                                                 Padding="15,8"
                                                 HorizontalAlignment="Left"
                                                 Margin="0,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========================== BACKUP CONNECTION ========================== -->
                <Border BorderBrush="#FFFF9800" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20"
                        Background="White">
                    <StackPanel>
                        <TextBlock Text="🟡 Backup Connection (Baza zapasowa w chmurze)" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#FFFF9800"
                                  Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Server -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" 
                                    Text="{Binding BackupServer, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Database -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1" 
                                    Text="{Binding BackupDatabase, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- User -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="User:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="2" Grid.Column="1" 
                                    Text="{Binding BackupUser, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Password -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <PasswordBox Grid.Row="3" Grid.Column="1" 
                                        x:Name="BackupPasswordBox"
                                        Margin="0,0,0,10"
                                        FontSize="14"/>

                            <!-- Port -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="4" Grid.Column="1" 
                                    Text="{Binding BackupPort, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Test Button -->
                            <syncfusion:ButtonAdv Grid.Row="5" Grid.Column="1"
                                                 Content="🧪 Test Backup Connection"
                                                 Command="{Binding TestBackupConnectionCommand}"
                                                 IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}"
                                                 Background="#FFFF9800"
                                                 Foreground="White"
                                                 FontSize="14"
                                                 Padding="15,8"
                                                 HorizontalAlignment="Left"
                                                 Margin="0,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========================== LOCAL CONNECTION ========================== -->
                <Border BorderBrush="#FF2196F3" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20"
                        Background="White">
                    <StackPanel>
                        <TextBlock Text="🔵 Local Connection (Baza lokalna - offline)" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#FF2196F3"
                                  Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Server -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" 
                                    Text="{Binding LocalServer, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Database -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1" 
                                    Text="{Binding LocalDatabase, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- User -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="User:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="2" Grid.Column="1" 
                                    Text="{Binding LocalUser, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Password -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <PasswordBox Grid.Row="3" Grid.Column="1" 
                                        x:Name="LocalPasswordBox"
                                        Margin="0,0,0,10"
                                        FontSize="14"/>

                            <!-- Port -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="4" Grid.Column="1" 
                                    Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,10"
                                    FontSize="14"/>

                            <!-- Test Button -->
                            <syncfusion:ButtonAdv Grid.Row="5" Grid.Column="1"
                                                 Content="🧪 Test Local Connection"
                                                 Command="{Binding TestLocalConnectionCommand}"
                                                 IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}"
                                                 Background="#FF2196F3"
                                                 Foreground="White"
                                                 FontSize="14"
                                                 Padding="15,8"
                                                 HorizontalAlignment="Left"
                                                 Margin="0,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========================== SETTINGS ========================== -->
                <Border BorderBrush="#FF9C27B0" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20"
                        Background="White">
                    <StackPanel>
                        <TextBlock Text="⚙️ Ustawienia Połączenia" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#FF9C27B0"
                                  Margin="0,0,0,15"/>

                        <CheckBox Content="Enable Automatic Failover (Primary → Backup → Local)"
                                 IsChecked="{Binding EnableFailover}"
                                 FontSize="14"
                                 Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                      Text="Connection Timeout (seconds):" 
                                      VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider Value="{Binding ConnectionTimeout}" 
                                       Minimum="1" 
                                       Maximum="30" 
                                       Width="200"
                                       TickFrequency="1"
                                       IsSnapToTickEnabled="True"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding ConnectionTimeout}" 
                                          FontWeight="Bold" 
                                          FontSize="16"
                                          VerticalAlignment="Center"
                                          Width="30"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========================== STATUS & SAVE ========================== -->
                <Border BorderBrush="#FF607D8B" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20"
                        Background="#FFF5F5F5">
                    <StackPanel>
                        <!-- Status Message -->
                        <TextBlock Text="{Binding StatusMessage}" 
                                  FontSize="14" 
                                  FontWeight="Bold"
                                  Foreground="#FF607D8B"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,15"
                                  HorizontalAlignment="Center"/>

                        <!-- Save Button -->
                        <syncfusion:ButtonAdv Content="💾 Save Configuration"
                                             Command="{Binding SaveConfigurationCommand}"
                                             IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                                             Background="#FF1976D2"
                                             Foreground="White"
                                             FontSize="16"
                                             FontWeight="Bold"
                                             Padding="30,12"
                                             HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ========== PRAWA KOLUMNA: ZARZĄDZANIE BAZĄ ========== -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ========================== INICJALIZACJA BAZY ========================== -->
                        <Border BorderBrush="#FF9C27B0" 
                                BorderThickness="2" 
                                CornerRadius="8" 
                                Padding="20" 
                                Margin="0,0,0,20"
                                Background="White">
                            <StackPanel>
                                <TextBlock Text="🗄️ Inicjalizacja Bazy Danych" 
                                          FontSize="18" 
                                          FontWeight="Bold" 
                                          Foreground="#FF9C27B0"
                                          Margin="0,0,0,15"/>

                                <TextBlock Text="Utwórz strukturę bazy danych (tabele, indeksy, relacje)" 
                                          FontSize="12" 
                                          Foreground="Gray"
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,15"/>

                                <!-- Wybór bazy do inicjalizacji -->
                                <TextBlock Text="Wybierz bazę danych:" 
                                          FontSize="12" 
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,5"/>

                                <ComboBox SelectedIndex="{Binding SelectedDatabaseTypeIndex, Mode=TwoWay}"
                                         FontSize="14"
                                         Margin="0,0,0,15">
                                    <ComboBoxItem Content="🟢 Primary (Główna produkcyjna)"/>
                                    <ComboBoxItem Content="🟡 Backup (Zapasowa)"/>
                                    <ComboBoxItem Content="🔵 Local (Lokalna)"/>
                                </ComboBox>

                                <syncfusion:ButtonAdv Content="⚡ Inicjalizuj Bazę Danych"
                                                     Command="{Binding InitializeDatabaseCommand}"
                                                     IsEnabled="{Binding IsInitializing, Converter={StaticResource InverseBooleanConverter}}"
                                                     Background="#FF9C27B0"
                                                     Foreground="White"
                                                     FontSize="14"
                                                     Padding="20,10"
                                                     HorizontalAlignment="Stretch"
                                                     Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding InitializationStatus}" 
                                          FontSize="12" 
                                          Foreground="#FF9C27B0"
                                          TextWrapping="Wrap"
                                          FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <!-- ========================== BACKUP BAZY ========================== -->
                        <Border BorderBrush="#FFFF6F00" 
                                BorderThickness="2" 
                                CornerRadius="8" 
                                Padding="20" 
                                Margin="0,0,0,20"
                                Background="White">
                            <StackPanel>
                                <TextBlock Text="💾 Backup Bazy Danych" 
                                          FontSize="18" 
                                          FontWeight="Bold" 
                                          Foreground="#FFFF6F00"
                                          Margin="0,0,0,15"/>

                                <TextBlock Text="Wykonaj pełną kopię zapasową bazy danych MySQL" 
                                          FontSize="12" 
                                          Foreground="Gray"
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,15"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" 
                                              Text="Ścieżka:" 
                                              VerticalAlignment="Center" 
                                              Margin="0,0,10,10"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" 
                                            Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}" 
                                            Margin="0,0,0,10"
                                            FontSize="12"/>

                                    <syncfusion:ButtonAdv Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                         Content="📦 Utwórz Backup"
                                                         Command="{Binding CreateBackupCommand}"
                                                         IsEnabled="{Binding IsBackingUp, Converter={StaticResource InverseBooleanConverter}}"
                                                         Background="#FFFF6F00"
                                                         Foreground="White"
                                                         FontSize="14"
                                                         Padding="20,10"
                                                         HorizontalAlignment="Stretch"
                                                         Margin="0,0,0,10"/>
                                </Grid>

                                <TextBlock Text="{Binding BackupStatus}" 
                                          FontSize="12" 
                                          Foreground="#FFFF6F00"
                                          TextWrapping="Wrap"
                                          FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <!-- ========================== STATYSTYKI BAZY ========================== -->
                        <Border BorderBrush="#FF00796B" 
                                BorderThickness="2" 
                                CornerRadius="8" 
                                Padding="20" 
                                Margin="0,0,0,20"
                                Background="White">
                            <StackPanel>
                                <TextBlock Text="📊 Statystyki Bazy Danych" 
                                          FontSize="18" 
                                          FontWeight="Bold" 
                                          Foreground="#FF00796B"
                                          Margin="0,0,0,15"/>

                                <syncfusion:ButtonAdv Content="🔍 Pobierz Statystyki"
                                                     Command="{Binding GetDatabaseStatisticsCommand}"
                                                     IsEnabled="{Binding IsLoadingStats, Converter={StaticResource InverseBooleanConverter}}"
                                                     Background="#FF00796B"
                                                     Foreground="White"
                                                     FontSize="14"
                                                     Padding="20,10"
                                                     HorizontalAlignment="Stretch"
                                                     Margin="0,0,0,15"/>

                                <!-- Wyniki statystyk -->
                                <Border BorderBrush="#FFE0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="15"
                                        Background="#FFF9F9F9">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Nazwa bazy -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nazwa bazy:" FontSize="12" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DbName}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>

                                            <!-- Liczba tabel -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Liczba tabel:" FontSize="12" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TableCount}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>

                                            <!-- Liczba rekordów -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Łączna liczba rekordów:" FontSize="12" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalRecords}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>

                                            <!-- Rozmiar bazy -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Rozmiar bazy:" FontSize="12" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DatabaseSize}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>

                                            <!-- Data ostatniego backupu -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ostatni backup:" FontSize="12"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastBackupDate}" FontWeight="Bold" FontSize="12"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ========================== OPERACJE KONSERWACYJNE ========================== -->
                        <Border BorderBrush="#FF455A64" 
                                BorderThickness="2" 
                                CornerRadius="8" 
                                Padding="20" 
                                Margin="0,0,0,20"
                                Background="White">
                            <StackPanel>
                                <TextBlock Text="🔧 Operacje Konserwacyjne" 
                                          FontSize="18" 
                                          FontWeight="Bold" 
                                          Foreground="#FF455A64"
                                          Margin="0,0,0,15"/>

                                <TextBlock Text="Narzędzia do optymalizacji i konserwacji bazy danych" 
                                          FontSize="12" 
                                          Foreground="Gray"
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,15"/>

                                <syncfusion:ButtonAdv Content="🧹 Optymalizuj Tabele"
                                                     Command="{Binding OptimizeTablesCommand}"
                                                     IsEnabled="{Binding IsOptimizing, Converter={StaticResource InverseBooleanConverter}}"
                                                     Background="#FF455A64"
                                                     Foreground="White"
                                                     FontSize="13"
                                                     Padding="15,8"
                                                     HorizontalAlignment="Stretch"
                                                     Margin="0,0,0,10"/>

                                <syncfusion:ButtonAdv Content="🔍 Napraw Tabele"
                                                     Command="{Binding RepairTablesCommand}"
                                                     IsEnabled="{Binding IsRepairing, Converter={StaticResource InverseBooleanConverter}}"
                                                     Background="#FF546E7A"
                                                     Foreground="White"
                                                     FontSize="13"
                                                     Padding="15,8"
                                                     HorizontalAlignment="Stretch"
                                                     Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding MaintenanceStatus}" 
                                          FontSize="12" 
                                          Foreground="#FF455A64"
                                          TextWrapping="Wrap"
                                          FontStyle="Italic"
                                          Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>